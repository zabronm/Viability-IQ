@page "/identity/register"
@page "/identity/profile"
@using ViabilityIQ.Application.Dtos
@using ViabilityIQ.Application.Interfaces.IdentityInterfaces
@layout MainLayout_Blank

<PageTitle>Viability.ID:Register Account</PageTitle>

<div class="m-0 font-def p-2">
    <div class="auth-card my-2 py-2">
        <div class="auth-header">
            <div class="auth-brand fs-2">
                <span class="brand-main">Viability</span><span class="brand-iq fst-italic">.IQ</span>
            </div>
            <p class="auth-subtitle">
                @(IsEditProfileMode ? "Manage your personal and professional profile details" : "Create your account to get started")
            </p>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-circle-fill me-2"></i>
                <strong>@(IsEditProfileMode ? "Update Failed" : "Registration Failed")</strong>
                <p class="mb-0 mt-1">@ErrorMessage</p>
                <button type="button" class="btn-close" @onclick="() => { ErrorMessage = string.Empty; StateHasChanged(); }" aria-label="Close"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                <strong>Success</strong>
                <p class="mb-0 mt-1">@SuccessMessage</p>
                <button type="button" class="btn-close" @onclick="() => { SuccessMessage = string.Empty; StateHasChanged(); }" aria-label="Close"></button>
            </div>
        }

        <EditForm Model="@RegisterRequest" OnSubmit="HandleFormSubmit" FormName="UserAccountForm">
            <DataAnnotationsValidator />

            @if (!IsEditProfileMode)
            {
                <div class="subscription-section">
                    <div class="subscription-heading">
                        <span class="subscription-icon"><i class="bi bi-grid-1x2-fill"></i></span>
                        <div>
                            <strong>Choose your workspace</strong>
                            <small>You can upgrade from Standard to Open Plan later without moving your data.</small>
                        </div>
                    </div>
                    <div class="plan-grid">
                        <button type="button"
                                class="plan-option @(RegisterRequest.PlanCode == "STANDARD" ? "selected" : "")"
                                @onclick='() => SelectPlan("STANDARD")'
                                disabled="@IsSubmitting">
                            <span class="plan-check"><i class="bi bi-person-fill"></i></span>
                            <span class="plan-copy">
                                <strong>Standard</strong>
                                <small>Personal workspace for one individual user.</small>
                            </span>
                            <span class="plan-seat">1 seat</span>
                        </button>
                        <button type="button"
                                class="plan-option @(RegisterRequest.PlanCode == "OPEN" ? "selected" : "")"
                                @onclick='() => SelectPlan("OPEN")'
                                disabled="@IsSubmitting">
                            <span class="plan-check"><i class="bi bi-buildings-fill"></i></span>
                            <span class="plan-copy">
                                <strong>Open Plan</strong>
                                <small>Organisation workspace with flexible users and branches.</small>
                            </span>
                            <span class="plan-seat">2+ seats</span>
                        </button>
                    </div>

                    @if (IsOpenPlan)
                    {
                        <div class="form-row-custom mt-3">
                            <div class="form-group-custom flex-fill">
                                <label class="form-label-custom">Organisation Name</label>
                                <div class="input-icon-wrapper">
                                    <i class="bi bi-building icon-addon"></i>
                                    <InputText @bind-Value="RegisterRequest.OrganisationName"
                                               class="form-control-custom"
                                               placeholder="Your organisation"
                                               disabled="@IsSubmitting" />
                                </div>
                            </div>
                            <div class="form-group-custom seats-field">
                                <label class="form-label-custom">Initial Seats</label>
                                <div class="input-icon-wrapper">
                                    <i class="bi bi-people icon-addon"></i>
                                    <InputNumber @bind-Value="RegisterRequest.RequestedSeats"
                                                 class="form-control-custom"
                                                 min="2"
                                                 disabled="@IsSubmitting" />
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- FIRST NAME & LAST NAME -->
            <div class="form-row-custom">
                <div class="form-group-custom flex-fill">
                    <label class="form-label-custom">First Name</label>
                    <div class="input-icon-wrapper">
                        <i class="bi bi-person icon-addon"></i>
                        <InputText @bind-Value="RegisterRequest.FirstName" class="form-control-custom" placeholder="John" disabled="@IsSubmitting" />
                    </div>
                    <ValidationMessage For="@(() => RegisterRequest.FirstName)" class="auth-error-msg" />
                </div>

                <div class="form-group-custom flex-fill">
                    <label class="form-label-custom">Last Name</label>
                    <div class="input-icon-wrapper">
                        <i class="bi bi-person icon-addon"></i>
                        <InputText @bind-Value="RegisterRequest.LastName" class="form-control-custom" placeholder="Doe" disabled="@IsSubmitting" />
                    </div>
                    <ValidationMessage For="@(() => RegisterRequest.LastName)" class="auth-error-msg" />
                </div>
            </div>

            <!-- EMAIL & PHONE NUMBER -->
            <div class="form-row-custom">
                <div class="form-group-custom flex-fill">
                    <label class="form-label-custom">Email Address</label>
                    <div class="input-icon-wrapper">
                        <i class="bi bi-envelope icon-addon"></i>
                        <InputText type="email" @bind-Value="RegisterRequest.Email" class="form-control-custom" placeholder="your@email.com" disabled="@(IsSubmitting || IsEditProfileMode)" />
                    </div>
                    <ValidationMessage For="@(() => RegisterRequest.Email)" class="auth-error-msg" />
                </div>

                <div class="form-group-custom flex-fill">
                    <label class="form-label-custom">Phone Number</label>
                    <div class="input-icon-wrapper">
                        <i class="bi bi-telephone icon-addon"></i>
                        <InputText @bind-Value="RegisterRequest.PhoneNumber" class="form-control-custom" placeholder="+1 (555) 000-0000" disabled="@IsSubmitting" />
                    </div>
                    <ValidationMessage For="@(() => RegisterRequest.PhoneNumber)" class="auth-error-msg" />
                </div>
            </div>

            <!-- DEPARTMENT & JOB TITLE -->
            <div class="form-row-custom">
                <div class="form-group-custom flex-fill">
                    <label class="form-label-custom">Department</label>
                    <div class="input-icon-wrapper">
                        <i class="bi bi-building icon-addon"></i>
                        <InputText @bind-Value="RegisterRequest.Department" class="form-control-custom" placeholder="Engineering" disabled="@IsSubmitting" />
                    </div>
                </div>

                <div class="form-group-custom flex-fill">
                    <label class="form-label-custom">Job Title</label>
                    <div class="input-icon-wrapper">
                        <i class="bi bi-briefcase icon-addon"></i>
                        <InputText @bind-Value="RegisterRequest.JobTitle" class="form-control-custom" placeholder="Lead Developer" disabled="@IsSubmitting" />
                    </div>
                </div>
            </div>

            <!-- PROVINCE -->
            <div class="form-row-custom">
                <div class="form-group-custom flex-fill">
                    <label class="form-label-custom">Province</label>
                    <div class="input-icon-wrapper">
                        <i class="bi bi-map icon-addon"></i>
                        <InputSelect @bind-Value="RegisterRequest.ProvinceId" class="form-control-custom" disabled="@IsSubmitting">
                            <option value="0">-- Select Province --</option>
                            @foreach (var province in Provinces)
                            {
                                <option value="@province.Id">@province.Name</option>
                            }
                        </InputSelect>
                    </div>
                    <ValidationMessage For="@(() => RegisterRequest.ProvinceId)" class="auth-error-msg" />
                </div>
            </div>

            <!-- DATE OF BIRTH & COUNTRY -->
            @* <div class="form-row-custom">
                <div class="form-group-custom flex-fill">
                    <label class="form-label-custom">Date of Birth</label>
                    <div class="input-icon-wrapper">
                        <i class="bi bi-calendar-event icon-addon"></i>
                        <InputDate @bind-Value="RegisterRequest.DateOfBirth" class="form-control-custom" disabled="@IsSubmitting" />
                    </div>
                </div>

                <div class="form-group-custom flex-fill">
                    <label class="form-label-custom">Country</label>
                    <div class="input-icon-wrapper">
                        <i class="bi bi-globe icon-addon"></i>
                        <InputText @bind-Value="RegisterRequest.Country" class="form-control-custom" placeholder="United States" disabled="@IsSubmitting" />
                    </div>
                </div>
            </div> *@

            <!-- ADDRESS & CITY -->
            <div class="form-row-custom">
                <div class="form-group-custom flex-fill">
                    <label class="form-label-custom">Street Address</label>
                    <div class="input-icon-wrapper">
                        <i class="bi bi-geo-alt icon-addon"></i>
                        <InputText @bind-Value="RegisterRequest.Address" class="form-control-custom" placeholder="123 Main St" disabled="@IsSubmitting" />
                    </div>
                </div>

                <div class="form-group-custom flex-fill">
                    <label class="form-label-custom">City</label>
                    <div class="input-icon-wrapper">
                        <i class="bi bi-pin-map icon-addon"></i>
                        <InputText @bind-Value="RegisterRequest.City" class="form-control-custom" placeholder="New York" disabled="@IsSubmitting" />
                    </div>
                </div>
            </div>

            @if (!IsEditProfileMode)
            {
                <!-- PASSWORD & CONFIRM PASSWORD -->
                <div class="form-row-custom">
                    <div class="form-group-custom flex-fill">
                        <label class="form-label-custom">Password</label>
                        <div class="input-icon-wrapper">
                            <i class="bi bi-lock icon-addon"></i>
                            <InputText type="@(ShowPassword ? "text" : "password")" @bind-Value="RegisterRequest.Password" class="form-control-custom" placeholder="••••••••" disabled="@IsSubmitting" />
                            <button type="button" class="password-toggle-btn" @onclick="TogglePasswordVisibility" tabindex="-1">
                                <i class="bi @(ShowPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                            </button>
                        </div>
                        <ValidationMessage For="@(() => RegisterRequest.Password)" class="auth-error-msg" />
                    </div>

                    <div class="form-group-custom flex-fill">
                        <label class="form-label-custom">Confirm Password</label>
                        <div class="input-icon-wrapper">
                            <i class="bi bi-lock icon-addon"></i>
                            <InputText type="@(ShowConfirmPassword ? "text" : "password")" @bind-Value="RegisterRequest.ConfirmPassword" class="form-control-custom" placeholder="••••••••" disabled="@IsSubmitting" />
                            <button type="button" class="password-toggle-btn" @onclick="ToggleConfirmPasswordVisibility" tabindex="-1">
                                <i class="bi @(ShowConfirmPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                            </button>
                        </div>
                        <ValidationMessage For="@(() => RegisterRequest.ConfirmPassword)" class="auth-error-msg" />
                    </div>
                </div>

                <!-- TERMS CHECKBOX -->
                <div class="auth-actions-row">
                    <label class="checkbox-container-custom">
                        <InputCheckbox @bind-Value="AgreedToTerms" disabled="@IsSubmitting" />
                        <span class="checkmark"></span>
                        I agree to the Terms of Service
                    </label>
                </div>
            }

            <!-- SUBMIT BUTTON -->
            <button type="submit" class="btn btn-primary w-100" disabled="@(IsSubmitting || !IsFormValid())">
                @if (IsSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>@(IsEditProfileMode ? "Saving Changes..." : "Creating Account...")</span>
                }
                else
                {
                    <span>@(IsEditProfileMode ? "Save Changes" : "Create Account")</span>
                }
            </button>
        </EditForm>

        <div class="auth-card-footer">
            @if (!IsEditProfileMode)
            {
                <div>
                    Already have an account?
                    <a href="/login" class="link-btn-inline font-weight-bold">Sign In Here</a>
                </div>
            }
            else
            {
                <div>
                    <a href="/home" class="link-btn-inline font-weight-bold"><i class="bi bi-arrow-left me-1"></i> Back to Dashboard</a>
                </div>
            }
        </div>
    </div>
</div>


<style>

    .font-def {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    .m-0 {
        margin: 0;
    }

    .p-2 {
        padding: 0.5rem;
    }

    .py-2 {
        padding-top: 0.5rem;
        padding-bottom: 0.5rem;
    }

    .mt-1 {
        margin-top: 0.25rem;
    }

    .me-1 {
        margin-right: 0.25rem;
    }

    .me-2 {
        margin-right: 0.5rem;
    }

    .fst-italic {
        font-style: italic;
    }

    :global(body) {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        margin: 0;
        padding: 20px;
    }

    .auth-card {
        background-color: #ffffff;
        width: 100%;
        max-width: 720px;
        border-radius: 16px;
        border: 1px solid #d1dbe8;
        box-shadow: 0 15px 35px rgba(0, 0, 102, 0.08);
        padding: 30px 32px;
        box-sizing: border-box;
    }

    .auth-header {
        text-align: center;
        margin-bottom: 24px;
    }

    .subscription-section {
        margin-bottom: 18px;
        padding: 14px;
        border: 1px solid #dbe5f0;
        border-radius: 10px;
        background: #f8fafc;
    }

    .subscription-heading {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 12px;
        color: #0f172a;
    }

    .subscription-heading small,
    .plan-copy small {
        display: block;
        color: #64748b;
        font-size: 0.74rem;
        font-weight: 400;
    }

    .subscription-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        color: #fff;
        background: #000099;
    }

    .plan-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .plan-option {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 10px;
        min-height: 72px;
        padding: 10px;
        text-align: left;
        background: #fff;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        cursor: pointer;
    }

    .plan-option.selected {
        border-color: #000099;
        box-shadow: 0 0 0 2px rgba(0, 0, 153, 0.08);
        background: #f5f7ff;
    }

    .plan-check {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        color: #000099;
        background: #e7e9ff;
    }

    .plan-copy strong {
        display: block;
        color: #172033;
    }

    .plan-seat {
        padding: 3px 7px;
        border-radius: 999px;
        color: #065f46;
        background: #d1fae5;
        font-size: 0.7rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .seats-field {
        flex: 0 0 145px;
    }

    .auth-brand {
        font-weight: 800;
        font-size: 1.5rem;
        color: #0f172a;
        margin-bottom: 8px;
        display: block;
    }

    .auth-subtitle {
        font-size: 0.85rem;
        color: #64748b;
        margin: 0;
    }

    .alert {
        border-radius: 8px;
        border: 1px solid;
        margin-bottom: 16px;
        font-size: 0.85rem;
        padding: 10px 14px;
    }

    .alert-danger {
        background-color: #fee2e2;
        border-color: #fca5a5;
        color: #991b1b;
    }

    .alert-success {
        background-color: #d1fae5;
        border-color: #6ee7b7;
        color: #065f46;
    }

    .btn-close {
        background: none;
        border: none;
        font-size: 1rem;
        cursor: pointer;
        position: absolute;
        right: 0.75rem;
        top: 0.5rem;
    }

    .form-row-custom {
        display: flex;
        gap: 14px;
    }

    .form-group-custom {
        margin-bottom: 14px;
        position: relative;
    }

    .flex-fill {
        flex: 1;
        min-width: 0;
    }

   @*  .form-label-custom {
        display: block;
        font-size: 0.7rem;
        font-weight: normal;
        color: #475569;
        margin-bottom: 1px;
        text-transform:inherit;
        letter-spacing: 0.4px;
    } *@

    .input-icon-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .icon-addon {
        position: absolute;
        left: 12px;
        color: #94a3b8;
        font-size: 0.95rem;
        pointer-events: none;
        z-index: 2;
    }

    /* Compact 36px height for text inputs and dropdown selects */
    .form-control-custom {
        width: 100%;
        height: 36px;
        background-color: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        padding: 0 12px 0 36px;
        font-size: 0.875rem;
        color: #1e293b;
        box-sizing: border-box;
        transition: all 0.2s ease-in-out;
    }

        .form-control-custom:focus {
            outline: none;
            border-color: #000099;
            box-shadow: 0 0 0 3px rgba(0, 0, 153, 0.08);
        }

        .form-control-custom:disabled {
            background-color: #f3f4f6;
            color: #9ca3af;
            cursor: not-allowed;
        }

    .password-toggle-btn {
        position: absolute;
        right: 4px;
        height: 30px;
        width: 30px;
        background: none;
        border: none;
        color: #64748b;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2;
    }

    .auth-actions-row {
        display: flex;
        align-items: center;
        margin-bottom: 16px;
    }

    .link-btn-inline {
        font-size: 0.825rem;
        color: #000099;
        text-decoration: none;
        font-weight: 700;
    }

        .link-btn-inline:hover {
            text-decoration: underline;
        }

    .checkbox-container-custom {
        display: flex;
        align-items: center;
        position: relative;
        padding-left: 24px;
        cursor: pointer;
        font-size: 0.825rem;
        color: #475569;
        user-select: none;
    }

        .checkbox-container-custom input {
            position: absolute;
            opacity: 0;
            cursor: pointer;
        }

    .checkmark {
        position: absolute;
        left: 0;
        height: 16px;
        width: 16px;
        background-color: #ffffff;
        border: 1.5px solid #cbd5e1;
        border-radius: 4px;
    }

    .checkbox-container-custom input:checked ~ .checkmark {
        background-color: #000099;
        border-color: #000099;
    }

    .checkmark:after {
        content: "";
        position: absolute;
        display: none;
        left: 4px;
        top: 1px;
        width: 4px;
        height: 8px;
        border: solid white;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg);
    }

    .checkbox-container-custom input:checked ~ .checkmark:after {
        display: block;
    }

    .auth-card-footer {
        margin-top: 18px;
        padding-top: 14px;
        border-top: 1px solid #e2e8f0;
        text-align: center;
        font-size: 0.825rem;
        color: #64748b;
    }

    .auth-error-msg {
        display: block;
        font-size: 0.72rem;
        color: #ef4444;
        margin-top: 2px;
    }

    .font-weight-bold {
        font-weight: 700;
    }
</style>