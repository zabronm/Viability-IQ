@namespace ViabilityIQ.Web.Components.Pages_Assessments.ProjectionComponents
@inherits IndependentCashflowProjectionComponent

<section class="cfhealth-card" aria-labelledby="cfhealth-title">
    <header class="cfhealth-header">
        <div><i class="bi bi-activity"></i><strong id="cfhealth-title">Business Health Index</strong></div>
        <span>Live viability radar</span>
    </header>

    @if (IsLoading)
    {
        <div class="cfhealth-state"><span class="spinner-border spinner-border-sm"></span> Loading health index...</div>
    }
    else if (!string.IsNullOrWhiteSpace(LoadError))
    {
        <div class="cfhealth-state cfhealth-state-error"><i class="bi bi-exclamation-triangle"></i> Health index could not load: @LoadError</div>
    }
    else if (Projection is not null)
    {
        <div class="cfhealth-layout">
            <div class="cfhealth-radar-wrap">
                <svg class="cfhealth-radar" viewBox="0 0 430 330" role="img" aria-labelledby="cfhealth-description">
                    <title id="cfhealth-description">Business health radar for interest cover, margin of safety and asset efficiency</title>

                    <defs>
                        <filter id="cfhealthGlow" x="-30%" y="-30%" width="160%" height="160%">
                            <feDropShadow dx="0" dy="4" stdDeviation="5" flood-color="#0f6c78" flood-opacity=".25" />
                        </filter>
                    </defs>

                    <polygon points="215,40 382,275 48,275" class="cfhealth-grid cfhealth-grid-outer" />
                    <polygon points="215,87 348.6,275 81.4,275" class="cfhealth-grid" />
                    <polygon points="215,134 315.2,275 114.8,275" class="cfhealth-grid" />
                    <polygon points="215,181 281.8,275 148.2,275" class="cfhealth-grid" />
                    <polygon points="215,228 248.4,275 181.6,275" class="cfhealth-grid" />

                    <line x1="215" y1="275" x2="215" y2="40" class="cfhealth-axis" />
                    <line x1="215" y1="275" x2="382" y2="275" class="cfhealth-axis" />
                    <line x1="215" y1="275" x2="48" y2="275" class="cfhealth-axis" />

                    <polygon points="215,275 215,@InterestY @MarginX,275"
                             class="cfhealth-zone cfhealth-zone-interest" />
                    <polygon points="215,275 @MarginX,275 @EfficiencyX,275"
                             class="cfhealth-zone cfhealth-zone-margin" />
                    <polygon points="215,275 @EfficiencyX,275 215,@InterestY"
                             class="cfhealth-zone cfhealth-zone-efficiency" />
                    <polygon points="@RadarPoints" class="cfhealth-outline" />

                    <circle cx="215" cy="@InterestY" r="5.5" class="cfhealth-point cfhealth-point-interest" />
                    <circle cx="@MarginX" cy="275" r="5.5" class="cfhealth-point cfhealth-point-margin" />
                    <circle cx="@EfficiencyX" cy="275" r="5.5" class="cfhealth-point cfhealth-point-efficiency" />

                    <text x="215" y="18" text-anchor="middle" class="cfhealth-label">Interest Cover</text>
                    <text x="215" y="32" text-anchor="middle" class="cfhealth-value-label">@InterestCoverDisplay</text>
                    <text x="396" y="301" text-anchor="end" class="cfhealth-label">Margin of Safety</text>
                    <text x="396" y="316" text-anchor="end" class="cfhealth-value-label">@MarginOfSafetyDisplay</text>
                    <text x="34" y="301" class="cfhealth-label">Asset Efficiency</text>
                    <text x="34" y="316" class="cfhealth-value-label">@AssetEfficiencyDisplay</text>
                </svg>
            </div>

            <aside class="cfhealth-score">
                <span>Overall health</span>
                <strong>@Projection.Viability.HealthScore.ToString("F0")<small>/100</small></strong>
                <div class="cfhealth-score-track">
                    <span style="@($"width:{Clamp(Projection.Viability.HealthScore):F0}%")"></span>
                </div>
                <p>@HealthSummary</p>
            </aside>
        </div>
    }
</section>

@code {
    private decimal InterestScore =>
        Projection!.Viability.InterestCover is null
            ? (Projection.Summary.InterestExpense == 0m && Projection.Summary.EBIT > 0m ? 100m : 0m)
            : Clamp(Projection.Viability.InterestCover.Value / 4m * 100m);

    private decimal MarginScore =>
        Clamp(Projection!.Viability.MarginOfSafety.GetValueOrDefault() / 0.5m * 100m);

    private decimal EfficiencyScore =>
        Clamp(Projection!.Viability.AssetTurnover.GetValueOrDefault() / 2m * 100m);

    private decimal InterestY => 275m - (235m * InterestScore / 100m);
    private decimal MarginX => 215m + (167m * MarginScore / 100m);
    private decimal EfficiencyX => 215m - (167m * EfficiencyScore / 100m);

    private string RadarPoints =>
        FormattableString.Invariant($"215,{InterestY:F1} {MarginX:F1},275 {EfficiencyX:F1},275");

    private string InterestCoverDisplay =>
        Projection!.Viability.InterestCover.HasValue
            ? $"{Projection.Viability.InterestCover.Value:F1}x"
            : Projection.Summary.InterestExpense == 0m ? "No interest burden" : "N/A";

    private string MarginOfSafetyDisplay =>
        Projection!.Viability.MarginOfSafety.HasValue
            ? $"{Projection.Viability.MarginOfSafety.Value * 100m:F1}%"
            : "N/A";

    private string AssetEfficiencyDisplay =>
        Projection!.Viability.AssetTurnover.HasValue
            ? $"{Projection.Viability.AssetTurnover.Value:F2}x"
            : "N/A";

    private string HealthSummary => Projection!.Viability.HealthScore switch
    {
        >= 75m => "Strong financial resilience",
        >= 55m => "Stable, with room to improve",
        >= 40m => "Performance requires attention",
        _ => "Immediate corrective action advised"
    };

    private static decimal Clamp(decimal value) => Math.Clamp(value, 0m, 100m);
}
