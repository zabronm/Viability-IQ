@namespace ViabilityIQ.Web.Components.Pages_Assessments.ProjectionComponents
@using ViabilityIQ.Shared.FinancialModels

<section class="business-indicators card border-0 shadow-sm h-100" aria-labelledby="business-indicators-title">
    <div class="card-header bg-dark text-white d-flex align-items-center justify-content-between">
        <div>
            <strong id="business-indicators-title">Business Performance Indicators</strong>
            <div class="indicator-subtitle">Profitability, resilience and asset efficiency</div>
        </div>
        <i class="bi bi-speedometer2"></i>
    </div>

    <div class="card-body">
        <div class="assessment-lines mb-3">
            <div class="assessment-line">
                <span>Margin of safety</span>
                <strong class="@MarginOfSafetyClass">@MarginOfSafetyStatus</strong>
            </div>
            <div class="assessment-line">
                <span>Interest cover</span>
                <strong class="@InterestCoverClass">@InterestCoverStatus</strong>
            </div>
            <div class="assessment-line">
                <span>Assets efficiency</span>
                <strong class="@AssetEfficiencyClass">@AssetEfficiencyStatus</strong>
            </div>
        </div>

        <div class="score-grid mb-3">
            <div class="health-score">
                <div class="score-label">Health score</div>
                <div class="score-value">@Projection.Viability.HealthScore.ToString("F0")<span>/100</span></div>
                <div class="progress" role="progressbar"
                     aria-label="Financial health score"
                     aria-valuenow="@Projection.Viability.HealthScore"
                     aria-valuemin="0"
                     aria-valuemax="100">
                    <div class="progress-bar @HealthScoreClass"
                         style="@($"width:{Projection.Viability.HealthScore:F0}%")"></div>
                </div>
            </div>
            <div class="business-value">
                <div class="score-label">Value of business</div>
                <div class="value-amount">@Money(Projection.Viability.IndicativeBusinessValue)</div>
                <div class="value-note">Indicative 12-month NPV at 10% nominal</div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-sm indicator-table mb-0">
                <tbody>
                    <tr>
                        <th>Monthly break-even</th>
                        <td>@Money(Projection.Viability.MonthlyBreakEvenSales)</td>
                    </tr>
                    <tr>
                        <th>Margin of safety %</th>
                        <td>@Percent(Projection.Viability.MarginOfSafety)</td>
                    </tr>
                    <tr>
                        <th>Interest cover times</th>
                        <td>@Ratio(Projection.Viability.InterestCover)</td>
                    </tr>
                    <tr>
                        <th>Return on assets %</th>
                        <td>@Percent(Projection.Viability.ReturnOnAssets)</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public CashflowProjectionResult Projection { get; set; } = default!;

    private string MarginOfSafetyStatus => Projection.Viability.MarginOfSafety switch
    {
        >= 0.50m => "Exceptionally good",
        >= 0.30m => "Very good",
        >= 0.20m => "Good",
        >= 0.10m => "Fair",
        >= 0m => "Low",
        _ => "At risk"
    };

    private string InterestCoverStatus => Projection.Viability.InterestCover switch
    {
        null when Projection.Summary.EBIT > 0m => "No interest burden",
        null => "Not available",
        >= 4m => "Outstandingly good",
        >= 3m => "Excellent",
        >= 2m => "Good",
        >= 1.5m => "Adequate",
        >= 1m => "Weak",
        _ => "Critical"
    };

    private string AssetEfficiencyStatus => Projection.Viability.AssetTurnover switch
    {
        null => "Not available",
        >= 2m => "Exceptional",
        >= 1.5m => "Strong",
        >= 1m => "Good",
        >= 0.5m => "Fair",
        _ => "Low"
    };

    private string MarginOfSafetyClass => StatusClass(Projection.Viability.MarginOfSafety, 0.20m, 0.10m);
    private string InterestCoverClass => Projection.Viability.InterestCover is null
        ? "status-neutral"
        : StatusClass(Projection.Viability.InterestCover, 2m, 1.5m);
    private string AssetEfficiencyClass => Projection.Viability.AssetTurnover is null
        ? "status-neutral"
        : StatusClass(Projection.Viability.AssetTurnover, 1m, 0.5m);
    private string HealthScoreClass => Projection.Viability.HealthScore switch
    {
        >= 70m => "bg-success",
        >= 50m => "bg-warning",
        _ => "bg-danger"
    };

    private static string StatusClass(decimal? value, decimal good, decimal warning) =>
        value >= good ? "status-good" : value >= warning ? "status-warning" : "status-risk";

    private static string Money(decimal? value) =>
        value.HasValue ? $"R {value.Value:N0}" : "N/A";

    private static string Percent(decimal? value) =>
        value.HasValue ? $"{value.Value * 100m:F1}%" : "N/A";

    private static string Ratio(decimal? value) =>
        value.HasValue ? $"{value.Value:F2}x" : "N/A";

}
