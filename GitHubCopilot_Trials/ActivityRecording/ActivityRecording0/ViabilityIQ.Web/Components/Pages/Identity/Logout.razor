@page "/logout"
@layout MainLayout_Blank
@inject NavigationManager Navigation

<PageTitle>Sign out</PageTitle>

<main class="container py-5">
    <section class="card mx-auto shadow-sm" style="max-width: 420px;">
        <div class="card-body p-4 text-center">
            <i class="bi bi-box-arrow-right fs-2 text-secondary"></i>
            <h1 class="h5 mt-3">Sign out of Viability.IQ?</h1>
            <p class="small text-secondary">
                Your current session will be closed securely.
            </p>

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="alert alert-danger small text-start" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                    @ErrorMessage
                </div>
            }

            <form method="post" action="/api/auth/signout-form">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-danger btn-sm px-4">
                    Sign out
                </button>
                <a href="/home" class="btn btn-outline-secondary btn-sm px-4 ms-2">
                    Cancel
                </a>
            </form>
        </div>
    </section>
</main>

@code {
    private string? ErrorMessage { get; set; }

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (!query.TryGetValue("error", out var error))
        {
            return;
        }

        ErrorMessage = error.ToString() switch
        {
            "AuditFailure" =>
                "Sign out was stopped because the mandatory activity record could not be saved. Please retry or contact support.",
            "InvalidRequest" =>
                "The sign-out request expired or was invalid. Please submit it again.",
            _ => null
        };
    }
}
