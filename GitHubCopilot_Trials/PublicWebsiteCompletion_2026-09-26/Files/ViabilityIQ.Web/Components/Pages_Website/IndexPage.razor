@page "/index"
@page "/website/index"
@page "/web/home"
@using ViabilityIQ.Web.Components.Layout.Websites
@using ViabilityIQ.Web.Components.Pages_Website.WebsiteComponents
@layout PublicLayout

<PageTitle>ViabilityIQ | Financial viability, projections and decision intelligence</PageTitle>

<div class="viq-home">
    <section class="home-hero" id="home">
        <div class="home-container hero-grid">
            <div class="hero-copy">
                <span class="section-kicker"><i class="bi bi-stars"></i> Financial clarity before commitment</span>
                <h1>Turn business assumptions into a decision-ready financial story.</h1>
                <p class="hero-lead">
                    ViabilityIQ brings structured data capture, 12-month projections,
                    sensitivity testing, risk indicators and AI-assisted interpretation
                    into one secure assessment workspace.
                </p>
                <div class="hero-actions">
                    <a class="home-button primary" href="/identity/register">
                        Start an assessment <i class="bi bi-arrow-right"></i>
                    </a>
                    <a class="home-button secondary" href="/website/index#contact">
                        Request a demo
                    </a>
                </div>
                <div class="hero-proof">
                    <span><i class="bi bi-check-circle-fill"></i> Scenario-based planning</span>
                    <span><i class="bi bi-check-circle-fill"></i> Explainable calculations</span>
                    <span><i class="bi bi-check-circle-fill"></i> Exportable reports</span>
                </div>
            </div>

            <div class="hero-visual" aria-label="ViabilityIQ dashboard preview">
                <div class="visual-frame">
                    <div class="visual-toolbar">
                        <span></span><span></span><span></span>
                        <small>Assessment intelligence workspace</small>
                    </div>
                    <img src="/images/hero-dashboard.png"
                         alt="ViabilityIQ financial assessment dashboard"
                         loading="eager" />
                    <div class="visual-insight">
                        <i class="bi bi-activity"></i>
                        <span><strong>Know what changes the outcome.</strong> Compare the baseline with practical scenarios before deciding.</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="trust-strip" aria-label="Platform strengths">
        <div class="home-container trust-grid">
            <span><i class="bi bi-calendar3"></i> 12-month projections</span>
            <span><i class="bi bi-shield-lock"></i> Tenant-aware access</span>
            <span><i class="bi bi-diagram-3"></i> Integrated operating model</span>
            <span><i class="bi bi-file-earmark-bar-graph"></i> Decision-ready reporting</span>
        </div>
    </section>

    <section class="home-section" id="capabilities">
        <div class="home-container">
            <div class="section-heading">
                <span class="section-kicker">One connected assessment</span>
                <h2>See how operations flow through to cash, risk and viability.</h2>
                <p>
                    Capture the drivers of the business once, then use the same
                    authoritative model across projections, alerts, scenarios and reports.
                </p>
            </div>

            <div class="capability-grid">
                <article class="capability-card featured">
                    <div class="capability-icon"><i class="bi bi-graph-up-arrow"></i></div>
                    <div>
                        <span>Projection engine</span>
                        <h3>Integrated financial projections</h3>
                        <p>Model sales, operating costs, VAT, working capital, loans, assets and cash flow over a practical 12-month horizon.</p>
                    </div>
                    <div class="card-graphic projection-bars" aria-hidden="true">
                        <i style="height:32%"></i><i style="height:47%"></i><i style="height:42%"></i>
                        <i style="height:68%"></i><i style="height:74%"></i><i style="height:88%"></i>
                    </div>
                </article>

                <article class="capability-card">
                    <div class="capability-icon"><i class="bi bi-sliders"></i></div>
                    <span>Decision testing</span>
                    <h3>Sensitivity and scenarios</h3>
                    <p>Stress-test revenue, costs, collections, interest and investment assumptions without changing source records.</p>
                </article>

                <article class="capability-card">
                    <div class="capability-icon"><i class="bi bi-exclamation-diamond"></i></div>
                    <span>Early warning</span>
                    <h3>Risk and break-even signals</h3>
                    <p>Surface liquidity pressure, funding gaps, weak cover and narrow margins of safety with clear recommended actions.</p>
                </article>

                <article class="capability-card">
                    <div class="capability-icon"><i class="bi bi-box-seam"></i></div>
                    <span>Operational detail</span>
                    <h3>Asset lifecycle intelligence</h3>
                    <p>Track acquisitions, movements, depreciation, disposals and monthly opening and closing values.</p>
                </article>

                <article class="capability-card">
                    <div class="capability-icon"><i class="bi bi-cpu"></i></div>
                    <span>Assisted interpretation</span>
                    <h3>Optional AI analysis</h3>
                    <p>Interpret deterministic sensitivity results with evidence-backed summaries and recommendations while keeping calculations authoritative.</p>
                </article>

                <article class="capability-card">
                    <div class="capability-icon"><i class="bi bi-file-earmark-spreadsheet"></i></div>
                    <span>Communication</span>
                    <h3>Reports and exports</h3>
                    <p>Prepare structured on-screen reports, spreadsheets and printable output for review and decision-making.</p>
                </article>
            </div>
        </div>
    </section>

    <section class="home-section soft-section" id="how-it-works">
        <div class="home-container">
            <div class="section-heading">
                <span class="section-kicker">A disciplined workflow</span>
                <h2>From source assumptions to a defensible decision.</h2>
            </div>
            <div class="process-grid">
                <article><b>01</b><h3>Capture</h3><p>Set up the client, business and assessment, then record the commercial and financial drivers.</p></article>
                <article><b>02</b><h3>Project</h3><p>Build the connected income, cash-flow, VAT, working-capital, debt and asset schedules.</p></article>
                <article><b>03</b><h3>Challenge</h3><p>Compare scenarios and test the assumptions that matter most to resilience and funding.</p></article>
                <article><b>04</b><h3>Decide</h3><p>Review alerts, KPIs and reports, then communicate the evidence behind the decision.</p></article>
            </div>
        </div>
    </section>

    <section class="home-section" id="who-its-for">
        <div class="home-container audience-layout">
            <div class="section-heading left">
                <span class="section-kicker">Built for practical decisions</span>
                <h2>One model, several decision-makers.</h2>
                <p>ViabilityIQ supports people who need more than a spreadsheet total—they need the operational reasons behind it.</p>
                <a class="text-link" href="/website/index#contact">Discuss your use case <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="audience-grid">
                <article><i class="bi bi-rocket-takeoff"></i><div><h3>Entrepreneurs</h3><p>Test whether a proposed business can fund its setup, costs and growth assumptions.</p></div></article>
                <article><i class="bi bi-building"></i><div><h3>Existing businesses</h3><p>Understand cash pressure, working-capital needs and the effect of operational changes.</p></div></article>
                <article><i class="bi bi-briefcase"></i><div><h3>Advisers and assessors</h3><p>Apply a consistent assessment workflow and produce evidence-led recommendations.</p></div></article>
                <article><i class="bi bi-pie-chart"></i><div><h3>Investors and funders</h3><p>Review the assumptions, downside exposure and funding requirements behind an opportunity.</p></div></article>
            </div>
        </div>
    </section>

    <section class="home-section plan-section" id="plans">
        <div class="home-container">
            <div class="section-heading">
                <span class="section-kicker">Flexible SaaS access</span>
                <h2>Choose the operating model that fits.</h2>
                <p>Start individually or create an organisation workspace with controlled access for a wider team.</p>
            </div>
            <div class="plan-grid">
                <article>
                    <span class="plan-label">Standard</span>
                    <h3>For an individual practitioner</h3>
                    <p>A focused personal tenant for building and reviewing assessments in one secure workspace.</p>
                    <ul>
                        <li><i class="bi bi-check2"></i> One user</li>
                        <li><i class="bi bi-check2"></i> Core assessment and projection tools</li>
                        <li><i class="bi bi-check2"></i> Sensitivity and reporting</li>
                    </ul>
                    <a href="/identity/register" class="home-button secondary">Choose Standard</a>
                </article>
                <article class="recommended">
                    <span class="plan-label">Open Plan</span>
                    <h3>For organisations and teams</h3>
                    <p>An organisation tenant with flexible seats, role assignment and authorised access to operational records.</p>
                    <ul>
                        <li><i class="bi bi-check2"></i> Multiple users and branches</li>
                        <li><i class="bi bi-check2"></i> Tenant roles and record access</li>
                        <li><i class="bi bi-check2"></i> Shared assessment workflows</li>
                    </ul>
                    <a href="/website/index#contact" class="home-button primary">Discuss Open Plan</a>
                </article>
            </div>
        </div>
    </section>

    <section class="home-section contact-section" id="contact">
        <div class="home-container contact-grid">
            <div class="contact-copy">
                <span class="section-kicker">Contact ViabilityIQ</span>
                <h2>Let’s talk about the decision you need to make.</h2>
                <p>Request a demonstration, ask for support, share feedback or discuss an organisation rollout.</p>

                <div class="contact-methods">
                    <article>
                        <i class="bi bi-geo-alt"></i>
                        <div><strong>Physical address</strong><address>35 Mercedes Street<br />5 Mamayila House<br />Dawn Park 1539<br />South Africa</address></div>
                    </article>
                    <article>
                        <i class="bi bi-whatsapp"></i>
                        <div>
                            <strong>WhatsApp</strong>
                            <a href="https://wa.me/27790757294?text=Hello%20ViabilityIQ%2C%20I%20would%20like%20to%20know%20more%20about%20the%20platform."
                               target="_blank" rel="noopener noreferrer">
                                +27 79 075 7294
                            </a>
                        </div>
                    </article>
                    <article>
                        <i class="bi bi-clock"></i>
                        <div><strong>Response target</strong><span>We aim to respond within one business day.</span></div>
                    </article>
                </div>
            </div>
            <ContactFormComponent />
        </div>
    </section>
</div>
