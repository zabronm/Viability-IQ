@using ViabilityIQ.Application.Interfaces
@using ViabilityIQ.Shared.DataModels
@inject IContactService ContactService
@inject ILogger<ContactFormComponent> Logger

<div class="contact-form-card">
    @if (_submitted)
    {
        <div class="contact-success" role="status">
            <i class="bi bi-check-circle-fill"></i>
            <div>
                <h3>Message received</h3>
                <p>@_resultMessage</p>
                <small>Reference: @_reference</small>
                <button type="button" class="contact-reset" @onclick="ResetForm">Send another message</button>
            </div>
        </div>
    }
    else
    {
        <div class="contact-form-heading">
            <span>Send us a message</span>
            <h3>How can we help?</h3>
        </div>

        <EditForm Model="_model" OnValidSubmit="HandleValidSubmitAsync">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="contact-error" role="alert">@_errorMessage</div>
            }

            <div class="contact-form-grid">
                <div class="form-field">
                    <label for="contact-name">Full name <em>*</em></label>
                    <InputText id="contact-name" @bind-Value="_model.Name" autocomplete="name" />
                    <ValidationMessage For="() => _model.Name" />
                </div>
                <div class="form-field">
                    <label for="contact-email">Email <em>*</em></label>
                    <InputText id="contact-email" type="email" @bind-Value="_model.Email" autocomplete="email" />
                    <ValidationMessage For="() => _model.Email" />
                </div>
                <div class="form-field">
                    <label for="contact-phone">Phone number</label>
                    <InputText id="contact-phone" type="tel" @bind-Value="_model.PhoneNumber" autocomplete="tel" />
                    <ValidationMessage For="() => _model.PhoneNumber" />
                </div>
                <div class="form-field">
                    <label for="contact-company">Company</label>
                    <InputText id="contact-company" @bind-Value="_model.Company" autocomplete="organization" />
                    <ValidationMessage For="() => _model.Company" />
                </div>
                <div class="form-field full">
                    <label for="contact-subject">Subject <em>*</em></label>
                    <InputSelect id="contact-subject" @bind-Value="_model.Subject">
                        <option value="">Select a subject</option>
                        <option value="Demo Request">Demo Request</option>
                        <option value="Sales Enquiry">Sales Enquiry</option>
                        <option value="Support">Support</option>
                        <option value="Feedback">Feedback</option>
                        <option value="Partnership">Partnership</option>
                        <option value="Other">Other</option>
                    </InputSelect>
                    <ValidationMessage For="() => _model.Subject" />
                </div>
                <div class="form-field full">
                    <label for="contact-message">Message <em>*</em></label>
                    <InputTextArea id="contact-message" @bind-Value="_model.Message" rows="5"
                                   placeholder="Tell us what you would like to discuss." />
                    <ValidationMessage For="() => _model.Message" />
                </div>
            </div>

            <div class="form-honeypot" aria-hidden="true">
                <label for="contact-website">Website</label>
                <InputText id="contact-website" @bind-Value="_model.Website" tabindex="-1" autocomplete="off" />
            </div>

            <label class="consent-field">
                <InputCheckbox @bind-Value="_model.Consent" />
                <span>I agree that ViabilityIQ may use these details to respond to my enquiry. <em>*</em></span>
            </label>
            <ValidationMessage For="() => _model.Consent" />

            <button type="submit" class="contact-submit" disabled="@_submitting">
                @if (_submitting)
                {
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    <span>Sending...</span>
                }
                else
                {
                    <span>Send message</span>
                    <i class="bi bi-send"></i>
                }
            </button>
        </EditForm>
    }
</div>

@code {
    private ContactRequest _model = new();
    private bool _submitting;
    private bool _submitted;
    private string? _errorMessage;
    private string _resultMessage = string.Empty;
    private string _reference = string.Empty;
    private DateTimeOffset? _lastSubmissionAt;

    private async Task HandleValidSubmitAsync()
    {
        if (_lastSubmissionAt.HasValue
            && DateTimeOffset.UtcNow - _lastSubmissionAt.Value < TimeSpan.FromSeconds(15))
        {
            _errorMessage = "Please wait a few seconds before submitting another message.";
            return;
        }

        _submitting = true;
        _errorMessage = null;
        try
        {
            var result = await ContactService.SubmitAsync(_model);
            if (!result.Accepted)
            {
                _errorMessage = result.UserMessage;
                return;
            }

            _lastSubmissionAt = DateTimeOffset.UtcNow;
            _resultMessage = result.UserMessage;
            _reference = result.Reference;
            _submitted = true;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Website contact submission failed.");
            _errorMessage = "We could not submit your message. Please try again or contact us on WhatsApp.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private void ResetForm()
    {
        _model = new();
        _submitted = false;
        _resultMessage = string.Empty;
        _reference = string.Empty;
        _errorMessage = null;
    }
}
