@rendermode InteractiveServer

<header class="viq-site-header">
    <div class="viq-nav-container">
        <a href="/website/index" class="viq-brand" aria-label="ViabilityIQ home">
            <img src="/images/ViabilityIQ_logo_0.png" alt="ViabilityIQ" />
        </a>

        <nav class="viq-main-nav" aria-label="Primary navigation">
            <a href="/website/index#capabilities" class="viq-nav-link">Capabilities</a>
            <a href="/website/index#how-it-works" class="viq-nav-link">How it works</a>
            <a href="/website/index#who-its-for" class="viq-nav-link">Who it’s for</a>
            <a href="/website/index#plans" class="viq-nav-link">Plans</a>
            <a href="/website/index#contact" class="viq-nav-link">Contact</a>
        </nav>

        <div class="viq-nav-actions">
            <a href="/identity/login" class="viq-login-link">Sign in</a>
            <a href="/website/index#contact" class="viq-primary-button">Request a demo</a>
        </div>

        <button class="viq-mobile-menu-button"
                type="button"
                @onclick="ToggleMobileMenu"
                aria-label="Toggle navigation"
                aria-expanded="@mobileMenuOpen">
            <i class="bi @(mobileMenuOpen ? "bi-x-lg" : "bi-list")"></i>
        </button>
    </div>

    @if (mobileMenuOpen)
    {
        <nav class="viq-mobile-menu" aria-label="Mobile navigation">
            <a href="/website/index#capabilities" @onclick="CloseMobileMenu">Capabilities</a>
            <a href="/website/index#how-it-works" @onclick="CloseMobileMenu">How it works</a>
            <a href="/website/index#who-its-for" @onclick="CloseMobileMenu">Who it’s for</a>
            <a href="/website/index#plans" @onclick="CloseMobileMenu">Plans</a>
            <a href="/website/index#contact" @onclick="CloseMobileMenu">Contact</a>
            <a href="/identity/login" @onclick="CloseMobileMenu">Sign in</a>
            <a href="/website/index#contact" class="viq-primary-button" @onclick="CloseMobileMenu">Request a demo</a>
        </nav>
    }
</header>

@code {
    private bool mobileMenuOpen;
    private void ToggleMobileMenu() => mobileMenuOpen = !mobileMenuOpen;
    private void CloseMobileMenu() => mobileMenuOpen = false;
}
