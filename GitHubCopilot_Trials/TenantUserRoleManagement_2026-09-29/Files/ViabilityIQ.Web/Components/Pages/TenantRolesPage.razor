@page "/settings/roles"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using ViabilityIQ.Application.Dtos
@using ViabilityIQ.Shared.DataModels.SecurityDataModels
@using ViabilityIQ.Web.Components.CommonComponents

<PageTitle>Tenant Roles</PageTitle>

<div class="p-0">
    <PageHeading _pageTitle="Security Settings" CurrentPage="PageType.Settings" _pageHeading="User Groups / Roles" />

    <main class="tenant-roles-page">
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }
        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success">@successMessage</div>
        }

        @if (isLoading)
        {
            <div class="d-grid place-items-center p-5">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else if (snapshot is not null)
        {
            <section class="roles-heading-card">
                <div>
                    <span class="roles-eyebrow">PROTECTED ACCESS PROFILES</span>
                    <h2>@snapshot.TenantName</h2>
                    <p>Roles define tenant-level authority. Multiple roles can be assigned to one member.</p>
                </div>
                <a class="btn btn-outline-primary" href="/settings/users">
                    <i class="bi bi-people-fill me-2"></i>Manage users
                </a>
            </section>

            <section class="role-catalogue">
                @foreach (var role in snapshot.Roles)
                {
                    <article class="role-card">
                        <div class="role-card-icon"><i class="@RoleIcon(role.RoleCode)"></i></div>
                        <div>
                            <h3>@role.RoleName</h3>
                            <code>@role.RoleCode</code>
                            <p>@role.Description</p>
                        </div>
                        <span class="badge text-bg-light">@MemberCount(role.RoleCode) member(s)</span>
                    </article>
                }
            </section>

            <section class="roles-table-card">
                <div class="roles-table-heading">
                    <div>
                        <span class="roles-eyebrow">ROLE ALLOCATION</span>
                        <h3>Tenant members</h3>
                    </div>
                    <span class="text-muted">Tenant Owner is protected.</span>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Branch</th>
                                <th>Assigned roles</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var member in snapshot.Members)
                            {
                                <tr>
                                    <td>
                                        <strong>@member.FullName</strong>
                                        <div class="text-muted small">@member.Email</div>
                                    </td>
                                    <td>@member.BranchName</td>
                                    <td>
                                        @foreach (var roleName in member.RoleNames)
                                        {
                                            <span class="role-pill">@roleName</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary"
                                                disabled="@member.IsOwner"
                                                @onclick="() => OpenRoles(member)">
                                            Assign roles
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    </main>
</div>

@if (showEditor && snapshot is not null && editingMember is not null)
{
    <div class="role-modal-backdrop" @onclick="CloseEditor"></div>
    <div class="role-modal" role="dialog" aria-modal="true">
        <div class="d-flex align-items-start justify-content-between border-bottom pb-3 mb-3">
            <div>
                <span class="roles-eyebrow">ASSIGN TENANT ROLES</span>
                <h3 class="mb-1">@editingMember.FullName</h3>
                <span class="text-muted">@editingMember.Email</span>
            </div>
            <button class="btn-close" @onclick="CloseEditor"></button>
        </div>

        <div class="role-choice-list">
            @foreach (var role in snapshot.Roles.Where(item => item.RoleCode != TenantRoleCodes.Owner))
            {
                <label class="role-choice">
                    <input type="checkbox"
                           checked="@editRequest.RoleCodes.Contains(role.RoleCode)"
                           @onchange="eventArgs => ToggleRole(role.RoleCode, (bool?)eventArgs.Value == true)" />
                    <span>
                        <strong>@role.RoleName</strong>
                        <small>@role.Description</small>
                    </span>
                </label>
            }
        </div>

        <div class="d-flex justify-content-end gap-2 border-top pt-3 mt-3">
            <button class="btn btn-outline-secondary" @onclick="CloseEditor" disabled="@isSaving">Cancel</button>
            <button class="btn btn-primary" @onclick="SaveRolesAsync" disabled="@isSaving">
                @(isSaving ? "Saving..." : "Save roles")
            </button>
        </div>
    </div>
}

@code {
    [Inject] private ViabilityIQ.Application.Interfaces.ITenantUserManagementService UserManagementService { get; set; } = default!;

    private TenantUserManagementSnapshot? snapshot;
    private TenantMemberRow? editingMember;
    private UpdateTenantMemberRequest editRequest = new();
    private bool isLoading = true;
    private bool isSaving;
    private bool showEditor;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            snapshot = await UserManagementService.GetSnapshotAsync();
        }
        catch (Exception exception)
        {
            errorMessage = exception is UnauthorizedAccessException
                ? exception.Message
                : $"Tenant roles could not be loaded: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenRoles(TenantMemberRow member)
    {
        editingMember = member;
        editRequest = new UpdateTenantMemberRequest
        {
            MembershipId = member.MembershipId,
            BranchId = member.BranchId,
            MembershipStatus = member.MembershipStatus,
            RoleCodes = member.RoleCodes.ToHashSet(StringComparer.OrdinalIgnoreCase)
        };
        showEditor = true;
    }

    private void CloseEditor()
    {
        if (!isSaving)
            showEditor = false;
    }

    private void ToggleRole(string roleCode, bool selected)
    {
        if (selected)
            editRequest.RoleCodes.Add(roleCode);
        else
            editRequest.RoleCodes.Remove(roleCode);
    }

    private async Task SaveRolesAsync()
    {
        isSaving = true;
        errorMessage = null;
        successMessage = null;
        try
        {
            var result = await UserManagementService.UpdateMemberAsync(editRequest);
            if (!result.Succeeded)
            {
                errorMessage = result.Message;
                return;
            }

            showEditor = false;
            await LoadAsync();
            successMessage = result.Message;
        }
        catch (Exception exception)
        {
            errorMessage = $"Role allocation could not be saved: {exception.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private int MemberCount(string roleCode) =>
        snapshot?.Members.Count(member => member.RoleCodes.Contains(roleCode)) ?? 0;

    private static string RoleIcon(string roleCode) => roleCode switch
    {
        TenantRoleCodes.Owner => "bi bi-shield-fill-check",
        TenantRoleCodes.Administrator => "bi bi-person-fill-gear",
        TenantRoleCodes.BranchManager => "bi bi-diagram-3-fill",
        TenantRoleCodes.BillingManager => "bi bi-credit-card-fill",
        _ => "bi bi-eye-fill"
    };
}

