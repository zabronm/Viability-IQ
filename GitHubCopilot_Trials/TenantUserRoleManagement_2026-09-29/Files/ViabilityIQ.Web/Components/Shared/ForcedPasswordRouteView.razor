@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using ViabilityIQ.Application.Interfaces.IdentityInterfaces

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IUserRepository UserRepository
@inject NavigationManager Navigation

@if (isChecking)
{
    <div class="d-flex justify-content-center p-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Checking account security...</span>
        </div>
    </div>
}
else
{
    <AuthorizeRouteView RouteData="@RouteData" DefaultLayout="@DefaultLayout">
        <NotAuthorized>
            <div class="alert alert-warning m-4">
                <h4>Access Denied</h4>
                <p>You must be logged in to access this page.</p>
                <a href="/login" class="btn btn-primary">Go to Login</a>
            </div>
        </NotAuthorized>
    </AuthorizeRouteView>
}

@code {
    [Parameter, EditorRequired] public RouteData RouteData { get; set; } = default!;
    [Parameter] public Type? DefaultLayout { get; set; }

    private bool isChecking = true;

    protected override async Task OnParametersSetAsync()
    {
        isChecking = true;
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var principal = authenticationState.User;
        if (principal.Identity?.IsAuthenticated == true && !IsPasswordRoute(RouteData.PageType))
        {
            var userIdValue = principal.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (long.TryParse(userIdValue, out var userId) && userId > 0)
            {
                var user = await UserRepository.GetUserByIdAsync(userId);
                if (user.MustChangePassword)
                {
                    Navigation.NavigateTo("/identity/change-password", replace: true);
                    return;
                }
            }
        }

        isChecking = false;
    }

    private static bool IsPasswordRoute(Type pageType) =>
        pageType.Name is "ChangePassword" or "Logout";
}

