@using ViabilityIQ.Shared.DataModels
@using ViabilityIQ.Shared.SharedModels

<div class="viq-form-shell">
    @if (IsLoading)
    {
        <div class="viq-form-busy" role="status" aria-live="polite">
            <div class="viq-form-busy-card">
                <span class="viq-form-spinner" aria-hidden="true"></span>
                <div>
                    <strong>Loading sales category</strong>
                    <span>Synchronizing sales category configuration matrix...</span>
                </div>
            </div>
        </div>
    }
    else if (Model != null)
    {
        <EditForm Model="@Model" OnValidSubmit="ExecuteSaveWorkflow"
                  class="viq-data-form" aria-label="Sales category">
            <DataAnnotationsValidator />

            <div class="viq-form-intro">
                <span class="viq-form-intro-icon"><i class="bi bi-tags" aria-hidden="true"></i></span>
                <div>
                    <h2>Sales category</h2>
                    <p>Configure revenue classification, markup and opening balances.</p>
                </div>
            </div>

            <ValidationSummary class="viq-form-validation-summary" />

            <section class="viq-form-section">
                <header class="viq-form-section-heading">
                    <span><i class="bi bi-card-heading" aria-hidden="true"></i></span>
                    <div>
                        <h3>Category details</h3>
                        <p>Name and classify this source of income.</p>
                    </div>
                </header>

                <div class="viq-form-grid viq-form-grid-2">
                    <div class="viq-form-field viq-form-span-2">
                        <label for="salesCategoryName">Sales category name <span class="viq-required">*</span></label>
                        <input id="salesCategoryName" type="text" class="viq-form-control"
                               placeholder="e.g. Retail Goods, Services"
                               @bind-value="Model.AssessmentSalesCategoryName" />
                        <ValidationMessage For="() => Model.AssessmentSalesCategoryName" class="viq-form-validation" />
                    </div>

                    <div class="viq-form-field viq-form-span-2">
                        <label>Income/revenue type <span class="viq-required">*</span></label>
                        <DDLookupComponent SourceKey="DDLookupEnums.IncomeTypes"
                                           @bind-Value="Model.IncomeTypeId" Readonly="true" />
                        <ValidationMessage For="() => Model.IncomeTypeId" class="viq-form-validation" />
                    </div>

                    <div class="viq-form-field viq-form-span-2">
                        <label for="markupPercentage">Markup percentage (%) <span class="viq-required">*</span></label>
                        <input id="markupPercentage" type="number" step="0.01" class="viq-form-control"
                               placeholder="0.00" @bind-value="Model.MarkupPercentage" />
                        <ValidationMessage For="() => Model.MarkupPercentage" class="viq-form-validation" />
                    </div>
                </div>
            </section>

            <section class="viq-form-section">
                <header class="viq-form-section-heading">
                    <span><i class="bi bi-wallet2" aria-hidden="true"></i></span>
                    <div>
                        <h3>Opening balances</h3>
                        <p>Starting stock, receivables and payables for this category.</p>
                    </div>
                </header>

                <div class="viq-form-grid viq-form-grid-2">
                    <div class="viq-form-field viq-form-span-2">
                        <label for="openingStock">Opening stock (R)</label>
                        <input id="openingStock" type="number" step="0.01" class="viq-form-control"
                               placeholder="0.00" @bind-value="Model.OpeningStock" />
                    </div>

                    <div class="viq-form-field">
                        <label for="openingDebtors">Opening acc. receivable/debtors (R)</label>
                        <input id="openingDebtors" type="number" step="0.01" class="viq-form-control"
                               placeholder="0.00" @bind-value="Model.OpeningDebtorsAmount" />
                    </div>

                    <div class="viq-form-field">
                        <label for="openingCreditors">Opening acc. payable/creditors (R)</label>
                        <input id="openingCreditors" type="number" step="0.01" class="viq-form-control"
                               placeholder="0.00" @bind-value="Model.OpeningCreditorsAmount" />
                    </div>
                </div>
            </section>

            <section class="viq-form-section">
                <header class="viq-form-section-heading">
                    <span><i class="bi bi-card-text" aria-hidden="true"></i></span>
                    <div>
                        <h3>Administration</h3>
                        <p>Audit context and list availability.</p>
                    </div>
                </header>

                <div class="viq-form-field">
                    <label for="salesCategoryRemarks">Audit trail remarks</label>
                    <textarea id="salesCategoryRemarks" class="viq-form-control viq-form-textarea" rows="3"
                              placeholder="Enter configuration remarks or optional justifications..."
                              @bind="Model.Remarks"></textarea>
                </div>

                <label class="viq-toggle-card viq-toggle-card-wide" for="salesCategoryActiveSwitch">
                    <span>
                        <strong>Include in lists</strong>
                        <small>Make this sales category available for selection.</small>
                    </span>
                    <input id="salesCategoryActiveSwitch" class="viq-switch" type="checkbox" @bind="Model.Active" />
                </label>
            </section>

            <footer class="viq-form-actions">
                @if (IsSubmitting)
                {
                    <button type="button" class="viq-button viq-button-secondary" disabled>
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Storing Buffers...</span>
                    </button>
                }
                else
                {
                    <button type="submit" class="viq-button viq-button-primary">
                        <i class="bi bi-save" aria-hidden="true"></i>
                        <span>Save Changes</span>
                    </button>
                }
            </footer>
        </EditForm>
    }
</div>
