@namespace ViabilityIQ.Web.Components.Pages_Assessments.PageFormComponents
@using ViabilityIQ.Shared.DataModels
@using ViabilityIQ.Web.Components.CommonComponents

<div class="viq-form-shell">
    @if (FormModel != null)
    {
        <EditForm Model="@FormModel" OnValidSubmit="ExecuteSaveWorkflowAsync"
                  class="viq-data-form" aria-label="Assessment expense projection">
            <DataAnnotationsValidator />

            <div class="viq-form-intro">
                <span class="viq-form-intro-icon"><i class="bi bi-receipt" aria-hidden="true"></i></span>
                <div>
                    <h2>Expense projection</h2>
                    <p>Configure expense classification, cashbook treatment and monthly allocations.</p>
                </div>
            </div>

            <section class="viq-form-section">
                <header class="viq-form-section-heading">
                    <span><i class="bi bi-tags" aria-hidden="true"></i></span>
                    <div>
                        <h3>Expense details</h3>
                        <p>Classify the expense and choose how it is calculated.</p>
                    </div>
                </header>
                <div class="viq-form-grid viq-form-grid-2">
                    <div class="viq-form-field">
                        <label>Expense type</label>
                        <DDLookupComponent SourceKey="DDLookupEnums.ExpenseTypes"
                                           @bind-Value="FormModel.ExpenseTypeId" />
                    </div>
                    <div class="viq-form-field">
                        <label>Expense item</label>
                        <DDLookupComponent SourceKey="DDLookupEnums.ExpenseItems"
                                           @bind-Value="FormModel.ExpenseItemId" />
                    </div>
                    <label class="viq-toggle-card" for="cashbookSwitch">
                        <span>
                            <strong>Post to cashbook?</strong>
                            <small>Include this expense in cashbook projections.</small>
                        </span>
                        <InputCheckbox id="cashbookSwitch" class="viq-switch"
                                       @bind-Value="FormModel.blSendToCashBook" />
                    </label>
                    <label class="viq-toggle-card" for="salesCheck">
                        <span>
                            <strong>Use % of sales?</strong>
                            <small>Calculate the expense from projected sales.</small>
                        </span>
                        <InputCheckbox id="salesCheck" class="viq-switch"
                                       @bind-Value="FormModel.blPercentageOfSalesUsed"
                                       @onclick="ToggleSalesPercentage" />
                    </label>
                    @if (FormModel.blPercentageOfSalesUsed)
                    {
                        <div class="viq-form-field viq-form-span-2">
                            <label for="salesPercentage">Percentage of sales</label>
                            <InputNumber id="salesPercentage" class="viq-form-control"
                                         placeholder="%" @bind-Value="FormModel.PercentageOfSalesRate" />
                        </div>
                    }
                </div>
            </section>

            <section class="viq-form-section">
                <header class="viq-form-section-heading">
                    <span><i class="bi bi-distribute-horizontal" aria-hidden="true"></i></span>
                    <div>
                        <h3>Apply allocation</h3>
                        <p>Apply the same amount to every month.</p>
                    </div>
                </header>
                <div class="viq-form-grid viq-form-grid-2">
                    <div class="viq-form-field">
                        <label for="monthlyAllocation">Monthly amount</label>
                        <input id="monthlyAllocation" type="number" class="viq-form-control"
                               @bind="FormModel.SameMonthlyAmount" />
                    </div>
                    <div class="viq-form-field">
                        <label>Allocation action</label>
                        <button class="viq-button viq-button-secondary" type="button"
                                @onclick="ApplyMonthlyAllocation">
                            <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                            <span>Apply allocation</span>
                        </button>
                    </div>
                </div>
            </section>

            <section class="viq-form-section">
                <header class="viq-form-section-heading">
                    <span><i class="bi bi-calendar3" aria-hidden="true"></i></span>
                    <div>
                        <h3>12-month projection</h3>
                        <p>Enter the expense allocation for each month.</p>
                    </div>
                </header>
                <div class="viq-form-grid viq-form-grid-2">
                    @for (int i = 0; i < 12; i++)
                    {
                        int index = i;
                        <div class="viq-form-field">
                            <label for="@($"expenseProjectionMonth{index + 1}")">Month @(index + 1)</label>
                            <InputNumber id="@($"expenseProjectionMonth{index + 1}")"
                                         class="viq-form-control"
                                         @bind-Value="MonthlyValues[index]" />
                        </div>
                    }
                </div>
            </section>

            <section class="viq-form-section">
                <header class="viq-form-section-heading">
                    <span><i class="bi bi-calculator" aria-hidden="true"></i></span>
                    <div>
                        <h3>Total allocation</h3>
                        <p>@MonthlyValues.Sum().ToString("N2")</p>
                    </div>
                </header>
            </section>

            <footer class="viq-form-actions">
                <button type="submit" class="viq-button viq-button-primary">Save changes</button>
                @* <button type="button" class="viq-button viq-button-secondary" @onclick="CancelFormAsync">Cancel</button> *@
            </footer>
        </EditForm>
    }
</div>
