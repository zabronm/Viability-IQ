@using ViabilityIQ.Infrastructure.Repositories

<div class="viq-form-shell">
    @if (loadingStateActive)
    {
        <div class="viq-form-busy" role="status" aria-live="polite">
            <div class="viq-form-busy-card">
                <span class="viq-form-spinner" aria-hidden="true"></span>
                <div>
                    <strong>Loading opening balances</strong>
                    <span>Please wait while the assessment settings are prepared.</span>
                </div>
            </div>
        </div>
    }
    else
    {
        <EditForm Model="@openingBalancesModel" OnValidSubmit="UpdateOpeningBalances"
                  class="viq-data-form" aria-label="Opening balances">
            <DataAnnotationsValidator />

            <div class="viq-form-intro">
                <span class="viq-form-intro-icon"><i class="bi bi-bank2" aria-hidden="true"></i></span>
                <div>
                    <h2>Opening balances</h2>
                    <p>Capture the balances carried into Month 1 of the assessment projection.</p>
                </div>
            </div>

            <ValidationSummary class="viq-form-validation-summary" />

            <section class="viq-form-section">
                <header class="viq-form-section-heading">
                    <span><i class="bi bi-wallet2" aria-hidden="true"></i></span>
                    <div>
                        <h3>Opening position</h3>
                        <p>Assets and cash available at the start of the projection.</p>
                    </div>
                </header>

                <div class="viq-form-grid viq-form-grid-2">
                    <div class="viq-form-field">
                        <label for="openingAssets">Opening stock / current assets (R)</label>
                        <input id="openingAssets" class="viq-form-control" type="number" step="0.01"
                               value="@FormatDecimal(openingBalancesModel.OpeningBalance_Assets)"
                               @onchange="e => openingBalancesModel.OpeningBalance_Assets = ParseDecimal(e.Value)" />
                        <span>Starting stock or other opening current-asset value.</span>
                    </div>

                    <div class="viq-form-field">
                        <label for="openingBank">Opening bank balance (R)</label>
                        <input id="openingBank" class="viq-form-control" type="number" step="0.01"
                               value="@FormatDecimal(openingBalancesModel.OpeningBalance_Bank)"
                               @onchange="e => openingBalancesModel.OpeningBalance_Bank = ParseDecimal(e.Value)" />
                        <span>Cash available at the beginning of Month 1.</span>
                    </div>
                </div>
            </section>

            <section class="viq-form-section">
                <header class="viq-form-section-heading">
                    <span><i class="bi bi-graph-down-arrow" aria-hidden="true"></i></span>
                    <div>
                        <h3>Projection adjustments</h3>
                        <p>Rates and allowances applied to the opening position.</p>
                    </div>
                </header>

                <div class="viq-form-grid viq-form-grid-2">
                    <div class="viq-form-field">
                        <label for="overdraftInterest">Overdraft interest (%)</label>
                        <input id="overdraftInterest" class="viq-form-control" type="number" step="0.01" min="0"
                               value="@FormatDecimal(openingBalancesModel.InterestOnOverDraft)"
                               @onchange="e => openingBalancesModel.InterestOnOverDraft = ParseDecimal(e.Value)" />
                        <span>Annual rate applied when the bank balance is overdrawn.</span>
                    </div>

                    <div class="viq-form-field">
                        <label for="projectedDepreciation">Projected depreciation (R)</label>
                        <input id="projectedDepreciation" class="viq-form-control" type="number" step="0.01"
                               value="@FormatDecimal(openingBalancesModel.DepreciationProjectedAmount)"
                               @onchange="e => openingBalancesModel.DepreciationProjectedAmount = ParseDecimal(e.Value)" />
                        <span>Opening depreciation allowance used by the assessment.</span>
                    </div>
                </div>
            </section>

            <footer class="viq-form-actions">
                <span><i class="bi bi-info-circle" aria-hidden="true"></i> These values establish the projection's starting financial position.</span>
                <button class="viq-button viq-button-primary" type="submit" disabled="@IsSubmitting">
                    @if (IsSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Updating…</span>
                    }
                    else
                    {
                        <i class="bi bi-check2-circle" aria-hidden="true"></i>
                        <span>Update opening balances</span>
                    }
                </button>
            </footer>
        </EditForm>
    }
</div>

@code {
    [Inject] private MasterDataService? ViqCrudService { get; set; }
    [Parameter] public OpeningBalancesModel openingBalancesModel { get; set; } = new();
    [Parameter] public EventCallback<SaveResult> OnUpdate { get; set; }
    private SaveResult? result = new();
    private bool IsSubmitting;
    private bool loadingStateActive;
    private static string FormatDecimal(decimal value) => value.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
    private static decimal ParseDecimal(object? value) => decimal.TryParse(Convert.ToString(value), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var parsed) ? parsed : 0m;

    protected override async Task OnParametersSetAsync() => await RefreshAsync();

    public async Task RefreshAsync()
    {
        loadingStateActive = true;
        await Task.Delay(150);
        loadingStateActive = false;
        StateHasChanged();
    }

    private async Task UpdateOpeningBalances()
    {
        IsSubmitting = true;
        const string sql = @"UPDATE tblAssessments SET OpeningBalance_Assets=@OpeningBalance_Assets,
            OpeningBalance_Bank=@OpeningBalance_Bank, InterestOnOverDraft=@InterestOnOverDraft,
            DepreciationProjectedAmount=@DepreciationProjectedAmount WHERE AssessmentId=@AssessmentId";
        try
        {
            var rows = await ViqCrudService!.ExecuteCommandAsync(sql, new
            {
                openingBalancesModel.OpeningBalance_Assets,
                openingBalancesModel.OpeningBalance_Bank,
                openingBalancesModel.InterestOnOverDraft,
                openingBalancesModel.DepreciationProjectedAmount,
                openingBalancesModel.AssessmentId
            });
            result = rows > 0
                ? new SaveResult { Message = "Opening balances updated successfully", Success = true }
                : SaveResult.Failed("Opening balances were not updated. Please retry.");
        }
        catch (Exception ex)
        {
            result = SaveResult.Failed($"Opening balances could not be updated: {ex.Message}");
        }
        finally
        {
            IsSubmitting = false;
            if (OnUpdate.HasDelegate) await OnUpdate.InvokeAsync(result!);
        }
    }
}
