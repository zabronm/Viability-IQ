@page "/assessment/budgets/{AssessmentId:long}"
@layout MainLayout_Assessment
@using System.Globalization
@using ViabilityIQ.Application.Interfaces
@using ViabilityIQ.Shared.DataModels.SecurityDataModels
@using ViabilityIQ.Shared.Reporting
@using ViabilityIQ.Shared.SharedModels
@using ViabilityIQ.Web.Services
@inject IAssessmentBudgetService BudgetService
@inject ITenantAuthorizationService AuthorizationService
@inject ISessionService SessionService
@inject ToastService Toast
@inject ILogger<AssessmentBudgetingPage> Logger

<div class="budget-workspace container-fluid p-0">
    <PageHeading_Assessment _pageTitle="Budgets"
                            PageTitle="Assessment Budget"
                            CurrentPage="PageType.Budgets" />

    @if (isLoading)
    {
        <section class="budget-state-card">
            <span class="spinner-border spinner-border-sm text-primary"></span>
            <span>Loading assessment budget...</span>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(pageError))
    {
        <section class="budget-state-card budget-state-error">
            <i class="bi bi-exclamation-octagon"></i>
            <div>
                <strong>Budget unavailable</strong>
                <span>@pageError</span>
            </div>
            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="LoadAsync">
                Retry
            </button>
        </section>
    }
    else if (workspace is null)
    {
        <section class="budget-empty">
            <div class="budget-empty-icon"><i class="bi bi-calculator"></i></div>
            <div>
                <span class="budget-eyebrow">Assessment budgeting</span>
                <h1>Create a working budget from this assessment</h1>
                <p>
                    ViabilityIQ will copy the current 12-month financial projection into
                    an editable budget. Future projection refreshes update the comparison
                    values without overwriting your budget.
                </p>
            </div>

            @if (canCreate)
            {
                <div class="budget-create-form">
                    <label>
                        Budget name
                        <input class="form-control"
                               maxlength="150"
                               @bind="newBudgetName" />
                    </label>
                    <label>
                        Planning notes <span>(optional)</span>
                        <textarea class="form-control"
                                  rows="3"
                                  maxlength="1000"
                                  @bind="newBudgetRemarks"></textarea>
                    </label>
                    <button type="button"
                            class="btn btn-success"
                            disabled="@isBusy"
                            @onclick="CreateAsync">
                        @if (isBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <i class="bi bi-stars me-1"></i>Create from assessment projection
                    </button>
                </div>
            }
            else
            {
                <div class="budget-readonly-message">
                    <i class="bi bi-shield-lock me-2"></i>
                    You have read access to this assessment, but your tenant role cannot create its budget.
                </div>
            }
        </section>
    }
    else
    {
        <section class="budget-hero">
            <div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="budget-eyebrow">Assessment-linked budget</span>
                    <span class="@StatusBadgeClass">@workspace.Status</span>
                    @if (isDirty)
                    {
                        <span class="badge rounded-pill text-bg-warning">Unsaved changes</span>
                    }
                </div>
                <h1>@workspace.BudgetName</h1>
                <p>
                    Projection snapshot imported
                    @workspace.ProjectionImportedAtUtc.ToLocalTime().ToString("dd MMM yyyy, HH:mm").
                    Budget values remain independent until you explicitly edit or refresh them.
                </p>
            </div>
            <div class="budget-actions">
                @if (workspace.Status == AssessmentBudgetStatuses.Draft && workspace.CanEdit)
                {
                    <button type="button"
                            class="btn btn-outline-primary btn-sm"
                            disabled="@isBusy"
                            title="Refresh comparison values without overwriting budget entries"
                            @onclick="RefreshProjectionAsync">
                        <i class="bi bi-arrow-repeat me-1"></i>Refresh projection
                    </button>
                    <button type="button"
                            class="btn btn-success btn-sm"
                            disabled="@(!isDirty || isBusy)"
                            @onclick="SaveAsync">
                        <i class="bi bi-check2-circle me-1"></i>Save draft
                    </button>
                    <button type="button"
                            class="btn btn-primary btn-sm"
                            disabled="@isBusy"
                            @onclick="SubmitAsync">
                        <i class="bi bi-send me-1"></i>Submit
                    </button>
                }
                else if (workspace.Status == AssessmentBudgetStatuses.Submitted && workspace.CanApprove)
                {
                    <button type="button"
                            class="btn btn-success btn-sm"
                            disabled="@isBusy"
                            @onclick="ApproveAsync">
                        <i class="bi bi-patch-check me-1"></i>Approve budget
                    </button>
                }
                else if (workspace.Status == AssessmentBudgetStatuses.Approved && workspace.CanApprove)
                {
                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            disabled="@isBusy"
                            @onclick="ReopenAsync">
                        <i class="bi bi-unlock me-1"></i>Reopen as draft
                    </button>
                }
            </div>
        </section>

        <section class="budget-kpis" aria-label="Budget key metrics">
            <article>
                <span>Budget revenue</span>
                <strong>@Money(BudgetTotal("REVENUE"))</strong>
                <small>@VarianceLabel("REVENUE")</small>
            </article>
            <article>
                <span>Profit before tax</span>
                <strong class="@ValueClass(workspace.BudgetProfitBeforeTax)">
                    @Money(workspace.BudgetProfitBeforeTax)
                </strong>
                <small>@SignedMoney(workspace.BudgetProfitBeforeTax - workspace.ProjectedProfitBeforeTax) vs projection</small>
            </article>
            <article>
                <span>Net cash movement</span>
                <strong class="@ValueClass(workspace.BudgetNetCashflow)">
                    @Money(workspace.BudgetNetCashflow)
                </strong>
                <small>@SignedMoney(workspace.BudgetNetCashflow - workspace.ProjectedNetCashflow) vs projection</small>
            </article>
            <article>
                <span>Closing cash</span>
                <strong class="@ValueClass(workspace.BudgetClosingBank)">
                    @Money(workspace.BudgetClosingBank)
                </strong>
                <small>Projected @Money(workspace.ProjectedClosingBank)</small>
            </article>
        </section>

        <section class="budget-alerts">
            <header>
                <div>
                    <span class="budget-eyebrow">Budget alerts</span>
                    <h2>Exceptions requiring attention</h2>
                </div>
                <span class="badge rounded-pill text-bg-light">@alerts.Count</span>
            </header>
            <div class="budget-alert-list">
                @foreach (var alert in alerts)
                {
                    <article class="@AlertClass(alert.Severity)">
                        <i class="@AlertIcon(alert.Severity)"></i>
                        <div><strong>@alert.Title</strong><span>@alert.Message</span></div>
                    </article>
                }
            </div>
        </section>

        <section class="budget-editor">
            <header class="budget-editor-toolbar">
                <div>
                    <span class="budget-eyebrow">Monthly planning matrix</span>
                    <h2>Budget and projection comparison</h2>
                </div>
                <div class="btn-group btn-group-sm" role="group" aria-label="Budget display mode">
                    <button type="button"
                            class="btn @(displayMode == BudgetDisplayMode.Budget ? "btn-primary" : "btn-outline-primary")"
                            @onclick="() => displayMode = BudgetDisplayMode.Budget">
                        Budget
                    </button>
                    <button type="button"
                            class="btn @(displayMode == BudgetDisplayMode.Projection ? "btn-primary" : "btn-outline-primary")"
                            @onclick="() => displayMode = BudgetDisplayMode.Projection">
                        Projection
                    </button>
                    <button type="button"
                            class="btn @(displayMode == BudgetDisplayMode.Variance ? "btn-primary" : "btn-outline-primary")"
                            @onclick="() => displayMode = BudgetDisplayMode.Variance">
                        Variance
                    </button>
                </div>
            </header>

            <div class="budget-name-row">
                <label>
                    Budget name
                    <input class="form-control form-control-sm"
                           maxlength="150"
                           disabled="@(!workspace.CanEdit)"
                           value="@workspace.BudgetName"
                           @onchange="UpdateBudgetName" />
                </label>
                <label>
                    Planning notes
                    <input class="form-control form-control-sm"
                           maxlength="1000"
                           disabled="@(!workspace.CanEdit)"
                           value="@workspace.Remarks"
                           @onchange="UpdateRemarks" />
                </label>
            </div>

            <div class="table-responsive budget-table-frame">
                <table class="table table-sm mb-0 budget-table">
                    <thead>
                        <tr>
                            <th class="budget-line-column">Budget line</th>
                            @for (var month = 1; month <= 12; month++)
                            {
                                <th>
                                    <span>M-@month</span>
                                    <small>@MonthLabel(month)</small>
                                </th>
                            }
                            <th class="budget-total-column">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var section in workspace.Lines.GroupBy(line => new { line.SectionCode, line.SectionName }))
                        {
                            <tr class="budget-section-row">
                                <td colspan="14">@section.Key.SectionName</td>
                            </tr>
                            @foreach (var line in section.OrderBy(item => item.DisplayOrder))
                            {
                                <tr class="@(line.IsCalculated ? "budget-calculated-row" : null)">
                                    <td class="budget-line-column">
                                        <strong>@line.LineName</strong>
                                        @if (line.IsCalculated)
                                        {
                                            <small>Calculated</small>
                                        }
                                    </td>
                                    @for (var month = 0; month < 12; month++)
                                    {
                                        <td class="@CellClass(line, month)">
                                            @if (displayMode == BudgetDisplayMode.Budget
                                                && workspace.CanEdit
                                                && !line.IsCalculated)
                                            {
                                                var monthIndex = month;
                                                <input type="number"
                                                       min="0"
                                                       step="0.01"
                                                       value="@line.BudgetMonths[monthIndex].ToString("F2", CultureInfo.InvariantCulture)"
                                                       @onchange="args => UpdateMonth(line, monthIndex, args.Value?.ToString())" />
                                            }
                                            else
                                            {
                                                @Money(CellValue(line, month))
                                            }
                                        </td>
                                    }
                                    <td class="@TotalClass(line)">
                                        @Money(DisplayTotal(line))
                                        @if (displayMode == BudgetDisplayMode.Budget && !line.IsCalculated)
                                        {
                                            <small>@SignedMoney(line.VarianceTotal) variance</small>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <footer>
                <span>
                    <i class="bi bi-info-circle me-1"></i>
                    Calculated rows update automatically. Projection refreshes never replace budget values.
                </span>
                <span>Last changed @workspace.ModifiedDate.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span>
            </footer>
        </section>
    }
</div>

<footer class="py-2 bg-light mt-3">
    <BFooter />
</footer>

@code {
    [Parameter] public long AssessmentId { get; set; }

    private AssessmentBudgetWorkspace? workspace;
    private IReadOnlyList<AssessmentBudgetAlert> alerts = [];
    private BudgetDisplayMode displayMode = BudgetDisplayMode.Budget;
    private bool isLoading;
    private bool isBusy;
    private bool isDirty;
    private bool canCreate;
    private long loadedAssessmentId;
    private string? pageError;
    private string newBudgetName = string.Empty;
    private string? newBudgetRemarks;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedAssessmentId == AssessmentId)
        {
            return;
        }

        loadedAssessmentId = AssessmentId;
        newBudgetName = $"Annual Budget - {SessionService.CaseNumber}";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        pageError = null;
        try
        {
            workspace = await BudgetService.GetAsync(AssessmentId);
            canCreate = await CanWriteAsync();
            RefreshDerivedState();
        }
        catch (UnauthorizedAccessException exception)
        {
            workspace = null;
            pageError = exception.Message;
            Toast.ShowError(exception.Message);
        }
        catch (Exception exception)
        {
            workspace = null;
            pageError = "The assessment budget could not be loaded.";
            Logger.LogError(exception, "Budget load failed for assessment {AssessmentId}.", AssessmentId);
            Toast.ShowError(pageError);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task<bool> CanWriteAsync()
    {
        try
        {
            await AuthorizationService.EnsureCanAccessAssessmentAsync(
                AssessmentId,
                TenantRecordAccess.Write);
            return true;
        }
        catch (UnauthorizedAccessException)
        {
            return false;
        }
    }

    private async Task CreateAsync()
    {
        await RunAsync(
            async () => workspace = await BudgetService.CreateFromProjectionAsync(new()
            {
                AssessmentId = AssessmentId,
                BudgetName = newBudgetName,
                Remarks = newBudgetRemarks
            }),
            "Budget created from the assessment projection.");
    }

    private async Task SaveAsync()
    {
        if (workspace is null)
        {
            return;
        }

        await RunAsync(
            async () => workspace = await BudgetService.SaveAsync(new()
            {
                AssessmentId = AssessmentId,
                BudgetId = workspace.BudgetId,
                BudgetName = workspace.BudgetName,
                Remarks = workspace.Remarks,
                RowVersion = workspace.RowVersion,
                Lines = workspace.Lines
                    .Where(line => !line.IsCalculated)
                    .Select(line => new SaveAssessmentBudgetLineRequest
                    {
                        BudgetLineId = line.BudgetLineId,
                        BudgetMonths = line.BudgetMonths.ToArray()
                    })
                    .ToList()
            }),
            "Budget draft saved.");
    }

    private async Task RefreshProjectionAsync()
    {
        if (workspace is null)
        {
            return;
        }

        await RunAsync(
            async () => workspace = await BudgetService.RefreshProjectionAsync(
                AssessmentId,
                workspace.BudgetId,
                workspace.RowVersion),
            "Projection comparison refreshed. Budget values were preserved.");
    }

    private async Task SubmitAsync()
    {
        if (workspace is null)
        {
            return;
        }

        if (isDirty)
        {
            Toast.ShowWarning("Save the draft before submitting it.");
            return;
        }

        await RunAsync(
            async () => workspace = await BudgetService.SubmitAsync(
                AssessmentId,
                workspace.BudgetId,
                workspace.RowVersion),
            "Budget submitted for approval.");
    }

    private async Task ApproveAsync()
    {
        if (workspace is null)
        {
            return;
        }

        await RunAsync(
            async () => workspace = await BudgetService.ApproveAsync(
                AssessmentId,
                workspace.BudgetId,
                workspace.RowVersion),
            "Budget approved and locked.");
    }

    private async Task ReopenAsync()
    {
        if (workspace is null)
        {
            return;
        }

        await RunAsync(
            async () => workspace = await BudgetService.ReopenAsync(
                AssessmentId,
                workspace.BudgetId,
                workspace.RowVersion),
            "Budget reopened as a draft.");
    }

    private async Task RunAsync(Func<Task> action, string successMessage)
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        try
        {
            await action();
            isDirty = false;
            RefreshDerivedState();
            Toast.ShowSuccess(successMessage);
        }
        catch (UnauthorizedAccessException exception)
        {
            Toast.ShowError(exception.Message);
        }
        catch (InvalidOperationException exception)
        {
            Toast.ShowWarning(exception.Message);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Budget operation failed for assessment {AssessmentId}.", AssessmentId);
            Toast.ShowError("The budget operation could not be completed. Please retry.");
        }
        finally
        {
            isBusy = false;
        }
    }

    private void UpdateBudgetName(ChangeEventArgs args)
    {
        if (workspace is null)
        {
            return;
        }

        workspace.BudgetName = args.Value?.ToString()?.Trim() ?? string.Empty;
        isDirty = true;
    }

    private void UpdateRemarks(ChangeEventArgs args)
    {
        if (workspace is null)
        {
            return;
        }

        workspace.Remarks = args.Value?.ToString()?.Trim();
        isDirty = true;
    }

    private void UpdateMonth(
        AssessmentBudgetLine line,
        int month,
        string? rawValue)
    {
        if (workspace is null || line.IsCalculated)
        {
            return;
        }

        if (!decimal.TryParse(
                rawValue,
                NumberStyles.Number,
                CultureInfo.InvariantCulture,
                out var value)
            && !decimal.TryParse(rawValue, out value))
        {
            Toast.ShowWarning("Enter a valid monthly amount.");
            return;
        }

        line.BudgetMonths[month] = Math.Max(0m, value);
        RecalculateLocal();
        isDirty = true;
    }

    private void RecalculateLocal()
    {
        if (workspace is null)
        {
            return;
        }

        var lines = workspace.Lines.ToDictionary(
            line => line.LineCode,
            StringComparer.OrdinalIgnoreCase);
        for (var month = 0; month < 12; month++)
        {
            Set(lines, "GROSS_PROFIT", month,
                Value(lines, "REVENUE", month) - Value(lines, "COGS", month));
            Set(lines, "EBITDA", month,
                Value(lines, "GROSS_PROFIT", month)
                + Value(lines, "OTHER_INCOME", month)
                - Value(lines, "OPERATING_EXPENSES", month));
            Set(lines, "EBIT", month,
                Value(lines, "EBITDA", month) - Value(lines, "DEPRECIATION", month));
            Set(lines, "PBT", month,
                Value(lines, "EBIT", month) - Value(lines, "INTEREST", month));
            Set(lines, "TOTAL_INFLOWS", month,
                Value(lines, "SALES_RECEIPTS", month)
                + Value(lines, "OTHER_RECEIPTS", month));
            Set(lines, "TOTAL_OUTFLOWS", month,
                Value(lines, "SUPPLIER_PAYMENTS", month)
                + Value(lines, "CASH_OPERATING_EXPENSES", month)
                + Value(lines, "VAT_PAYMENT", month)
                + Value(lines, "LOAN_PAYMENTS", month)
                + Value(lines, "ASSET_PURCHASES", month));
            Set(lines, "NET_CASH", month,
                Value(lines, "TOTAL_INFLOWS", month)
                - Value(lines, "TOTAL_OUTFLOWS", month));
            var openingBank = month == 0
                ? workspace.OpeningBank
                : Value(lines, "CLOSING_BANK", month - 1);
            Set(lines, "CLOSING_BANK", month,
                openingBank + Value(lines, "NET_CASH", month));
        }

        RefreshDerivedState();
    }

    private void RefreshDerivedState()
    {
        alerts = workspace is null
            ? []
            : BudgetService.BuildAlerts(workspace);
    }

    private decimal CellValue(AssessmentBudgetLine line, int month) =>
        displayMode switch
        {
            BudgetDisplayMode.Projection => line.ProjectedMonths[month],
            BudgetDisplayMode.Variance =>
                line.BudgetMonths[month] - line.ProjectedMonths[month],
            _ => line.BudgetMonths[month]
        };

    private decimal DisplayTotal(AssessmentBudgetLine line)
    {
        if (line.LineCode == "CLOSING_BANK")
        {
            return displayMode switch
            {
                BudgetDisplayMode.Projection => line.ProjectedMonths[^1],
                BudgetDisplayMode.Variance =>
                    line.BudgetMonths[^1] - line.ProjectedMonths[^1],
                _ => line.BudgetMonths[^1]
            };
        }

        return displayMode switch
        {
            BudgetDisplayMode.Projection => line.ProjectionTotal,
            BudgetDisplayMode.Variance => line.VarianceTotal,
            _ => line.BudgetTotal
        };
    }

    private string MonthLabel(int month) =>
        ProjectPeriodMapper.GetMonth(workspace?.AssessmentStartDate, month).CalendarLabel;

    private decimal BudgetTotal(string lineCode) =>
        workspace?.FindLine(lineCode)?.BudgetTotal ?? 0m;

    private string VarianceLabel(string lineCode)
    {
        var line = workspace?.FindLine(lineCode);
        return line is null
            ? "No comparison"
            : $"{SignedMoney(line.VarianceTotal)} vs projection";
    }

    private string? CellClass(AssessmentBudgetLine line, int month)
    {
        var value = CellValue(line, month);
        return displayMode == BudgetDisplayMode.Variance
            ? value < 0m ? "budget-negative" : value > 0m ? "budget-positive" : null
            : null;
    }

    private string TotalClass(AssessmentBudgetLine line)
    {
        var value = DisplayTotal(line);
        var varianceClass = displayMode == BudgetDisplayMode.Variance
            ? value < 0m ? "budget-negative" : value > 0m ? "budget-positive" : null
            : null;
        return $"budget-total-column {varianceClass}";
    }

    private string StatusBadgeClass =>
        workspace?.Status switch
        {
            AssessmentBudgetStatuses.Approved => "badge rounded-pill text-bg-success",
            AssessmentBudgetStatuses.Submitted => "badge rounded-pill text-bg-primary",
            _ => "badge rounded-pill text-bg-secondary"
        };

    private static string AlertClass(string severity) =>
        severity switch
        {
            "Critical" => "budget-alert budget-alert-critical",
            "Warning" => "budget-alert budget-alert-warning",
            _ => "budget-alert budget-alert-information"
        };

    private static string AlertIcon(string severity) =>
        severity switch
        {
            "Critical" => "bi bi-exclamation-octagon-fill",
            "Warning" => "bi bi-exclamation-triangle-fill",
            _ => "bi bi-check-circle-fill"
        };

    private static string ValueClass(decimal value) =>
        value < 0m ? "budget-negative" : "budget-positive";

    private static string Money(decimal value) => value.ToString("N2");

    private static string SignedMoney(decimal value) =>
        value == 0m ? "0.00" : $"{(value > 0m ? "+" : "-")}{Math.Abs(value):N2}";

    private static decimal Value(
        IReadOnlyDictionary<string, AssessmentBudgetLine> lines,
        string code,
        int month) =>
        lines.TryGetValue(code, out var line) ? line.BudgetMonths[month] : 0m;

    private static void Set(
        IReadOnlyDictionary<string, AssessmentBudgetLine> lines,
        string code,
        int month,
        decimal value)
    {
        if (lines.TryGetValue(code, out var line))
        {
            line.BudgetMonths[month] = value;
        }
    }

    private enum BudgetDisplayMode
    {
        Budget,
        Projection,
        Variance
    }
}
