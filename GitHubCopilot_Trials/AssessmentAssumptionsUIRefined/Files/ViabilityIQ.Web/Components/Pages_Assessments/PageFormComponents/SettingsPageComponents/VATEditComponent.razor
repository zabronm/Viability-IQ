@using ViabilityIQ.Infrastructure.Repositories

@if (loadingStateActive) { <FormLoadingComponent /> }
else
{
<EditForm Model="@vatUpdateModel" OnValidSubmit="UpdateVATRateOnly">
    <DataAnnotationsValidator />
    <section class="vat-card">
        <header><span class="vat-icon"><i class="bi bi-receipt"></i></span><div><span>Statutory settings</span><h3>Assessment Period &amp; VAT</h3><p>Confirm the assessment context and VAT rate used across taxable projections.</p></div></header>
        <ValidationSummary class="vat-validation" />
        <div class="vat-grid">
            <label><span>Case number</span><input value="@vatUpdateModel.CaseNumber" readonly disabled /></label>
            <label><span>Period start</span><input value="@vatUpdateModel.AssessmentStartDate?.ToString("yyyy-MM-dd")" readonly disabled /></label>
            <label><span>Period end</span><input value="@vatUpdateModel.AssessmentFinishDate?.ToString("yyyy-MM-dd")" readonly disabled /></label>
            <label><span>Business</span><DDLookupComponent SourceKey="DDLookupEnums.Businesses" Label="Business" @bind-Value="@vatUpdateModel.BusinessId" IsDisabled="true" /></label>
            <label><span>VAT rate</span><div class="vat-input"><input type="number" min="0" max="100" step="0.01" value="@vatUpdateModel.VatRate.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" @onchange="SetVatRate" /><span>%</span></div></label>
        </div>
        <footer><span><i class="bi bi-info-circle"></i> The rate is applied to VAT-inclusive Sales, purchases and expenses.</span><button type="submit" disabled="@IsSubmitting"><i class="bi bi-check2-circle"></i> Update VAT</button></footer>
    </section>
</EditForm>
}

@code {
    [Inject] private MasterDataService? ViqCrudService { get; set; }
    [Parameter] public VatUpdateModel vatUpdateModel { get; set; } = new();
    [Parameter] public EventCallback<SaveResult> OnUpdate { get; set; }
    private SaveResult? result = new(); private bool IsSubmitting; private bool loadingStateActive;
    protected override async Task OnParametersSetAsync() => await RefreshAsync();
    public async Task RefreshAsync(){loadingStateActive=true;await Task.Delay(150);loadingStateActive=false;StateHasChanged();}
    private void SetVatRate(ChangeEventArgs e){if(decimal.TryParse(Convert.ToString(e.Value),System.Globalization.NumberStyles.Number,System.Globalization.CultureInfo.InvariantCulture,out var value))vatUpdateModel.VatRate=value;}
    private async Task UpdateVATRateOnly()
    {
        IsSubmitting=true;
        try
        {
            var rows=await ViqCrudService!.ExecuteCommandAsync("UPDATE tblAssessments SET VATRate=@VATRate WHERE AssessmentId=@AssessmentId",new{VATRate=vatUpdateModel.VatRate,vatUpdateModel.AssessmentId});
            result=rows>0?new SaveResult{Message="VAT rate updated successfully",Success=true}:SaveResult.Failed("VAT rate was not updated. Please retry.");
        }
        catch(Exception ex){result=SaveResult.Failed($"VAT rate could not be updated: {ex.Message}");}
        finally{IsSubmitting=false;if(OnUpdate.HasDelegate)await OnUpdate.InvokeAsync(result!);}
    }
}
