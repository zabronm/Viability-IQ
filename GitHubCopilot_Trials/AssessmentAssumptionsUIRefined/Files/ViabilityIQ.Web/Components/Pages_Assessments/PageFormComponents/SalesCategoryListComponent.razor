@using ViabilityIQ.Shared.DataModels
@using ViabilityIQ.Application.Interfaces
@inject IGenericDataRepository<AssessmentSalesCategory> SalesCategoryRepository

<section class="scl-card">
    <header class="scl-header">
        <div><span class="scl-icon"><i class="bi bi-tags"></i></span><div><span>Revenue structure</span><h3>Sales Categories</h3><p>Classify income streams and define markup and opening stock assumptions.</p></div></div>
        <button type="button" @onclick="() => OnEditRequested.InvokeAsync(0)"><i class="bi bi-plus-lg"></i> Add Sales Category</button>
    </header>
    <div class="scl-body">
        @if (IsComponentLoading)
        {
            <div class="scl-state"><span class="spinner-border spinner-border-sm"></span> Loading Sales Categories...</div>
        }
        else if (!Categories.Any())
        {
            <div class="scl-state"><i class="bi bi-folder-plus"></i><strong>No Sales Categories yet</strong><span>Add a category to classify projected income.</span></div>
        }
        else
        {
            <div class="scl-table-wrap"><table class="scl-table">
                <thead><tr><th>#</th><th>Category</th><th class="text-end">Markup</th><th class="text-end">Opening stock</th><th class="text-center">Status</th><th class="text-center">Action</th></tr></thead>
                <tbody>
                @{ var row = 1; }
                @foreach (var category in Categories)
                {
                    <tr><td>@row</td><td><strong>@category.AssessmentSalesCategoryName</strong></td>
                        <td class="text-end"><span class="scl-rate">@category.MarkupPercentage.ToString("N2")%</span></td>
                        <td class="text-end">R @category.OpeningStock.ToString("N2")</td>
                        <td class="text-center"><span class="scl-status @(category.Active ? "active" : "inactive")">@(category.Active ? "Active" : "Inactive")</span></td>
                        <td class="text-center"><button class="scl-edit" type="button" title="Edit category" @onclick="() => OnEditRequested.InvokeAsync(category.AssessmentSalesCategoryId)"><i class="bi bi-pencil-square"></i></button></td>
                    </tr>
                    row++;
                }
                </tbody>
            </table></div>
        }
    </div>
    <footer><i class="bi bi-info-circle"></i> Markup supports cost-of-Sales estimates; opening stock feeds the starting working-capital position.</footer>
</section>
