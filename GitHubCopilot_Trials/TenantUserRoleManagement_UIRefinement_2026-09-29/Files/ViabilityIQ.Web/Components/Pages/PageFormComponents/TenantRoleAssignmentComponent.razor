@using ViabilityIQ.Application.Dtos
@using ViabilityIQ.Application.Interfaces
@using ViabilityIQ.Shared.DataModels.SecurityDataModels
@using ViabilityIQ.Shared.SharedModels
@using ViabilityIQ.Web.Services

@inject ITenantUserManagementService UserManagementService
@inject OffCanvasStateService OffCanvasService
@inject ILogger<TenantRoleAssignmentComponent> Logger

<div class="viq-form-shell">
    @if (isProcessing)
    {
        <div class="viq-form-busy">
            <div class="viq-form-busy-card">
                <span class="viq-form-spinner"></span>
                <div><strong>Processing role allocation</strong><span>Please wait...</span></div>
            </div>
        </div>
    }

    @if (!isLoading && snapshot is not null && member is not null)
    {
        <div class="viq-data-form">
            <div class="viq-form-intro">
                <span class="viq-form-intro-icon"><i class="bi bi-person-lock"></i></span>
                <div><h2>Assign tenant roles</h2><p>@member.FullName · @member.Email</p></div>
            </div>

            <section class="viq-form-section">
                <div class="viq-form-section-heading">
                    <span><i class="bi bi-key"></i></span>
                    <div><h3>Access profiles</h3><p>Select every role this member should hold in @snapshot.TenantName.</p></div>
                </div>
                <div class="tenant-role-assignment-grid">
                    @foreach (var role in snapshot.Roles.Where(item => item.RoleCode != TenantRoleCodes.Owner))
                    {
                        <label class="tenant-role-assignment-choice">
                            <input type="checkbox"
                                   checked="@request.RoleCodes.Contains(role.RoleCode)"
                                   @onchange="eventArgs => ToggleRole(role.RoleCode, (bool?)eventArgs.Value == true)" />
                            <span><strong>@role.RoleName</strong><small>@role.Description</small></span>
                        </label>
                    }
                </div>
            </section>

            <div class="viq-form-actions">
                <button type="button" class="viq-button viq-button-secondary" @onclick="CloseAsync" disabled="@isProcessing">
                    Cancel
                </button>
                <button type="button" class="viq-button viq-button-primary" @onclick="SaveAsync" disabled="@isProcessing">
                    <i class="bi bi-check2-square"></i><span>Save roles</span>
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public long MembershipId { get; set; }

    private TenantUserManagementSnapshot? snapshot;
    private TenantMemberRow? member;
    private UpdateTenantMemberRequest request = new();
    private bool isLoading = true;
    private bool isProcessing;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        isProcessing = true;
        try
        {
            snapshot = await UserManagementService.GetSnapshotAsync();
            member = snapshot.Members.SingleOrDefault(item => item.MembershipId == MembershipId);
            if (member is null || member.IsOwner)
            {
                await PublishFailureAsync("The selected tenant member's roles cannot be changed.", true);
                return;
            }

            request = new UpdateTenantMemberRequest
            {
                MembershipId = member.MembershipId,
                BranchId = member.BranchId,
                MembershipStatus = member.MembershipStatus,
                RoleCodes = member.RoleCodes.ToHashSet(StringComparer.OrdinalIgnoreCase)
            };
        }
        catch (Exception exception)
        {
            if (exception is not UnauthorizedAccessException)
                Logger.LogError(exception, "The role-assignment form could not be loaded.");
            await PublishFailureAsync(
                exception is UnauthorizedAccessException
                    ? exception.Message
                    : "The role-assignment form could not be loaded.",
                true);
        }
        finally
        {
            isLoading = false;
            isProcessing = false;
        }
    }

    private void ToggleRole(string roleCode, bool selected)
    {
        if (selected)
            request.RoleCodes.Add(roleCode);
        else
            request.RoleCodes.Remove(roleCode);
    }

    private async Task SaveAsync()
    {
        isProcessing = true;
        try
        {
            var result = await UserManagementService.UpdateMemberAsync(request);
            await OffCanvasService.PublishResultAsync(new SaveResult
            {
                Success = result.Succeeded,
                RefreshGrid = result.Succeeded,
                ClosePanel = result.Succeeded,
                Message = result.Message
            });
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Tenant role allocation could not be saved.");
            await PublishFailureAsync("Role allocation could not be saved. Please retry.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private Task PublishFailureAsync(string message, bool closePanel = false) =>
        OffCanvasService.PublishResultAsync(new SaveResult
        {
            Success = false,
            ClosePanel = closePanel,
            Message = message
        });

    private Task CloseAsync() => OffCanvasService.CloseAsync();
}
