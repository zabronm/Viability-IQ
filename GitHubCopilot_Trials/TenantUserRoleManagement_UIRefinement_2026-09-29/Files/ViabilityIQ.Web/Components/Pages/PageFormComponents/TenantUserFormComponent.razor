@using ViabilityIQ.Application.Dtos
@using ViabilityIQ.Application.Interfaces
@using ViabilityIQ.Shared.DataModels.SecurityDataModels
@using ViabilityIQ.Shared.SharedModels
@using ViabilityIQ.Web.Services

@inject ITenantUserManagementService UserManagementService
@inject OffCanvasStateService OffCanvasService
@inject ILogger<TenantUserFormComponent> Logger

<div class="viq-form-shell">
    @if (isProcessing)
    {
        <div class="viq-form-busy">
            <div class="viq-form-busy-card">
                <span class="viq-form-spinner"></span>
                <div>
                    <strong>@(isLoading ? "Loading tenant user" : "Saving tenant user")</strong>
                    <span>Please wait while the security profile is processed...</span>
                </div>
            </div>
        </div>
    }

    @if (!isLoading && snapshot is not null)
    {
        @if (MembershipId == 0)
        {
            <EditForm Model="@createRequest" OnValidSubmit="CreateAsync" FormName="CreateTenantUserOffCanvas" class="viq-data-form">
                <DataAnnotationsValidator />
                <ValidationSummary class="viq-form-validation-summary" />

                <div class="viq-form-intro">
                    <span class="viq-form-intro-icon"><i class="bi bi-person-plus-fill"></i></span>
                    <div>
                        <h2>Add tenant user</h2>
                        <p>Create a new account or attach an existing ViabilityIQ account to @snapshot.TenantName.</p>
                    </div>
                </div>

                <section class="viq-form-section">
                    <div class="viq-form-section-heading">
                        <span><i class="bi bi-person-vcard"></i></span>
                        <div><h3>User identity</h3><p>Account holder name and sign-in email address.</p></div>
                    </div>
                    <div class="viq-form-grid viq-form-grid-2">
                        <div class="viq-form-field">
                            <label>First name</label>
                            <InputText class="viq-form-control" @bind-Value="createRequest.FirstName" />
                            <ValidationMessage For="@(() => createRequest.FirstName)" class="viq-form-validation" />
                        </div>
                        <div class="viq-form-field">
                            <label>Last name</label>
                            <InputText class="viq-form-control" @bind-Value="createRequest.LastName" />
                            <ValidationMessage For="@(() => createRequest.LastName)" class="viq-form-validation" />
                        </div>
                        <div class="viq-form-field viq-form-span-2">
                            <label>Email address</label>
                            <InputText type="email" class="viq-form-control" @bind-Value="createRequest.Email" />
                            <ValidationMessage For="@(() => createRequest.Email)" class="viq-form-validation" />
                            <small>A generated temporary password is emailed when this is a new account.</small>
                        </div>
                    </div>
                </section>

                <section class="viq-form-section">
                    <div class="viq-form-section-heading">
                        <span><i class="bi bi-shield-lock"></i></span>
                        <div><h3>Tenant access</h3><p>Branch ownership and one or more access profiles.</p></div>
                    </div>
                    <div class="viq-form-field">
                        <label>Branch</label>
                        <InputSelect class="viq-form-control" @bind-Value="createRequest.BranchId">
                            <option value="">Unassigned</option>
                            @foreach (var branch in snapshot.Branches)
                            {
                                <option value="@branch.BranchId">@branch.BranchName</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="tenant-offcanvas-role-grid">
                        @foreach (var role in snapshot.Roles.Where(item => item.RoleCode != TenantRoleCodes.Owner))
                        {
                            <label class="tenant-offcanvas-role-choice">
                                <input type="checkbox"
                                       checked="@createRequest.RoleCodes.Contains(role.RoleCode)"
                                       @onchange="eventArgs => ToggleRole(createRequest.RoleCodes, role.RoleCode, (bool?)eventArgs.Value == true)" />
                                <span><strong>@role.RoleName</strong><small>@role.Description</small></span>
                            </label>
                        }
                    </div>
                </section>

                <div class="viq-form-actions">
                    <button type="button" class="viq-button viq-button-secondary" @onclick="CloseAsync" disabled="@isProcessing">
                        Cancel
                    </button>
                    <button type="submit" class="viq-button viq-button-primary" disabled="@isProcessing">
                        <i class="bi bi-check2-square"></i><span>Add user</span>
                    </button>
                </div>
            </EditForm>
        }
        else if (member is not null)
        {
            <EditForm Model="@updateRequest" OnValidSubmit="UpdateAsync" FormName="UpdateTenantUserOffCanvas" class="viq-data-form">
                <DataAnnotationsValidator />

                <div class="viq-form-intro">
                    <span class="viq-form-intro-icon"><i class="bi bi-person-gear"></i></span>
                    <div>
                        <h2>Edit tenant user</h2>
                        <p>@member.FullName · @member.Email</p>
                    </div>
                </div>

                <section class="viq-form-section">
                    <div class="viq-form-section-heading">
                        <span><i class="bi bi-shield-lock"></i></span>
                        <div><h3>Tenant access</h3><p>Branch ownership and one or more access profiles.</p></div>
                    </div>
                    <div class="viq-form-field">
                        <label>Branch</label>
                        <InputSelect class="viq-form-control" @bind-Value="updateRequest.BranchId">
                            <option value="">Unassigned</option>
                            @foreach (var branch in snapshot.Branches)
                            {
                                <option value="@branch.BranchId">@branch.BranchName</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="tenant-offcanvas-role-grid">
                        @foreach (var role in snapshot.Roles.Where(item => item.RoleCode != TenantRoleCodes.Owner))
                        {
                            <label class="tenant-offcanvas-role-choice">
                                <input type="checkbox"
                                       checked="@updateRequest.RoleCodes.Contains(role.RoleCode)"
                                       @onchange="eventArgs => ToggleRole(updateRequest.RoleCodes, role.RoleCode, (bool?)eventArgs.Value == true)" />
                                <span><strong>@role.RoleName</strong><small>@role.Description</small></span>
                            </label>
                        }
                    </div>
                </section>

                <section class="viq-form-section">
                    <div class="viq-form-section-heading">
                        <span><i class="bi bi-person-check"></i></span>
                        <div><h3>Membership status</h3><p>Control the member's access to this tenant.</p></div>
                    </div>
                    <div class="viq-form-field">
                        <label>Status</label>
                        <InputSelect class="viq-form-control" @bind-Value="updateRequest.MembershipStatus">
                            <option value="Active">Active</option>
                            <option value="Suspended">Suspended</option>
                            <option value="Removed">Removed</option>
                        </InputSelect>
                    </div>
                </section>

                <div class="viq-form-actions">
                    <button type="button" class="viq-button viq-button-secondary" @onclick="CloseAsync" disabled="@isProcessing">
                        Cancel
                    </button>
                    <button type="submit" class="viq-button viq-button-primary" disabled="@isProcessing">
                        <i class="bi bi-check2-square"></i><span>Update user</span>
                    </button>
                </div>
            </EditForm>
        }
    }
</div>

@code {
    [Parameter] public long MembershipId { get; set; }

    private TenantUserManagementSnapshot? snapshot;
    private TenantMemberRow? member;
    private CreateTenantUserRequest createRequest = new();
    private UpdateTenantMemberRequest updateRequest = new();
    private bool isLoading = true;
    private bool isProcessing;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        isProcessing = true;
        try
        {
            snapshot = await UserManagementService.GetSnapshotAsync();
            if (MembershipId == 0)
            {
                createRequest = new CreateTenantUserRequest
                {
                    RoleCodes = [TenantRoleCodes.Viewer]
                };
            }
            else
            {
                member = snapshot.Members.SingleOrDefault(item => item.MembershipId == MembershipId);
                if (member is null || member.IsOwner)
                {
                    await PublishFailureAsync("The selected tenant membership cannot be edited.", true);
                    return;
                }

                updateRequest = new UpdateTenantMemberRequest
                {
                    MembershipId = member.MembershipId,
                    BranchId = member.BranchId,
                    MembershipStatus = member.MembershipStatus,
                    RoleCodes = member.RoleCodes.ToHashSet(StringComparer.OrdinalIgnoreCase)
                };
            }
        }
        catch (Exception exception)
        {
            if (exception is not UnauthorizedAccessException)
                Logger.LogError(exception, "The tenant user form could not be loaded.");
            await PublishFailureAsync(
                exception is UnauthorizedAccessException
                    ? exception.Message
                    : "The tenant user form could not be loaded.",
                true);
        }
        finally
        {
            isLoading = false;
            isProcessing = false;
        }
    }

    private async Task CreateAsync()
    {
        await SaveAsync(() => UserManagementService.CreateMemberAsync(createRequest));
    }

    private async Task UpdateAsync()
    {
        await SaveAsync(() => UserManagementService.UpdateMemberAsync(updateRequest));
    }

    private async Task SaveAsync(Func<Task<TenantUserOperationResult>> operation)
    {
        isProcessing = true;
        try
        {
            var result = await operation();
            await OffCanvasService.PublishResultAsync(new SaveResult
            {
                Success = result.Succeeded,
                RefreshGrid = result.Succeeded,
                ClosePanel = result.Succeeded,
                Message = result.Message
            });
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "The tenant user could not be saved.");
            await PublishFailureAsync("The tenant user could not be saved. Please retry.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private Task PublishFailureAsync(string message, bool closePanel = false) =>
        OffCanvasService.PublishResultAsync(new SaveResult
        {
            Success = false,
            ClosePanel = closePanel,
            Message = message
        });

    private Task CloseAsync() => OffCanvasService.CloseAsync();

    private static void ToggleRole(HashSet<string> roles, string roleCode, bool selected)
    {
        if (selected)
            roles.Add(roleCode);
        else
            roles.Remove(roleCode);
    }
}
