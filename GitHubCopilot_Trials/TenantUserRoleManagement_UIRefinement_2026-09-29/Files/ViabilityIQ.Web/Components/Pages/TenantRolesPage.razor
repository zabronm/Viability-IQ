@page "/settings/roles"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using ViabilityIQ.Application.Dtos
@using ViabilityIQ.Shared.DataModels.SecurityDataModels
@using ViabilityIQ.Web.Components.CommonComponents
@using ViabilityIQ.Web.Components.Pages.PageFormComponents
@using ViabilityIQ.Web.Services

<PageTitle>Tenant Roles</PageTitle>

<div class="p-0">
    <PageHeading _pageTitle="Security Settings" CurrentPage="PageType.Settings" _pageHeading="User Groups / Roles" />

    <nav aria-label="breadcrumb" class="px-3 pt-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/settings/settings">Settings</a></li>
            <li class="breadcrumb-item active" aria-current="page">User Groups / Roles</li>
        </ol>
    </nav>

    <main class="tenant-roles-page">
        @if (isLoading)
        {
            <div class="d-grid p-5 text-center">
                <div class="spinner-border text-primary mx-auto" role="status"></div>
            </div>
        }
        else if (snapshot is not null)
        {
            <section class="roles-heading-card">
                <div>
                    <span class="roles-eyebrow">PROTECTED ACCESS PROFILES</span>
                    <h2>@snapshot.TenantName</h2>
                    <p>Roles define tenant-level authority. Multiple roles can be assigned to one member.</p>
                </div>
                <a class="btn btn-outline-primary" href="/settings/users">
                    <i class="bi bi-people-fill me-2"></i>Manage users
                </a>
            </section>

            <section class="role-catalogue">
                @foreach (var role in snapshot.Roles)
                {
                    <article class="role-card">
                        <div class="role-card-icon"><i class="@RoleIcon(role.RoleCode)"></i></div>
                        <div>
                            <h3>@role.RoleName</h3>
                            <code>@role.RoleCode</code>
                            <p>@role.Description</p>
                        </div>
                        <span class="badge text-bg-light">@MemberCount(role.RoleCode) member(s)</span>
                    </article>
                }
            </section>

            <section class="roles-table-card">
                <div class="roles-table-heading">
                    <div>
                        <span class="roles-eyebrow">ROLE ALLOCATION</span>
                        <h3>Tenant members</h3>
                    </div>
                    <span class="text-muted">Tenant Owner is protected.</span>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Branch</th>
                                <th>Assigned roles</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var member in snapshot.Members)
                            {
                                <tr>
                                    <td>
                                        <strong>@member.FullName</strong>
                                        <div class="text-muted small">@member.Email</div>
                                    </td>
                                    <td>@member.BranchName</td>
                                    <td>
                                        @foreach (var roleName in member.RoleNames)
                                        {
                                            <span class="role-pill">@roleName</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary"
                                                disabled="@member.IsOwner"
                                                @onclick="() => OpenRoleEditorAsync(member.MembershipId)">
                                            Assign roles
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    </main>
</div>

@code {
    [Inject] private ViabilityIQ.Application.Interfaces.ITenantUserManagementService UserManagementService { get; set; } = default!;
    [Inject] private OffCanvasStateService OffCanvasService { get; set; } = default!;
    [Inject] private ToastService Toast { get; set; } = default!;
    [Inject] private ViabilityIQ.Application.Interfaces.ISessionService SessionService { get; set; } = default!;
    [Inject] private ILogger<TenantRolesPage> Logger { get; set; } = default!;

    private TenantUserManagementSnapshot? snapshot;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            snapshot = await UserManagementService.GetSnapshotAsync();
        }
        catch (Exception exception)
        {
            snapshot = null;
            if (exception is not UnauthorizedAccessException)
                Logger.LogError(exception, "Tenant roles could not be loaded.");
            Toast.ShowError(
                exception is UnauthorizedAccessException
                    ? exception.Message
                    : "Tenant roles could not be loaded. Please retry.",
                SessionService.AppTitle);
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task OpenRoleEditorAsync(long membershipId) =>
        OffCanvasService.ShowAsync(new CanvasRequest
        {
            Title = "Assign Tenant Roles",
            Width = 600,
            ComponentType = typeof(TenantRoleAssignmentComponent),
            Parameters = new Dictionary<string, object?>
            {
                [nameof(TenantRoleAssignmentComponent.MembershipId)] = membershipId
            },
            ResultCallback = ProcessResultAsync
        });

    private async Task ProcessResultAsync(SaveResult result)
    {
        if (result.Success)
        {
            Toast.ShowSuccess(result.Message, SessionService.AppTitle);
            await LoadAsync();
        }
        else
        {
            Toast.ShowError(result.Message, SessionService.AppTitle);
        }

        await InvokeAsync(StateHasChanged);
    }

    private int MemberCount(string roleCode) =>
        snapshot?.Members.Count(member => member.RoleCodes.Contains(roleCode)) ?? 0;

    private static string RoleIcon(string roleCode) => roleCode switch
    {
        TenantRoleCodes.Owner => "bi bi-shield-fill-check",
        TenantRoleCodes.Administrator => "bi bi-person-fill-gear",
        TenantRoleCodes.BranchManager => "bi bi-diagram-3-fill",
        TenantRoleCodes.BillingManager => "bi bi-credit-card-fill",
        _ => "bi bi-eye-fill"
    };
}
