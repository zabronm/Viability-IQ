@namespace ViabilityIQ.Web.Components.Pages_Assessments.PageFormComponents
@using ViabilityIQ.Shared.DataModels
@using ViabilityIQ.Web.Components.CommonComponents

<div class="px-1">
    @if (FormModel != null)
    {
        <EditForm Model="@FormModel" OnValidSubmit="ExecuteSaveWorkflowAsync">
            <DataAnnotationsValidator />

            <!-- Expense Category Row -->
            <div class="row mb-2 align-items-center">
                <div class="col-4"><label class="form-label text-xs fw-bold text-secondary mb-0">Expense Type</label></div>
                <div class="col-8"><DDLookupComponent SourceKey="DDLookupEnums.ExpenseTypes" @bind-Value="FormModel.ExpenseTypeId" /></div>
            </div>

            <!-- Expense Item Lookup Row -->
            <div class="row mb-2 align-items-center">
                <div class="col-4"><label class="form-label text-xs fw-bold text-secondary mb-0">Expense Item</label></div>
                <div class="col-8"><DDLookupComponent SourceKey="DDLookupEnums.ExpenseItems" @bind-Value="FormModel.ExpenseItemId" /></div>
            </div>

            <!-- Post to cashbook Row -->
            <div class="row mb-3 align-items-center">
                <div class="col-5"><label class="form-label text-xs fw-bold text-primary mb-0">Post to Cashbook?</label></div>
                <div class="col-5"><InputCheckbox class="form-check-input" @bind-Value="FormModel.blSendToCashBook" /></div>
            </div>

            <!-- % of Sales Checkbox and Conditional Percentage Row -->
            <div class="row mb-3 align-items-center">
                <div class="col-5">
                    <div class="form-check">
                        <InputCheckbox class="form-check-input" id="salesCheck" @bind-Value="FormModel.blPercentageOfSalesUsed" @onclick="ToggleSalesPercentage" />
                        <label class="form-check-label text-xs fw-bold text-primary" for="salesCheck">Use % of Sales?</label>
                    </div>
                </div>
                @if (FormModel.blPercentageOfSalesUsed)
                {
                    <div class="col-4">
                        <InputNumber class="form-control form-control-sm text-xs" style="width: 80px;" placeholder="%" @bind-Value="FormModel.PercentageOfSalesRate" />
                    </div>
                }
            </div>

            <!-- Allocation tool -->
            <div class="card bg-light border-0 mb-3 p-2 rounded shadow-sm">
                <label class="form-label text-xs fw-bold text-navy-brand uppercase">Apply Allocation (Amount to all months)</label>
                <div class="input-group input-group-sm">
                    <input type="number" class="form-control text-xs" @bind="FormModel.SameMonthlyAmount" />
                    <button class="btn btn-outline-success text-xxs px-2" type="button" @onclick="ApplyMonthlyAllocation">Apply Allocation</button>
                </div>
            </div>

            <!-- Projection Grid -->
            <h6 class="text-xxs fw-bold text-secondary mb-1 uppercase">12-Month Projection</h6>
            <div class="pe-1 border p-1.5 pt-1 rounded bg-light-subtle mb-2" style="max-height: 240px; overflow-y: auto;">
                @for (int i = 0; i < 12; i++)
                {
                    int index = i;
                    <div class="row align-items-center mb-1 g-2 mx-0">
                        <div class="col-4 ps-4"><span class="small text-muted">Month @(index + 1)</span></div>
                        <div class="col-8"><InputNumber class="form-control form-control-sm text-end text-xs" @bind-Value="MonthlyValues[index]" /></div>
                    </div>
                }
            </div>

            <!-- Total allocation row -->
            <div class="d-flex justify-content-between p-2 rounded text-xs fw-bold mb-3" style="background-color: #e0f2fe; color: #1e3a8a;">
                <span>TOTAL ALLOCATION</span>
                <span>@MonthlyValues.Sum().ToString("N2")</span>
            </div>

            <div class="d-flex gap-2 border-top pt-2">
                <button type="submit" class="btn btn-primary btn-sm flex-fill">Save Changes</button>
                @* <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelFormAsync">Cancel</button> *@
            </div>
        </EditForm>
    }
</div>