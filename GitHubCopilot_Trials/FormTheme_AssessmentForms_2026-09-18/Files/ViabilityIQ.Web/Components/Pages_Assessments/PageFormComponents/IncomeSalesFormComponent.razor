@namespace ViabilityIQ.Web.Components.Pages_Assessments.PageFormComponents
@using ViabilityIQ.Shared.DataModels

<div class="p-3">
    @if (FormModel != null)
    {
        <EditForm Model="FormModel" OnValidSubmit="ExecuteSaveWorkflowAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-2 mt-0">
                <label class="form-label-custom  mb-1">Income Type Category</label>
                <DDLookupComponent SourceKey="DDLookupEnums.IncomeTypes" @bind-Value="FormModel.IncomeTypeId" />
            </div>

            <div class="mb-2">
                <label class="form-label-custom mb-1">Income Description</label>
                <input type="text" class="form-control-compact form-control" @bind="FormModel.Description" />
            </div>            

            <div class="form-check form-switch mb-2 mt-0 d-flex gap-2">
                <input class="form-check-input" type="checkbox" checked="@(FormModel.IncludeVAT > 0)"
                       @onchange="@(e => FormModel.IncludeVAT = (bool)e.Value! ? 1 : 0)" value="true" />
                <label class="form-check-label fw-semibold text-muted">Include VAT (+15%)</label>
            </div>

            <div class="card bg-light border-0 mb-3 p-1.5 rounded">
                <div class="input-group input-group-sm">
                    <input type="number" class="form-control" @bind="BulkAnnualValueTarget" />
                    <button class="btn btn-outline-success" type="button" @onclick="DistributeAnnualValueEvenly">Apply Split</button>
                </div>
            </div>

            <h6 class="text-xs fw-bold text-secondary mb-1 uppercase">Assessment Period Sales Projections</h6>
            <div class="sales-input-pane" style="max-height:260px; overflow-y:auto;">
                @for (int i = 0; i < 12; i++)
                {
                    int index = i;

                    <div class="d-flex align-items-center mb-2">
                        <label class="me-2 mb-0" style="width:100px;">
                            Month-@(index + 1)
                        </label>

                        <input type="number"
                               class="form-control form-control-sm text-end"
                               @bind="MonthlyValues[index]"
                               @bind:event="oninput" />
                    </div>
                }
            </div>
            @* <div class="sales-input-pane" style="max-height: 260px; overflow-y: auto;">
                @for (int i = 0; i < 12; i++)
                {
                    int index = i;                   
                    <div class="input-group input-group-sm mb-1">
                        
                        <span class="input-group-text text-xs">Month-@(index + 1)</span>
                        <input type="number" class="form-control-compact text-end" @bind="MonthlyValues[index]" @bind:event="oninput" />
                    </div>
                }
            </div> *@

            <div class="p-2 bg-light rounded mt-3">
                <div class="d-flex justify-content-between text-xs"><span>Total:</span> <b>R @GrandCalculatedTotalSum.ToString("N2")</b></div>
            </div>

            <div class="mt-3 border-top pt-2 d-flex gap-2">
                <button class="btn btn-primary btn-sm flex-fill" @onclick="ExecuteSaveWorkflowAsync">Save</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="CancelFormAsync">Cancel</button>
            </div>
        </EditForm>
    }
</div>