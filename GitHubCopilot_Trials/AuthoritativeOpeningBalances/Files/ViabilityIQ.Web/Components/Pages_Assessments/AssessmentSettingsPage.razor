@page "/assessment/assumptions/{ActiveAssessmentId:long}"

@layout MainLayout_Assessment
@inherits Microsoft.AspNetCore.Components.ComponentBase
@using ViabilityIQ.Shared.DataModels
@using ViabilityIQ.Shared.SharedModels
@using ViabilityIQ.Web.Components.Pages_Assessments.AssumptionComponents

<div class="assumptions-page container-fluid p-0 position-relative dashboard-workspace">
    <PageHeading_Assessment _pageTitle="Assumptions"
                            PageTitle="Assessment Assumptions &amp; Baseline"
                            CurrentPage="PageType.Settings" />
    <nav class="assumptions-resources" aria-label="Assumptions resources">
        <a href="@($"/assessment/assumptions/{ActiveAssessmentId}/report")" target="_blank"><i class="bi bi-file-earmark-pdf-fill"></i> Assumptions Report</a>
        <a href="/documents/AssessmentAssumptionsDataCollection.csv" download><i class="bi bi-filetype-csv"></i> Data Collection Template</a>
        <a href="/documents/AssessmentReadinessRules.txt" target="_blank"><i class="bi bi-card-checklist"></i> Readiness Rules</a>
        <a href="/documents/AssessmentAssumptionsHelp.pdf" target="_blank"><i class="bi bi-question-circle-fill"></i> Help Guide</a>
    </nav>
    <div class="row bg-white g-3 mt-1 mb-1 py-2 px-2" style="border-radius: 6px;">
        @if (IsLoading)
        {
            <FormLoadingComponent />
        }
        else if (Model is not null)
        {
            <div class="mb-2 mt-2 px-0 assessment-readiness-wrapper">
                <div class="assumption-hover-card px-0">
                    <AssessmentProjectionReadinessComponent @key="AssumptionsRevision"
                                                            AssessmentId="@ActiveAssessmentId" />
                </div>
            </div>
            <section class="assets-tabs-shell">
                <div class="assets-tabs" role="tablist" aria-label="Assessment assumption sections">
                    <button type="button" role="tab"
                            aria-selected="@(ActiveTab == AssumptionTab.OpeningPosition)"
                            class="assets-tab @(ActiveTab == AssumptionTab.OpeningPosition ? "active" : null)"
                            @onclick="() => ActiveTab = AssumptionTab.OpeningPosition">
                        <i class="bi bi-bank"></i><span>Opening Position</span>
                    </button>
                    <button type="button" role="tab"
                            aria-selected="@(ActiveTab == AssumptionTab.SalesWorkingCapital)"
                            class="assets-tab @(ActiveTab == AssumptionTab.SalesWorkingCapital ? "active" : null)"
                            @onclick="() => ActiveTab = AssumptionTab.SalesWorkingCapital">
                        <i class="bi bi-graph-up-arrow"></i><span>Sales &amp; Working Capital</span>
                    </button>
                    <button type="button" role="tab"
                            aria-selected="@(ActiveTab == AssumptionTab.ExpensesVat)"
                            class="assets-tab @(ActiveTab == AssumptionTab.ExpensesVat ? "active" : null)"
                            @onclick="() => ActiveTab = AssumptionTab.ExpensesVat">
                        <i class="bi bi-receipt"></i><span>Expenses &amp; VAT</span>
                    </button>
                    <button type="button" role="tab"
                            aria-selected="@(ActiveTab == AssumptionTab.FundingAssets)"
                            class="assets-tab @(ActiveTab == AssumptionTab.FundingAssets ? "active" : null)"
                            @onclick="() => ActiveTab = AssumptionTab.FundingAssets">
                        <i class="bi bi-building"></i><span>Funding &amp; Assets</span>
                    </button>
                </div>

                <div class="assets-tab-content" role="tabpanel">
                    @switch (ActiveTab)
                    {
                        case AssumptionTab.OpeningPosition:
                            <section class="assumptions-section-heading">
                                <div>
                                    <span>Baseline facts</span>
                                    <h2>Opening financial position</h2>
                                    <p>Record the confirmed balances at the start of the assessment period.</p>
                                </div>
                            </section>
                            <div class="assumption-hover-card mb-3">
                                <OpeningBalancesComponent @ref="OpeningBalancesRef"
                                                          openingBalancesModel="@openingBalancesModel"
                                                          OnUpdate='(result) => RefreshAssumptionSource(result, "OPENING-BALANCES")' />
                            </div>
                            <div class="assumption-hover-card mb-3">
                                <AssumptionsGuidanceComponent Section="opening" />
                            </div>
                            break;

                        case AssumptionTab.SalesWorkingCapital:
                            <section class="assumptions-section-heading">
                                <div>
                                    <span>Operating assumptions</span>
                                    <h2>Sales, stock and working capital</h2>
                                    <p>Define revenue structure and the timing of customer and supplier cash movements.</p>
                                </div>
                            </section>

                            <div class="assumption-hover-card mb-3">
                                <SalesCategoryListComponent @ref="SalesCategoryListRef"
                                                            AssessmentId="@ActiveAssessmentId"
                                                            OnEditRequested='(id) => OpenConfigurationPanel("SALES-CATEGORY", id)' />
                            </div>

                            <div class="assumption-hover-card mb-3">
                                <DebtorsCreditorsComponent @ref="DebtorsCreditorsRef"
                                                           AssessmentId="@ActiveAssessmentId"
                                                           OnUpdate='(result) => RefreshAssumptionSource(result, "DEBTORS-CREDITORS")' />
                            </div>

                            <div class="assumption-hover-card mb-3">
                                <LightweightProjectionAssumptionsComponent AssessmentId="@ActiveAssessmentId"
                                                                           Section="sales"
                                                                           OnSaved="RefreshReadiness" />
                            </div>
                            break;

                        case AssumptionTab.ExpensesVat:
                            <section class="assumptions-section-heading">
                                <div>
                                    <span>Cost assumptions</span>
                                    <h2>Expenses, payroll and VAT</h2>
                                    <p>Confirm statutory settings and simple cost-escalation assumptions.</p>
                                </div>
                            </section>

                            <div class="assumption-hover-card mb-3">
                                <VATEditComponent @ref="VATEditRef"
                                                  vatUpdateModel="@vatUpdateModel"
                                                  OnUpdate='(result) => RefreshAssumptionSource(result, "VAT-UPDATE")' />
                            </div>

                            <div class="row g-3 mt-1">
                                <div class="col-lg-5">
                                    <div class="assumption-hover-card h-100">
                                        <DirectorWagesComponent @ref="DirectorWagesRef"
                                                                directorWagesModel="@directorWagesModel"
                                                                OnUpdate='(result) => RefreshAssumptionSource(result, "DIRECTOR-WAGES")' />
                                    </div>
                                </div>
                                <div class="col-lg-7">
                                    <div class="assumption-hover-card h-100">
                                        <LightweightProjectionAssumptionsComponent AssessmentId="@ActiveAssessmentId"
                                                                                   Section="expenses"
                                                                                   OnSaved="RefreshReadiness" />
                                    </div>
                                </div>
                            </div>
                            break;

                        case AssumptionTab.FundingAssets:
                            <section class="assumptions-section-heading">
                                <div>
                                    <span>Funding facts and policy</span>
                                    <h2>Loans, cash reserve and assets</h2>
                                    <p>Maintain contractual funding data and the minimum cash buffer used for readiness review.</p>
                                </div>
                            </section>

                            <div class="assumption-hover-card mb-3">
                                <AssessmentLoansListComponent @ref="AssessmentLoansListRef"
                                                              AssessmentId="@ActiveAssessmentId"
                                                              OnEditRequested='(id) => OpenConfigurationPanel("ASSESSMENT-LOANS", id)' />
                            </div>

                            <div class="row g-3 mt-1">
                                <div class="col-lg-7">
                                    <div class="assumption-hover-card h-100">
                                        <LightweightProjectionAssumptionsComponent AssessmentId="@ActiveAssessmentId"
                                                                                   Section="funding"
                                                                                   OnSaved="RefreshReadiness" />
                                    </div>
                                </div>
                                <div class="col-lg-5">
                                    <div class="assumption-hover-card h-100">
                                        <AssumptionsGuidanceComponent Section="assets"
                                                                      AssessmentId="@ActiveAssessmentId" />
                                    </div>
                                </div>
                            </div>
                            break;
                    }
                </div>
            </section>
        }
    </div>
</div>


<ZabOffCanvas @ref="OffCanvasControlRef" HeaderTitle="@ActivePanelTitle" dWidth="350">
    @if (ActiveFormType != null)
    {
        <DynamicComponent Type="@ActiveFormType" Parameters="@ActiveFormParameters" />
    }
</ZabOffCanvas>

<footer class="py-2 bg-light mt-3"><BFooter /></footer>

@code {
    private AssumptionTab ActiveTab { get; set; } = AssumptionTab.OpeningPosition;
    private int AssumptionsRevision { get; set; }

    private void RefreshReadiness() => AssumptionsRevision++;

    private async Task RefreshAssumptionSource(SaveResult result, string reference)
    {
        await RefreshComponentData(result, reference);
        if (result.Success)
            RefreshReadiness();
    }

    private enum AssumptionTab
    {
        OpeningPosition,
        SalesWorkingCapital,
        ExpensesVat,
        FundingAssets
    }
}