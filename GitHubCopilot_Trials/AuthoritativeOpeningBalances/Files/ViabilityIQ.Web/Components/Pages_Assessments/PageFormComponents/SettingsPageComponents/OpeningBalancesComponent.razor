@using ViabilityIQ.Application.Interfaces
@using ViabilityIQ.Shared.FinancialModels
@using ViabilityIQ.Infrastructure.Repositories
@using ViabilityIQ.Shared.DataModels
@inject IGenericDataRepository<AssessmentSalesCategory> CategoryRepository
@inject IGenericDataRepository<AssessmentAsset> AssetRepository
@inject IGenericDataRepository<AssessmentLoan> LoanRepository
@inject IGenericDataRepository<IncomeType> IncomeTypeRepository
@inject IAssetDepreciationEngine DepreciationEngine

@if (loadingStateActive)
{
    <FormLoadingComponent />
}
else
{
    <EditForm Model="@openingBalancesModel" OnValidSubmit="UpdateOpeningBalances">
        <DataAnnotationsValidator />
        <section class="ob-card">
            <header class="ob-header">
                <span class="ob-icon"><i class="bi bi-bank2"></i></span>
                <div>
                    <span>Opening position</span>
                    <h3>Opening Balances</h3>
                    <p>Calculated balances come from their detailed records; only independent balances remain editable.</p>
                </div>
            </header>
            <ValidationSummary class="ob-validation" />

            <div class="ob-section-title"><span>Calculated from detailed records</span><small>Read-only authoritative totals</small></div>
            <div class="ob-grid ob-readonly-grid">
                @ReadOnlyBalance("Opening stock", "Sum of active Sales Category opening stock.", OpeningStock, "bi-box-seam")
                @ReadOnlyBalance("Opening debtors", "Sum of active category debtor balances.", OpeningDebtors, "bi-person-up")
                @ReadOnlyBalance("Opening creditors", "Sum of active category creditor balances.", OpeningCreditors, "bi-person-down")
                @ReadOnlyBalance("Opening loan balance", "Sum of active assessment loan balances.", OpeningLoans, "bi-bank")
                @ReadOnlyBalance("Gross fixed assets", "Sum of registered asset opening costs.", OpeningGrossAssets, "bi-building")
                @ReadOnlyBalance("Accumulated depreciation", "Sum already accumulated before Month 1.", OpeningAccumulatedDepreciation, "bi-graph-down-arrow")
                @ReadOnlyBalance("Net fixed assets", "Gross assets less accumulated depreciation.", OpeningNetAssets, "bi-calculator")
                @ReadOnlyBalance("Projected depreciation", "12-month total calculated by the asset engine.", ProjectedDepreciation, "bi-calendar3")
            </div>

            <div class="ob-section-title"><span>Balances requiring confirmation</span><small>Enter from opening statements or reconciliations</small></div>
            <div class="ob-grid">
                @MoneyInput("Opening bank balance", "Use a negative value for an opening overdraft.", openingBalancesModel.OpeningBalance_Bank, value => openingBalancesModel.OpeningBalance_Bank = value, true)
                @PercentInput("Overdraft interest", "Annual interest rate applied while cash is negative.", openingBalancesModel.InterestOnOverDraft, value => openingBalancesModel.InterestOnOverDraft = value)
                @MoneyInput("Other current assets", "Prepayments, staff loans or receivables not captured as trade debtors.", openingBalancesModel.OpeningOtherCurrentAssets, value => openingBalancesModel.OpeningOtherCurrentAssets = value)
                @MoneyInput("Other current liabilities", "Accruals or short-term obligations not captured as trade creditors.", openingBalancesModel.OpeningOtherCurrentLiabilities, value => openingBalancesModel.OpeningOtherCurrentLiabilities = value)
                @MoneyInput("Opening VAT payable", "VAT already owed at the projection start; settled in Month 1.", openingBalancesModel.OpeningVatPayable, value => openingBalancesModel.OpeningVatPayable = value)
                @MoneyInput("Opening VAT refundable", "VAT refund already receivable; collected in Month 1.", openingBalancesModel.OpeningVatRefundable, value => openingBalancesModel.OpeningVatRefundable = value)
            </div>
            <footer class="ob-footer">
                <span><i class="bi bi-info-circle"></i> Opening equity is calculated automatically as assets less liabilities.</span>
                <button class="btn btn-success" type="submit" disabled="@IsSubmitting"><i class="bi bi-check2-circle"></i> Update Opening Balances</button>
            </footer>
        </section>
    </EditForm>
}

@code {
    [Inject] private MasterDataService? ViqCrudService { get; set; }
    [Parameter] public OpeningBalancesModel openingBalancesModel { get; set; } = new();
    [Parameter] public EventCallback<SaveResult> OnUpdate { get; set; }
    private SaveResult? result = new();
    private bool IsSubmitting;
    private bool loadingStateActive;
    private decimal OpeningStock, OpeningDebtors, OpeningCreditors, OpeningLoans;
    private decimal OpeningGrossAssets, OpeningAccumulatedDepreciation, ProjectedDepreciation;
    private decimal OpeningNetAssets => OpeningGrossAssets - OpeningAccumulatedDepreciation;

    protected override async Task OnParametersSetAsync() => await RefreshAsync();

    public async Task RefreshAsync()
    {
        loadingStateActive = true;
        try
        {
            var id = openingBalancesModel.AssessmentId;
            var categoriesTask = CategoryRepository.GetAllAsync(x => x.AssessmentId == id && x.Active);
            var assetsTask = AssetRepository.GetAllAsync(x => x.AssessmentId == id && x.Active);
            var loansTask = LoanRepository.GetAllAsync(x => x.AssessmentId == id && x.Active);
            var incomeTypesTask = IncomeTypeRepository.GetAllAsync();
            var depreciationTask = DepreciationEngine.CalculateAnnualDepreciationAsync(id);
            await Task.WhenAll(categoriesTask, assetsTask, loansTask, incomeTypesTask, depreciationTask);
            var categories = (await categoriesTask).ToArray();
            var assets = (await assetsTask).ToArray();
            var classifier = new IncomeTypeClassifier(await incomeTypesTask);
            OpeningStock = categories
                .Where(x => classifier.Classify(x) == IncomeSourceKind.Sales)
                .Sum(x => x.OpeningStock);
            OpeningDebtors = categories.Sum(x => x.OpeningDebtorsAmount);
            OpeningCreditors = categories.Sum(x => x.OpeningCreditorsAmount);
            OpeningLoans = (await loansTask).Sum(x => x.LoanBalanceAtAssessmentDate);
            OpeningGrossAssets = assets.Sum(x => x.OpeningBalanceValue);
            OpeningAccumulatedDepreciation = assets.Sum(x => x.OpeningAccumulatedDepreciation);
            ProjectedDepreciation = (await depreciationTask).Values.Sum();
        }
        finally { loadingStateActive = false; }
    }

    private RenderFragment ReadOnlyBalance(string label, string note, decimal value, string icon) => @<div class="ob-readonly">
        <i class="bi @icon"></i><div><span>@label</span><small>@note</small></div><strong>R @value.ToString("N2")</strong>
    </div>;

    private RenderFragment MoneyInput(string label, string note, decimal value, Action<decimal> setter, bool allowNegative = false) => @<label class="ob-field">
        <span>@label</span><small>@note</small><div class="ob-input"><span>R</span><input type="number" min="@(allowNegative ? null : "0")" step="0.01" value="@FormatDecimal(value)" @onchange="e => setter(ParseDecimal(e.Value, allowNegative))" /></div>
    </label>;

    private RenderFragment PercentInput(string label, string note, decimal value, Action<decimal> setter) => @<label class="ob-field">
        <span>@label</span><small>@note</small><div class="ob-input ob-suffix"><input type="number" min="0" step="0.01" value="@FormatDecimal(value)" @onchange="e => setter(ParseDecimal(e.Value))" /><span>%</span></div>
    </label>;

    private static string FormatDecimal(decimal value) => value.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
    private static decimal ParseDecimal(object? value, bool allowNegative = false) => decimal.TryParse(Convert.ToString(value), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var parsed) ? (allowNegative ? parsed : Math.Max(0m, parsed)) : 0m;

    private async Task UpdateOpeningBalances()
    {
        IsSubmitting = true;
        const string sql = @"UPDATE tblAssessments SET OpeningBalance_Bank=@OpeningBalance_Bank,
            InterestOnOverDraft=@InterestOnOverDraft, OpeningOtherCurrentAssets=@OpeningOtherCurrentAssets,
            OpeningOtherCurrentLiabilities=@OpeningOtherCurrentLiabilities, OpeningVatPayable=@OpeningVatPayable,
            OpeningVatRefundable=@OpeningVatRefundable WHERE AssessmentId=@AssessmentId";
        try
        {
            var rows = await ViqCrudService!.ExecuteCommandAsync(sql, openingBalancesModel);
            result = rows > 0 ? new SaveResult { Message = "Opening balances updated successfully", Success = true } : SaveResult.Failed("Opening balances were not updated.");
        }
        catch (Exception ex) { result = SaveResult.Failed($"Opening balances could not be updated: {ex.Message}"); }
        finally { IsSubmitting = false; if (OnUpdate.HasDelegate) await OnUpdate.InvokeAsync(result!); }
    }
}
