@namespace ViabilityIQ.Web.Components.Pages_Assessments.ProjectionComponents
@using ViabilityIQ.Shared.FinancialModels

<section class="cashflow-kpis" aria-label="Assessment key performance indicators">
    <div class="kpi-grid">
        @Card("Total Sales", Projection.Summary.Revenue, "bi-graph-up-arrow", "Sales revenue", "sales")
        @Card("Inventory Movement", InventoryMovement, "bi-boxes", InventoryMovementNote, InventoryMovement >= 0m ? "inventory-up" : "inventory-down")
        @Card("Operating Expenses", Projection.Summary.OperatingExpenses, "bi-wallet2", "Projected period", "expenses")
        @Card("Net VAT", Projection.Summary.VatPayable, "bi-receipt", VatNote, "vat")
        @Card("Gross Profit", Projection.Summary.GrossProfit, "bi-bar-chart-line", Margin(Projection.Summary.GrossProfit), "gross-profit")
        @Card("EBITDA", Projection.Summary.EBITDA, "bi-speedometer2", Margin(Projection.Summary.EBITDA), "ebitda")
        @Card("Profit Before Tax", Projection.Summary.ProfitBeforeTax, "bi-cash-coin", Margin(Projection.Summary.ProfitBeforeTax), Projection.Summary.ProfitBeforeTax >= 0m ? "profit" : "loss")
    </div>
</section>

@code {
    private decimal InventoryMovement =>
        Projection.Summary.ClosingStock - Projection.Summary.OpeningStock;

    private string InventoryMovementNote =>
        $"Opening R {Projection.Summary.OpeningStock:N0} · Closing R {Projection.Summary.ClosingStock:N0}";

    private string VatNote =>
        Projection.Summary.VatPayable >= 0m ? "Payable" : "Refund receivable";

    private string Margin(decimal value) =>
        Projection.Summary.Revenue == 0m
            ? "No sales base"
            : $"{value / Projection.Summary.Revenue * 100m:F1}% of sales";

    private static RenderFragment Card(
        string label,
        decimal value,
        string icon,
        string note,
        string accent) => builder =>
    {
        builder.OpenElement(0, "article");
        builder.AddAttribute(1, "class", $"kpi-card kpi-{accent}");
        builder.OpenElement(2, "div");
        builder.AddAttribute(3, "class", "kpi-heading");
        builder.OpenElement(4, "span");
        builder.AddAttribute(5, "class", "kpi-label");
        builder.AddContent(6, label);
        builder.CloseElement();
        builder.OpenElement(7, "span");
        builder.AddAttribute(8, "class", "kpi-icon");
        builder.OpenElement(9, "i");
        builder.AddAttribute(10, "class", $"bi {icon}");
        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();
        builder.OpenElement(11, "div");
        builder.AddAttribute(12, "class", "kpi-value");
        builder.AddContent(13, $"R {value:N0}");
        builder.CloseElement();
        builder.OpenElement(14, "div");
        builder.AddAttribute(15, "class", "kpi-note");
        builder.AddContent(16, note);
        builder.CloseElement();
        builder.CloseElement();
    };
}
