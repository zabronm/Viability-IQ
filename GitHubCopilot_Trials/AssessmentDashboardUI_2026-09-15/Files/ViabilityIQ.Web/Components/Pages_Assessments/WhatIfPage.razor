@page "/assessment/dashboards/{AssessmentId:long}"
@page "/assessment/dashboards/"

@layout MainLayout_Assessment

@using ViabilityIQ.Web.Components.CommonComponents
@using ViabilityIQ.Web.Components.Layout
@using ViabilityIQ.Web.Components.Pages_Assessments.ProjectionComponents

<div class="dashboard-workspace container-fluid p-0">
    <PageHeading_Assessment _pageTitle="What-If Analysis"
                            PageTitle="Dashboards &amp; Scenarios"
                            CurrentPage="PageType.Dashboards" />

    @if (IsLoading)
    {
        <div class="dashboard-state">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <span>Calculating the live assessment dashboard...</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger mt-2" role="alert">
            <strong>Dashboard calculation failed.</strong> @ErrorMessage
        </div>
    }
    else if (Projection is not null)
    {
        <section class="dashboard-alert @AlertClass" aria-live="polite">
            <i class="bi @AlertIcon"></i>
            <div>
                <strong>@AlertHeading</strong>
                <span>@AlertMessage</span>
            </div>
        </section>

        <main class="dashboard-content">
            <CashflowKPICardsComponent Projection="@Projection" />

            <section class="dashboard-visual-grid" aria-label="Assessment performance charts">
                <CashflowBusinessHealthIndexComponent Projection="@Projection" />
                <CashflowProfitLossTimelineComponent Projection="@Projection" />
            </section>

            <section class="dashboard-detail-grid" aria-label="Assessment financial summary">
                <CashflowSummaryDashboardComponent Projection="@Projection" />
                <CashflowBusinessIndicatorComponent Projection="@Projection" />
            </section>
        </main>
    }
</div>

<footer class="py-2 bg-light mt-3">
    <BFooter />
</footer>
