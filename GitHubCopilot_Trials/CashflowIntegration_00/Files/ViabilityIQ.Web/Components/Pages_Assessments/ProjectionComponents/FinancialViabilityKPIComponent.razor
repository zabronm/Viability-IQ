@namespace ViabilityIQ.Web.Components.Pages_Assessments.ProjectionComponents

<div class="financial-viability-kpi auth-card">
    <h5>Financial Viability Metrics</h5>
    <table class="table table-borderless">
        <tbody>
            <tr><td>Contribution margin ratio</td><td class="text-end">@Percent(Projection.Viability.ContributionMarginRatio)</td></tr>
            <tr><td>Break-even sales <small>(all operating expenses treated as fixed)</small></td><td class="text-end">@Money(Projection.Viability.BreakEvenSales)</td></tr>
            <tr><td>Margin of safety</td><td class="text-end">@Percent(Projection.Viability.MarginOfSafety)</td></tr>
            <tr><td>Interest cover (EBIT / interest)</td><td class="text-end">@Ratio(Projection.Viability.InterestCover)</td></tr>
            <tr><td>DSCR (EBITDA / loan cash payments)</td><td class="text-end">@Ratio(Projection.Viability.DebtServiceCoverageRatio)</td></tr>
            <tr><td>NPV (10% nominal annual / 12)</td><td class="text-end">@Projection.Viability.NetPresentValue.ToString("N0")</td></tr>
            <tr><td>PBT volatility</td><td class="text-end">@Percent(Projection.Viability.ProfitVolatility)</td></tr>
            <tr><td>Current ratio</td><td class="text-end">@Ratio(Projection.Viability.CurrentRatio)</td></tr>
            <tr><td>Payback</td><td class="text-end">Not available — no initial investment basis</td></tr>
        </tbody>
    </table>
</div>

@code {
    private static string Percent(decimal? value) => value.HasValue ? value.Value.ToString("P1") : "N/A";
    private static string Ratio(decimal? value) => value.HasValue ? $"{value.Value:F2}x" : "N/A";
    private static string Money(decimal? value) => value.HasValue ? value.Value.ToString("N0") : "N/A";
}
