@namespace ViabilityIQ.Web.Components.Pages_Assessments.ProjectionComponents

<div class="business-health-alerts-container">
    @foreach (var alert in Projection.Alerts)
    {
        <div class="alert @Css(alert.Severity) mb-2" role="alert" @key="alert.Code">
            <strong>@alert.Title</strong> — @alert.Message
        </div>
    }
</div>

@code {
    private static string Css(ViabilityIQ.Shared.FinancialModels.CashflowAlertSeverity severity) => severity switch
    {
        ViabilityIQ.Shared.FinancialModels.CashflowAlertSeverity.Critical => "alert-danger",
        ViabilityIQ.Shared.FinancialModels.CashflowAlertSeverity.Warning => "alert-warning",
        _ => "alert-success"
    };
}
