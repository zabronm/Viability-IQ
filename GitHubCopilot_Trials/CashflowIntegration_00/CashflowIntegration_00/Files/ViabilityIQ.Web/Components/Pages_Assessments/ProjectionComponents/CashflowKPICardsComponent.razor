@namespace ViabilityIQ.Web.Components.Pages_Assessments.ProjectionComponents

<div class="kpi-cards-container font-def">
    <div class="kpi-grid">
        @Card("TOTAL SALES", Projection.Summary.Revenue)
        @Card("OPENING STOCK", Projection.Summary.OpeningStock)
        @Card("CLOSING STOCK", Projection.Summary.ClosingStock)
        @Card("OPERATING EXPENSES", Projection.Summary.OperatingExpenses)
        @Card("VAT PAYABLE / (REFUND)", Projection.Summary.VatPayable)
        @Card("GROSS PROFIT", Projection.Summary.GrossProfit)
        @Card("EBITDA", Projection.Summary.EBITDA)
        @Card("PROFIT BEFORE TAX", Projection.Summary.ProfitBeforeTax)
    </div>
</div>

@code {
    private static Microsoft.AspNetCore.Components.RenderFragment Card(string label, decimal value) => builder =>
    {
        builder.OpenElement(0, "div"); builder.AddAttribute(1, "class", "kpi-card kpi-card-default");
        builder.OpenElement(2, "div"); builder.AddAttribute(3, "class", "kpi-content");
        builder.OpenElement(4, "div"); builder.AddAttribute(5, "class", "kpi-label"); builder.AddContent(6, label); builder.CloseElement();
        builder.OpenElement(7, "div"); builder.AddAttribute(8, "class", "kpi-value"); builder.AddContent(9, value.ToString("N0")); builder.CloseElement();
        builder.CloseElement(); builder.CloseElement();
    };
}
