@page "/settings/users"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using ViabilityIQ.Application.Dtos
@using ViabilityIQ.Web.Components.CommonComponents
@using ViabilityIQ.Web.Components.Pages.PageFormComponents
@using ViabilityIQ.Web.Services

<PageTitle>Tenant Users</PageTitle>

<div class="p-0">
    <PageHeading _pageTitle="Security Settings" CurrentPage="PageType.Settings" _pageHeading="Tenant Users" />

    <nav aria-label="breadcrumb" class="px-3 pt-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/settings/settings">Settings</a></li>
            <li class="breadcrumb-item active" aria-current="page">Users</li>
        </ol>
    </nav>

    <main class="tenant-security-page">
        @if (isLoading)
        {
            <div class="tenant-security-loading">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else if (snapshot is not null)
        {
            <section class="tenant-security-summary">
                <div>
                    <span class="tenant-security-eyebrow">ACTIVE TENANT</span>
                    <h2>@snapshot.TenantName</h2>
                    <p>Manage tenant membership, branch allocation, access status and roles.</p>
                </div>
                <div class="tenant-seat-card">
                    <span>Subscribed seats</span>
                    <strong>@snapshot.ActiveMemberCount / @snapshot.SeatQuantity</strong>
                </div>
                <button class="btn btn-primary" @onclick="() => OpenUserEditorAsync(0)">
                    <i class="bi bi-person-plus-fill me-2"></i>Add user
                </button>
            </section>

            <section class="tenant-security-card">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Branch</th>
                                <th>Roles</th>
                                <th>Status</th>
                                <th>Last sign-in</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var member in snapshot.Members)
                            {
                                <tr>
                                    <td>
                                        <strong>@member.FullName</strong>
                                        <div class="text-muted small">@member.Email</div>
                                        @if (member.MustChangePassword)
                                        {
                                            <span class="badge text-bg-warning mt-1">Password change required</span>
                                        }
                                    </td>
                                    <td>@member.BranchName</td>
                                    <td>
                                        @foreach (var role in member.RoleNames)
                                        {
                                            <span class="tenant-role-pill">@role</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @(member.MembershipStatus == "Active" ? "text-bg-success" : "text-bg-secondary")">
                                            @member.MembershipStatus
                                        </span>
                                    </td>
                                    <td>@(member.LastLoginAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "Never")</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary"
                                                disabled="@(!member.CanEditMembership)"
                                                title="@(member.CanEditMembership
                                                    ? member.IsOwner ? "Change your tenant branch" : "Edit membership"
                                                    : "Only the Tenant Owner can change the Owner branch.")"
                                                @onclick="() => OpenUserEditorAsync(member.MembershipId)">
                                            Edit
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    </main>
</div>

@code {
    [Inject] private ViabilityIQ.Application.Interfaces.ITenantUserManagementService UserManagementService { get; set; } = default!;
    [Inject] private OffCanvasStateService OffCanvasService { get; set; } = default!;
    [Inject] private ToastService Toast { get; set; } = default!;
    [Inject] private ViabilityIQ.Application.Interfaces.ISessionService SessionService { get; set; } = default!;
    [Inject] private ILogger<TenantUsersPage> Logger { get; set; } = default!;

    private TenantUserManagementSnapshot? snapshot;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            snapshot = await UserManagementService.GetSnapshotAsync();
        }
        catch (Exception exception)
        {
            snapshot = null;
            if (exception is not UnauthorizedAccessException)
                Logger.LogError(exception, "Tenant users could not be loaded.");
            Toast.ShowError(
                exception is UnauthorizedAccessException
                    ? exception.Message
                    : "Tenant users could not be loaded. Please retry.",
                SessionService.AppTitle);
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task OpenUserEditorAsync(long membershipId) =>
        OffCanvasService.ShowAsync(new CanvasRequest
        {
            Title = membershipId == 0 ? "Add Tenant User" : "Edit Tenant User",
            Width = 650,
            ComponentType = typeof(TenantUserFormComponent),
            Parameters = new Dictionary<string, object?>
            {
                [nameof(TenantUserFormComponent.MembershipId)] = membershipId
            },
            ResultCallback = ProcessResultAsync
        });

    private async Task ProcessResultAsync(SaveResult result)
    {
        if (result.Success)
        {
            Toast.ShowSuccess(result.Message, SessionService.AppTitle);
            await LoadAsync();
        }
        else
        {
            Toast.ShowError(result.Message, SessionService.AppTitle);
        }

        await InvokeAsync(StateHasChanged);
    }
}
