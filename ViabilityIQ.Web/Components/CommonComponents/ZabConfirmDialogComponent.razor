@if (IsVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg" style="border-radius: 10px; overflow: hidden;">
                <div class="modal-header py-2 d-flex align-items-center shadow-sm" style="background-color: #edf7fc;">
                    <h5 class="modal-title fs-6 fw-bold d-flex align-items-center mb-0">
                        <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>@Title
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => SelectChoice(false)"></button>
                </div>
                <div class="modal-body py-4">
                    <p class="mb-0 text-secondary">@Message</p>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-outline-secondary fw-bold btn-sm text-xs" @onclick="() => SelectChoice(false)">@CancelText</button>
                    <button type="button" class="btn btn-warning btn-sm fw-bold text-dark text-xs" @onclick="() => SelectChoice(true)">@ConfirmText</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool IsVisible { get; set; } = false;
    private string Title { get; set; } = "Confirm";
    private string Message { get; set; } = "Are you sure?";
    private string ConfirmText { get; set; } = "OK";
    private string CancelText { get; set; } = "Cancel";

    private TaskCompletionSource<bool>? _tsc;

    public Task<bool> ShowAsync(string title, string message, string confirmText = "OK", string cancelText = "Cancel")
    {
        Title = title;
        Message = message;
        ConfirmText = confirmText;
        CancelText = cancelText;

        IsVisible = true;
        StateHasChanged();

        _tsc = new TaskCompletionSource<bool>();
        return _tsc.Task;
    }

    private void SelectChoice(bool choice)
    {
        IsVisible = false;
        _tsc?.SetResult(choice);
    }
}