@using Microsoft.AspNetCore.Components

<div class="doc-workspace-full mt-1 p-2">

    <div class="doc-list-panel mt-1">
        <div class="table-toolbar mb-0 py-0 d-flex justify-content-between align-items-center">
            <!-- LEFT BUTTON -->
            <div>
                <button class="btn btn-primary d-flex align-items-center" @onclick="OpenRequestCanvas">
                    <i class="bi bi-plus-lg me-1"></i>
                    <span>@RequestButtonText</span>
                </button>
            </div>
            <!-- RIGHT BUTTON -->
            @if (CanProceed)
            {
                <div class="position-relative py-0 my-0">
                    <button disabled="@(!CanProceed)" class="btn btn-success d-flex align-items-center">
                    <span>
                        Proceed Next Phase
                    </span>
                    <i class="bi bi-arrow-right-circle-fill text-white fs-5 ms-2"></i>
                </button>
            </div>
            }
        </div>

        <div class="mt-3 mb-0" style="color:navy;font-weight:bold;">
            @PhaseName Documents Required<i class="bi bi-caret-down-fill"></i><i class="bi bi-caret-down-fill"></i>
        </div>

        <!----  TABLE STARTS HERE -->
        <table class="table-custom table-sm table-hover align-middle" style=" border: solid 1px #87AFC7; border-radius: 14px;">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Document</th>
                    <th>Status</th>
                    <th class="text-center">Action</th>
                    <th class="text-center">Download</th>
                    <th class="text-center">Delete</th>
                </tr>
            </thead>

            <tbody>
                @for (int i = 0; i < lstApplicationDocumentDto.Count; i++)
                {
                    var doc = lstApplicationDocumentDto[i];
                    <tr class="py-3">
                        <!-- ROW NUMBER -->

                        <td>
                            @(i + 1)
                        </td>
                        <!-- DOCUMENT NAME -->
                        <td>
                            @doc.DocumentName

                            @if (doc.IsSpecialRequest)
                            {
                                <span class="badge bg-warning text-dark ms-2">
                                    Special
                                </span>
                            }
                        </td>


                        <!-- STATUS -->
                        <td>
                            @if (doc.IsSubmitted)
                            {
                                <span class="text-success">
                                    <i class="bi bi-check-circle-fill me-0"></i>
                                    Submitted
                                </span>
                            }
                            else
                            {
                                <span class="text-danger">
                                    <i class="bi bi-exclamation-circle-fill me-0"></i>
                                    Missing
                                </span>
                            }
                        </td>


                        <!-- UPLOAD / PREVIEW -->
                        <td class="text-center">
                            @if (!doc.IsSubmitted)
                            {
                                <button title="Upload document" class="btn btn-sm btn-primary action-btn" @onclick="() => OpenUpload(doc)">
                                    <i class="bi bi-upload"></i>
                                </button>
                            }
                            else
                            {
                                <button title="View document" class="btn btn-sm btn-info action-btn" @onclick="() => ViewDocument(doc)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            }
                        </td>


                        <!-- DOWNLOAD -->
                        <td class="text-center">
                            @if (doc.IsSubmitted)
                            {
                                <button title="Download to local" class="btn btn-sm btn-success action-btn" @onclick="() => DownloadDocument(doc)">
                                    <i class="bi bi-download"></i>
                                </button>
                            }
                        </td>


                        <!-- DELETE -->

                        <td class="text-center">

                            @if (doc.IsSubmitted)
                            {
                                <button title="Delete this file" class="btn btn-sm btn-danger action-btn" @onclick="() => DeleteDocument(doc)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }

            </tbody>

        </table>

        <!---  TABLE ENDS HERE -->

        <div class="phase-gate-box mb-3 mt-2">
            <span class="text-muted fs-5">
                &nbsp;Submitted:
                @lstApplicationDocumentDto.Count(x => x.IsSubmitted)
                of
                @lstApplicationDocumentDto.Count
            </span>
            <div class="mt-0 ps-0 ms-0">
                @* @if (AllowAdditionalRequests)
                { *@
                    <button title="Add additional file" class="btn btn-warning ms-0"  @onclick="OpenAdditionalDocuments">
                        <span class="fw-bold">Additional Document</span> &nbsp;&nbsp;
                        <i class="bi bi-box-arrow-up-right text-black fw-bold"></i>
                    </button>
                @* } *@
            </div>
        </div>

    </div>

</div>


<ZabOffCanvas @ref="_offCanvas"
              dWidth="550px"
              Id="@offcanvas_name"
              Title="@PhaseName">

    @if (ActiveCanvasForm != null)
    {
        @ActiveCanvasForm
    } 
</ZabOffCanvas>


<style type="text/css">
    .icon-size {
        height: 20px;
        width: 40px;
    }

</style>
