@using System.Linq.Expressions
@using ViabilityIQ.Application.Interfaces
@using ViabilityIQ.Shared.SharedModels

@inject IDDLookupService LookupService

<div class="form-group lookup-dropdown-group">
    @*  <select class="form-select form-select-sm @FieldClass"
            value="@Value"
            @onchange="HandleChange"
            disabled="@(IsDisabled || _isLoading || Readonly)"> *@

    <select class="form-select form-select-sm @FieldClass @SelectedStyleClass"
            value="@Value"
            @onchange="HandleChange"
            disabled="@(IsDisabled || _isLoading || Readonly)">

        @if (_isLoading)
        {
            <option>Loading data...</option>
        }
        else
        {
            <option value="0">-- @Placeholder --</option>
            @foreach (var opt in _options)
            {
                <option value="@opt.Id">@opt.Description</option>
            }
        }
    </select>
</div>


@* Define custom styles scoped to this component *@
<style>
    .dd-normal {
        font-weight: 400 !important;
    }

    .dd-bold {
        font-weight: 700 !important;
    }

    .dd-light {
        font-weight: 300 !important;
    }
</style>




@code {
    private IEnumerable<LookupItem> _options = Array.Empty<LookupItem>();
    private bool _isLoading = true;
    private FieldIdentifier _fieldIdentifier;

    [CascadingParameter] private EditContext? EditContext { get; set; }

    [Parameter] public long Value { get; set; }
    [Parameter] public EventCallback<long> ValueChanged { get; set; }
    [Parameter] public Expression<Func<long>>? ValueExpression { get; set; }

    [Parameter] public DDLookupEnums SourceKey { get; set; }

    // Dynamic Filter Parameters
    [Parameter] public string? FilterField { get; set; }
    [Parameter] public object? FilterValue { get; set; }

    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Placeholder { get; set; } = "Select Option";
    [Parameter] public bool IsDisabled { get; set; } = false;
    [Parameter] public bool Readonly { get; set; } = false;
    [Parameter] public string StyleOption { get; set; } = "normal";

    private string SelectedStyleClass => StyleOption switch
    {
        "bold" => "dd-bold",
        "light" => "dd-light",
        _ => "dd-normal"
    };

    private string FieldClass => EditContext != null && ValueExpression != null &&
                                 EditContext.GetValidationMessages(_fieldIdentifier).Any()
                                 ? "is-invalid" : "";

    protected override void OnParametersSet()
    {
        if (EditContext != null && ValueExpression != null)
        {
            _fieldIdentifier = FieldIdentifier.Create(ValueExpression);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        // Pass field name and value to the service
        _options = await LookupService.GetLookupOptionsAsync(SourceKey, FilterField, FilterValue);
        _isLoading = false;
    }

    private async Task HandleChange(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out long result))
        {
            await ValueChanged.InvokeAsync(result);

            if (EditContext != null && ValueExpression != null)
            {
                EditContext.NotifyFieldChanged(_fieldIdentifier);
            }
        }
    }
}