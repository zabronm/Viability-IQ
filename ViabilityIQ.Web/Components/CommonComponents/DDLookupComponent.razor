@using Microsoft.AspNetCore.Components.Forms
@using ViabilityIQ.Application.Interfaces
@using ViabilityIQ.Shared.SharedModels
@inherits InputBase<long>

@inject IDDLookupService LookupService

<div class="form-group lookup-dropdown-group">
    <select id="@InputId"
            class="form-select form-select-sm @CssClass @SelectedStyleClass"
            value="@CurrentValueAsString"
            @onchange="HandleChange"
            disabled="@(IsDisabled || _isLoading || Readonly)">

        @if (_isLoading)
        {
            <option>Loading data...</option>
        }
        else
        {
            <option value="0">-- @Placeholder --</option>
            @foreach (var opt in _options)
            {
                <option value="@opt.Id">@opt.Description</option>
            }
        }
    </select>
</div>


@* Define custom styles scoped to this component *@
<style>
    .dd-normal {
        font-weight: 400 !important;
    }

    .dd-bold {
        font-weight: 700 !important;
    }

    .dd-light {
        font-weight: 300 !important;
    }
</style>




@code {
    private IReadOnlyList<LookupItem> _options = [];
    private bool _isLoading = true;
    private bool _hasLoaded;
    private DDLookupEnums _loadedSourceKey;
    private string? _loadedFilterField;
    private object? _loadedFilterValue;
    private readonly string _generatedInputId = $"ddlookup-{Guid.NewGuid():N}";

    [Parameter] public DDLookupEnums SourceKey { get; set; }

    // Dynamic Filter Parameters
    [Parameter] public string? FilterField { get; set; }
    [Parameter] public object? FilterValue { get; set; }

    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Placeholder { get; set; } = "Select Option";
    [Parameter] public bool IsDisabled { get; set; } = false;
    [Parameter] public bool Readonly { get; set; } = false;
    [Parameter] public string StyleOption { get; set; } = "normal";
    [Parameter] public string? Id { get; set; }

    private string InputId => string.IsNullOrWhiteSpace(Id) ? _generatedInputId : Id;
    private string SelectedStyleClass => StyleOption switch
    {
        "bold" => "dd-bold",
        "light" => "dd-light",
        _ => "dd-normal"
    };

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (_hasLoaded
            && _loadedSourceKey == SourceKey
            && string.Equals(
                _loadedFilterField,
                FilterField,
                StringComparison.Ordinal)
            && Equals(_loadedFilterValue, FilterValue))
        {
            return;
        }

        _isLoading = true;
        try
        {
            _options = (await LookupService.GetLookupOptionsAsync(
                SourceKey,
                FilterField,
                FilterValue)).ToArray();
            _loadedSourceKey = SourceKey;
            _loadedFilterField = FilterField;
            _loadedFilterValue = FilterValue;
            _hasLoaded = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void HandleChange(ChangeEventArgs e)
    {
        CurrentValueAsString = e.Value?.ToString();
    }

    protected override bool TryParseValueFromString(
        string? value,
        out long result,
        out string? validationErrorMessage)
    {
        if (long.TryParse(value, out result))
        {
            validationErrorMessage = null;
            return true;
        }

        result = 0;
        validationErrorMessage = $"The {FieldIdentifier.FieldName} field is invalid.";
        return false;
    }
}