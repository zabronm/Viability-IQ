@using ViabilityIQ.Web.Components.Shared
@inherits LayoutComponentBase


<div class="fa-layout-wrapper">
    @* <TopBarComponent isAssessmentPage=false /> *@

    <header class="fa-top-bar">
        <div class="fa-brand-zone">
            <span class="brand-main fs-2">Viability</span><span class="brand-iq  fs-2 fst-italic">.IQ</span>
        </div>

        <div class="ms-5 me-0">
            @* <button class="fa-toggle-sidebar-btn pe-0" @onclick="ToggleSidebar">
                <span class="nav-icon-avatar-round"><i class="bi bi-list"></i></span>
            </button> *@
            <button class="fa-toggle-sidebar-btn pe-0 me-0" @onclick="ToggleSidebar">
                <span class="nav-icon-avatar-round"><i class="bi bi-list"></i></span>
            </button>
        </div>

        @if (isAssessmentPage)
        {
            @* <div class="ms-0 dropdown-container">
                <button class="btn-quick-access" @onclick="ToggleQuickAccess" @onfocusout="CloseQuickAccess">
                    <i class="bi bi-ui-radios-grid p-0"></i>
                </button>

                <div class="dropdown-card-menu g-2 @(isQuickAccessOpen ? "show" : "")">
                    <div class="dropdown-card-header">Navigation Shortcuts</div>
                    <div class="quick-access-grid">
                        <a class="quick-grid-item" style="border-radius: 14px;" href="global/quick1">
                            <div class="grid-icon-wrapper"><i class="bi bi-speedometer2"></i></div>
                            <span class="strong">Loans</span>
                        </a>
                        <a class="quick-grid-item " style="border-radius: 14px;" href="global/quick2">
                            <div class="grid-icon-wrapper"><i class="bi bi-file-earmark-text text-secondary"></i></div>
                            <span class="strong">Debtors</span>
                        </a>
                        <a class="quick-grid-item " style="border-radius: 14px;" href="global/quick3">
                            <div class="grid-icon-wrapper"><i class="bi bi-graph-up-arrow"></i></div>
                            <span class="strong">CapEx</span>
                        </a>
                        <a class="quick-grid-item " style="border-radius: 14px;" href="global/quick4">
                            <div class="grid-icon-wrapper"><i class="bi bi-database-check"></i></div>
                            <span class="strong">Creditors</span>
                        </a>
                    </div>
                </div>
            </div> *@
            @* <QuickAccessComponent /> *@
        }

        <div class="fa-top-bar-right">
            <span class="marble-date-badge">
                <i class="bi bi-calendar3 me-1"></i> @DateTime.Now.ToString("dd MMMM yyyy")
            </span>

            <button class="action-icon-btn">
                <i class="bi bi-bell"></i>
                <span class="notification-indicator"></span>
            </button>

            <div class="dropdown-container">
                <button class="avatar-trigger-btn" @onclick="ToggleProfileMenu" @onfocusout="CloseProfileMenu">
                    <div class="avatar-circle">ZM</div>
                </button>
                <div class="profile-card-dropdown @(isProfileOpen ? "show" : "")">
                    <div class="profile-card-header">
                        <div class="profile-avatar-large">ZM</div>
                        <div class="profile-info">
                            <h4 class="profile-name">Zabron Muyambo</h4>
                            <span class="profile-role">Lead Systems Developer</span>
                        </div>
                    </div>
                    <div class="profile-card-body">
                        <div class="profile-section-title">Account Management</div>
                        <a class="profile-menu-item" href="profile/details">
                            <i class="bi bi-person-bounding-box"></i> My Profile
                        </a>
                        <a class="profile-menu-item" href="profile/settings">
                            <i class="bi bi-sliders"></i> Preferences
                        </a>

                        <div class="profile-section-title">Systems & Auditing</div>
                        <a class="profile-menu-item" href="global/audit-logs">
                            <i class="bi bi-shield-check"></i> Project Audit Status
                        </a>

                        <div class="dropdown-divider"></div>
                        <a class="profile-menu-item logout-item" href="logout">
                            <i class="bi bi-box-arrow-right"></i> Sign Out
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="fa-workspace-container">
        <aside class="fa-sidebar @(isSidebarCollapsed ? "collapsed" : "")">
            <div class="sidebar-scroller">

                <NavLink class="fa-nav-item" href="/home" Match="NavLinkMatch.All">
                    <div class="nav-icon-avatar-round"><i class="bi bi-grid"></i></div>
                    <span class="strong">Dashboards | Home</span>
                </NavLink>

                <div class="fa-nav-heading">Main Operations</div>

                <NavLink class="fa-nav-item" href="/settings/assessments">
                    <div class="nav-icon-avatar-round"><i class="bi bi-stack"></i></div>
                    <span class="strong">My Assessments</span>
                </NavLink>

                <NavLink class="fa-nav-item" href="/settings/businesses">
                    <div class="nav-icon-avatar-round"><i class="bi bi-buildings"></i></div>
                    <span class="strong">Businesses</span>
                </NavLink>

                <NavLink class="fa-nav-item" href="/settings/client-contacts">
                    <div class="nav-icon-avatar-round"><i class="bi bi-people"></i></div>
                    <span class="strong">Client Contacts</span>
                </NavLink>

                <NavLink class="fa-nav-item" href="/notifications">
                    <div class="nav-icon-avatar-round"><i class="bi bi-bell-fill"></i></div>
                    <span class="strong">Communication</span>
                </NavLink>


                <NavLink class="fa-nav-item" href="/reports">
                    <div class="nav-icon-avatar-round"><i class="bi bi-clipboard2-data"></i></div>
                    <span class="strong">Reports</span>
                </NavLink>

                <div class="fa-nav-heading">System Config</div>

                <NavLink class="fa-nav-item " href="/settings">
                    <div class="nav-icon-avatar-round"><i class="bi bi-gear"></i></div>
                    <span class="strong">Settings</span>&nbsp;<i class="bi bi-caret-right-fill"></i>
                </NavLink>

                @* <button class="fa-nav-item fa-composite-trigger @(isSetupOpen ? "open" : "")" @onclick="ToggleSetupMenu">
                    <div class="d-flex align-items-center">
                        <div class="nav-icon-avatar-round"><i class="bi bi-gear"></i></div>
                        <span>Setup Configuration</span>
                    </div>
                    <i class="bi bi-chevron-right chevron"></i>
                </button>

                @if (isSetupOpen)
                {
                    <ul class="fa-sub-menu">
                        @for (int i = 1; i <= 5; i++)
                        {
                            var index = i;
                            <li>
                                <NavLink class="fa-sub-link" href="@($"global/setup/item{index}")">
                                    <i class="bi bi-circle-fill"></i><span>Global Option @index</span>
                                </NavLink>
                            </li>
                        }
                    </ul>
                } *@
            </div>

            <div class="sidebar-footer-static">
                <NavLink class="fa-nav-item footer-item border-top-thick" href="global/support">
                    <div class="nav-icon-avatar-round"><i class="bi bi-question-circle-fill"></i></div>
                    <div class="footer-text-stack">
                        <span class="footer-main-text">Get Help</span>
                        <span class="footer-sub-text small">Log support ticket</span>
                    </div>
                </NavLink>

                <NavLink class="fa-nav-item footer-item border-top-thick" href="global/suggestions">
                    <div class="nav-icon-avatar-round"><i class="bi bi-person-raised-hand"></i></div>
                    <div class="footer-text-stack">
                        <span class="footer-main-text">Send Suggestion</span>
                    </div>
                </NavLink>
            </div>
        </aside>

        <main class="fa-main-content-surface @(isSidebarCollapsed ? "expanded" : "")">
            <div class="content-body-padding">
                @Body
            </div>
        </main>
    </div>
</div>


@code {
    private bool isAssessmentPage = false;
    private bool isSidebarCollapsed = false;
    private bool isSetupOpen = false;
    private bool isQuickAccessOpen = false;
    private bool isProfileOpen = false;

    private void ToggleSidebar() => isSidebarCollapsed = !isSidebarCollapsed;
    private void ToggleSetupMenu() => isSetupOpen = !isSetupOpen;

    private void ToggleQuickAccess() => isQuickAccessOpen = !isQuickAccessOpen;
    private void ToggleProfileMenu() => isProfileOpen = !isProfileOpen;

    private async Task CloseQuickAccess()
    {
        await Task.Delay(150);
        isQuickAccessOpen = false;
    }

    private async Task CloseProfileMenu()
    {
        await Task.Delay(150);
        isProfileOpen = false;
    }
}
<ToastComponent />