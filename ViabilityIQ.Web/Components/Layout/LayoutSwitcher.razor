{
    private string currentLayout = "global";

    [Parameter]
    public EventCallback<string> LayoutChanged { get; set; }

    private async Task SetLayout(string layout)
    {
        currentLayout = layout;
        await LayoutChanged.InvokeAsync(layout);
    }
