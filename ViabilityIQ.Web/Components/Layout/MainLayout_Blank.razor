@inherits LayoutComponentBase

<div class="body-bkg">

    <div class="body-content">

        @Body

    </div>

</div>

<style type="text/css">

    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
    }

    .body-bkg {
        position: relative;
        width: 100vw;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background-image: url('images/neumorphic.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }


        /* OVERLAY */

        .body-bkg::before {
            content: '';
            position: absolute;
            inset: 0;
            background:  rgba(10, 24, 51, 0.05);
            backdrop-filter: blur(1px);
            z-index: 1;
        }


    /* CONTENT */

    .body-content {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
    }

</style>