@using ViabilityIQ.Web.Components.Shared
@using ViabilityIQ.Application.Interfaces
@inherits LayoutComponentBase
@implements IDisposable

@inject ISessionService SessionService

<div class="fa-layout-wrapper">

    <header class="fa-top-bar">
        <div class="fa-brand-zone">
            <span class="brand-main fs-2">Viability</span><span class="brand-iq fs-2 fst-italic">.IQ</span>
        </div>
        <div class="d-flex align-items-center gap-2 ms-2 me-0">
            <button class="fa-toggle-sidebar-btn pe-0 me-0" @onclick="ToggleSidebar">
                <span class="nav-icon-avatar-round"><i class="bi bi-list"></i></span>
            </button>

            <div class="ms-0 dropdown-container">
                <button class="fa-toggle-sidebar-btn" @onclick="ToggleShortcutsMenu" @onfocusout="CloseShortcutsMenu">
                    <span class="nav-icon-avatar-round">
                        <i class="bi bi-menu-down"></i>
                    </span>
                </button>
                <div class="viq-elevated-card profile-card-dropdown shortcut-menu-dropdown @(isShortcutsOpen ? "show" : "")" style="border: solid 0.4px #778899">
                    <div class="p-0 ">
                        <QuickAccessComponent />
                    </div>
                </div>
            </div>
        </div>

        <div class="fa-top-bar-right">
            <span class="marble-date-badge">
                <i class="bi bi-calendar3 me-1"></i> @DateTime.Now.ToString("dd MMMM yyyy")
            </span>

            <button class="action-icon-btn">
                <i class="bi bi-bell"></i>
                <span class="notification-indicator"></span>
            </button>

            <div class="dropdown-container">
                <button class="avatar-trigger-btn" @onclick="ToggleProfileMenu" @onfocusout="CloseProfileMenu">
                    <div class="avatar-circle">ZM</div>
                </button>
                <div class="profile-card-dropdown @(isProfileOpen ? "show" : "")">
                    <div class="profile-card-header">
                        <div class="profile-avatar-large">ZM</div>
                        <div class="profile-info">
                            <h4 class="profile-name">Zabron Muyambo</h4>
                            <span class="profile-role">Lead Developer</span>
                        </div>
                    </div>
                    <div class="profile-card-body">
                        <a href="profile" class="profile-dropdown-item">
                            <i class="bi bi-person me-2"></i> My Profile
                        </a>
                        <a href="settings" class="profile-dropdown-item">
                            <i class="bi bi-gear me-2"></i> Account Settings
                        </a>
                        <div class="dropdown-divider"></div>
                        <a href="logout" class="profile-dropdown-item text-danger">
                            <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="fa-workspace-container">
        <aside class="fa-sidebar @(isSidebarCollapsed ? "collapsed" : "")">
            <div class="sidebar-scroller">

                <NavLink class="fa-nav-item mt-1 py-1 mb-0 home-nav-link" href="home" Match="NavLinkMatch.All">
                    <div class="nav-icon-avatar-round"><i class="bi bi-house-door-fill"></i></div>
                    <span class="footer-main-text-sm">Home</span>
                </NavLink>
                @* <hr class="border-secondary my-0" /> *@

                <NavLink class="fa-nav-item py-1 my-0" href="assessment/dashboards" Match="NavLinkMatch.All">
                    <div class="nav-icon-avatar-round"><i class="bi bi-speedometer2"></i></div>
                    <span class="footer-main-text-sm">Dashboard</span>
                </NavLink>

                <div class="fa-nav-heading" style="border-top: dotted 0.6px #92c7c7; border-bottom: dotted 0.6px #92c7c7;">Main Operations</div>

                <NavLink class="fa-nav-item py-1 my-0" href="assessment/sales">
                    <div class="nav-icon-avatar-round"><i class="bi bi-graph-up-arrow"></i></div>
                    <span class="footer-main-text-sm">Sales/Income</span>
                    <span class="ms-1 viq-indicator-dot @(HasSalesData ? "status-success" : "status-warning")"
                          title="@(HasSalesData ? "Sales data entry verified" : "No Sales records populated yet")"></span>
                </NavLink>

                @if (HasDebtorsCreditorsData)               //Shows when NOT Cash business
                {
                    <NavLink class="fa-nav-item py-1 my-0" href="assessment/debtors-creditors">
                        <div class="nav-icon-avatar-round"><i class="bi bi-incognito"></i></div>
                        <span class="footer-main-text-sm">Debtors/Creditors</span>
                        <span class="ms-1 viq-indicator-dot @(HasDebtorsCreditorsData ? "status-success" : "status-warning")"
                        title="@(HasSalesData ? "Debtors/Creditors data verified" : "No Debtors/Creditors data populated yet")"></span>
                    </NavLink>
                }

                <NavLink class="fa-nav-item py-1 my-0" href="assessment/stock">
                    <div class="nav-icon-avatar-round"><i class="bi bi-boxes"></i></div>
                    <span class="footer-main-text-sm">Stock</span>
                    <span class="ms-1 viq-indicator-dot @(HasStockData ? "status-success" : "status-warning")"
                          title="@(HasStockData ? "Client data entry verified" : "No client records populated yet")"></span>
                </NavLink>

                <NavLink class="fa-nav-item py-1 my-0" href="assessment/expenses">
                    <div class="nav-icon-avatar-round"><i class="bi bi-wallet2"></i></div>
                    <span class="footer-main-text-sm">Expenses</span>
                    <span class="ms-1 viq-indicator-dot @(HasExpensesData ? "status-success" : "status-warning")"
                          title="@(HasExpensesData ? "Client data entry verified" : "No client records populated yet")"></span>
                </NavLink>

               @*  @if (HasLoansData)              //Shows when Loans are available
                { *@
                    <NavLink class="fa-nav-item py-1 my-0" href="assessment/loan-repayments">
                        <div class="nav-icon-avatar-round"><i class="bi bi-umbrella-fill"></i></div>
                    <span class="footer-main-text-sm">Loan Repayments</span>
                        <span class="ms-1 viq-indicator-dot @(HasLoansData ? "status-success" : "status-warning")"
                        title="@(HasExpensesData ? "Loans data entry verified" : "No Loans records populated yet")"></span>
                    </NavLink>
                @* } *@

                <NavLink class="fa-nav-item py-1" href="assessment/VAT">
                    <div class="nav-icon-avatar-round"><i class="bi bi-bug"></i></div>
                    <span class="footer-main-text-sm">Value Added Tax(VAT)</span>
                </NavLink>

                <NavLink class="fa-nav-item py-1 my-0" href="assessment/reports">
                    <div class="nav-icon-avatar-round"><i class="bi bi-clipboard2-data"></i></div>
                    <span class="footer-main-text-sm">Reports</span>
                    @* <span class="ms-1 viq-indicator-dot @(HasReportsData ? "status-success" : "status-warning")"
                          title="@(HasReportsData ? "Client report generation verified" : "Reports ungenerated")"></span> *@
                </NavLink>

                @* <div class="fa-nav-heading" style="border-top: solid 0.6px #bcbcbc; border-bottom: solid 0.6px #bcbcbc;">Assessment Config</div> *@

                <NavLink class="fa-nav-item" href="assessment/settings">
                    <div class="nav-icon-avatar-round"><i class="bi bi-gear"></i></div>
                    <span class="footer-main-text">Setup</span>&nbsp;<i class="bi bi-caret-right-fill"></i>
                </NavLink>
            </div>

            <div class="sidebar-footer-static mb-1">
                <div class="dropdown-container w-100 ms-1">
                    <button class="fa-nav-item footer-item border-0 w-100 bg-transparent text-start d-flex align-items-center" @onclick="ToggleSetupMenu" @onfocusout="CloseSetupMenu">

                        <div class="nav-icon-avatar-round me-0 pe-0">
                            <i class="bi bi-folder-symlink ms-1"></i>
                        </div>

                        <div class="footer-text-stack ms-0 ps-0">
                            <span class="footer-main-text">Switch Assessment</span>
                            <span class="footer-sub-text text-truncate">Case: @(string.IsNullOrEmpty(SessionService.CaseNumber) ? "None Loaded" : SessionService.CaseNumber)</span>
                        </div>

                        <i class="bi bi-chevron-up ms-2 chevron-rotate @(isSetupOpen ? "rotated" : "")"></i>
                    </button>

                    <div class="setup-submenu-dropdown @(isSetupOpen ? "show" : "")">
                        <a href="global/assessments" class="setup-dropdown-item">
                            <i class="bi bi-list-columns-reverse"></i>&nbsp; All Assessments
                        </a>
                        <a href="global/clients" class="setup-dropdown-item">
                            <i class="bi bi-people"></i>&nbsp; Client Manager
                        </a>
                    </div>
                </div>

                <NavLink class="fa-nav-item footer-item border-top-thick" href="global/suggestions">
                    <div class="nav-icon-avatar-round"><i class="bi bi-person-raised-hand"></i></div>
                    <div class="footer-text-stack">
                        <span class="footer-main-text">Send Suggestion</span>
                    </div>
                </NavLink>
            </div>
        </aside>

        <main class="fa-main-content-surface @(isSidebarCollapsed ? "expanded" : "")">
            <div class="content-body-padding">
                @Body
            </div>
        </main>
    </div>

    <ZabOffCanvasHost />                        <!--THIS IS THE NEW HOST FOR offCanvas component -->
</div>

<ToastComponent />

@code {   

    private bool isSidebarCollapsed = false;
    private bool isSetupOpen = false;
    private bool isProfileOpen = false;
    private bool isShortcutsOpen = false;

    private bool HasDebtorsCreditorsData => SessionService.HasDebtorsCreditorsData;
    private bool HasLoansData => SessionService!.HasLoansData;
    private bool HasSalesData => SessionService!.HasSalesEntries;
    private bool HasStockData => SessionService!.HasStockEntries;
    private bool HasExpensesData => SessionService!.HasExpensesEntries;
    private bool HasReportsData => SessionService!.HasReportsGenerated;

    protected override void OnInitialized()
    {
        SessionService!.OnSessionChanged += SynchronizeComponentViewLayout;
    }

    private void ToggleSidebar() => isSidebarCollapsed = !isSidebarCollapsed;
    private void ToggleSetupMenu() => isSetupOpen = !isSetupOpen;
    private void ToggleProfileMenu() => isProfileOpen = !isProfileOpen;
    private void ToggleShortcutsMenu() => isShortcutsOpen = !isShortcutsOpen;
    private void CloseSetupMenu() => isSetupOpen = false;

    private async Task CloseProfileMenu()
    {
        await Task.Delay(150);
        isProfileOpen = false;
    }

    private async Task CloseShortcutsMenu()
    {
        await Task.Delay(150);
        isShortcutsOpen = false;
    }

    private void SynchronizeComponentViewLayout()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SessionService.OnSessionChanged -= SynchronizeComponentViewLayout;
    }

}