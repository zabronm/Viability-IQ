<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/style.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" >

    <link rel="stylesheet" href="/css/viability-iq.css" />
    <link rel="stylesheet" href="/css/styles_m.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="ViabilityIQ.Web.styles.css" />
    <link rel="stylesheet" href="/css/AssessmentSettings.css" />
    <link rel="stylesheet" href="/css/assessment-page-tools.css" />
    <link rel="stylesheet" href="/css/data-entry-forms.css" />
    <link rel="stylesheet" href="/css/website.css" />  
    <link rel="stylesheet" href="/css/public-website.css" />
    <link rel="stylesheet" href="/css/brand-website.css" />
    <!-- SVG Favicon (modern browsers) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any"> 

    <!-- PNG Favicon (fallback, 32x32) -->
    <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32">

    <!-- Apple Touch Icon (iOS) -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">

    <!-- Web App Manifest (PWA) -->
    <link rel="manifest" href="/site.webmanifest">
        
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <ApplicationShell @rendermode="new InteractiveServerRenderMode(prerender: false)" />

    <div id="components-reconnect-modal" class="components-reconnect-hide" role="status">
        <div class="viq-reconnect-card">
            <div class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></div>
            <span class="components-reconnect-show">Reconnecting to Viability.IQ...</span>
            <span class="components-reconnect-failed">
                Connection could not be restored.
                <button type="button" class="btn btn-sm btn-primary ms-2" onclick="location.reload()">Reload</button>
            </span>
            <span class="components-reconnect-rejected">
                This session is no longer available.
                <button type="button" class="btn btn-sm btn-primary ms-2" onclick="location.reload()">Start a new session</button>
            </span>
        </div>
    </div>
    

    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/scripts.js"></script>
    <script src="/scripts/viqscript.js"></script>
    <script src="/js/viqcharts.js"></script>
    <script src="js/zabOffCanvas.js"></script>
    <script src="/js/session-lifecycle.js"></script>
    <script src="scripts/assessmentAssetDetailsCharts.js"></script>
    <script src="scripts/assessmentPagePrint.js"></script>
    <script src="scripts/reportOutput.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.8.0/Chart.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>
    <script src="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/umd/simple-datatables.min.js" crossorigin="anonymous"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
