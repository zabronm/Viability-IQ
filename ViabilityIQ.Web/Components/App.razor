@using Microsoft.AspNetCore.Components.Authorization
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/style.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <link rel="stylesheet" href="/css/viability-iq.css" />
    <link rel="stylesheet" href="/css/styles_m.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="ViabilityIQ.Web.styles.css" />
    <link rel="stylesheet" href="/css/AssessmentSettings.css" />

    <!-- SVG Favicon (modern browsers) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any"> 

    <!-- PNG Favicon (fallback, 32x32) -->
    <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32">

    <!-- Apple Touch Icon (iOS) -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">

    <!-- Web App Manifest (PWA) -->
    <link rel="manifest" href="/site.webmanifest">
        
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
        <!-- CRITICAL: CascadingAuthenticationState wrapper for authentication to work -->
    <CascadingAuthenticationState>
        <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)"  />
    </CascadingAuthenticationState>
    

    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/scripts.js"></script>
    <script src="/scripts/viqscript.js"></script>
    <script src="/js/viqcharts.js"></script>
    <script src="js/zabOffCanvas.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.8.0/Chart.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>
    <script src="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/umd/simple-datatables.min.js" crossorigin="anonymous"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
