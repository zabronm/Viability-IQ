@page "/applications"

@using BrucolWeb.Application.DTOs.Applications
@using BrucolWeb.Application.Services
@using BrucolWeb.Web.Components.Common
@inject NavigationManager Nav
@inject LoanApplicationService LoanApplicationService
@inject IToastService _Toast

@if (isLoading)
{
    <LoadingComponent />
}
else
{
    <PageHeading _pageTitle="Loan Applications" _pageHeading="Loan Applications" />

    <main class="mt-3 shadow-sm p-3 soft-card rounded-5 mb-2" style="border-radius: 30px;">
        <div>
            <ZabDataTableAdvanced TItem="LoanApplicationListDTO"
                                  Items="@LoanApplicationsList"
                                  Columns="@TableColumns"
                                  OnEdit="EditApplication"
                                  OnDelete="DeleteApplication"
                                  OnAdd="CreateApplication"
                                  ShowDelete="false"
                                  GetRowId="x => x.ApplicationId"
                                  EditUrl="@(x => $"/application/{x.ApplicationId}")"
                                  OnRowClick="OpenApplication" />
        </div>
    </main>

    <div class="mt-10" style="margin-top:50px;">
        <BFooter />
    </div>

}


<!-- 🔹 Offcanvas goes HERE (bottom of page) -->
<ZabOffCanvas @ref="offcanvas"
              Id="farmPanel"
              Title="@offcanvasTitle">

    @* <CropDetails Model="_model" OnSave="SaveCrop" /> *@

    <div style="position: relative;">

        @if (isSaving)
        {
            <div class="loading-overlay">
                <div class="spinner-border text-primary"></div>
            </div>
        }
        @if (_model != null)
        {
            <EditForm Model="_model" OnValidSubmit="HandleSubmit">

                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">Loan type</label>
                    <div class="col-8">
                        <ZabDropDownFilter TValue="long" LookupType="LoanTypes" @bind-Value="_model.LoanTypeId" />
                    </div>
                </div>
                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">Client</label>
                    <div class="col-8">
                        <ZabDropDownFilter TValue="long" LookupType="Farmers" @bind-Value="_model.FarmerId" />
                    </div>
                </div>

                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">Farm</label>
                    <div class="col-8">
                        <ZabDropDownFilter TValue="long" LookupType="Farms" @bind-Value="_model.FarmId" />
                    </div>
                </div>

                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">Date</label>
                    <div class="col-8">
                        <InputDate class="form-control" @bind-Value="_model.ApplicationDate" />
                    </div>
                </div>
                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">Bank</label>
                    <div class="col-8">
                        <ZabDropDownFilter TValue="long" LookupType="Banks" @bind-Value="_model.BankId" />
                    </div>
                </div>

                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">Season</label>
                    <div class="col-8">
                        <ZabDropDownFilter TValue="long" LookupType="Seasons" @bind-Value="_model.SeasonId" />
                    </div>
                </div>
                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">Amount Rqrd</label>
                    <div class="col-8">
                        <InputNumber class="form-control" @bind-Value="_model.AmountRequested" @bind-Value:format="F2" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Remarks</label>
                    <InputTextArea class="form-control" @bind-Value="_model.Remarks" rows="2" />
                </div>
                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">Active ?</label>
                    <div class="col-8 form-switch">
                        &nbspp;&nbsp;<InputCheckbox class="form-check-input" @bind-Value="_model.Active" />
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-2 py-2">
                    <button type="submit" class="btn btn-primary w-75 py-2" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span class="ms-1">Saving...</span>
                        }
                        else
                        {
                            <i class="bi bi-save me-1"></i>
                            <span class="ms-1">@ButtonMessage</span>
                        }
                    </button>
                </div>
            </EditForm>
        }
    </div>

</ZabOffCanvas>
