@page "/company"
@using BrucolWeb.Web.Components.Common
@using BrucolWeb.Application.DTOs.Company
@inject NavigationManager Nav0

<PageHeading _pageTitle="Companies" _pageHeading="Companies" />

<main class="mt-3 shadow-sm p-3 soft-card rounded-5 mb-2" style="border-radius: 30px;">
    <div>
        <ZabDataTable TItem="CompanyListDTO"
                      Items="companies"
                      Columns="columns"
                      OnEdit="@(company => EditCompany(company))"
                      OnAdd="CreateCompany"
                      OnDelete="DeleteCompany"
                      ShowDelete="false" />
    </div>
</main>
<div class="mt-10" style="margin-top:50px;">
    <BFooter />
</div>


<!-- 🔹 Offcanvas goes HERE (bottom of page) -->
<ZabOffCanvas @ref="offcanvas"
              Id="companyPanel"
              Title="@offcanvasTitle">

    @* <CompanyDetails Model="_model" OnSave="SaveCompany" /> *@

    <div style="position: relative;">

        @if (isSaving)
        {
            <div class="loading-overlay">
                <div class="spinner-border text-primary"></div>
            </div>
        }
        @if (_model != null)
        {
            <EditForm Model="_model" OnValidSubmit="HandleSubmit">

                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">Co. Name</label>
                    <div class="col-8">
                        <InputText class="form-control" @bind-Value="_model.CompanyName" />
                    </div>
                </div>

                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">CK Number</label>
                    <div class="col-8">
                        <InputText class="form-control" @bind-Value="_model.CKNumber" />
                    </div>
                </div>

                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">Street Addr.</label>
                    <div class="col-8">
                        <InputText class="form-control" @bind-Value="_model.Street_Address" />
                    </div>
                </div>
                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">Surburb</label>
                    <div class="col-8">
                        <InputText class="form-control" @bind-Value="_model.Suburb" />
                    </div>
                </div>
                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">City/Town</label>
                    <div class="col-8">
                        <InputText class="form-control" @bind-Value="_model.CityTown" />
                    </div>
                </div>

                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">Postal Addr.</label>
                    <div class="col-8">
                        <InputText class="form-control" @bind-Value="_model.Postal_Address" />
                    </div>
                </div>
                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">City/Town</label>
                    <div class="col-8">
                        <InputText class="form-control" @bind-Value="_model.Postal_CityTown" />
                    </div>
                </div>
                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">City/Town</label>
                    <div class="col-8">
                        <InputText class="form-control" @bind-Value="_model.PostalCode" />
                    </div>
                </div>
                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">Province</label>
                    <div class="col-8">
                        <ZabDropDownFilter TValue="long" LookupType="Provinces" @bind-Value="_model.ProvinceId" />
                    </div>
                </div>    
                 <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">Contact</label>
                    <div class="col-8">
                        <InputText class="form-control" @bind-Value="_model.ContactPerson" />
                    </div>
                </div> 
                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">Telephone</label>
                    <div class="col-8">
                        <InputText class="form-control" @bind-Value="_model.Telephone" />
                    </div>
                </div>

                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">Mobile</label>
                    <div class="col-8">
                        <InputText class="form-control" @bind-Value="_model.Mobile" />
                    </div>
                </div>

                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">Email</label>
                    <div class="col-8">
                        <InputText class="form-control" @bind-Value="_model.Email" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Remarks</label>
                    <InputTextArea class="form-control"  @bind-Value="_model.Remarks"  rows="2" />
                </div>

                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">Active ?</label>
                    <div class="col-8">
                        <InputCheckbox class="form-check-input" @bind-Value="_model.Active" />
                    </div>
                </div>

                @* <button class="btn btn-primary" style="width: 150px;">Save</button> *@
                <div class="d-flex justify-content-end mt-2 py-2">
                    <button class="btn btn-success" disabled="@isSaving" style="width: 65%;">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2">Saving ...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-circle me-1"></i>

                            <span>@ButtonMessage</span>
                        }
                    </button>
                </div>

            </EditForm>
        }
    </div>



</ZabOffCanvas>