@page "/farms"
@using BrucolWeb.Application.Services
@using BrucolWeb.Web.Components.Common

@inject NavigationManager Nav0
@inject IToastService _Toast

@if (isLoading)
{
    <LoadingComponent />
}
else
{
    <PageHeading _pageTitle="Farms" _pageHeading="Farms" />

    <main class="mt-3 shadow-sm p-3 soft-card rounded-5 mb-2" style="border-radius: 30px;">
        <div>
            <ZabDataTable TItem="FarmListDTO"
                          Items="farms"
                          Columns="columns"
                          OnEdit="@(farm => EditFarm(farm))"
                          OnAdd="CreateFarm"
                          OnDelete="DeleteFarm"
                          ShowDelete="false" />
        </div>
    </main>

    <div class="mt-10" style="margin-top:50px;">
        <BFooter />
    </div>
}


<!-- 🔹 Offcanvas goes HERE (bottom of page) -->
<ZabOffCanvas @ref="offcanvas"
              Id="farmPanel"
              dWidth="550"
              Title="@offcanvasTitle">

    @if (isLoading)
    {
        <LoadingComponent />
    }
    else
    {
        <div style="position: relative;">
        @if (isSaving)
        {
            <div class="loading-overlay">
                <div class="spinner-border text-primary"></div>
            </div>
        }
        @if (_model != null)
        {
            <EditForm Model="_model" OnValidSubmit="HandleSubmit">

                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">Farm Name</label>
                    <div class="col-8">
                        <InputText class="form-control" @bind-Value="_model.FarmName" />
                    </div>
                </div>

                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">CK Number</label>
                    <div class="col-8">
                        <InputText class="form-control" @bind-Value="_model.CKNumber" />
                    </div>
                </div>

                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">Client</label>
                    <div class="col-8">
                        <ZabDropDownFilter TValue="long" LookupType="Farmers" @bind-Value="_model.FarmerId" />
                    </div>
                </div>
                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">Area/Location</label>
                    <div class="col-8">
                        <InputText class="form-control" @bind-Value="_model.AreaLocation" />
                    </div>
                </div>
                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">Province</label>
                    <div class="col-8">
                        <ZabDropDownFilter TValue="long" LookupType="Provinces" @bind-Value="_model.ProvinceId" />
                    </div>
                </div>

                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">Manager</label>
                    <div class="col-8">
                        <InputText class="form-control" @bind-Value="_model.ContactPerson" />
                    </div>
                </div>

                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">Telephone</label>
                    <div class="col-8">
                        <InputText class="form-control" @bind-Value="_model.Telephone" />
                    </div>
                </div>

                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">Mobile</label>
                    <div class="col-8">
                        <InputText class="form-control" @bind-Value="_model.Mobile" />
                    </div>
                </div>

                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">Email</label>
                    <div class="col-8">
                        <InputText class="form-control" @bind-Value="_model.Email" />
                    </div>
                </div>
                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">Website</label>
                    <div class="col-8">
                        <InputText class="form-control" @bind-Value="_model.Website" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Remarks</label>
                    <InputTextArea class="form-control" @bind-Value="_model.Remarks" rows="2" />
                </div>
                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">Active ?</label>
                    <div class="col-8 form-switch ps-5">
                        &nbsp;<InputCheckbox class="form-check-input" @bind-Value="_model.Active" />
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-2 py-2">
                    <button class="btn btn btn-primary w-75 py-2" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span class="ms-1">Saving...</span>
                        }
                        else
                        {
                            <i class="bi bi-save me-1"></i>
                            <span class="ms-1">@ButtonMessage</span>
                        }
                    </button>
                </div>

            </EditForm>
        }
        </div>

    }

</ZabOffCanvas>