@page "/doc_checklist"
@inject NavigationManager Nav0
@inject IToastService _Toast

@using BrucolWeb.Application.Services
@using BrucolWeb.Web.Components.Common
@using BrucolWeb.Application.DTOs.FarmerTypes

@if (isLoading)
{
    <LoadingComponent />
}
else
{
    <PageHeading _pageTitle="Document Checklist" _pageHeading="Client Categories" />

    <main class="mt-3 shadow-sm p-3 soft-card rounded-5 mb-2" style="border-radius: 30px;">
        <div>
            <ZabDataTable_Docs TItem="FarmerTypeListDto"
                               Items="farmerTypes"
                               Columns="columns"
                               OnEdit="@(farmerType => EditFarmerType(farmerType))"
                               OnAdd="CreateFarmerType"
                               OnDelete="DeleteFarmerType"
                               ShowDelete="false" />
            @* OnEditDocs="CreateFileCheckList" *@
        </div>
    </main>
    <div class="mt-10" style="margin-top:50px;">
        <BFooter />
    </div>

}

<!-- 🔹 Offcanvas goes HERE (bottom of page) -->
<ZabOffCanvas @ref="offcanvas"
              Id="farmPanel"
              Title="@offcanvasTitle">

    @* <CropDetails Model="_model" OnSave="SaveCrop" /> *@
    @if (isLoading)
    { 
        <LoadingComponent />
    }
    else
    {
    <div style="position: relative;">

        @if (isSaving)
        {
            <div class="loading-overlay">
                <div class="spinner-border text-primary"></div>
            </div>
        }
        @if (_model != null)
        {
            <EditForm Model="_model" OnValidSubmit="HandleSubmit">

                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">Category</label>
                    <div class="col-8">
                        <InputText class="form-control" @bind-Value="_model.FarmerType" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Remarks</label>
                    <InputTextArea class="form-control" @bind-Value="_model.Remarks" rows="2" />
                </div>
                <div class="row mb-2 align-items-center">
                    <label class="col-4 col-form-label">Active ?</label>
                    <div class="col-8 form-switch">
                        <InputCheckbox class="form-check-input" @bind-Value="_model.Active" />
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-2 py-2">
                    <button class="btn btn btn-primary w-75 py-2" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span class="ms-1">Saving...</span>
                        }
                        else
                        {
                            <i class="bi bi-save me-1"></i>
                            <span class="ms-1">@ButtonMessage</span>
                        }
                    </button>
                </div>
            </EditForm>
        }
    </div>

    }
</ZabOffCanvas>