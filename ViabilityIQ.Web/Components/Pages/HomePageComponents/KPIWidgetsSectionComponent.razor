<div class="wk-widgets-section">
    <div class="wk-widgets-header">
        <h5 class="wk-widgets-title">
            <i class="bi bi-speedometer2"></i>
            Assesments Performance & Status Metrics
        </h5>
        <p class="wk-widgets-subtitle">Track your assessment metrics</p>
    </div>

    @if (KPIMetrics == null)
    {
        <div class="wk-widgets-loading">
            <div class="spinner-border spinner-border-sm text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p>Loading metrics...</p>
        </div>
    }
    else
    {
        <div class="row g-2 mb-3">
            <div class="col-lg-2 col-md-4 col-sm-6">
                <KPICardComponent0 Label="Total Assessments"
                                   Value="@KPIMetrics.TotalAssessments"
                                   Subtext="registered"
                                   FooterText="your portfolio"
                                   KPIType="TotalAssessments"
                                   IconClass="bi-collection"
                                   OnClick="HandleDrill" />
            </div>

            <div class="col-lg-2 col-md-4 col-sm-6">
                <KPICardComponent0 Label="Draft"
                                   Value="@KPIMetrics.DraftAssessments"
                                   Subtext="setup stage"
                                   FooterText="needs input"
                                   KPIType="DraftAssessments"
                                   IconClass="bi-file-earmark-text"
                                   OnClick="HandleDrill" />
            </div>

            <div class="col-lg-2 col-md-4 col-sm-6">
                <KPICardComponent0 Label="In Progress"
                                   Value="@KPIMetrics.InProgressAssessments"
                                   Subtext="being prepared"
                                   FooterText="active workflow"
                                   KPIType="InProgressAssessments"
                                   IconClass="bi-hourglass-split"
                                   OnClick="HandleDrill" />
            </div>

            <div class="col-lg-2 col-md-4 col-sm-6">
                <KPICardComponent0 Label="Ready for Review"
                                   Value="@KPIMetrics.ReadyForReviewAssessments"
                                   Subtext="workflow ready"
                                   FooterText="awaiting review"
                                   KPIType="ReadyForReviewAssessments"
                                   IconClass="bi-person-check"
                                   OnClick="HandleDrill" />
            </div>

            <div class="col-lg-2 col-md-4 col-sm-6">
                <KPICardComponent0 Label="Ready for Assessment"
                                   Value="@KPIMetrics.ProjectionReadyAssessments"
                                   Subtext="100% projection ready"
                                   FooterText="no readiness gaps"
                                   KPIType="ProjectionReadyAssessments"
                                   IconClass="bi-clipboard2-check"
                                   OnClick="HandleDrill" />
            </div>

            <div class="col-lg-2 col-md-4 col-sm-6">
                <KPICardComponent0 Label="Completed"
                                   Value="@KPIMetrics.CompletedAssessments"
                                   Subtext="finalized"
                                   FooterText="completed cases"
                                   KPIType="CompletedAssessments"
                                   IconClass="bi-check-circle-fill"
                                   OnClick="HandleDrill" />
            </div>
        </div>
    }
</div>
