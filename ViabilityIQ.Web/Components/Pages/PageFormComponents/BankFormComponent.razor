@using Microsoft.AspNetCore.Components.Forms
@using ViabilityIQ.Shared.DataModels
@using ViabilityIQ.Web.Components.CommonComponents

<div class="viq-form-shell">
    @if (isProcessingData)
    {
        <div class="viq-form-busy">
            <div class="viq-form-busy-card">
                <span class="viq-form-spinner"></span>
                <div><strong>Saving bank</strong><span>Synchronizing the workspace record...</span></div>
            </div>
        </div>
    }

    <EditForm Model="@bankModel" OnValidSubmit="HandleFormSubmissionAsync" class="viq-data-form">
        <DataAnnotationsValidator />
        <ValidationSummary class="viq-form-validation-summary" />

        <div class="viq-form-intro">
            <span class="viq-form-intro-icon"><i class="bi bi-bank"></i></span>
            <div><h2>Bank or funder</h2><p>Maintain the institution name, reference code and availability.</p></div>
        </div>

        <section class="viq-form-section">
            <div class="viq-form-section-heading">
                <span><i class="bi bi-building"></i></span>
                <div><h3>Institution details</h3><p>Information used in funding and repayment records.</p></div>
            </div>
            <div class="viq-form-grid viq-form-grid-2">
                <div class="viq-form-field">
                    <label for="bankName">Bank / Funder Name <span class="viq-required">*</span></label>
                    <InputText id="bankName" class="viq-form-control" @bind-Value="bankModel.BankName" />
                    <ValidationMessage For="@(() => bankModel.BankName)" class="viq-form-validation" />
                </div>
                <div class="viq-form-field">
                    <label for="shortName">Short Code Abbreviation</label>
                    <InputText id="shortName" class="viq-form-control" @bind-Value="bankModel.ShortName" />
                    <ValidationMessage For="@(() => bankModel.ShortName)" class="viq-form-validation" />
                </div>
                <div class="viq-form-field viq-form-span-2">
                    <label for="remarks">Internal Notes &amp; Description</label>
                    <InputTextArea id="remarks" class="viq-form-control viq-form-textarea" rows="2" @bind-Value="bankModel.Remarks" />
                    <ValidationMessage For="@(() => bankModel.Remarks)" class="viq-form-validation" />
                </div>
            </div>
        </section>

        <section class="viq-form-section">
            <div class="viq-form-section-heading">
                <span><i class="bi bi-toggles"></i></span>
                <div><h3>Availability</h3><p>Control whether this institution can be selected.</p></div>
            </div>
            <label class="viq-toggle-card viq-toggle-card-wide" for="isActive">
                <span><strong>@(isRowActive ? "Bank active" : "Bank inactive")</strong><small>Inactive banks remain available in historical records.</small></span>
                <InputCheckbox id="isActive" class="viq-switch" @bind-Value="isRowActive" />
            </label>
        </section>

        <div class="viq-form-actions">
            <button type="submit" class="viq-button viq-button-primary" disabled="@isProcessingData">
                @if (isProcessingData) { <span class="spinner-border spinner-border-sm" role="status"></span><span>Saving...</span> }
                else { <i class="bi bi-check2-square"></i><span>@(BankId == 0 ? "Add Bank" : "Update Bank")</span> }
            </button>
        </div>
    </EditForm>
</div>
