@using Microsoft.AspNetCore.Components.Forms
@using ViabilityIQ.Shared.DataModels
@using ViabilityIQ.Shared.SharedModels
@using ViabilityIQ.Web.Components.CommonComponents

<div class="viq-form-shell">
    @if (isProcessingData)
    {
        <div class="viq-form-busy" role="status" aria-live="polite">
            <div class="viq-form-busy-card">
                <span class="viq-form-spinner" aria-hidden="true"></span>
                <div>
                    <strong>Processing business</strong>
                    <span>Please wait while the record is prepared.</span>
                </div>
            </div>
        </div>
    }

    <EditForm Model="businessModel" OnValidSubmit="HandleFormSubmissionAsync"
              class="viq-data-form" aria-label="Business details">
        <DataAnnotationsValidator />
@* 
        <div class="viq-form-intro">
            <span class="viq-form-intro-icon"><i class="bi bi-buildings" aria-hidden="true"></i></span>
            <div>
                <h2>@(BusinessId == 0 ? "New business profile" : "Business profile")</h2>
                <p>Capture the organisation, compliance, address and contact information used by assessments.</p>
            </div>
        </div> *@

        <ValidationSummary class="viq-form-validation-summary" />

        <section class="viq-form-section">
            <header class="viq-form-section-heading">
                <span><i class="bi bi-building" aria-hidden="true"></i></span>
                <div>
                    <h3>Organisation details</h3>
                    <p>Core identity and ownership information.</p>
                </div>
            </header>

            <div class="viq-form-grid viq-form-grid-2">
                <div class="viq-form-field viq-form-span-2">
                    <label for="businessName">Business name <span class="viq-required">*</span></label>
                    <InputText id="businessName" class="viq-form-control"
                               autocomplete="organization"
                               @bind-Value="businessModel.BusinessName" />
                    <ValidationMessage For="@(() => businessModel.BusinessName)" class="viq-form-validation" />
                </div>

                <div class="viq-form-field">
                    <label>Business sector <span class="viq-required">*</span></label>
                    <DDLookupComponent SourceKey="DDLookupEnums.Sectors"
                                       @bind-Value="businessModel.BusinessSectorId" />
                    <ValidationMessage For="@(() => businessModel.BusinessSectorId)" class="viq-form-validation" />
                </div>

                <div class="viq-form-field">
                    <label>Business owner <span class="viq-required">*</span></label>
                    <DDLookupComponent SourceKey="DDLookupEnums.Clients"
                                       @bind-Value="businessModel.ClientId" />
                    <ValidationMessage For="@(() => businessModel.ClientId)" class="viq-form-validation" />
                </div>

                <div class="viq-form-field viq-form-span-2">
                    <label for="registrationNumber">Registration number</label>
                    <InputText id="registrationNumber" class="viq-form-control"
                               @bind-Value="businessModel.CKNumber" />
                    <ValidationMessage For="@(() => businessModel.CKNumber)" class="viq-form-validation" />
                </div>
            </div>
        </section>

        <section class="viq-form-section">
            <header class="viq-form-section-heading">
                <span><i class="bi bi-patch-check" aria-hidden="true"></i></span>
                <div>
                    <h3>Registration and compliance</h3>
                    <p>Classify the organisation for reporting and assessment purposes.</p>
                </div>
            </header>

            <div class="viq-toggle-grid">
                <label class="viq-toggle-card" for="isRegistered">
                    <span><strong>Registered business</strong><small>Formal business registration</small></span>
                    <InputCheckbox id="isRegistered" class="viq-switch"
                                   @bind-Value="businessModel.IsRegistered" />
                </label>
                <label class="viq-toggle-card" for="isVatRegistered">
                    <span><strong>VAT registered</strong><small>Registered for value-added tax</small></span>
                    <InputCheckbox id="isVatRegistered" class="viq-switch"
                                   @bind-Value="businessModel.IsVATRegistered" />
                </label>
                <label class="viq-toggle-card" for="isBeeExempt">
                    <span><strong>BEE exempt</strong><small>Exempt from BEE requirements</small></span>
                    <InputCheckbox id="isBeeExempt" class="viq-switch"
                                   @bind-Value="businessModel.IsBEE_Exempt" />
                </label>
            </div>
        </section>

        <section class="viq-form-section">
            <header class="viq-form-section-heading">
                <span><i class="bi bi-geo-alt" aria-hidden="true"></i></span>
                <div>
                    <h3>Physical address</h3>
                    <p>Primary operating location of the business.</p>
                </div>
            </header>

            <div class="viq-form-grid viq-form-grid-2">
                <div class="viq-form-field viq-form-span-2">
                    <label for="streetAddress">Street address</label>
                    <InputText id="streetAddress" class="viq-form-control"
                               autocomplete="street-address"
                               @bind-Value="businessModel.Street_Address" />
                    <ValidationMessage For="@(() => businessModel.Street_Address)" class="viq-form-validation" />
                </div>
                <div class="viq-form-field">
                    <label for="suburb">Suburb</label>
                    <InputText id="suburb" class="viq-form-control"
                               @bind-Value="businessModel.Surburb" />
                    <ValidationMessage For="@(() => businessModel.Surburb)" class="viq-form-validation" />
                </div>
                <div class="viq-form-field">
                    <label for="cityTown">City or town</label>
                    <InputText id="cityTown" class="viq-form-control"
                               autocomplete="address-level2"
                               @bind-Value="businessModel.CityTown" />
                    <ValidationMessage For="@(() => businessModel.CityTown)" class="viq-form-validation" />
                </div>
                <div class="viq-form-field viq-form-span-2">
                    <label>Province</label>
                    <DDLookupComponent SourceKey="DDLookupEnums.Provinces"
                                       @bind-Value="businessModel.ProvinceId" />
                    <ValidationMessage For="@(() => businessModel.ProvinceId)" class="viq-form-validation" />
                </div>
            </div>
        </section>

        <section class="viq-form-section">
            <header class="viq-form-section-heading">
                <span><i class="bi bi-envelope-paper" aria-hidden="true"></i></span>
                <div>
                    <h3>Postal and contact details</h3>
                    <p>Correspondence address and primary contact channels.</p>
                </div>
            </header>

            <div class="viq-form-grid viq-form-grid-2">
                <div class="viq-form-field viq-form-span-2">
                    <label for="postalAddress">Postal address</label>
                    <InputText id="postalAddress" class="viq-form-control"
                               @bind-Value="businessModel.Postal_Address" />
                    <ValidationMessage For="@(() => businessModel.Postal_Address)" class="viq-form-validation" />
                </div>
                <div class="viq-form-field">
                    <label for="postalLocation">Postal location</label>
                    <InputText id="postalLocation" class="viq-form-control"
                               @bind-Value="businessModel.Postal_CityTown" />
                    <ValidationMessage For="@(() => businessModel.Postal_CityTown)" class="viq-form-validation" />
                </div>
                <div class="viq-form-field">
                    <label for="postalCode">Postal code</label>
                    <InputText id="postalCode" class="viq-form-control"
                               autocomplete="postal-code"
                               @bind-Value="businessModel.PostalCode" />
                    <ValidationMessage For="@(() => businessModel.PostalCode)" class="viq-form-validation" />
                </div>
                <div class="viq-form-field">
                    <label for="telephone">Telephone</label>
                    <InputText id="telephone" class="viq-form-control"
                               autocomplete="tel"
                               @bind-Value="businessModel.Telephone" />
                    <ValidationMessage For="@(() => businessModel.Telephone)" class="viq-form-validation" />
                </div>
                <div class="viq-form-field">
                    <label for="mobile">Mobile</label>
                    <InputText id="mobile" class="viq-form-control"
                               autocomplete="tel"
                               @bind-Value="businessModel.Mobile" />
                    <ValidationMessage For="@(() => businessModel.Mobile)" class="viq-form-validation" />
                </div>
                <div class="viq-form-field">
                    <label for="email">Email</label>
                    <InputText id="email" class="viq-form-control"
                               type="email" autocomplete="email"
                               @bind-Value="businessModel.Email" />
                    <ValidationMessage For="@(() => businessModel.Email)" class="viq-form-validation" />
                </div>
                <div class="viq-form-field">
                    <label for="website">Website</label>
                    <InputText id="website" class="viq-form-control"
                               type="url" autocomplete="url" placeholder="https://"
                               @bind-Value="businessModel.Website" />
                    <ValidationMessage For="@(() => businessModel.Website)" class="viq-form-validation" />
                </div>
            </div>
        </section>

        <section class="viq-form-section">
            <header class="viq-form-section-heading">
                <span><i class="bi bi-card-text" aria-hidden="true"></i></span>
                <div>
                    <h3>Administration</h3>
                    <p>Internal notes and record availability.</p>
                </div>
            </header>

            <div class="viq-form-field">
                <label for="remarks">Internal notes and description</label>
                <InputTextArea id="remarks" class="viq-form-control viq-form-textarea" rows="3"
                               @bind-Value="businessModel.Remarks" />
                <ValidationMessage For="@(() => businessModel.Remarks)" class="viq-form-validation" />
            </div>

            <label class="viq-toggle-card viq-toggle-card-wide" for="isActive">
                <span>
                    <strong>@(isRowActive ? "Business active" : "Business inactive")</strong>
                    <small>Inactive businesses remain in history but are unavailable for normal selection.</small>
                </span>
                <InputCheckbox id="isActive" class="viq-switch" @bind-Value="isRowActive" />
            </label>
        </section>

        <footer class="viq-form-actions">
            <button type="button" class="viq-button viq-button-secondary"
                    @onclick="CancelAsync" disabled="@isProcessingData">
                Cancel
            </button>
            <button type="submit" class="viq-button viq-button-primary" disabled="@isProcessingData">
                @if (isProcessingData)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Saving…</span>
                }
                else
                {
                    <i class="bi bi-check2-circle" aria-hidden="true"></i>
                    <span>@(BusinessId == 0 ? "Add business" : "Save changes")</span>
                }
            </button>
        </footer>
    </EditForm>
</div>
