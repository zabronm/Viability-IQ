@using Microsoft.AspNetCore.Components.Forms
@using ViabilityIQ.Shared.DataModels
@using ViabilityIQ.Shared.SharedModels
@using ViabilityIQ.Web.Components.CommonComponents

<div class="viq-form-shell">
    @if (isProcessingData)
    {
        <div class="viq-form-busy">
            <div class="viq-form-busy-card"><span class="viq-form-spinner"></span><div><strong>Saving client</strong><span>Synchronizing personal and contact information...</span></div></div>
        </div>
    }

    <EditForm Model="clientModel" OnValidSubmit="HandleFormSubmissionAsync" class="viq-data-form">
        <DataAnnotationsValidator />
        <ValidationSummary class="viq-form-validation-summary" />

        @* <div class="viq-form-intro">
            <span class="viq-form-intro-icon"><i class="bi bi-person-badge"></i></span>
            <div><h2>Client details</h2><p>Capture identity, demographic, address and contact information.</p></div>
        </div> *@

        <section class="viq-form-section">
            <div class="viq-form-section-heading"><span><i class="bi bi-person-vcard"></i></span><div><h3>Personal information</h3><p>Identity and client classification details.</p></div></div>
            <div class="viq-form-grid viq-form-grid-2">
                <div class="viq-form-field viq-form-span-2">
                    <label for="clientName">Full Name/s <span class="viq-required">*</span></label>
                    <InputText id="clientName" class="viq-form-control" @bind-Value="clientModel.FullName" />
                    <ValidationMessage For="@(() => clientModel.FullName)" class="viq-form-validation" />
                </div>

                <div class="viq-form-field">
                    <label>Client Type / Category <span class="viq-required">*</span></label>
                    <DDLookupComponent SourceKey="DDLookupEnums.ClientTypes" @bind-Value="clientModel.ClientTypeId" />
                    <ValidationMessage For="() => clientModel.ClientTypeId" class="viq-form-validation" />
                </div>
                <div class="viq-form-field">
                    <label for="idNumber">ID / Passport Number <span class="viq-required">*</span></label>
                    <InputText id="idNumber" class="viq-form-control" @bind-Value="clientModel.IDNumber" />
                    <ValidationMessage For="@(() => clientModel.IDNumber)" class="viq-form-validation" />
                </div>
                <div class="viq-form-field">
                    <label>Gender</label>
                    <DDLookupComponent SourceKey="DDLookupEnums.Genders" @bind-Value="clientModel.GenderId" />
                    <ValidationMessage For="() => clientModel.GenderId" class="viq-form-validation" />
                </div>
                <div class="viq-form-field">
                    <label>Race</label>
                    <DDLookupComponent SourceKey="DDLookupEnums.Races" @bind-Value="clientModel.RaceId" />
                    <ValidationMessage For="() => clientModel.RaceId" class="viq-form-validation" />
                </div>
            </div>
        </section>

        <section class="viq-form-section">
            <div class="viq-form-section-heading"><span><i class="bi bi-geo-alt"></i></span><div><h3>Physical address</h3><p>Primary residential or operating address.</p></div></div>
            <div class="viq-form-grid viq-form-grid-2">
                <div class="viq-form-field"><label for="street">Street Address</label><InputText id="street" class="viq-form-control" @bind-Value="clientModel.Address_Street" /><ValidationMessage For="@(() => clientModel.Address_Street)" class="viq-form-validation" /></div>
                <div class="viq-form-field"><label for="suburb">Suburb</label><InputText id="suburb" class="viq-form-control" @bind-Value="clientModel.Address_Surburb" /><ValidationMessage For="@(() => clientModel.Address_Surburb)" class="viq-form-validation" /></div>
                <div class="viq-form-field"><label for="city">City / Town</label><InputText id="city" class="viq-form-control" @bind-Value="clientModel.Address_CityTown" /><ValidationMessage For="@(() => clientModel.Address_CityTown)" class="viq-form-validation" /></div>
                <div class="viq-form-field"><label>Province</label><DDLookupComponent SourceKey="DDLookupEnums.Provinces" @bind-Value="clientModel.ProvinceId" /><ValidationMessage For="() => clientModel.ProvinceId" class="viq-form-validation" /></div>
            </div>
        </section>

        <section class="viq-form-section">
            <div class="viq-form-section-heading"><span><i class="bi bi-mailbox"></i></span><div><h3>Postal and contact details</h3><p>Postal destination and preferred communication channels.</p></div></div>
            <div class="viq-form-grid viq-form-grid-2">
                <div class="viq-form-field"><label for="postAddr">Postal Address</label><InputText id="postAddr" class="viq-form-control" @bind-Value="clientModel.Address_Postal" /><ValidationMessage For="@(() => clientModel.Address_Postal)" class="viq-form-validation" /></div>
                <div class="viq-form-field"><label for="area">Postal Area / Location</label><InputText id="area" class="viq-form-control" @bind-Value="clientModel.Address_PostalLocation" /><ValidationMessage For="@(() => clientModel.Address_PostalLocation)" class="viq-form-validation" /></div>
                <div class="viq-form-field"><label for="postLoc">Postal Town / City</label><InputText id="postLoc" class="viq-form-control" @bind-Value="clientModel.Address_PostalCity" /><ValidationMessage For="@(() => clientModel.Address_PostalCity)" class="viq-form-validation" /></div>
                <div class="viq-form-field"><label for="postCode">Postal Code</label><InputText id="postCode" class="viq-form-control" @bind-Value="clientModel.Address_PostalCode" /><ValidationMessage For="@(() => clientModel.Address_PostalCode)" class="viq-form-validation" /></div>
                <div class="viq-form-field"><label for="telephone">Telephone</label><InputText id="telephone" class="viq-form-control" @bind-Value="clientModel.Telephone" /><ValidationMessage For="@(() => clientModel.Telephone)" class="viq-form-validation" /></div>
                <div class="viq-form-field"><label for="mobile">Mobile</label><InputText id="mobile" class="viq-form-control" @bind-Value="clientModel.Mobile" /><ValidationMessage For="@(() => clientModel.Mobile)" class="viq-form-validation" /></div>
                <div class="viq-form-field viq-form-span-2"><label for="email">Email</label><InputText id="email" class="viq-form-control" @bind-Value="clientModel.Email" /><ValidationMessage For="@(() => clientModel.Email)" class="viq-form-validation" /></div>
            </div>
        </section>

        <section class="viq-form-section">
            <div class="viq-form-section-heading"><span><i class="bi bi-journal-text"></i></span><div><h3>Administration</h3><p>Internal context and record availability.</p></div></div>
            <div class="viq-form-grid"><div class="viq-form-field"><label for="remarks">Internal Notes &amp; Description</label><InputTextArea id="remarks" class="viq-form-control viq-form-textarea" rows="2" @bind-Value="clientModel.Remarks" /><ValidationMessage For="@(() => clientModel.Remarks)" class="viq-form-validation" /></div></div>
            <label class="viq-toggle-card viq-toggle-card-wide" for="isActive">
                <span><strong>@(isRowActive ? "Client active" : "Client inactive")</strong><small>Inactive clients remain visible in historical records.</small></span>
                <InputCheckbox id="isActive" class="viq-switch" @bind-Value="isRowActive" />
            </label>
        </section>

        <div class="viq-form-actions">
            <button type="submit" class="viq-button viq-button-primary" disabled="@isProcessingData">
                @if (isProcessingData) { <span class="spinner-border spinner-border-sm" role="status"></span><span>Saving...</span> }
                else { <i class="bi bi-check2-square"></i><span>@(ClientId == 0 ? "Add Client" : "Update Client")</span> }
            </button>
        </div>
    </EditForm>
</div>
