@using Microsoft.AspNetCore.Components.Forms
@using ViabilityIQ.Shared.DataModels
@using ViabilityIQ.Shared.SharedModels
@using ViabilityIQ.Web.Components.CommonComponents

<div class="viq-form-shell">
    @if (isProcessingData)
    {
        <div class="viq-form-busy"><div class="viq-form-busy-card"><span class="viq-form-spinner"></span><div><strong>Saving provincial office</strong><span>Synchronizing office and contact information...</span></div></div></div>
    }

    <EditForm Model="provinceModel" OnValidSubmit="HandleFormSubmissionAsync" class="viq-data-form">
        <DataAnnotationsValidator />
        <ValidationSummary class="viq-form-validation-summary" />

        <div class="viq-form-intro">
            <span class="viq-form-intro-icon"><i class="bi bi-geo"></i></span>
            <div><h2>Provincial office</h2><p>Maintain office identity, management, address and contact information.</p></div>
        </div>

        <section class="viq-form-section">
            <div class="viq-form-section-heading"><span><i class="bi bi-building"></i></span><div><h3>Office information</h3><p>Name, short reference and responsible manager.</p></div></div>
            <div class="viq-form-grid viq-form-grid-2">
                <div class="viq-form-field"><label for="clientName">Province Name</label><InputText id="clientName" class="viq-form-control" @bind-Value="provinceModel.ProvinceName" /><ValidationMessage For="@(() => provinceModel.ProvinceName)" class="viq-form-validation" /></div>
                <div class="viq-form-field"><label for="shortname">Short Name</label><InputText id="shortname" class="viq-form-control" @bind-Value="provinceModel.ShortName" /><ValidationMessage For="@(() => provinceModel.ShortName)" class="viq-form-validation" /></div>
                <div class="viq-form-field viq-form-span-2"><label>Manager</label><DDLookupComponent SourceKey="DDLookupEnums.Users" @bind-Value="provinceModel.Manager_UserId" /><ValidationMessage For="() => provinceModel.Manager_UserId" class="viq-form-validation" /></div>
            </div>
        </section>

        <section class="viq-form-section">
            <div class="viq-form-section-heading"><span><i class="bi bi-geo-alt"></i></span><div><h3>Physical address</h3><p>Location of the provincial office.</p></div></div>
            <div class="viq-form-grid viq-form-grid-2">
                <div class="viq-form-field"><label for="street">Street Address</label><InputText id="street" class="viq-form-control" @bind-Value="provinceModel.Address_Street" /><ValidationMessage For="@(() => provinceModel.Address_Street)" class="viq-form-validation" /></div>
                <div class="viq-form-field"><label for="area">Suburb</label><InputText id="area" class="viq-form-control" @bind-Value="provinceModel.Address_Suburb" /><ValidationMessage For="@(() => provinceModel.Address_Suburb)" class="viq-form-validation" /></div>
                <div class="viq-form-field"><label for="city">City / Town</label><InputText id="city" class="viq-form-control" @bind-Value="provinceModel.Address_City" /><ValidationMessage For="@(() => provinceModel.Address_City)" class="viq-form-validation" /></div>
                <div class="viq-form-field"><label>Province</label><DDLookupComponent SourceKey="DDLookupEnums.Provinces" @bind-Value="provinceModel.ProvinceId" /><ValidationMessage For="() => provinceModel.ProvinceId" class="viq-form-validation" /></div>
            </div>
        </section>

        <section class="viq-form-section">
            <div class="viq-form-section-heading"><span><i class="bi bi-mailbox"></i></span><div><h3>Postal and contact details</h3><p>Postal destination and office communication channels.</p></div></div>
            <div class="viq-form-grid viq-form-grid-2">
                <div class="viq-form-field"><label for="postAddr">Postal Address</label><InputText id="postAddr" class="viq-form-control" @bind-Value="provinceModel.Address_Postal" /><ValidationMessage For="@(() => provinceModel.Address_Postal)" class="viq-form-validation" /></div>
                <div class="viq-form-field"><label for="postLoc">Postal Area / Location</label><InputText id="postLoc" class="viq-form-control" @bind-Value="provinceModel.Address_PostalLocation" /><ValidationMessage For="@(() => provinceModel.Address_PostalLocation)" class="viq-form-validation" /></div>
                <div class="viq-form-field"><label for="postCity">Postal City</label><InputText id="postCity" class="viq-form-control" @bind-Value="provinceModel.Address_PostalCity" /><ValidationMessage For="@(() => provinceModel.Address_PostalCity)" class="viq-form-validation" /></div>
                <div class="viq-form-field"><label for="postCode">Postal Code</label><InputText id="postCode" class="viq-form-control" @bind-Value="provinceModel.Address_PostalCode" /><ValidationMessage For="@(() => provinceModel.Address_PostalCode)" class="viq-form-validation" /></div>
                <div class="viq-form-field"><label for="telephone">Telephone</label><InputText id="telephone" class="viq-form-control" @bind-Value="provinceModel.Telephone" /><ValidationMessage For="@(() => provinceModel.Telephone)" class="viq-form-validation" /></div>
                <div class="viq-form-field"><label for="mobile">Mobile</label><InputText id="mobile" class="viq-form-control" @bind-Value="provinceModel.Mobile" /><ValidationMessage For="@(() => provinceModel.Mobile)" class="viq-form-validation" /></div>
                <div class="viq-form-field viq-form-span-2"><label for="email">Email</label><InputText id="email" class="viq-form-control" @bind-Value="provinceModel.Email" /><ValidationMessage For="@(() => provinceModel.Email)" class="viq-form-validation" /></div>
            </div>
        </section>

        <section class="viq-form-section">
            <div class="viq-form-section-heading"><span><i class="bi bi-journal-text"></i></span><div><h3>Administration</h3><p>Internal context and record availability.</p></div></div>
            <div class="viq-form-grid"><div class="viq-form-field"><label for="remarks">Internal Notes &amp; Description</label><InputTextArea id="remarks" class="viq-form-control viq-form-textarea" rows="2" @bind-Value="provinceModel.Remarks" /><ValidationMessage For="@(() => provinceModel.Remarks)" class="viq-form-validation" /></div></div>
            <label class="viq-toggle-card viq-toggle-card-wide" for="isActive">
                <span><strong>@(isRowActive ? "Province active" : "Province inactive")</strong><small>Inactive provincial offices remain visible in historical records.</small></span>
                <InputCheckbox id="isActive" class="viq-switch" @bind-Value="isRowActive" />
            </label>
        </section>

        <div class="viq-form-actions">
            <button type="submit" class="viq-button viq-button-primary" disabled="@isProcessingData">
                @if (isProcessingData) { <span class="spinner-border spinner-border-sm" role="status"></span><span>Saving...</span> }
                else { <i class="bi bi-check2-square"></i><span>@(ProvinceId == 0 ? "Add Province" : "Update Province")</span> }
            </button>
        </div>
    </EditForm>
</div>
