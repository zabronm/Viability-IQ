@using ViabilityIQ.Shared.SharedModels
@using ViabilityIQ.Shared.DataModels
@inherits Microsoft.AspNetCore.Components.ComponentBase

<div class="viq-form-shell asset-category-form-container">
    @if (isLoading)
    {
        <div class="viq-form-busy">
            <div class="viq-form-busy-card"><span class="viq-form-spinner"></span><div><strong>Loading category</strong><span>Preparing the asset classification...</span></div></div>
        </div>
    }
    else
    {
        <form @onsubmit="HandleSubmit" class="viq-data-form">
            @* <div class="viq-form-intro">
                <span class="viq-form-intro-icon"><i class="bi bi-boxes"></i></span>
                <div><h2>Asset category</h2><p>Define classification, balance-sheet placement and display settings.</p></div>
            </div> *@

            <section class="viq-form-section">
                <div class="viq-form-section-heading"><span><i class="bi bi-tag"></i></span><div><h3>Category information</h3><p>Name and describe the assets grouped in this category.</p></div></div>
                <div class="viq-form-grid">
                    <div class="viq-form-field">
                        <label for="categoryName">Category Name <span class="viq-required">*</span></label>
                        <input id="categoryName" type="text" class="viq-form-control @(HasError(nameof(category.CategoryName)) ? "invalid" : "")" @bind="category.CategoryName" placeholder="e.g. Land & Buildings, Plant & Machinery, Vehicles" />
                        @if (HasError(nameof(category.CategoryName))) { <div class="viq-form-validation">@GetError(nameof(category.CategoryName))</div> }
                    </div>
                    @* <div class="viq-form-field">
                        <label for="categoryDescription">Description</label>
                        <textarea id="categoryDescription" class="viq-form-control viq-form-textarea" rows="2" @bind="category.Description" placeholder="Describe the assets that belong in this category..."></textarea>
                    </div> *@
                </div>
            </section>

            <section class="viq-form-section">
                <div class="viq-form-section-heading"><span><i class="bi bi-diagram-3"></i></span><div><h3>Asset classification</h3><p>Set liquidity and balance-sheet placement.</p></div></div>
                <div class="viq-toggle-grid">
                    <label class="viq-toggle-card" for="isCurrentAsset">
                        <span><strong>Current Asset</strong><small>Convertible to cash within one year.</small></span>
                        <input class="viq-switch" type="checkbox" id="isCurrentAsset" @onchange="OnClassificationChanged" />
                    </label>
                </div>
                <div class="viq-form-grid">
                    <div class="viq-form-field">
                        <label for="balanceSheetSection">Balance Sheet Section <span class="viq-required">*</span></label>
                        <select id="balanceSheetSection" class="viq-form-control @(HasError(nameof(category.BalanceSheetSection)) ? "invalid" : "")" @bind="category.BalanceSheetSection">
                            <option value="">-- Select Section --</option>
                            @foreach (var section in balanceSheetSections) { <option value="@section">@section</option> }
                        </select>
                        @if (HasError(nameof(category.BalanceSheetSection))) { <div class="viq-form-validation">@GetError(nameof(category.BalanceSheetSection))</div> }
                    </div>
                </div>
            </section>

            <section class="viq-form-section">
                <div class="viq-form-section-heading"><span><i class="bi bi-sort-numeric-down"></i></span><div><h3>Display settings</h3><p>Choose the category's position in lists and lookups.</p></div></div>
                <div class="viq-form-grid">
                    <div class="viq-form-field">
                        <label for="displayOrder">Display Order</label>
                        <input id="displayOrder" type="number" class="viq-form-control" @bind="category.DisplayOrder" step="1" min="0" placeholder="0" />
                    </div>
                </div>
                <label class="viq-toggle-card viq-toggle-card-wide" for="isActive">
                    <span><strong>@(category.Active ? "Category active" : "Category inactive")</strong><small>Inactive categories remain viewable but cannot be selected for new assets.</small></span>
                    <input class="viq-switch" type="checkbox" id="isActive" @bind="category.Active" />
                </label>
            </section>

            @if (!string.IsNullOrEmpty(category.CategoryName))
            {
                <div class="alert alert-info mb-0" role="status">
                    <strong>Preview:</strong> @category.CategoryName (@(category.IsCurrentAsset ? "Current Asset" : "Fixed Asset")) - @category.BalanceSheetSection
                    <span class="badge @(category.Active ? "bg-success" : "bg-secondary") ms-2">@(category.Active ? "Active" : "Inactive")</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success alert-dismissible fade show mb-0" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
                </div>
            }

            @if (validationErrors.Any())
            {
                <div class="viq-form-validation-summary" role="alert">
                    <strong>Review the following:</strong>
                    <ul class="mb-0">@foreach (var error in validationErrors) { <li>@error.Value</li> }</ul>
                </div>
            }

            <div class="viq-form-actions">
                <button type="button" class="viq-button viq-button-secondary" @onclick="HandleCancel">Cancel</button>
                <button type="submit" class="viq-button viq-button-primary" disabled="@isSaving">
                    @if (isSaving) { <span class="spinner-border spinner-border-sm" role="status"></span><span>Saving...</span> }
                    else { <i class="bi bi-check2-square"></i><span>@(category.AssetCategoryId == 0 ? "Add Category" : "Update Category")</span> }
                </button>
            </div>
        </form>
    }
</div>
