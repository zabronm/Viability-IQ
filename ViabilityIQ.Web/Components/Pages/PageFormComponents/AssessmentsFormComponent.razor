@using Microsoft.AspNetCore.Components.Forms
@using ViabilityIQ.Shared.DataModels
@using ViabilityIQ.Shared.SharedModels
@using ViabilityIQ.Web.Components.CommonComponents

<div class="zab-form-wrapper mb-4">
    @if (isProcessingData)
    {
        <div class="form-processing-overlay animate-fade-in">
            <div class="spinner-container-box">
                <div class="sleek-form-spinner"></div>
                <p class="processing-text-alert">Synchronizing Assessment Case Context...</p>
            </div>
        </div>
    }

    <EditForm Model="@assessmentModel" OnValidSubmit="HandleFormSubmissionAsync">
        <DataAnnotationsValidator />
        <ValidationSummary class="alert alert-danger p-0 small mb-1 list-unstyled" />

        <div class="p-0 mt-0">
            <!-- Left Side Grid Structural Form Controls -->
            @* <div class="col-md-6"> *@
            <div class="mb-3 mt-0">
                <label for="caseNumber" class="form-label-custom">Case Number</label>
                <InputText id="caseNumber" class="form-control-compact bg-light" @bind-Value="assessmentModel.CaseNumber" placeholder="SYSTEM GENERATED" disabled />
            </div>

            <div class="mb-1">
                <label class="form-label-custom">Business Name<span class="text-danger">*</span></label>
                <DDLookupComponent SourceKey="DDLookupEnums.Businesses"
                                   @bind-Value="assessmentModel.BusinessId" />
                <ValidationMessage For="() => assessmentModel.BusinessId" class="text-danger small" />
            </div>

            <div class="mb-1">
                <label class="form-label-custom">Assessment Type<span class="text-danger">*</span></label>
                <DDLookupComponent SourceKey="DDLookupEnums.AssessmentTypes"
                                   @bind-Value="assessmentModel.AssessmentTypeId" />
                <ValidationMessage For="() => assessmentModel.AssessmentTypeId" class="text-danger small" />
            </div>    

            <div class="mb-3">
                <label for="startDate" class="form-label-custom">Assessment Start Date</label>
                <input type="date" id="startDate" class="form-control-compact" value="@formattedStartDate" @onchange="OnStartDateChanged" />
            </div>
            <div class="mb-3">
                <label for="endDate" class="form-label-custom">Assessment Finish Date</label>
                <input type="date" id="endDate" class="form-control-compact" value="@formattedEndDate" @onchange="OnEndDateChanged" />
            </div>
        </div>        

        <!-- Remarks/Internal Description Field -->
        <div class="col-12 mb-2">
            <label for="remarks" class="form-label-custom">Remarks & Internal Notes</label>
            <InputTextArea id="remarks" class="form-control-compact form-control-compact-textarea" rows="3" @bind-Value="assessmentModel.Remarks" placeholder="Enter diagnostic assignment metadata background statements..." />
        </div>

        <div class="d-flex align-items-center justify-content-end gap-2 pt-3">
            <button type="submit" class="btn btn-primary btn-submit-compact w-100" disabled="@isProcessingData">
                @if (isProcessingData)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Saving Record Context...</span>
                }
                else
                {
                    <i class="bi bi-check2-square me-1.5"></i>
                    <span>@(AssessmentId == 0 ? "Commit New Case File" : "Apply Modifications")</span>
                }
            </button>
        </div>
    </EditForm>
</div>
