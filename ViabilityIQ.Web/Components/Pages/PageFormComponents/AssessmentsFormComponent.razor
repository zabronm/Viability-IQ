@using Microsoft.AspNetCore.Components.Forms
@using ViabilityIQ.Shared.DataModels
@using ViabilityIQ.Shared.SharedModels
@using ViabilityIQ.Web.Components.CommonComponents

<div class="viq-form-shell">
    @if (isProcessingData)
    {
        <div class="viq-form-busy" role="status" aria-live="polite">
            <div class="viq-form-busy-card">
                <span class="viq-form-spinner" aria-hidden="true"></span>
                <div>
                    <strong>Processing assessment</strong>
                    <span>Synchronizing assessment case context.</span>
                </div>
            </div>
        </div>
    }

    <EditForm Model="@assessmentModel" OnValidSubmit="HandleFormSubmissionAsync"
              class="viq-data-form" aria-label="Assessment details">
        <DataAnnotationsValidator />

        @* <div class="viq-form-intro">
            <span class="viq-form-intro-icon"><i class="bi bi-clipboard2-pulse" aria-hidden="true"></i></span>
            <div>
                <h2>@(AssessmentId == 0 ? "New assessment" : "Assessment details")</h2>
                <p>Define the business, assessment type and review period for this case.</p>
            </div>
        </div>
 *@
        <ValidationSummary class="viq-form-validation-summary" />
        @if (!string.IsNullOrWhiteSpace(formError))
        {
            <div class="alert alert-danger" role="alert">@formError</div>
        }

        <section class="viq-form-section">
            <header class="viq-form-section-heading">
                <span><i class="bi bi-folder2-open" aria-hidden="true"></i></span>
                <div>
                    <h3>Case details</h3>
                    <p>Core case identity and assessment classification.</p>
                </div>
            </header>

            <div class="viq-form-grid viq-form-grid-2">
                <div class="viq-form-field viq-form-span-2">
                    <label for="caseNumber">Case number</label>
                    <InputText id="caseNumber" class="viq-form-control"
                               @bind-Value="assessmentModel.CaseNumber"
                               placeholder="SYSTEM GENERATED" disabled />
                </div>
                <div class="viq-form-field viq-form-span-2">
                    <label>Business name <span class="viq-required">*</span></label>
                    <DDLookupComponent SourceKey="DDLookupEnums.Businesses"
                                       @bind-Value="assessmentModel.BusinessId" />
                    <ValidationMessage For="() => assessmentModel.BusinessId" class="viq-form-validation" />
                </div>
                <div class="viq-form-field viq-form-span-2">
                    <label for="assessmentMode">Assessment mode <span class="viq-required">*</span></label>
                    <InputSelect id="assessmentMode" class="viq-form-control"
                                 disabled="@(AssessmentId > 0)"
                                 @bind-Value="assessmentModel.AssessmentModeId">
                        <option value="@((int)AssessmentMode.Trading)">Trading</option>
                        <option value="@((int)AssessmentMode.Service)">Service</option>
                        <option value="@((int)AssessmentMode.Manufacturing)">Manufacturing</option>
                        @if (AssessmentId > 0
                            && assessmentModel.AssessmentModeId == (int)AssessmentMode.ManufacturingSimplified)
                        {
                            <option value="@((int)AssessmentMode.ManufacturingSimplified)">
                                Manufacturing (legacy simplified)
                            </option>
                        }
                    </InputSelect>
                    <small class="assessment-field-annotation">
                        Choose the operating model for this assessment.
                        @(AssessmentId > 0 ? "The mode is fixed after creation to prevent existing data being reinterpreted." : string.Empty)
                    </small>
                </div>
                @if (assessmentModel.AssessmentModeId == (int)AssessmentMode.Manufacturing)
                {
                    <div class="viq-form-field viq-form-span-2">
                        <span>Production estimate method <span class="viq-required">*</span></span>
                        <InputRadioGroup TValue="int" @bind-Value="assessmentModel.ManufacturingInputMethodId"
                                        class="manufacturing-method-options">
                            <label class="manufacturing-method-option">
                                <InputRadio TValue="int" Value="@((int)ManufacturingInputMethod.MonthlyEstimates)" />
                                <span>Monthly Estimates</span>
                                <span class="manufacturing-help-tip" tabindex="0"
                                      aria-label="Monthly Estimates: enter material purchases and closing raw-material quantities by month, plus month-end WIP and finished-goods values. Costs are derived through inventory roll-forwards; inconsistent balances are flagged.">
                                    <i class="bi bi-info-circle" aria-hidden="true"></i>
                                    <span class="manufacturing-help-tooltip" role="tooltip">
                                        Enter raw-material purchases and month-end quantities, plus WIP and finished-goods values. The projection derives material use, completed production cost and cost of sales, and flags inconsistent balances.
                                    </span>
                                </span>
                            </label>
                            <label class="manufacturing-method-option is-unavailable">
                                <input type="radio" disabled />
                                <span>BOM-based <small>(planned)</small></span>
                                <span class="manufacturing-help-tip" tabindex="0"
                                      aria-label="BOM-based: define material quantities for repeatable products. The system would estimate material requirements from planned production. This option is planned and is not available yet.">
                                    <i class="bi bi-info-circle" aria-hidden="true"></i>
                                    <span class="manufacturing-help-tooltip" role="tooltip">
                                        Intended for repeatable products: define the materials and quantities used for each product, then estimate material requirements from planned production. This method is planned and is not available yet.
                                    </span>
                                </span>
                            </label>
                            <label class="manufacturing-method-option is-unavailable">
                                <input type="radio" disabled />
                                <span>Job-based <small>(planned)</small></span>
                                <span class="manufacturing-help-tip" tabindex="0"
                                      aria-label="Job-based: estimate materials and production costs for custom jobs without defining a product recipe. This option is planned and is not available yet.">
                                    <i class="bi bi-info-circle" aria-hidden="true"></i>
                                    <span class="manufacturing-help-tooltip" role="tooltip">
                                        Intended for custom work: estimate materials and production costs by job or job category without maintaining a product recipe. This method is planned and is not available yet.
                                    </span>
                                </span>
                            </label>
                        </InputRadioGroup>
                        <small class="assessment-field-annotation">
                            Monthly Estimates is the current default. BOM-based and job-based workflows are planned and cannot yet be selected.
                        </small>
                    </div>
                }
                @if (assessmentModel.AssessmentModeId == (int)AssessmentMode.ManufacturingSimplified)
                {
                    <div class="alert alert-warning viq-form-span-2">
                        This assessment uses the legacy simplified Manufacturing projection. Its existing inputs are preserved and are not reinterpreted by the new Manufacturing method.
                    </div>
                }
            </div>
        </section>

        <section class="viq-form-section">
            <header class="viq-form-section-heading">
                <span><i class="bi bi-globe2" aria-hidden="true"></i></span>
                <div>
                    <h3>International settings</h3>
                    <p>Set the assessment's English locale and single reporting currency. No currency conversion is performed.</p>
                </div>
            </header>
            <div class="viq-form-grid viq-form-grid-2">
                <div class="viq-form-field">
                    <label for="assessmentCulture">Country and format locale</label>
                    <InputSelect TValue="string" id="assessmentCulture" class="viq-form-control"
                                 Value="@assessmentModel.CultureName"
                                 ValueChanged="@(cultureName => OnCultureChanged(cultureName))"
                                 ValueExpression="() => assessmentModel.CultureName">
                        @foreach (var locale in AssessmentLocaleOptions.EnglishCultures)
                        {
                            <option value="@locale.CultureName">@locale.DisplayName</option>
                        }
                    </InputSelect>
                    <small class="assessment-field-annotation">Controls English date and number conventions for this assessment.</small>
                </div>
                <div class="viq-form-field">
                    <label for="assessmentCurrency">Reporting currency</label>
                    <InputSelect id="assessmentCurrency" class="viq-form-control"
                                 @bind-Value="assessmentModel.CurrencyCode">
                        @foreach (var currencyCode in AssessmentLocaleOptions.CurrencyCodes)
                        {
                            <option value="@currencyCode">@currencyCode</option>
                        }
                    </InputSelect>
                    <small class="assessment-field-annotation">Amounts are entered and calculated in this currency; they are not converted.</small>
                </div>
                <div class="viq-form-field viq-form-span-2">
                    <span class="text-muted">
                        Preview: @LocaleDateSample · @LocaleNumberSample · @assessmentModel.CurrencyCode
                    </span>
                </div>
            </div>
        </section>

        <section class="viq-form-section">
            <header class="viq-form-section-heading">
                <span><i class="bi bi-calendar-range" aria-hidden="true"></i></span>
                <div>
                    <h3>Assessment period</h3>
                    <p>Set the planned start and finish dates.</p>
                </div>
            </header>

            <div class="viq-form-grid viq-form-grid-2">
                <div class="viq-form-field">
                    <label for="startDate">Assessment start date <span class="viq-required">*</span></label>
                    <input type="date" id="startDate" class="viq-form-control"
                           value="@formattedStartDate" @onchange="OnStartDateChanged" />
                </div>
                <div class="viq-form-field">
                    <label for="endDate">Assessment finish date</label>
                    <input type="date" id="endDate" class="viq-form-control"
                           value="@formattedEndDate" @onchange="OnEndDateChanged" />
                </div>
            </div>
        </section>

        <section class="viq-form-section">
            <header class="viq-form-section-heading">
                <span><i class="bi bi-card-text" aria-hidden="true"></i></span>
                <div>
                    <h3>Internal notes</h3>
                    <p>Add background information for the assessment team.</p>
                </div>
            </header>

            <div class="viq-form-field">
                <label for="remarks">Remarks and internal notes</label>
                <InputTextArea id="remarks" class="viq-form-control viq-form-textarea" rows="3"
                               @bind-Value="assessmentModel.Remarks"
                               placeholder="Enter diagnostic assignment metadata background statements..." />
            </div>
        </section>
        <section class="viq-form-section">
            <div class="viq-form-section-heading"><span><i class="bi bi-toggles"></i></span><div><h3>Availability</h3><p>Control whether this assessment can be selected.</p></div></div>
            <label class="viq-toggle-card viq-toggle-card-wide" for="isActive">
                <span><strong>@(isRowActive ? "Assessment active" : "Assessment inactive")</strong><small>Inactive assessments remain visible on existing records.</small></span>
                <InputCheckbox id="isActive" class="viq-switch" @bind-Value="isRowActive" />
            </label>
        </section>

        <footer class="viq-form-actions">
            <button type="submit" class="viq-button viq-button-primary" disabled="@isProcessingData">
                @if (isProcessingData)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Saving Record Context...</span>
                }
                else
                {
                    <i class="bi bi-check2-square" aria-hidden="true"></i>
                    <span>@(AssessmentId == 0 ? "Commit New Case File" : "Apply Modifications")</span>
                }
            </button>
        </footer>
    </EditForm>
</div>
