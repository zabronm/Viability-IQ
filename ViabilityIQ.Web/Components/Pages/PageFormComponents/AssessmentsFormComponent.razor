@using Microsoft.AspNetCore.Components.Forms
@using ViabilityIQ.Shared.DataModels
@using ViabilityIQ.Shared.SharedModels
@using ViabilityIQ.Web.Components.CommonComponents

<div class="viq-form-shell">
    @if (isProcessingData)
    {
        <div class="viq-form-busy" role="status" aria-live="polite">
            <div class="viq-form-busy-card">
                <span class="viq-form-spinner" aria-hidden="true"></span>
                <div>
                    <strong>Processing assessment</strong>
                    <span>Synchronizing assessment case context.</span>
                </div>
            </div>
        </div>
    }

    <EditForm Model="@assessmentModel" OnValidSubmit="HandleFormSubmissionAsync"
              class="viq-data-form" aria-label="Assessment details">
        <DataAnnotationsValidator />

        <div class="viq-form-intro">
            <span class="viq-form-intro-icon"><i class="bi bi-clipboard2-pulse" aria-hidden="true"></i></span>
            <div>
                <h2>@(AssessmentId == 0 ? "New assessment" : "Assessment details")</h2>
                <p>Define the business, assessment type and review period for this case.</p>
            </div>
        </div>

        <ValidationSummary class="viq-form-validation-summary" />

        <section class="viq-form-section">
            <header class="viq-form-section-heading">
                <span><i class="bi bi-folder2-open" aria-hidden="true"></i></span>
                <div>
                    <h3>Case details</h3>
                    <p>Core case identity and assessment classification.</p>
                </div>
            </header>

            <div class="viq-form-grid viq-form-grid-2">
                <div class="viq-form-field viq-form-span-2">
                    <label for="caseNumber">Case number</label>
                    <InputText id="caseNumber" class="viq-form-control"
                               @bind-Value="assessmentModel.CaseNumber"
                               placeholder="SYSTEM GENERATED" disabled />
                </div>
                <div class="viq-form-field">
                    <label>Business name <span class="viq-required">*</span></label>
                    <DDLookupComponent SourceKey="DDLookupEnums.Businesses"
                                       @bind-Value="assessmentModel.BusinessId" />
                    <ValidationMessage For="() => assessmentModel.BusinessId" class="viq-form-validation" />
                </div>
                <div class="viq-form-field">
                    <label>Assessment type <span class="viq-required">*</span></label>
                    <DDLookupComponent SourceKey="DDLookupEnums.AssessmentTypes"
                                       @bind-Value="assessmentModel.AssessmentTypeId" />
                    <ValidationMessage For="() => assessmentModel.AssessmentTypeId" class="viq-form-validation" />
                </div>
            </div>
        </section>

        <section class="viq-form-section">
            <header class="viq-form-section-heading">
                <span><i class="bi bi-calendar-range" aria-hidden="true"></i></span>
                <div>
                    <h3>Assessment period</h3>
                    <p>Set the planned start and finish dates.</p>
                </div>
            </header>

            <div class="viq-form-grid viq-form-grid-2">
                <div class="viq-form-field">
                    <label for="startDate">Assessment start date <span class="viq-required">*</span></label>
                    <input type="date" id="startDate" class="viq-form-control"
                           value="@formattedStartDate" @onchange="OnStartDateChanged" />
                </div>
                <div class="viq-form-field">
                    <label for="endDate">Assessment finish date</label>
                    <input type="date" id="endDate" class="viq-form-control"
                           value="@formattedEndDate" @onchange="OnEndDateChanged" />
                </div>
            </div>
        </section>

        <section class="viq-form-section">
            <header class="viq-form-section-heading">
                <span><i class="bi bi-card-text" aria-hidden="true"></i></span>
                <div>
                    <h3>Internal notes</h3>
                    <p>Add background information for the assessment team.</p>
                </div>
            </header>

            <div class="viq-form-field">
                <label for="remarks">Remarks and internal notes</label>
                <InputTextArea id="remarks" class="viq-form-control viq-form-textarea" rows="3"
                               @bind-Value="assessmentModel.Remarks"
                               placeholder="Enter diagnostic assignment metadata background statements..." />
            </div>
        </section>

        <footer class="viq-form-actions">
            <button type="submit" class="viq-button viq-button-primary" disabled="@isProcessingData">
                @if (isProcessingData)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Saving Record Context...</span>
                }
                else
                {
                    <i class="bi bi-check2-square" aria-hidden="true"></i>
                    <span>@(AssessmentId == 0 ? "Commit New Case File" : "Apply Modifications")</span>
                }
            </button>
        </footer>
    </EditForm>
</div>
