@using Microsoft.AspNetCore.Components.Forms
@using ViabilityIQ.Shared.DataModels
@using ViabilityIQ.Shared.SharedModels
@using ViabilityIQ.Web.Components.CommonComponents

<div class="zab-form-wrapper mb-4">
    @if (isProcessingData)
    {
        <div class="form-processing-overlay animate-fade-in">
            <div class="spinner-container-box">
                <div class="sleek-form-spinner"></div>
                <p class="processing-text-alert">Synchronizing Workspace Dataset...</p>
            </div>
        </div>
    }

    <EditForm Model="productServiceModel" OnValidSubmit="HandleFormSubmissionAsync">
        <DataAnnotationsValidator />
        <ValidationSummary class="alert alert-danger p-2 small mb-3 list-unstyled" />
        
        <div class="mb-3">
            <label for="prodName" class="form-label-custom">Product/Service Name<span class="text-danger">*</span></label>
            <InputText id="prodName" class="form-control-compact" @bind-Value="productServiceModel.ProductName" />
            <ValidationMessage For="@(() => productServiceModel.ProductName)" class="text-danger small mt-1" />
        </div>

        <div class="mb-3">
            <label for="otherName" class="form-label-custom">Other Name/s<span class="text-danger">*</span></label>
            <InputText id="otherName" class="form-control-compact" @bind-Value="productServiceModel.OtherName" />
            <ValidationMessage For="@(() => productServiceModel.OtherName)" class="text-danger small mt-1" />
        </div>

        <div class="mb-3">
            <label for="categoryName" class="form-label-custom">Product Category<span class="text-danger">*</span></label>
            <DDLookupComponent SourceKey="DDLookupEnums.ProductServiceCategories"
                                   Label="Product Category"
                                   @bind-Value="productServiceModel.ProductCategoryId" />
                <ValidationMessage For="() => productServiceModel.ProductCategoryId" class="text-danger small" />
           
        </div>
               
        <div class="mb-3">
            <label for="MarkupPC" class="form-label-custom">Markup(%) <span class="text-danger">*</span></label>
            <InputNumber id="MarkupPC" class="form-control-compact" @bind-Value="productServiceModel.MarkupPercentage" />
            <ValidationMessage For="@(() => productServiceModel.MarkupPercentage)" class="text-danger small mt-1" />
        </div>

        <div class="mb-4">
            <label for="remarks" class="form-label-custom">Internal Notes & Description</label>
            <InputTextArea id="remarks" class="form-control-compact form-control-compact-textarea" rows="2" @bind-Value="productServiceModel.Remarks" />
            <ValidationMessage For="@(() => productServiceModel.Remarks)" class="text-danger small mt-1" />
        </div>

        <div class="mb-3 d-flex align-items-center justify-content-start ">
            <label class="col-4 form-label-custom m-0 clickable-label" for="isActive">
                @(isRowActive ? "Product Active" : "Product Not-Active")
            </label>
            <div class="form-check form-switch p-0 m-0 d-flex align-items-center col-2">
                <InputCheckbox id="isActive" class="form-check-input style-toggle-switch-right" @bind-Value="isRowActive" />
            </div>
        </div>

        <div class="d-flex align-items-center justify-content-end gap-2 pt-3 border-top">
            <button type="submit" class="btn btn-primary btn-submit-compact w-100" disabled="@isProcessingData">
                @if (isProcessingData)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <i class="bi bi-check2-square me-1.5"></i>
                    <span>@(ProductServiceId == 0 ? "Add Product/Service" : "Update Product/Service")</span>
                }
            </button>
        </div>
    </EditForm>
</div>