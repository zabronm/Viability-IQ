@using Microsoft.AspNetCore.Components.Forms
@using ViabilityIQ.Shared.DataModels
@using ViabilityIQ.Shared.SharedModels
@using ViabilityIQ.Web.Components.CommonComponents

<div class="viq-form-shell">
    @if (isProcessingData)
    {
        <div class="viq-form-busy" role="status" aria-live="polite">
            <div class="viq-form-busy-card">
                <span class="viq-form-spinner" aria-hidden="true"></span>
                <div>
                    <strong>Processing expense item</strong>
                    <span>Synchronizing expense matrix ledger data.</span>
                </div>
            </div>
        </div>
    }

    <EditForm Model="@expenseModel" OnValidSubmit="HandleFormSubmissionAsync"
              class="viq-data-form" aria-label="Expense item details">
        <DataAnnotationsValidator />

        <div class="viq-form-intro">
            <span class="viq-form-intro-icon"><i class="bi bi-receipt" aria-hidden="true"></i></span>
            <div>
                <h2>@(ExpenseItemId == 0 ? "New expense item" : "Expense item details")</h2>
                <p>Maintain a reusable cost line for assessment expense planning.</p>
            </div>
        </div>

        <ValidationSummary class="viq-form-validation-summary" />

        <section class="viq-form-section">
            <header class="viq-form-section-heading">
                <span><i class="bi bi-cash-stack" aria-hidden="true"></i></span>
                <div>
                    <h3>Expense information</h3>
                    <p>Name and describe this cost line.</p>
                </div>
            </header>

            <div class="viq-form-grid">
                <div class="viq-form-field">
                    <label for="expenseItemName">Expense item name</label>
                    <InputText id="expenseItemName" class="viq-form-control"
                               @bind-Value="expenseModel.ExpenseItemName"
                               placeholder="e.g. Fuel, Salaries, Logistics" />
                    <ValidationMessage For="@(() => expenseModel.ExpenseItemName)" class="viq-form-validation" />
                </div>
                <div class="viq-form-field">
                    <label for="remarks">Internal notes and description</label>
                    <InputTextArea id="remarks" class="viq-form-control viq-form-textarea" rows="3"
                                   @bind-Value="expenseModel.Remarks"
                                   placeholder="Provide context parameters for this cost line..." />
                    <ValidationMessage For="@(() => expenseModel.Remarks)" class="viq-form-validation" />
                </div>
            </div>

            <label class="viq-toggle-card viq-toggle-card-wide" for="isActive">
                <span>
                    <strong>@(isRowActive ? "Item line active" : "Item line suspended")</strong>
                    <small>Suspended items remain available in historical records.</small>
                </span>
                <InputCheckbox id="isActive" class="viq-switch" @bind-Value="isRowActive" />
            </label>
        </section>

        <footer class="viq-form-actions">
            <button type="submit" class="viq-button viq-button-primary" disabled="@isProcessingData">
                @if (isProcessingData)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Saving Context Details...</span>
                }
                else
                {
                    <i class="bi bi-check2-square" aria-hidden="true"></i>
                    <span>@(ExpenseItemId == 0 ? "Commit New Expense Item" : "Save Structural Updates")</span>
                }
            </button>
        </footer>
    </EditForm>
</div>
