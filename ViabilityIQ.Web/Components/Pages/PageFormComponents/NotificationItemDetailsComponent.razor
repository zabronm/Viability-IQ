@using ViabilityIQ.Shared.DataModels

<div class="zab-form-wrapper mb-4">
    <div class="mb-3">
        <span class="badge @(NotificationItemData.IsTask ? "bg-warning text-dark" : "bg-info text-dark") mb-2">
            @(NotificationItemData.IsTask ? "Assigned Task" : "Direct Message")
        </span>
        @if (!string.IsNullOrWhiteSpace(NotificationItemData.AssessmentNumber))
        {
            <span class="badge bg-light text-secondary border mb-2 ms-1">
                <i class="bi bi-folder2-open me-1"></i> Case: @NotificationItemData.AssessmentNumber
            </span>
        }
        <h4 class="text-dark fw-bold fs-5 mb-1">@NotificationItemData.Title</h4>
        <small class="text-muted d-block mb-3">Received on: @NotificationItemData.CreatedDate.ToString("dd MMM yyyy, HH:mm")</small>
    </div>

    <div class="p-3 bg-light rounded border mb-3">
        <p class="text-secondary mb-0" style="white-space: pre-wrap; line-height: 1.5;">@NotificationItemData.Message</p>
    </div>

    @if (NotificationItemData.IsTask && NotificationItemData.DueDate.HasValue)
    {
        <div class="alert alert-warning py-2 small mb-3">
            <i class="bi bi-calendar-event me-1"></i> <strong>Due Date:</strong> @NotificationItemData.DueDate.Value.ToString("yyyy-MM-dd")
        </div>
    }

    <div class="d-flex flex-column gap-2 mt-4 pt-3 border-top">
        @if (NotificationItemData.IsTask && NotificationItemData.TaskStatus != TaskStatusType.Completed)
        {
            <button class="btn btn-success btn-sm w-100" @onclick="MarkCompletedAsync">
                <i class="bi bi-check-lg me-1"></i> Mark Task as Completed
            </button>
        }
        <button class="btn btn-outline-secondary btn-sm w-100" @onclick="CloseDrawerAsync">Close</button>
    </div>
</div>