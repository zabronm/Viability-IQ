@using Microsoft.AspNetCore.Components.Forms
@using ViabilityIQ.Shared.DataModels
@using ViabilityIQ.Web.Components.CommonComponents

<div class="zab-form-wrapper mb-4">
    @if (isProcessingData)
    {
        <div class="form-processing-overlay animate-fade-in">
            <div class="spinner-container-box">
                <div class="sleek-form-spinner"></div>
                <p class="processing-text-alert">Synchronizing Workspace Dataset...</p>
            </div>
        </div>
    }

    <EditForm Model="@productCategoryModel" OnValidSubmit="HandleFormSubmissionAsync">
        <DataAnnotationsValidator />

        <ValidationSummary class="alert alert-danger p-2 small mb-3 list-unstyled" />

        <div class="mb-2">
            <label for="categoryName" class="form-label-custom">Product Category Name <span class="text-danger">*</span></label>
            <InputText id="categoryName" class="form-control-compact" @bind-Value="productCategoryModel.ProductCategoryName" />
            <ValidationMessage For="@(() =>productCategoryModel.ProductCategoryName)" class="text-danger small mt-1" />
        </div>

        <div class="mb-2">
            <label class="form-label-custom">Income/Revenue Type<span class="text-danger">*</span></label>
            <DDLookupComponent SourceKey="DDLookupEnums.IncomeTypes"
                               @bind-Value="productCategoryModel.IncomeTypeId" />
            <ValidationMessage For="() => productCategoryModel.IncomeTypeId" class="text-danger small" />
        </div>

        <div class="mb-2">
            <label for="UoM" class="form-label-custom">Unit Of Measure(Kgs, Meters, etc) <span class="text-danger">*</span></label>
            <InputText id="UoM" class="form-control-compact" @bind-Value="productCategoryModel.UOM" />
            <ValidationMessage For="@(() => productCategoryModel.UOM)" class="text-danger small mt-1" />
        </div>

        <div class="mb-2">
            <label for="MarkupPC" class="form-label-custom">Markup(%) <span class="text-danger">*</span></label>
            <InputNumber id="MarkupPC" class="form-control-compact" @bind-Value="productCategoryModel.MarkupPercentage" />
            <ValidationMessage For="@(() => productCategoryModel.MarkupPercentage)" class="text-danger small mt-1" />
        </div>

        <div class="mb-2">
            <label for="remarks" class="form-label-custom">Internal Notes & Description</label>
            <InputTextArea id="remarks" class="form-control-compact form-control-compact-textarea" rows="2" @bind-Value="productCategoryModel.Remarks" />
            <ValidationMessage For="@(() => productCategoryModel.Remarks)" class="text-danger small mt-1" />
        </div>

        <div class="mb-2 d-flex align-items-center justify-content-start ">
            <label class="col-4 form-label-custom m-0 clickable-label" for="isActive">
                @(isRowActive ? "Category Active" : "Category Not-Active")
            </label>
            <div class="form-check form-switch p-0 m-0 d-flex align-items-center col-2">
                <InputCheckbox id="isActive" class="form-check-input style-toggle-switch-right" @bind-Value="isRowActive" />
            </div>
        </div>       

        <div class="d-flex align-items-center justify-content-end gap-2 pt-3 border-top">
            <button type="submit" class="btn btn-primary btn-submit-compact w-100" disabled="@isProcessingData">
                @if (isProcessingData)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <i class="bi bi-check2-square me-1.5"></i>
                    <span>@(ProductCategoryId == 0 ? "Commit Record" : "Apply Modifications")</span>
                }
            </button>
        </div>
    </EditForm>
</div>