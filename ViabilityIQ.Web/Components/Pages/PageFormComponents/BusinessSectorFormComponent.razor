@using Microsoft.AspNetCore.Components.Forms
@using ViabilityIQ.Shared.DataModels
@using ViabilityIQ.Shared.SharedModels
@using ViabilityIQ.Web.Components.CommonComponents

<div class="zab-form-wrapper mb-4">
    @if (isProcessingData)
    {
        <div class="form-processing-overlay animate-fade-in">
            <div class="spinner-container-box">
                <div class="sleek-form-spinner"></div>
                <p class="processing-text-alert">Synchronizing Sector Ledger Data...</p>
            </div>
        </div>
    }

    <EditForm Model="@sectorModel" OnValidSubmit="HandleFormSubmissionAsync">
        <DataAnnotationsValidator />
        <ValidationSummary class="alert alert-danger p-2 small mb-3 list-unstyled" />

        <div class="mb-3">
            <label for="sectorName" class="form-label-custom">Business Sector Name <span class="text-danger">*</span></label>
            <InputText id="sectorName" class="form-control-compact" @bind-Value="sectorModel.BusinessSectorName" placeholder="e.g. Agriculture, Fintech" />
            <ValidationMessage For="@(() => sectorModel.BusinessSectorName)" class="text-danger small mt-1" />
        </div>

        <div class="col-12 mb-4">
            <label for="remarks" class="form-label-custom">Internal Notes & Descriptions</label>
            <InputTextArea id="remarks" class="form-control-compact form-control-compact-textarea" rows="3" @bind-Value="sectorModel.Remarks" placeholder="Define sector scope parameters..." />
            <ValidationMessage For="@(() => sectorModel.Remarks)" class="text-danger small mt-1" />
        </div>

        <div class="col-12 mb-4 d-flex align-items-center justify-content-start">
            <label class="form-label-custom m-0 clickable-label me-3" for="isActive" style="min-width: 140px;">
                @(isRowActive ? "Classification Active" : "Classification Suspended")
            </label>
            <div class="form-check form-switch p-0 m-0 d-flex align-items-center">
                <InputCheckbox id="isActive" class="form-check-input style-toggle-switch-right" @bind-Value="isRowActive" />
            </div>
        </div>

        <div class="d-flex align-items-center justify-content-end gap-2 pt-3 border-top">
            <button type="submit" class="btn btn-primary btn-submit-compact w-100" disabled="@isProcessingData">
                @if (isProcessingData)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Saving Record Context...</span>
                }
                else
                {
                    <i class="bi bi-check2-square me-1.5"></i>
                    <span>@(BusinessSectorId == 0 ? "Create Sector Track" : "Apply Modifications")</span>
                }
            </button>
        </div>
    </EditForm>
</div>