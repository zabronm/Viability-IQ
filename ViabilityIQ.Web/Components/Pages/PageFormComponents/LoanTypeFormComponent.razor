@using Microsoft.AspNetCore.Components.Forms
@using ViabilityIQ.Shared.DataModels
@using ViabilityIQ.Web.Components.CommonComponents

<div class="viq-form-shell">
    @if (isProcessingData)
    {
        <div class="viq-form-busy"><div class="viq-form-busy-card"><span class="viq-form-spinner"></span><div><strong>Saving loan type</strong><span>Synchronizing the workspace record...</span></div></div></div>
    }

    <EditForm Model="@loanTypeModel" OnValidSubmit="HandleFormSubmissionAsync" class="viq-data-form">
        <DataAnnotationsValidator />
        <ValidationSummary class="viq-form-validation-summary" />

        @* <div class="viq-form-intro">
            <span class="viq-form-intro-icon"><i class="bi bi-cash-coin"></i></span>
            <div><h2>Loan type</h2><p>Maintain funding product names and reference descriptions.</p></div>
        </div> *@

        <section class="viq-form-section">
            <div class="viq-form-section-heading"><span><i class="bi bi-card-list"></i></span><div><h3>Loan classification</h3><p>Information used when capturing finance facilities.</p></div></div>
            <div class="viq-form-grid viq-form-grid-2">
                <div class="viq-form-field viq-form-span-2">
                    <label for="bankName">Loan Type Name <span class="viq-required">*</span></label>
                    <InputText id="bankName" class="viq-form-control" @bind-Value="loanTypeModel.LoanTypeName" />
                    <ValidationMessage For="@(() => loanTypeModel.LoanTypeName)" class="viq-form-validation" />
                </div>
                <div class="viq-form-field viq-form-span-2">
                    <label for="shortName">Other Name/s</label>
                    <InputText id="shortName" class="viq-form-control" @bind-Value="loanTypeModel.ShortName" />
                    <ValidationMessage For="@(() => loanTypeModel.ShortName)" class="viq-form-validation" />
                </div>
                <div class="viq-form-field viq-form-span-2">
                    <label for="remarks">Internal Notes &amp; Description</label>
                    <InputTextArea id="remarks" class="viq-form-control viq-form-textarea" rows="2" @bind-Value="loanTypeModel.Remarks" />
                    <ValidationMessage For="@(() => loanTypeModel.Remarks)" class="viq-form-validation" />
                </div>
            </div>
        </section>

        <section class="viq-form-section">
            <div class="viq-form-section-heading"><span><i class="bi bi-toggles"></i></span><div><h3>Availability</h3><p>Control whether this loan type can be selected.</p></div></div>
            <label class="viq-toggle-card viq-toggle-card-wide" for="isActive">
                <span><strong>@(isRowActive ? "Loan type active" : "Loan type inactive")</strong><small>Inactive loan types remain visible on existing records.</small></span>
                <InputCheckbox id="isActive" class="viq-switch" @bind-Value="isRowActive" />
            </label>
        </section>

        <div class="viq-form-actions">
            <button type="submit" class="viq-button viq-button-primary" disabled="@isProcessingData">
                @if (isProcessingData) { <span class="spinner-border spinner-border-sm" role="status"></span><span>Saving...</span> }
                else { <i class="bi bi-check2-square"></i><span>@(LoanTypeId == 0 ? "Add Loan Type" : "Update Loan Type")</span> }
            </button>
        </div>
    </EditForm>
</div>
