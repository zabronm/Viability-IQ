@using Microsoft.AspNetCore.Components.Forms
@using ViabilityIQ.Shared.DataModels
@using ViabilityIQ.Web.Components.CommonComponents

<div class="viq-form-shell">
    @if (isProcessingData)
    {
        <div class="viq-form-busy">
            <div class="viq-form-busy-card"><span class="viq-form-spinner"></span><div><strong>Saving company</strong><span>Synchronizing the organisation record...</span></div></div>
        </div>
    }

    <EditForm Model="@companyModel" OnValidSubmit="HandleFormSubmissionAsync" class="viq-data-form">
        <DataAnnotationsValidator />
        <ValidationSummary class="viq-form-validation-summary" />

        <div class="viq-form-intro">
            <span class="viq-form-intro-icon"><i class="bi bi-buildings"></i></span>
            <div><h2>Company details</h2><p>Maintain the organisation identity and primary contact information.</p></div>
        </div>

        <section class="viq-form-section">
            <div class="viq-form-section-heading"><span><i class="bi bi-building"></i></span><div><h3>Organisation</h3><p>Core company and customer reference information.</p></div></div>
            <div class="viq-form-grid viq-form-grid-2">
                <div class="viq-form-field">
                    <label for="companyName">Company Name</label>
                    <InputText id="companyName" class="viq-form-control" @bind-Value="companyModel.CompanyName" />
                    <ValidationMessage For="@(() => companyModel.CompanyName)" class="viq-form-validation" />
                </div>
                <div class="viq-form-field">
                    <label for="customerCode">Customer Code</label>
                    <InputText id="customerCode" class="viq-form-control" @bind-Value="companyModel.CompanyCustomerCode" />
                    <ValidationMessage For="@(() => companyModel.CompanyCustomerCode)" class="viq-form-validation" />
                </div>
            </div>
        </section>

        <section class="viq-form-section">
            <div class="viq-form-section-heading"><span><i class="bi bi-person-lines-fill"></i></span><div><h3>Contact details</h3><p>Primary person and communication channels.</p></div></div>
            <div class="viq-form-grid viq-form-grid-2">
                <div class="viq-form-field">
                    <label for="contactPerson">Contact Person</label>
                    <InputText id="contactPerson" class="viq-form-control" @bind-Value="companyModel.ContactPerson" />
                    <ValidationMessage For="@(() => companyModel.ContactPerson)" class="viq-form-validation" />
                </div>
                <div class="viq-form-field">
                    <label for="telephone">Telephone</label>
                    <InputText id="telephone" class="viq-form-control" @bind-Value="companyModel.Telephone" />
                    <ValidationMessage For="@(() => companyModel.Telephone)" class="viq-form-validation" />
                </div>
                <div class="viq-form-field">
                    <label for="mobile">Mobile</label>
                    <InputText id="mobile" class="viq-form-control" @bind-Value="companyModel.Mobile" />
                    <ValidationMessage For="@(() => companyModel.Mobile)" class="viq-form-validation" />
                </div>
                <div class="viq-form-field">
                    <label for="email">Email</label>
                    <InputText id="email" class="viq-form-control" @bind-Value="companyModel.Email" />
                    <ValidationMessage For="@(() => companyModel.Email)" class="viq-form-validation" />
                </div>
                <div class="viq-form-field viq-form-span-2">
                    <label for="website">Website</label>
                    <InputText id="website" class="viq-form-control" @bind-Value="companyModel.Website" />
                    <ValidationMessage For="@(() => companyModel.Website)" class="viq-form-validation" />
                </div>
            </div>
        </section>

        <section class="viq-form-section">
            <div class="viq-form-section-heading"><span><i class="bi bi-journal-text"></i></span><div><h3>Administration</h3><p>Internal context and record availability.</p></div></div>
            <div class="viq-form-grid">
                <div class="viq-form-field">
                    <label for="remarks">Internal Notes &amp; Description</label>
                    <InputTextArea id="remarks" class="viq-form-control viq-form-textarea" rows="3" @bind-Value="companyModel.Remarks" />
                    <ValidationMessage For="@(() => companyModel.Remarks)" class="viq-form-validation" />
                </div>
            </div>
            <label class="viq-toggle-card viq-toggle-card-wide" for="isActive">
                <span><strong>@(isRowActive ? "Company active" : "Company inactive")</strong><small>Inactive companies remain visible in historical records.</small></span>
                <InputCheckbox id="isActive" class="viq-switch" @bind-Value="isRowActive" />
            </label>
        </section>

        <div class="viq-form-actions">
            <button type="submit" class="viq-button viq-button-primary" disabled="@isProcessingData">
                @if (isProcessingData) { <span class="spinner-border spinner-border-sm" role="status"></span><span>Saving...</span> }
                else { <i class="bi bi-check2-square"></i><span>@(CompanyId == 0 ? "Add Company" : "Update Company")</span> }
            </button>
        </div>
    </EditForm>
</div>
