@using Microsoft.AspNetCore.Components.Forms
@using ViabilityIQ.Shared.DataModels
@using ViabilityIQ.Shared.SharedModels
@using ViabilityIQ.Web.Components.CommonComponents

<div class="viq-form-shell">
    @if (isProcessingData)
    {
        <div class="viq-form-busy"><div class="viq-form-busy-card"><span class="viq-form-spinner"></span><div><strong>Saving income type</strong><span>Synchronizing the revenue classification...</span></div></div></div>
    }

    <EditForm Model="@incomeTypeModel" OnValidSubmit="HandleFormSubmissionAsync" class="viq-data-form">
        <DataAnnotationsValidator />
        <ValidationSummary class="viq-form-validation-summary" />
@* 
        <div class="viq-form-intro">
            <span class="viq-form-intro-icon"><i class="bi bi-graph-up-arrow"></i></span>
            <div><h2>Income type</h2><p>Maintain the categories used to group revenue streams.</p></div>
        </div> *@

        <section class="viq-form-section">
            <div class="viq-form-section-heading"><span><i class="bi bi-tag"></i></span><div><h3>Revenue classification</h3><p>Name and describe this income category.</p></div></div>
            <div class="viq-form-grid">
                <div class="viq-form-field">
                    <label for="TypeName">Revenue Stream <span class="viq-required">*</span></label>
                    <InputText id="TypeName" class="viq-form-control" @bind-Value="incomeTypeModel.IncomeTypeName" placeholder="e.g. Product Sales, Service Revenue" />
                    <ValidationMessage For="@(() => incomeTypeModel.IncomeTypeName)" class="viq-form-validation" />
                </div>
                <div class="viq-form-field">
                    <label for="remarks">Internal Notes &amp; Description</label>
                    <InputTextArea id="remarks" class="viq-form-control viq-form-textarea" rows="3" @bind-Value="incomeTypeModel.Remarks" placeholder="Describe this revenue stream..." />
                    <ValidationMessage For="@(() => incomeTypeModel.Remarks)" class="viq-form-validation" />
                </div>
            </div>
        </section>

        <section class="viq-form-section">
            <div class="viq-form-section-heading"><span><i class="bi bi-toggles"></i></span><div><h3>Availability</h3><p>Control whether this income type can be selected.</p></div></div>
            <label class="viq-toggle-card viq-toggle-card-wide" for="isActive">
                <span><strong>@(isRowActive ? "Income type active" : "Income type inactive")</strong><small>Inactive types remain visible on existing records.</small></span>
                <InputCheckbox id="isActive" class="viq-switch" @bind-Value="isRowActive" />
            </label>
        </section>

        <div class="viq-form-actions">
            <button type="submit" class="viq-button viq-button-primary" disabled="@isProcessingData">
                @if (isProcessingData) { <span class="spinner-border spinner-border-sm" role="status"></span><span>Saving...</span> }
                else { <i class="bi bi-check2-square"></i><span>@(IncomeTypeId == 0 ? "Add Income Type" : "Update Income Type")</span> }
            </button>
        </div>
    </EditForm>
</div>
