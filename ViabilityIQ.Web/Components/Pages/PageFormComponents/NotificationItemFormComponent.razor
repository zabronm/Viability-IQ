@using Microsoft.AspNetCore.Components.Forms
@using ViabilityIQ.Shared.DataModels

<div class="zab-form-wrapper mb-4">
    @if (isProcessing)
    {
        <div class="form-processing-overlay animate-fade-in">
            <div class="spinner-container-box">
                <div class="sleek-form-spinner"></div>
                <p class="processing-text-alert">Sending Communication...</p>
            </div>
        </div>
    }

    <EditForm Model="@newItem" OnValidSubmit="HandleSubmitAsync">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label small fw-bold">Communication Type</label>
            <div class="form-check">
                <InputCheckbox class="form-check-input" id="isTaskCheck" @bind-Value="newItem.IsTask" />
                <label class="form-check-label small" for="isTaskCheck">
                    Mark as an <strong>Assigned Task</strong> (Requires completion)
                </label>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label small fw-bold">Recipient ID <span class="text-danger">*</span></label>
            <InputNumber class="form-control form-control-sm" @bind-Value="newItem.RecipientId" />
            <ValidationMessage For="@(() => newItem.RecipientId)" class="text-danger small mt-1" />
        </div>

        <div class="mb-3">
            <label class="form-label small fw-bold">Assessment Case Number (Optional)</label>
            <InputText class="form-control form-control-sm" @bind-Value="newItem.AssessmentNumber" placeholder="e.g. CAS-2026-001" />
        </div>

        <div class="mb-3">
            <label class="form-label small fw-bold">Title / Subject <span class="text-danger">*</span></label>
            <InputText class="form-control form-control-sm" @bind-Value="newItem.Title" placeholder="Brief subject header" />
            <ValidationMessage For="@(() => newItem.Title)" class="text-danger small mt-1" />
        </div>

        <div class="mb-3">
            <label class="form-label small fw-bold">Message Details <span class="text-danger">*</span></label>
            <InputTextArea class="form-control form-control-sm" rows="5" @bind-Value="newItem.Message" placeholder="Type your message or task description here..." />
            <ValidationMessage For="@(() => newItem.Message)" class="text-danger small mt-1" />
        </div>

        @if (newItem.IsTask)
        {
            <div class="mb-3">
                <label class="form-label small fw-bold text-danger">Task Due Date</label>
                <input type="date" class="form-control form-control-sm" @bind="newItem.DueDate" />
            </div>
        }

        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
            <button type="submit" class="btn btn-success btn-sm w-100" disabled="@isProcessing">
                @if (isProcessing)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    <span>Sending...</span>
                }
                else
                {
                    <i class="bi bi-send me-1"></i>
                    <span>Send / Assign</span>
                }
            </button>
        </div>
    </EditForm>
</div>