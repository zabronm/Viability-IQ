@page "/home"

@using ViabilityIQ.Web.Components.CommonComponents
@inject NavigationManager Nav0

<div class="p-0 position-relative home-page-container">
    <PageTitle>Viability.IQ</PageTitle>

    <div class="greeting-section my-0 py-1">
        <div class="greeting-content">
            <h1 class="greeting-title">
                Welcome back, <span class="greeting-name">@CurrentUser?.FirstName</span>! 👋
            </h1>
            <p class="greeting-subtitle">
                <span class="last-seen-label">Last seen:</span>
                <span class="last-seen-time">@FormatLastLoginDate(LastLoginDate)</span>
                <span class="branch-separator">|</span>
                <span class="branch-label">Your Branch:</span>
                <span class="branch-name">@CurrentBranch</span>
            </p>
        </div>
    </div>


    <main class="p-3 bg-white mt-2 mb-4 main-content-box">

        <!-- Loading State -->
        @if (IsLoading)
        {
            <div class="loading-container">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="loading-text">Loading your dashboard...</p>
            </div>
        }
        else
        {
            <!-- KPI Widgets Section -->
            <div class="p-0 mt-0">
                <KPIWidgetsSectionComponent KPIMetrics="KPIData" OnKPIDrill="HandleKPIDrill" />
            </div>

            <!-- Row Two: Recent Activity (col-5) + Important Alerts (col-5) + Quick Actions (col-2) -->
            <div class="row-two-container">
                <div class="recent-activity-column dashboard-component-wrapper">
                    <RecentActivitySnapshotComponent Activities="RecentActivities" OnRefresh="RefreshDashboard" />
                </div>
                <div class="alerts-column dashboard-component-wrapper">
                    <ImportantAlertsSectionComponent Alerts="AlertsData" Announcements="SystemAnnouncements"
                                                     OnDismiss="HandleAlertDismissal" />
                </div>
                <div class="quick-actions-column dashboard-component-wrapper">
                    <QuickActionsPanelComponent OnActionClick="HandleQuickAction" />
                </div>
            </div>

            <!-- Recent Assessments Section -->
            <div class="dashboard-component-wrapper">
                <RecentAssessmentsSnapshotComponent Assessments="RecentAssessments" />
            </div>

            <!-- Full-Width System Insights Section -->
            <div class="full-width-insight-container">
                <div class="insights-column-full dashboard-component-wrapper">
                    <SystemInsightsSectionComponent Insights="InsightsData" OnExport="HandleExport" />
                </div>
            </div>
        }

    </main>

    <footer class="py-4 bg-light mt-auto">
        <BFooter />
    </footer>
</div>