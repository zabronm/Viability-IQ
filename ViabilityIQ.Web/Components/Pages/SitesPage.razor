@page "/settings/sites"
@using ViabilityIQ.Shared.DataModels
@using ViabilityIQ.Web.Components.CommonComponents

<div class="p-0 position-relative">
    <PageHeading _pageTitle="Sites" CurrentPage="PageType.Settings" _pageHeading="Sites" />
    <main class="p-3 bg-white mt-2 mb-4" style="border-radius:8px;">
        <div class="app-workspace-shell">
            <ZabDataTableAdvanced TItem="Branch"
                                  Items="@sites"
                                  ItemName="Site"
                                  Columns="@tableColumns"
                                  IsLoading="@loading"
                                  ShowAdd="true"
                                  ShowDelete="false"
                                  GetRowId="@(site => site.BranchId)"
                                  OnAddRecordId="OpenFormAsync"
                                  OnEditRecordId="OpenFormAsync" />
        </div>
    </main>
    <footer class="py-4 bg-light mt-auto"><BFooter /></footer>
</div>
