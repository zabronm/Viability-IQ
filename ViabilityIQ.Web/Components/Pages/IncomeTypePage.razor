@page "/settings/income-types"

@using ViabilityIQ.Web.Components.CommonComponents
@using ViabilityIQ.Shared.DataModels
@using ViabilityIQ.Web.Components.Pages.PageFormComponents
@inherits Microsoft.AspNetCore.Components.ComponentBase

<div class="p-0 position-relative">
    <PageHeading _pageTitle="Revenue Streams" CurrentPage="PageType.IncomeTypes" _pageHeading="Revenue Streams" />

    <main class="p-3 bg-white mt-2 mb-4" style="border-radius:8px;">
        <div class="my-0">
            <ViqAlertComponent Severity="AlertSeverity" Heading="@AlertHeading" Message="@AlertMessage" AllowDismiss="true"  />
        </div>
        <div class="app-workspace-shell">
           
            <ZabDataTableAdvanced TItem="IncomeType"
                                  Items="@incomeTypeList"
                                  ItemName="Income Type"
                                  Columns="@tableColumns"
                                  IsLoading="@loadingStateActive"
                                  ShowAdd="true"
                                  ShowDelete="false"
                                  OnDelete="DeleteSelectedSector"
                                  GetRowId="@(x => x.IncomeTypeId)"
                                  OnAddRecordId="HandleFormExecution"
                                  OnEditRecordId="HandleFormExecution"
                                  OnPrintList="ExecutePrintFormatProcess"
                                  OnExportExcelList="ExecuteExcelExportProcess"
                                  OnEmailList="ExecuteEmailDistributionProcess" />
        </div>
    </main>

    <footer class="py-4 bg-light mt-auto">
        <BFooter />
    </footer>
</div>
