@page "/"
@using System.ComponentModel.DataAnnotations
@using ViabilityIQ.Web.Components.Layout


@layout MainLayout_Blank

<div class="m-0 font-def">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-brand fs-2">
                <span class="brand-main">Viability</span><span class="brand-iq fst-italic">.IQ</span>
            </div>
            @* <h3 class="auth-title">Welcome Back</h3> *@
            <p class="auth-subtitle">Please enter your system credentials to proceed</p>
        </div>

        <EditForm Model="@loginModel" OnSubmit="HandleLogin" FormName="LogUserForm">
            <DataAnnotationsValidator />

            <div class="form-group-custom">
                <label class="form-label">Email Address</label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-envelope icon-addon"></i>
                    <InputText @bind-Value="loginModel.Email" class="form-control-custom" placeholder="name@company.com" />
                </div>
                <ValidationMessage For="@(() => loginModel.Email)" class="auth-error-msg" />
            </div>

            <div class="form-group-custom">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="form-label mb-0">Password</label>
                    <button type="button" class="link-btn-inline" @onclick="NavigateToForgotPassword">Forgot Password?</button>
                </div>
                <div class="input-icon-wrapper">
                    <i class="bi bi-lock icon-addon"></i>
                    <InputText type="@(showPassword ? "text" : "password")" @bind-Value="loginModel.Password" class="form-control-custom" placeholder="••••••••" />
                    <button type="button" class="password-toggle-btn" @onclick="TogglePasswordVisibility">
                        <i class="bi @(showPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                    </button>
                </div>
                <ValidationMessage For="@(() => loginModel.Password)" class="auth-error-msg" />
            </div>

            <div class="auth-actions-row">
                <label class="checkbox-container-custom">
                    <InputCheckbox @bind-Value="loginModel.RememberMe" />
                    <span class="checkmark"></span>
                    Remember this device
                </label>
            </div>

            <button type="submit" class="btn btn-primary w-100" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Authenticating...</span>
                }
                else
                {
                    <span>Sign In</span>
                }
            </button>
        </EditForm>

        <div class="auth-card-footer">
            Need an account recovery option? <button type="button" class="link-btn-inline font-weight-bold" @onclick="NavigateToResetPassword">Reset Password</button><br/>
            Need a new account? <button type="button" class="link-btn-inline font-weight-bold" @onclick="NavigateToSignUp">Sign Up Here</button>
        </div>  
        @* <div class="auth-card-footer">            
            Support <button type="button" class="link-btn-inline" @onclick="NavigateToProduct">ND Solutions CC, South Africa</button>
        </div> *@
    </div>
</div>

<style>
    * ==========================================================================
    Enterprise Auth Theme System Architecture
    ========================================================================== */
    .auth-surface-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        /*min-height: 100vh;
        width: 100vw;*/
        background-color: #f8fafc; /* Synchronized off-blue/whitish layout background */
        font-family: -apple-system, BlinkMacSystemFont,"arial", "Segoe UI", Roboto, sans-serif;
        padding: 20px;
        box-sizing: border-box;
    }

    .auth-container {
        display: flex;
       
        padding: 20px;
        box-sizing: border-box;
        font-family: -apple-system, BlinkMacSystemFont,"arial", "Segoe UI", Roboto, sans-serif;
        /* background-image: url('images/neumorphic.jpg'); */
        background-repeat: repeat; /* or no-repeat */
        background-size: cover; /* or cover, contain */
        background-position: center;
        box-shadow: 0 5px 10px rgba(0, 0, 0, 0.15);
    }

    .auth-card {
        background-color: #ffffff;
        width: 100%;
        max-width: 420px;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        /* Custom layout design blue shadow signature token */
        box-shadow: 0 10px 30px rgba(0, 0, 153, 0.06), 0 4px 20px rgba(0, 0, 153, 0.04);
        padding: 40px 32px;
        box-sizing: border-box;
        transition: transform 0.3s ease;
    }

    /* Core Branding & Header Elements */
    .auth-header {
        text-align: center;
        margin-bottom: 32px;
    }

    .auth-brand {
        font-weight: 800;
        font-size: 1.65rem;
        color: #0f172a;
        letter-spacing: -0.03em;
        margin-bottom: 12px;
    }

        .auth-brand {
            color: #000099; /* Layout signature royal corporate blue */
        }

    .auth-title {
        font-size: 1.35rem;
        font-weight: 700;
        color: #1e293b;
        margin: 0 0 6px 0;
    }

    .auth-subtitle {
        font-size: 0.875rem;
        color: #64748b;
        margin: 0;
        line-height: 1.4;
    }

    /* Custom Form Construction System */
    .form-group-custom {
        margin-bottom: 20px;
        position: relative;
    }

    .form-label {
        display: block;
        font-size: 0.825rem;
        font-weight: 600;
        color: #475569;
        margin-bottom: 6px;
    }

    .input-icon-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .icon-addon {
        position: absolute;
        left: 14px;
        color: #94a3b8;
        font-size: 1.1rem;
        pointer-events: none;
    }

    .form-control-custom {
        width: 100%;
        height: 46px;
        background-color: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 0 16px 0 42px;
        font-size: 0.925rem;
        color: #1e293b;
        box-sizing: border-box;
        transition: all 0.2s ease-in-out;
    }

        /* Form Interactive Input focus parameters mapping layout theme colors */
        .form-control-custom:focus {
            outline: none;
            border-color: #000099;
            box-shadow: 0 0 0 4px rgba(0, 0, 153, 0.08);
        }

    /* Password Utility Elements button toggle mechanics */
    .password-toggle-btn {
        position: absolute;
        right: 4px;
        height: 38px;
        width: 38px;
        background: none;
        border: none;
        color: #64748b;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        font-size: 1rem;
        transition: background-color 0.2s, color 0.2s;
    }

        .password-toggle-btn:hover {
            background-color: #f2f4f7; /* Layout Custom Marble Gray hover action */
            color: #344054;
        }

    /* Secondary Action Rows & Checkboxes */
    .auth-actions-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
    }

    .link-btn-inline {
        background: none;
        border: none;
        padding: 0;
        font-size: 0.825rem;
        font-weight: 600;
        color: #000099;
        cursor: pointer;
        transition: color 0.15s;
        text-decoration: none;
    }

        .link-btn-inline:hover {
            color: #344054; /* Marble dark shift interaction */
            text-decoration: underline;
        }

    /* Custom Checkbox Design Execution */
    .checkbox-container-custom {
        display: flex;
        align-items: center;
        position: relative;
        padding-left: 26px;
        cursor: pointer;
        font-size: 0.85rem;
        font-weight: 500;
        color: #475569;
        user-select: none;
    }

        .checkbox-container-custom input {
            position: absolute;
            opacity: 0;
            cursor: pointer;
            height: 0;
            width: 0;
        }

    .checkmark {
        position: absolute;
        left: 0;
        height: 18px;
        width: 18px;
        background-color: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 4px;
        transition: all 0.15s;
    }

    .checkbox-container-custom:hover input ~ .checkmark {
        border-color: #000099;
        background-color: rgba(0, 0, 153, 0.02);
    }

    .checkbox-container-custom input:checked ~ .checkmark {
        background-color: #000099;
        border-color: #000099;
    }

    .checkmark:after {
        content: "";
        position: absolute;
        display: none;
        left: 6px;
        top: 2px;
        width: 4px;
        height: 9px;
        border: solid white;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg);
    }

    .checkbox-container-custom input:checked ~ .checkmark:after {
        display: block;
    }

    /* Primary Authentication Trigger Button */
    .auth-submit-btn {
        width: 100%;
        height: 46px;
        background-color: #000099; /* Deep Primary System Layout Theme color */
        color: #ffffff;
        border: none;
        border-radius: 8px;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(0, 0, 153, 0.15);
    }

        .auth-submit-btn:hover {
            background-color: #000077;
            box-shadow: 0 6px 16px rgba(0, 0, 153, 0.25);
        }

        .auth-submit-btn:disabled {
            background-color: #94a3b8;
            box-shadow: none;
            cursor: not-allowed;
        }

    /* Footer Card Structural Separator */
    .auth-card-footer {
        margin-top: 28px;
        padding-top: 20px;
        border-top: 1px solid #e2e8f0;
        text-align: center;
        font-size: 0.825rem;
        color: #64748b;
    }

    /* Validation Errors engine styles */
    .auth-error-msg {
        display: block;
        font-size: 0.75rem;
        color: #ef4444;
        margin-top: 4px;
        font-weight: 500;
    }
</style>
