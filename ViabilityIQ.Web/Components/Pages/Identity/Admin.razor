@page "/admin"

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Admin Panel</PageTitle>

<div class="row mb-4">
    <div class="col">
        <h1>Admin Panel</h1>
        <p class="text-muted">Manage users and roles</p>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <h5 class="card-title">Total Users</h5>
                <p class="card-text display-4">@(AllUsers?.Count ?? 0)</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success">
            <div class="card-body">
                <h5 class="card-title">Active Users</h5>
                <p class="card-text display-4">@(AllUsers?.Count(u => u.IsActive) ?? 0)</p>
            </div>
        </div>
    </div>
</div>

@if (AllUsers == null)
{
    <div class="spinner-border" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
}
else
{
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Users List</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Status</th>
                            <th>Roles</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in AllUsers)
                        {
                            <tr>
                                <td>@user.FirstName @user.LastName</td>
                                <td>@user.Email</td>
                                <td>@user.PhoneNumber</td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </td>
                                <td>
                                    @{
                                        var userRoles = UserRoles.ContainsKey(user.Id.ToString()) ? UserRoles[user.Id.ToString()] : new List<string>();
                                    }
                                    @foreach (var role in userRoles)
                                    {
                                        <span class="badge bg-info me-1">@role</span>
                                    }
                                </td>
                                <td>@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <button class="btn btn-sm btn-primary" @onclick="() => EditUser(user)">Edit</button>
                                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteUser(user)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
