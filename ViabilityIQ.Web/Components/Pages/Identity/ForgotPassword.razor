@page "/forgot-password"
@using ViabilityIQ.Application.Dtos
@using ViabilityIQ.Application.Dtos.IdentityDtos
@using ViabilityIQ.Application.Interfaces.IdentityInterfaces
@using ViabilityIQ.Web.Services

@layout MainLayout_Blank

<div class="m-0 font-def p-2">
    <div class="auth-card my-2 py-2">

        @* <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body p-5"> *@
        <div class="auth-header">
            <div class="auth-brand fs-2">
                <span class="brand-main">Viability</span><span class="brand-iq fst-italic">.IQ</span>
            </div>
            <h2 class="card-title text-center mb-4">Forgot Password</h2>
        </div>

                    
        @if (showResetForm)
        {
            <ResetPasswordForm OnSubmit="HandleResetPassword" />
        }
        else
        {
            <RequestResetForm OnSubmit="@HandleRequestReset" />
        }

        <div class="text-center mt-4">
            <a href="/login" class="text-decoration-none">Back to Login</a>
        </div>
    </div>
</div>


@code {

    [Inject] public IPasswordService? PasswordService { get; set; }
    [Inject] public ToastService? ToastService { get; set; }
    [Inject] public NavigationManager? Navigation { get; set; }
    [Inject] public ILogger<ForgotPassword>? Logger { get; set; }

    private bool showResetForm = false;
    private long resetUserId;  // ✅ Changed to long
    private string resetToken;


    private async Task HandleRequestReset(ForgotPasswordRequest request)
    {
        Logger.LogInformation("Requesting password reset for email: {Email}", request.Email);

        var result = await PasswordService.GeneratePasswordResetTokenAsync(request.Email);

        if (result.Success)
        {
            // ✅ Store as long (result.UserId is already long)
            resetUserId = result.UserId;
            resetToken = result.ResetToken;
            showResetForm = true;

            ToastService.ShowInfo("Please enter your new password below", "Check Your Email");
        }
        else
        {
            ToastService.ShowError(string.Join(", ", result.Messages), "Request Failed");
        }
    }



    private async Task HandleResetPassword(ResetPasswordRequest request)
    {
        // ✅ Validate long resetUserId properly
        if (resetUserId <= 0 || string.IsNullOrEmpty(resetToken))
        {
            ToastService.ShowError("Invalid reset request", "Error");
            return;
        }

        Logger.LogInformation("Resetting password for user ID: {UserId}", resetUserId);

        // ✅ Pass long directly (no conversion needed)
        var result = await PasswordService.ResetPasswordAsync(resetUserId, resetToken, request.NewPassword);

        if (result.Success)
        {
            ToastService.ShowSuccess(result.Messages.First(), "Password Reset Successful");
            await Task.Delay(1500);
            Navigation.NavigateTo("/login");
        }
        else
        {
            ToastService.ShowError(string.Join(", ", result.Messages), "Reset Failed");
        }
    }
}

