@page "/logout"
@layout MainLayout_Blank
@inject NavigationManager Navigation

<PageTitle>Sign out</PageTitle>

<main class="container py-5">
    <div class="d-flex align-items-center justify-content-center gap-2 text-secondary">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        Preparing secure sign out...
    </div>
</main>

@code {
    protected override void OnInitialized()
    {
        Navigation.NavigateTo("/api/auth/signout-confirmation", forceLoad: true);
    }
}
