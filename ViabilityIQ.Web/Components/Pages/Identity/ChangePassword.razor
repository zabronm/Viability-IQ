@page "/identity/change-password"
@layout MainLayout_Blank


@using ViabilityIQ.Application.Dtos
@using ViabilityIQ.Application.Interfaces.IdentityInterfaces

<PageTitle>Change Password - Viability.IQ</PageTitle>

<div class="m-0 font-def p-2">
    <div class="auth-card my-2 py-2">
        <div class="auth-header">
            <div class="auth-brand fs-2">
                <span class="brand-main">Viability</span><span class="brand-iq fst-italic">.IQ</span>
            </div>
            <p class="auth-subtitle">Update your account password securely</p>
        </div>

        <EditForm Model="@PasswordRequest" OnSubmit="HandlePasswordChange" FormName="ChangePasswordForm">
            <DataAnnotationsValidator />

            <!-- CURRENT PASSWORD -->
            <div class="form-group-custom">
                <label class="form-label-custom" for="current-password">Current Password</label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-lock icon-addon"></i>
                    <InputText id="current-password" type="@(ShowCurrentPassword ? "text" : "password")" @bind-Value="PasswordRequest.CurrentPassword" class="form-control-custom" placeholder="••••••••" autocomplete="current-password" disabled="@IsSubmitting" />
                    <button type="button" class="password-toggle-btn" @onclick="ToggleCurrentPasswordVisibility" aria-label="@(ShowCurrentPassword ? "Hide current password" : "Show current password")" title="@(ShowCurrentPassword ? "Hide current password" : "Show current password")" disabled="@IsSubmitting">
                        <i class="bi @(ShowCurrentPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                    </button>
                </div>
                <ValidationMessage For="@(() => PasswordRequest.CurrentPassword)" class="auth-error-msg" />
            </div>

            <!-- NEW PASSWORD -->
            <div class="form-group-custom">
                <label class="form-label-custom" for="new-password">New Password</label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-shield-lock icon-addon"></i>
                    <InputText id="new-password" type="@(ShowNewPassword ? "text" : "password")" @bind-Value="PasswordRequest.NewPassword" class="form-control-custom" placeholder="••••••••" autocomplete="new-password" disabled="@IsSubmitting" />
                    <button type="button" class="password-toggle-btn" @onclick="ToggleNewPasswordVisibility" aria-label="@(ShowNewPassword ? "Hide new password" : "Show new password")" title="@(ShowNewPassword ? "Hide new password" : "Show new password")" disabled="@IsSubmitting">
                        <i class="bi @(ShowNewPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                    </button>
                </div>
                <ValidationMessage For="@(() => PasswordRequest.NewPassword)" class="auth-error-msg" />
            </div>

            <!-- CONFIRM NEW PASSWORD -->
            <div class="form-group-custom mb-3">
                <label class="form-label-custom" for="confirm-password">Confirm New Password</label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-shield-check icon-addon"></i>
                    <InputText id="confirm-password" type="@(ShowConfirmPassword ? "text" : "password")" @bind-Value="PasswordRequest.ConfirmNewPassword" class="form-control-custom" placeholder="••••••••" autocomplete="new-password" disabled="@IsSubmitting" />
                    <button type="button" class="password-toggle-btn" @onclick="ToggleConfirmPasswordVisibility" aria-label="@(ShowConfirmPassword ? "Hide confirmation password" : "Show confirmation password")" title="@(ShowConfirmPassword ? "Hide confirmation password" : "Show confirmation password")" disabled="@IsSubmitting">
                        <i class="bi @(ShowConfirmPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                    </button>
                </div>
                <ValidationMessage For="@(() => PasswordRequest.ConfirmNewPassword)" class="auth-error-msg" />
            </div>

            <!-- SUBMIT BUTTON -->
            <button type="submit" class="btn btn-primary w-100 mt-2" disabled="@(IsSubmitting || !IsFormValid())">
                @if (IsSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Updating Password...</span>
                }
                else
                {
                    <span>Update Password</span>
                }
            </button>
        </EditForm>

        <div class="auth-card-footer">
            <div>
                <a href="/account/profile" class="link-btn-inline font-weight-bold me-3"><i class="bi bi-arrow-left me-1"></i> Back to Profile</a>
                <a href="/home" class="link-btn-inline font-weight-bold">Dashboard</a>
            </div>
        </div>
    </div>
</div>

