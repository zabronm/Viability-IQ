@page "/identity/change-password"
@using ViabilityIQ.Application.Dtos
@using ViabilityIQ.Application.Interfaces.IdentityInterfaces

<div class="m-0 font-def p-2">
    <div class="auth-card my-2 py-2">
        <div class="auth-header">
            <div class="auth-brand fs-2">
                <span class="brand-main">Viability</span><span class="brand-iq fst-italic">.IQ</span>
            </div>
            <p class="auth-subtitle">Update your account password securely</p>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-circle-fill me-2"></i>
                <strong>Update Failed</strong>
                <p class="mb-0 mt-1">@ErrorMessage</p>
                <button type="button" class="btn-close" @onclick="() => { ErrorMessage = string.Empty; StateHasChanged(); }" aria-label="Close"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                <strong>Success</strong>
                <p class="mb-0 mt-1">@SuccessMessage</p>
                <button type="button" class="btn-close" @onclick="() => { SuccessMessage = string.Empty; StateHasChanged(); }" aria-label="Close"></button>
            </div>
        }

        <EditForm Model="@PasswordRequest" OnSubmit="HandlePasswordChange" FormName="ChangePasswordForm">
            <DataAnnotationsValidator />

            <!-- CURRENT PASSWORD -->
            <div class="form-group-custom">
                <label class="form-label-custom">Current Password</label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-lock icon-addon"></i>
                    <InputText type="@(ShowCurrentPassword ? "text" : "password")" @bind-Value="PasswordRequest.CurrentPassword" class="form-control-custom" placeholder="••••••••" disabled="@IsSubmitting" />
                    <button type="button" class="password-toggle-btn" @onclick="ToggleCurrentPasswordVisibility" tabindex="-1">
                        <i class="bi @(ShowCurrentPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                    </button>
                </div>
                <ValidationMessage For="@(() => PasswordRequest.CurrentPassword)" class="auth-error-msg" />
            </div>

            <!-- NEW PASSWORD -->
            <div class="form-group-custom">
                <label class="form-label-custom">New Password</label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-shield-lock icon-addon"></i>
                    <InputText type="@(ShowNewPassword ? "text" : "password")" @bind-Value="PasswordRequest.NewPassword" class="form-control-custom" placeholder="••••••••" disabled="@IsSubmitting" />
                    <button type="button" class="password-toggle-btn" @onclick="ToggleNewPasswordVisibility" tabindex="-1">
                        <i class="bi @(ShowNewPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                    </button>
                </div>
                <ValidationMessage For="@(() => PasswordRequest.NewPassword)" class="auth-error-msg" />
            </div>

            <!-- CONFIRM NEW PASSWORD -->
            <div class="form-group-custom mb-3">
                <label class="form-label-custom">Confirm New Password</label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-shield-check icon-addon"></i>
                    <InputText type="@(ShowConfirmPassword ? "text" : "password")" @bind-Value="PasswordRequest.ConfirmNewPassword" class="form-control-custom" placeholder="••••••••" disabled="@IsSubmitting" />
                    <button type="button" class="password-toggle-btn" @onclick="ToggleConfirmPasswordVisibility" tabindex="-1">
                        <i class="bi @(ShowConfirmPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                    </button>
                </div>
                <ValidationMessage For="@(() => PasswordRequest.ConfirmNewPassword)" class="auth-error-msg" />
            </div>

            <!-- SUBMIT BUTTON -->
            <button type="submit" class="btn btn-primary w-100 mt-2" disabled="@(IsSubmitting || !IsFormValid())">
                @if (IsSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Updating Password...</span>
                }
                else
                {
                    <span>Update Password</span>
                }
            </button>
        </EditForm>

        <div class="auth-card-footer">
            <div>
                <a href="/account/profile" class="link-btn-inline font-weight-bold me-3"><i class="bi bi-arrow-left me-1"></i> Back to Profile</a>
                <a href="/home" class="link-btn-inline font-weight-bold">Dashboard</a>
            </div>
        </div>
    </div>
</div>


