@page "/login"
@page "/"

@layout MainLayout_Blank


<PageTitle>Viability.IQ:Welcome</PageTitle>

<div class="m-0 font-def">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-brand fs-2">
                <span class="brand-main">Viability</span><span class="brand-iq fst-italic">.IQ</span>
            </div>
            <p class="auth-subtitle">Please enter your system credentials to proceed</p>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-circle-fill me-2"></i>
                <strong>Authentication Failed</strong>
                <p class="mb-0 mt-1">@ErrorMessage</p>
                <button type="button" class="btn-close" @onclick="() => ErrorMessage = null" aria-label="Close"></button>
            </div>
        }

        @* Native form post: No JavaScript, no fetch, browser handles cookies & submission automatically *@
        <form method="post" action="/api/auth/signin-form">
            <div class="form-group-custom">
                <label class="form-label-custom">Email Address</label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-envelope icon-addon"></i>
                    <input type="email"
                           name="Email"
                           class="form-control-custom"
                           placeholder="name@company.com"
                           required />
                </div>
            </div>

            <div class="form-group-custom">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="form-label-custom mb-0">Password</label>
                    <a href="/identity/forgot-password" class="link-btn-inline">Forgot Password?</a>
                </div>
                <div class="input-icon-wrapper">
                    <i class="bi bi-lock icon-addon"></i>
                    <input type="@(showPassword ? "text" : "password")"
                           name="Password"
                           class="form-control-custom"
                           placeholder="••••••••"
                           required />
                    <button type="button"
                            class="password-toggle-btn"
                            @onclick="TogglePasswordVisibility"
                            tabindex="-1">
                        <i class="bi @(showPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                    </button>
                </div>
            </div>

            <div class="auth-actions-row">
                <label class="checkbox-container-custom">
                    <input type="checkbox" name="RememberMe" value="true" />
                    <span class="checkmark"></span>
                    Remember this device
                </label>
            </div>

            <button type="submit" class="btn btn-primary w-100 auth-submit-btn" disabled="@isLoading" @onclick="HandleSubmit">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Signing In...</span>
                }
                else
                {
                    <span>Sign In</span>
                }
            </button>
        </form>

        <div class="auth-card-footer">
            <div class="mb-2">
                Need an account?
                <a href="/identity/register" class="link-btn-inline font-weight-bold">Sign Up Here</a>
            </div>
            <div>
                Need account recovery?
                <a href="/identity/change-password" class="link-btn-inline font-weight-bold">Reset Password</a>
            </div>
        </div>
    </div>
</div>

