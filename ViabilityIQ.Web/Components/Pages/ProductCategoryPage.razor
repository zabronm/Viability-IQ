@page "/settings/product-category"

@using ViabilityIQ.Web.Components.CommonComponents
@using ViabilityIQ.Shared.DataModels
@using ViabilityIQ.Web.Components.Pages.PageFormComponents
@inherits Microsoft.AspNetCore.Components.ComponentBase

<div class="p-0 position-relative">
    <PageHeading _pageTitle="Product/Service Categories" CurrentPage="PageHeading.PageType.ProductCategory" _pageHeading="Product/Service Categories" />

    <main class="p-3 bg-white mt-2 mb-4" style="border-radius:8px;">
        <div class="app-workspace-shell">
           

            <ZabDataTableAdvanced TItem="ProductCategory"
                                  Items="@productCategoryList"
                                  ItemName="Product/Service Category"
                                  Columns="@tableColumns"
                                  IsLoading="@loadingStateActive"
                                  ShowAdd="true"
                                  ShowDelete="true"
                                  OnDelete="DeleteSelectedBank"
                                  GetRowId="@(x => x.ProductCategoryId)"
                                  OnAddRecordId="HandleFormExecution"
                                  OnEditRecordId="HandleFormExecution"
                                  OnPrintList="ExecutePrintFormatProcess"
                                  OnExportExcelList="ExecuteExcelExportProcess"
                                  OnEmailList="ExecuteEmailDistributionProcess" />


        </div>
    </main>

    <ZabOffCanvas @ref="canvasShell" @bind-IsOpen="canvasOpenStatus" HeaderTitle="@formTitle">
        @if (canvasOpenStatus)
    {
        <ProductCategoryFormComponent ProductCategoryId="@activeRecordId" OnSavedSuccess="RefreshWorkspaceGridData" />
    }
    </ZabOffCanvas>

    <ZabOffCanvas @ref="canvasShell" @bind-IsOpen="canvasOpenStatus" HeaderTitle="@formTitle">
    @if (canvasOpenStatus)
    {
            <ProductCategoryFormComponent ProductCategoryId="@activeRecordId" OnSavedSuccess="@(res => ProcessExecutionFeedback(res))" />
    }
</ZabOffCanvas>



    <footer class="py-4 bg-light mt-auto">
        <BFooter />
    </footer>
</div>