@page "/assessment/sales/"
@layout MainLayout_Assessment
@inherits Microsoft.AspNetCore.Components.ComponentBase

@using ViabilityIQ.Web.Components.CommonComponents
@using ViabilityIQ.Web.Components.Layout
@using ViabilityIQ.Web.Components.Pages_Assessments.PageFormComponents
@using ViabilityIQ.Shared.DataModels

<div class="p-0 position-relative dashboard-workspace container-fluid">
    <PageHeading_Assessment _pageTitle="Sales" PageTitle="Sales & Forecasts" CurrentPage="PageType.Sales" />

    <div class="row bg-white g-3 mt-1 mb-1 py-2 px-2" style="border-radius: 6px;">
        @if (blAlert)
        {
            <div class="my-0">
                <ViqAlertComponent Severity="AlertSeverity" Heading="@AlertHeading" Message="@AlertMessage" AllowDismiss="true" />
            </div>
        }
        <div class="col-xl-12 col-lg-12 col-12 py-2" style="background-color: #ffffff; border: solid 0px #566D7E; border-radius:6px;">

            <div class="mb-4">
                <div class="py-1 px-1">
                    <span class="h6 text-marble-light mb-0 fw-bold small"><i class="bi bi-wallet-fill text-primary"></i>&nbsp;Unified Revenue Income Streams ..</span>
                    <span class="small text-xs text-muted">&nbsp;|&nbsp; Combined Position View Matrix</span>
                </div>

                <div class="px-0 mb-3">
                    <div class="row g-2 mt-1 align-items-center p-0 mx-0">
                        <div class="col-md-4 col-12">
                            <button type="button" class="btn btn-primary text-xs py-2 px-2 shadow-sm" @onclick="() => AddIncomeStream()">
                                <i class="bi bi-plus-circle me-1"></i>Add Revenue Stream
                            </button>
                        </div>

                        <!-- (3) Filter & Search Header Controls Area -->
                        <div class="col-md-8 col-12 d-flex gap-2 justify-content-end">
                            <!-- Dropdown width scaled to 18% -->
                            <select class="form-select form-select-sm text-xs shadow-sm" style="width: 18%;" @bind="SelectedFilterType">
                                <option value="">All Income Types</option>
                                <option value="@IncomeTypeEnum.SalesCategoryA">Sales Category A</option>
                                <option value="@IncomeTypeEnum.SalesCategoryB">Sales Category B</option>
                                <option value="@IncomeTypeEnum.SundryIncome">Sundry Income</option>
                                <option value="@IncomeTypeEnum.GrantsDonations">Grants / Donations</option>
                            </select>

                            <!-- Search container explicitly scaled down to 20% using inline styling -->
                            <div class="input-group input-group-sm shadow-sm search-input-frame" style="width: 30%;">
                                <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-search"></i></span>
                                <input type="text" class="form-control text-xs border-start-0 ps-1" placeholder="Search entries..." @bind="SearchQuery" @bind:event="oninput" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="table-responsive shadow-sm border border-secondary-subtle">
                    <table class="table table-sm table-hover text-nowrap vertical-align-middle align-middle mb-0 matrix-grid-table grid-font-standard">
                        <thead>
                            <tr class="bg-light text-muted fw-bold border-bottom align-bottom">
                                <th class="sticky-col ps-2 text-uppercase text-xxs">Revenue Channels &nbsp;<i class="bi bi-caret-right-fill"></i></th>
                                <!-- (1) Substituted Inc VAT with Income Type Header Contexts -->
                                <th class="text-start text-xxs text-uppercase px-2">Income Type</th>
                                @for (int m = 1; m <= 12; m++)
                                {
                                    <th class="text-end text-xxs text-uppercase">M@(m)</th>
                                }
                                <th class="text-end font-weight-bold text-white bg-navy text-uppercase text-xxs header-totals-navy">Total Revenue</th>
                                <th class="text-center sticky-action-header text-xxs"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (FilteredIncomeStreams != null && FilteredIncomeStreams.Any())
                            {
                                @foreach (var item in FilteredIncomeStreams)
                                {
                                    var truncatedName = item.Description.Length > 20
                                    ? ".." + item.Description.Substring(item.Description.Length - 20)
                                    : item.Description;

                                    <tr>
                                        <td class="sticky-col ps-2 text-dark font-weight-bold text-truncate" title="@item.Description">
                                            @truncatedName
                                            @if (item.IncludesVat)
                                            {
                                                <span class="badge bg-light text-secondary border custom-vat-tag ms-1 fw-normal">VAT</span>
                                            }
                                        </td>
                                        <td class="px-2"><span class="badge bg-soft-blue text-navy-brand text-xs">@GetDisplayTypeName(item.Type)</span></td>
                                        @for (int i = 0; i < 12; i++)
                                        {
                                            var index = i;
                                            <td class="text-end font-monospace text-secondary">
                                                @item.MonthlyValues[index].ToString("N0").Replace(",", " ")
                                            </td>
                                        }
                                        <td class="text-end font-monospace font-weight-bold bg-navy-light-summary text-navy-brand">
                                            @item.MonthlyValues.Sum().ToString("N0").Replace(",", " ")
                                        </td>
                                        <td class="text-center bg-light-totals-cell">
                                            <button type="button" class="btn btn-outline-primary btn-xs p-0 px-1 shadow-sm" @onclick="() => OpenIncomeFormPanel(item)">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                                <tr class="bg-light-totals font-weight-bold border-top-navy">
                                    <td class="sticky-col ps-2 text-navy-brand text-uppercase text-xxs fw-bold" colspan="2">Grand Total Inflows:</td>
                                    @for (int i = 0; i < 12; i++)
                                    {
                                        var index = i;
                                        <td class="text-end font-monospace text-navy-brand font-weight-bold">
                                            @FilteredIncomeStreams.Sum(c => c.MonthlyValues[index]).ToString("N0").Replace(",", " ")
                                        </td>
                                    }
                                    <td class="text-end font-monospace text-white bg-navy font-weight-bold header-totals-navy">
                                        @GrandTotalRevenue.ToString("N0").Replace(",", " ")
                                    </td>
                                    <td class="text-center bg-light-totals-cell"></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-2 mb-4 pt-1 pb-4 shadow" style="border-radius: 8px;">
        <div class="col-xl-12 col-lg-12 col-12 py-2" style="background-color: #ffffff; border: solid 0px #566D7E; border-radius:6px;">
            <div class="fs-4 my-1">Cash Flow & Business Health Analysis</div>

            <!-- (4) Isolated Components Parameters Bridge Interface Contexts Mapping -->
            <CashFlowSummaryDetailComponent IncomeStreams="IncomeStreams" />
            <!-- New Cross-Section Analysis Grid Containers Added Below -->
            @*  @if (AreSummariesReady)
            { *@
            <!-- Tier 1: Matrix Ledger Profile Summary -->
            <div class="row g-3 mt-3 fade-staged-panel delay-tier-1">
                <div class="col-12">
                    <NetProfitSummaryComponent Data="ConsolidatedAssessmentData" />
                </div>
            </div>

            <!-- Tier 2: Newly Introduced Intermediate Dual Columns Row (Trend Graph + Totals Summary) -->
            <div class="row g-3 mt-2 fade-staged-panel delay-tier-2">
                <div class="col-xl-7 col-lg-7 col-12">
                    <NetProfitMonthlyGraphComponent Data="ConsolidatedAssessmentData" />
                </div>
                <div class="col-xl-5 col-lg-5 col-12">
                    <NetProfitAnnualSummaryComponent Data="ConsolidatedAssessmentData" />
                </div>
            </div>

            <!-- Tier 3: Ratios and Graph Allocations Base Footer Panels -->
            <div class="row g-3 mt-1 fade-staged-panel delay-tier-3">
                <div class="col-xl-6 col-lg-6 col-12">
                    <AnalysisOfReceiptsGraphComponent Data="ConsolidatedAssessmentData" />
                </div>
                <div class="col-xl-6 col-lg-6 col-12">
                    <SalesRatiosComponent Data="ConsolidatedAssessmentData" />
                </div>
            </div>
            @*  } *@
            }
        </div>
    </div>
</div>

<footer class="py-2 bg-light mt-3">
    <BFooter />
</footer>