@page "/assessment/sales/"
@layout MainLayout_Assessment
@inherits Microsoft.AspNetCore.Components.ComponentBase
@using ViabilityIQ.Web.Components.CommonComponents
@using ViabilityIQ.Web.Components.Pages_Assessments.ProjectionComponents
@using ViabilityIQ.Shared.UtilityServices


<div class="p-0 position-relative dashboard-workspace container-fluid">
    <PageHeading_Assessment _pageTitle="Sales" PageTitle="Sales & Forecasts" CurrentPage="PageType.Sales" />

    <div class="row bg-white g-3 mt-1 mb-1 py-2 px-2" style="border-radius: 6px;">

        <!-- ✅ BUSINESS HEALTH ALERTS (FIRST) -->
        <div class="col-12 mt-0 pt-0">
            @* <BusinessHealthAlertsComponent AssessmentId="@AssessmentId" MaxAlerts="3" /> *@
            <BusinessHealthAlertsAccordionComponent AssessmentId="@AssessmentId" MaxAlerts="3" />
        </div>

        <div class="col-12 py-1 mt-1">
            <div class="px-0 mb-3">
                <div class="row g-2 align-items-center">
                    <div class="col-md-4">
                        <button class="btn btn-primary btn-sm text-xs" @onclick="() => AddIncomeStream()">
                            <i class="bi bi-plus-circle me-1"></i>&nbsp;Add Revenue Stream
                        </button>
                    </div>
                    <div class="col-md-8 d-flex gap-2 justify-content-end">
                        <!-- (1) Implementation of DDLookupComponent -->
                        <div style="width: 25%; font-weight: normal!important;">
                            <DDLookupComponent SourceKey="DDLookupEnums.IncomeTypes"
                                               @bind-Value="SelectedFilterId"
                                               Placeholder="All Revenue Sources" />
                        </div>
                        <input type="text" class="form-control form-control-sm" style="width: 30%;" placeholder="Search..." @bind="SearchQuery" @bind:event="oninput" />
                    </div>
                </div>
            </div>

            <!-- (5) Table border-radius applied via wrapper -->
            <div class="table-responsive shadow-sm border border-secondary-subtle" style="border-radius: 6px; overflow: hidden;">
                <table class="table table-sm table-hover mb-0">
                    <!-- Table Header with restored font sizes -->
                    <thead class="text-xxs">
                        <tr class="bg-light text-muted fw-bold border-bottom align-bottom">
                            <th class="sticky-col ps-2 text-xxs text-uppercase">Revenue Channels <i class="bi bi-caret-down-fill text-secondary"></i></th>
                            <th class="text-start text-uppercase px-2">Income Type</th>
                            @for (int m = 1; m <= 12; m++)
                            {
                                <th class="text-end text-uppercase">M@(m)</th>
                            }
                            <!-- (2) Marble background for Total column -->
                            <th class="text-end text-uppercase" style="background-color: #d1d5db; color: #000080;">Total Revenue</th>
                            <th class="text-center"></th>
                        </tr>
                    </thead>
                    <tbody class="grid-font-standard">

                        @if (IsLoading)
                        {
                            <LoadingTableRowsComponent />
                        }
                        else if (!FilteredIncomeStreams.Any())
                        {
                            <EmptyTableRowComponent EmptyRowMessage="No income/revenue records mapped to this assessment yet. " />
                        }
                        else
                        {
                            @foreach (var item in FilteredIncomeStreams)
                            {
                                <tr class="hover-light-blue">
                                    <!-- Applied hover effect class -->
                                    <td class="ps-2 text-black">
                                        <span title="@item.Description"
                                              style="font-size:0.80rem !important;">
                                            @DisplayUtility.TruncateValue(item.Description, 20)
                                        </span>
                                        @if (item.IncludesVat)
                                        {
                                            <span class="badge bg-light text-secondary fw-light text-xs border ms-1" style="font-size: 0.60rem;">VAT</span>
                                        }
                                    </td>
                                    <td class="px-2"><span class="badge bg-soft-blue text-navy-brand-plain text-xss">@item.TypeName.ToString()</span></td>
                                    @for (int i = 0; i < 12; i++)
                                    {
                                        <td class="text-end font-monospace text-secondary">@item.MonthlyValues[i].ToString("N0")</td>
                                    }
                                    <!-- (2) Marble background -->
                                    <td class="text-end font-monospace fw-bold" style="background-color: #d1d5db; color: #000080;">@item.MonthlyValues.Sum().ToString("N0")</td>
                                    <td class="text-center">
                                        <button class="btn-action-operation btn-edit-accent"
                                                @onclick="() => OpenIncomeFormPanel(item)">
                                            <i class="bi bi-vector-pen text-navy"></i>
                                        </button>
                                    </td>
                                </tr>
                            }

                            <!-- (4) Grand Total Row with dark blue theme -->
                            <tr style="background-color: #d1d5db; color: #000080; font-weight: bold;">
                                <td colspan="2" class="ps-2 text-uppercase text-xxs">Grand Total Inflows:</td>
                                @for (int i = 0; i < 12; i++)
                                {
                                    <td class="text-end font-monospace">@FilteredIncomeStreams.Sum(c => c.MonthlyValues[i]).ToString("N0")</td>
                                }
                                <td class="text-end font-monospace">@GrandTotalRevenue.ToString("N0")</td>
                                <td></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>

    <!-- CASHFLOW SUMMARIES AND DETAIL & PROJECTIONS-->
    <div class="row bg-white g-3 mt-1 mb-4 py-2 px-2" style="border-radius: 6px; border-color: #ffffff;">
        <div class="fs-4">Cashflow Projections</div>
        <div class="my-2">
            <CashflowKPICardsComponent AssessmentId="@AssessmentId" />
        </div>
        <div class="accordion" id="accordionPanelsStayOpenExample">
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button py-2 btn-primary text-white" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseOne" aria-expanded="true" aria-controls="panelsStayOpen-collapseOne">
                        <i class="bi bi-cash-stack me-2 text-white"></i> Cashflow Summary
                    </button>
                </h2>
                
                <div id="panelsStayOpen-collapseOne" class="accordion-collapse collapse show">
                    <div class="accordion-body">
                        <div class="row w-100 g-4 mx-0 font-def">
                            <!-- Card 1: Cashflow Summary -->
                            <div class="col-md-5 px-2">
                                <div class="auth-card h-100 py-3 px-3" style="max-width: 100%;">                                   
                                    <div class="card-body p-0">
                                        <CashflowSummaryDashboardComponent AssessmentId="@AssessmentId" />                                       
                                    </div>
                                </div>
                            </div>

                            <!-- Card 2: Business Health Indicators -->
                            <div class="col-md-7 px-2">
                                <div class="auth-card h-100 py-3 px-3" style="max-width: 100%;">                                    
                                    <div class="card-body p-0">
                                        <FinancialViabilityKPIComponent AssessmentId="@AssessmentId" />                                        
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="accordion-item mt-1">
                <h2 class="accordion-header" >
                    <button class="accordion-button collapsed btn-primary text-white py-2" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseTwo" aria-expanded="false" aria-controls="panelsStayOpen-collapseTwo">
                        <i class="bi bi-cash-stack me-2 text-white"></i> Cashflow Details
                    </button>
                </h2>
                <div id="panelsStayOpen-collapseTwo" class="accordion-collapse collapse">
                    <div class="accordion-body">
                        <DetailedCashflowStatementComponent AssessmentId="@AssessmentId" />         @* This is the cashflow details component *@
                    </div>
                </div>
            </div>
            <div class="accordion-item mt-1">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed btn-primary py-2" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseThree" aria-expanded="false" aria-controls="panelsStayOpen-collapseThree">
                        <i class="bi bi-cash-stack me-2 text-navy"></i> Other Cashflow Analytics
                    </button>
                </h2>
                <div id="panelsStayOpen-collapseThree" class="accordion-collapse collapse">
                    <div class="accordion-body">

                        Put charts and other analytics here

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
