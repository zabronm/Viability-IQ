@namespace ViabilityIQ.Web.Components.Pages_Assessments.AssetFormComponents

<section class="asmkpi-shell" aria-labelledby="asmkpi-title">
    <header class="asmkpi-header">
        <h2 id="asmkpi-title" style="font-weight: bold !important;"><i class="bi bi-speedometer2"></i> Assets Performance Metrics</h2>
        <span>Quick asset KPI metrics</span>
    </header>

    <div class="asmkpi-grid">
        @foreach (var metric in Metrics)
        {
            <article class="asmkpi-card @metric.CssClass">
                <div>
                    <span class="asmkpi-label">@metric.Label</span>
                    <i class="bi @metric.Icon"></i>
                </div>
                <strong>@metric.Value</strong>
                <small>@metric.Note</small>
            </article>
        }
    </div>
</section>

@code {
    [Parameter] public int TotalAssetsCount { get; set; }
    [Parameter] public decimal TotalGrossValue { get; set; }
    [Parameter] public decimal TotalAdditions { get; set; }
    [Parameter] public decimal TotalDisposals { get; set; }
    [Parameter] public decimal TotalAccumulatedDepreciation { get; set; }
    [Parameter] public decimal TotalNetValue { get; set; }
    [Parameter] public decimal HealthRate { get; set; }

    private IReadOnlyList<AssetMetric> Metrics =>
    [
        new("Total assets", TotalAssetsCount.ToString("N0"), "Registered items", "bi-boxes", "asmkpi-blue"),
        new("Opening balance", Money(TotalGrossValue), "Initial valuation", "bi-wallet2", "asmkpi-slate"),
        new("Additions", Money(TotalAdditions), "Current period", "bi-plus-square", "asmkpi-green"),
        new("Disposals", Money(TotalDisposals), "Current period", "bi-dash-square", "asmkpi-red"),
        new("Closing gross value", Money(TotalGrossValue + TotalAdditions - TotalDisposals), "Before depreciation", "bi-graph-up-arrow", "asmkpi-cyan"),
        new("Accumulated depreciation", Money(TotalAccumulatedDepreciation), "Total wear & tear", "bi-file-earmark-bar-graph", "asmkpi-amber"),
        new("Net book value", Money(TotalNetValue), "Book carrying value", "bi-shield-check", "asmkpi-blue"),
        new("Asset health rate", $"{HealthRate:F1}%", HealthRate >= 60m ? "Healthy carrying value" : "Review ageing assets", "bi-heart-pulse", HealthRate >= 60m ? "asmkpi-green" : "asmkpi-amber")
    ];

    private static string Money(decimal value) => $"R {value:N0}";

    private sealed record AssetMetric(
        string Label,
        string Value,
        string Note,
        string Icon,
        string CssClass);
}
