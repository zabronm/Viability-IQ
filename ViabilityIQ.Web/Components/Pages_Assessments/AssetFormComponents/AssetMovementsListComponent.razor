@using ViabilityIQ.Shared.SharedModels
@using ViabilityIQ.Shared.DataModels
@using ViabilityIQ.Application.Dtos
@inherits Microsoft.AspNetCore.Components.ComponentBase

<div class="asset-movements-container">
    @if (isLoading)
    {
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    }
    else
    {
        <!-- ====================================================
             ASSET HEADER & SUMMARY
             ==================================================== -->
        <div class="card mb-3">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <h5 class="card-title mb-1">@assetName</h5>
                        <small class="text-muted d-block">@assetType | @assetCategory</small>
                    </div>
                    <div class="col-md-6 text-end">
                        <div class="row g-2">
                            <div class="col-6">
                                <small class="d-block text-muted">Opening Value</small>
                                <strong>@openingValue.ToString("C0")</strong>
                            </div>
                            <div class="col-6">
                                <small class="d-block text-muted">Closing Value</small>
                                <strong>@closingValue.ToString("C0")</strong>
                            </div>
                            <div class="col-6">
                                <small class="d-block text-muted">Accumulated Depr.</small>
                                <strong class="text-warning">@accumulatedDepreciation.ToString("C0")</strong>
                            </div>
                            <div class="col-6">
                                <small class="d-block text-muted">Net Value</small>
                                <strong class="text-primary">@netValue.ToString("C0")</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ====================================================
             TABBED INTERFACE
             ==================================================== -->
        <ul class="nav nav-tabs mb-3" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == "movements" ? "active" : "")"
                        id="movements-tab" data-bs-toggle="tab" data-bs-target="#movements-content"
                        type="button" role="tab" aria-controls="movements-content"
                        aria-selected="@(activeTab == "movements")" @onclick="@(() => ChangeTab("movements"))">
                    Movements
                    <span class="badge bg-info ms-2">@movementsList.Count</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == "depreciation" ? "active" : "")"
                        id="depreciation-tab" data-bs-toggle="tab" data-bs-target="#depreciation-content"
                        type="button" role="tab" aria-controls="depreciation-content"
                        aria-selected="@(activeTab == "depreciation")" @onclick="@(() => ChangeTab("depreciation"))">
                    Depreciation Schedule
                    <span class="badge bg-secondary ms-2">@depreciationList.Count</span>
                </button>
            </li>
        </ul>

        <!-- ====================================================
             MOVEMENTS TAB
             ==================================================== -->
        <div class="tab-content">
            <div class="tab-pane fade @(activeTab == "movements" ? "show active" : "")"
                 id="movements-content" role="tabpanel" aria-labelledby="movements-tab">

                <!-- Add Movement Button -->
                <div class="mb-3">
                    <button type="button" class="btn btn-sm btn-primary" @onclick="@(() => OpenAddMovementForm())">
                        <span class="bi bi-plus-circle me-2"></span> Add Movement
                    </button>
                </div>

                <!-- Movements Table -->
                @if (movementsList.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Type</th>
                                    <th class="text-end">Amount</th>
                                    <th>Reference</th>
                                    <th>Description</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var movement in movementsList.OrderByDescending(x => x.MovementDate))
                                {
                                    <tr>
                                        <td>
                                            <small>@movement.MovementDate.ToString("MMM dd, yyyy")</small>
                                        </td>
                                        <td>
                                            <span class="badge @GetMovementTypeClass(movement.MovementType)">
                                                @movement.MovementTypeDisplay
                                            </span>
                                        </td>
                                        <td class="text-end fw-bold @GetMovementAmountClass(movement.MovementAmount)">
                                            @movement.FormattedAmount
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(movement.Reference))
                                            {
                                                <small>@movement.Reference</small>
                                            }
                                            else
                                            {
                                                <small class="text-muted">--</small>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(movement.Description))
                                            {
                                                <small>@movement.Description</small>
                                            }
                                            else
                                            {
                                                <small class="text-muted">--</small>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-xs btn-warning"
                                                    title="Edit" @onclick="@(() => OpenEditMovementForm(movement.AssetMovementId))">
                                                ✎
                                            </button>
                                            <button type="button" class="btn btn-xs btn-danger"
                                                    title="Delete" @onclick="@(() => DeleteMovement(movement))">
                                                ✕
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info" role="alert">
                        <strong>No movements recorded.</strong> Click "Add Movement" to record additions, disposals, or transfers.
                    </div>
                }
            </div>

            <!-- ====================================================
                 DEPRECIATION TAB
                 ==================================================== -->
            <div class="tab-pane fade @(activeTab == "depreciation" ? "show active" : "")"
                 id="depreciation-content" role="tabpanel" aria-labelledby="depreciation-tab">

                <!-- Depreciation Info -->
                @if (depreciationMethod != null)
                {
                    <div class="row g-2 mb-3">
                        <div class="col-md-3">
                            <small class="d-block text-muted">Method</small>
                            <strong>@depreciationMethod</strong>
                        </div>
                        <div class="col-md-3">
                            <small class="d-block text-muted">Annual Rate</small>
                            <strong>@depreciationRate.ToString("F2")%</strong>
                        </div>
                        <div class="col-md-3">
                            <small class="d-block text-muted">Useful Life</small>
                            <strong>@(usefulLifeYears.HasValue ? usefulLifeYears + " years" : "N/A")</strong>
                        </div>
                        <div class="col-md-3">
                            <small class="d-block text-muted">Annual Depr.</small>
                            <strong>@annualDepreciation.ToString("C0")</strong>
                        </div>
                    </div>
                }

                <!-- Depreciation Schedule Table -->
                @if (depreciationList.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th class="text-end">Amount</th>
                                    <th class="text-end">Accumulated Before</th>
                                    <th class="text-end">Accumulated After</th>
                                    <th>Method</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var depr in depreciationList.OrderBy(x => x.DepreciationDate))
                                {
                                    <tr>
                                        <td>
                                            <small>@depr.DepreciationDate.ToString("MMM dd, yyyy")</small>
                                        </td>
                                        <td class="text-end fw-bold text-danger">
                                            -@depr.DepreciationAmount.ToString("C0")
                                        </td>
                                        <td class="text-end">
                                            <small>@depr.AccumulatedDepreciationBefore.ToString("C0")</small>
                                        </td>
                                        <td class="text-end">
                                            <small>@depr.AccumulatedDepreciationAfter.ToString("C0")</small>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(depr.Method))
                                            {
                                                <small>@depr.Method</small>
                                            }
                                            else
                                            {
                                                <small class="text-muted">--</small>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-xs btn-info"
                                                    title="View" @onclick="@(() => ViewDepreciationDetail(depr))">
                                                👁
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info" role="alert">
                        <strong>No depreciation schedule.</strong> Add movements or configure depreciation settings.
                    </div>
                }
            </div>
        </div>

        <!-- ====================================================
             EXPORT/PRINT OPTIONS
             ==================================================== -->
        <div class="mt-3 pt-3 border-top">
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="@(() => ExportAsCSV())">
                <span class="bi bi-download me-1"></span> Export CSV
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="@(() => ExportAsPDF())">
                <span class="bi bi-file-pdf me-1"></span> Export PDF
            </button>
        </div>

        <!-- ====================================================
             ERROR & SUCCESS MESSAGES
             ==================================================== -->
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                @successMessage
                <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                @errorMessage
                <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
            </div>
        }
    }
</div>
