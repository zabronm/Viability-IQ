@using ViabilityIQ.Web.Components.CommonComponents
@namespace ViabilityIQ.Web.Components.Pages_Assessments.AssetFormComponents

<div class="viq-form-shell">
    @if (IsSubmitting)
    {
        <div class="viq-form-busy" role="status" aria-live="polite">
            <div class="viq-form-busy-card">
                <span class="viq-form-spinner" aria-hidden="true"></span>
                <div>
                    <strong>Saving asset</strong>
                    <span>Please wait while the asset and movement profile are updated.</span>
                </div>
            </div>
        </div>
    }

    <EditForm Model="FormModel" OnValidSubmit="ExecuteSaveWorkflowAsync"
              class="viq-data-form" aria-label="Assessment asset registration">
        <DataAnnotationsValidator />

        @* <div class="viq-form-intro">
            <span class="viq-form-intro-icon"><i class="bi bi-building" aria-hidden="true"></i></span>
            <div>
                <h2>@(AssessmentAssetId == 0 ? "New assessment asset" : "Assessment asset")</h2>
                <p>Capture ownership timing, valuation and the depreciation profile used by projections.</p>
            </div>
        </div> *@

        <ValidationSummary class="viq-form-validation-summary" />

        <section class="viq-form-section">
            <header class="viq-form-section-heading">
                <span><i class="bi bi-calendar-range" aria-hidden="true"></i></span>
                <div>
                    <h3>Ownership period</h3>
                    <p>Asset existed at assessment start or acquired during the projection period?</p>
                </div>
            </header>

            <div class="aaf-ownership-body">
                <div class="aaf-ownership-options" role="group" aria-label="Asset ownership period">
                    <button type="button"
                            class="aaf-ownership-option @(FormModel.AcquisitionStartMonth == 0 ? "active" : null)"
                            aria-pressed="@(FormModel.AcquisitionStartMonth == 0)"
                            @onclick="() => OnInceptionTypeChanged(true)">
                        <i class="bi bi-check-circle" aria-hidden="true"></i>
                        <span>
                            <strong>Existing asset</strong>
                            <small>Owned at assessment start</small>
                        </span>
                    </button>
                    <button type="button"
                            class="aaf-ownership-option @(FormModel.AcquisitionStartMonth > 0 ? "active" : null)"
                            aria-pressed="@(FormModel.AcquisitionStartMonth > 0)"
                            @onclick="() => OnInceptionTypeChanged(false)">
                        <i class="bi bi-plus-circle" aria-hidden="true"></i>
                        <span>
                            <strong>Acquired in period</strong>
                            <small>Purchased in Months 1–12</small>
                        </span>
                    </button>
                </div>

                @if (FormModel.AcquisitionStartMonth > 0)
                {
                    <div class="viq-form-field">
                        <label for="assetAcquisitionMonth">Acquisition month <span class="viq-required">*</span></label>
                        <select id="assetAcquisitionMonth" class="viq-form-control"
                                @bind="FormModel.AcquisitionStartMonth">
                            @for (int month = 1; month <= 12; month++)
                            {
                                <option value="@month">Month @month</option>
                            }
                        </select>
                        <small class="aaf-field-note">
                            The asset becomes active in Month @FormModel.AcquisitionStartMonth; earlier months remain inactive.
                        </small>
                    </div>
                }
            </div>
        </section>

        <section class="viq-form-section">
            <header class="viq-form-section-heading">
                <span><i class="bi bi-card-heading" aria-hidden="true"></i></span>
                <div>
                    <h3>Asset identity</h3>
                    <p>Name and classify the asset for reporting and projection.</p>
                </div>
            </header>

            <div class="viq-form-grid viq-form-grid-2">
                <div class="viq-form-field viq-form-span-2">
                    <label for="assetName">Asset name <span class="viq-required">*</span></label>
                    <input id="assetName" type="text" class="viq-form-control"
                           @bind="FormModel.AssetName"
                           placeholder="e.g., Factory Building" />
                    <ValidationMessage For="@(() => FormModel.AssetName)" class="viq-form-validation" />
                </div>

                <div class="viq-form-field viq-form-span-2">
                    <label>Asset type <span class="viq-required">*</span></label>
                    <DDLookupComponent SourceKey="DDLookupEnums.AssetTypes"
                                       @bind-Value="FormModel.AssetTypeId"
                                       Placeholder="Select Asset Type" />
                    <ValidationMessage For="@(() => FormModel.AssetTypeId)" class="viq-form-validation" />
                </div>
            </div>
        </section>

        <section class="viq-form-section">
            <header class="viq-form-section-heading">
                <span><i class="bi bi-cash-coin" aria-hidden="true"></i></span>
                <div>
                    <h3>Opening valuation</h3>
                    <p>Record gross cost and depreciation accumulated before projection period.</p>
                </div>
            </header>

            <div class="viq-form-grid viq-form-grid-2">
                <div class="viq-form-field viq-form-span-2">
                    <label for="assetOpeningValue">
                        @(FormModel.AcquisitionStartMonth == 0 ? "Opening value" : "Acquisition price")
                        <span class="viq-required">*</span>
                    </label>
                    <div class="aaf-input-group">
                        <span>R</span>
                        <input id="assetOpeningValue" type="number" min="0" step="0.01"
                               class="viq-form-control text-end"
                               @bind="FormModel.OpeningBalanceValue"
                               placeholder="0.00" />
                    </div>
                    <small class="aaf-field-note">
                        @(FormModel.AcquisitionStartMonth == 0
                            ? "Gross value at assessment start."
                            : $"Purchase price recognized in Month {FormModel.AcquisitionStartMonth}.")
                    </small>
                </div>

                <div class="viq-form-field viq-form-span-2 ">
                    <label for="assetOpeningDepreciation">Opening Accumulated Depr.</label>
                    <div class="aaf-input-group">
                        <span>R</span>
                        <input id="assetOpeningDepreciation" type="number" min="0" step="0.01"
                               class="viq-form-control text-end"
                               @bind="FormModel.OpeningAccumulatedDepreciation"
                               placeholder="0.00"
                               disabled="@(FormModel.AcquisitionStartMonth > 0)" />
                    </div>
                    <small class="aaf-field-note">
                        @(FormModel.AcquisitionStartMonth == 0
                            ? "Depreciation accumulated before Month 1."
                            : "Zero if acquired during projection period.")
                    </small>
                </div>
            </div>
        </section>

        <section class="viq-form-section">
            <header class="viq-form-section-heading">
                <span><i class="bi bi-graph-down-arrow" aria-hidden="true"></i></span>
                <div>
                    <h3>Depreciation profile</h3>
                    <p>Define how depreciation method across the twelve-month projection.</p>
                </div>
            </header>

            <div class="viq-form-grid viq-form-grid-2">
                <div class="viq-form-field viq-form-span-2">
                    <label for="assetDepreciationRate">Annual depreciation rate (%)</label>
                    <div class="aaf-input-group aaf-input-group-suffix">
                        <input id="assetDepreciationRate" type="number" min="0" max="100" step="0.01"
                               class="viq-form-control text-end"
                               @bind="FormModel.DepreciationRate"
                               placeholder="10.00" />
                        <span>%</span>
                    </div>
                    <small class="aaf-field-note">
                        @* Estimated monthly charge: @((FormModel.OpeningBalanceValue * FormModel.DepreciationRate / 100m) / 12m).ToString("C2") *@
                        Estimated monthly charge: @EstimatedMontlyDepreciation
                    </small>
                </div>

                <div class="viq-form-field viq-form-span-2">
                    <label for="assetDepreciationMethod">Depreciation method</label>
                    <select id="assetDepreciationMethod" class="viq-form-control"
                            @bind="FormModel.DepreciationMethod">
                        <option value="">Select method</option>
                        <option value="Straight-Line">Straight-Line</option>
                        <option value="Declining-Balance">Declining-Balance</option>
                        <option value="Units-of-Production">Units-of-Production</option>
                    </select>
                    <small class="aaf-field-note">@GetDepreciationMethodDescription(FormModel.DepreciationMethod)</small>
                </div>
            </div>
        </section>

        <div class="aaf-status-summary" role="status">
            <span><i class="@FormModel.StatusIcon" aria-hidden="true"></i></span>
            <div>
                <strong>@(FormModel.AcquisitionStartMonth == 0 ? "Pre-existing asset" : $"Acquired in Month {FormModel.AcquisitionStartMonth}")</strong>
                <small>
                    @(FormModel.AcquisitionStartMonth == 0
                        ? "Active for all 12 projection months."
                        : $"Active from Month {FormModel.AcquisitionStartMonth}; Months 1–{FormModel.AcquisitionStartMonth - 1} remain inactive.")
                </small>
            </div>
        </div>

        <footer class="viq-form-actions">
            <button type="submit" class="viq-button viq-button-primary" disabled="@IsSubmitting">
                @if (IsSubmitting)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Saving asset…</span>
                }
                else
                {
                    <i class="bi bi-check2-circle" aria-hidden="true"></i>
                    <span>Save asset</span>
                }
            </button>
        </footer>
    </EditForm>
</div>
