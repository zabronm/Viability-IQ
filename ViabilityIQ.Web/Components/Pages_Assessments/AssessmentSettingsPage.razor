@page "/assessment/settings/"

@layout MainLayout_Assessment
@inherits Microsoft.AspNetCore.Components.ComponentBase
@using ViabilityIQ.Shared.DataModels
@using ViabilityIQ.Shared.SharedModels


<div class="p-0 position-relative dashboard-workspace container-fluid">
    <PageHeading_Assessment _pageTitle="Settings" PageTitle="Assessment Settings" CurrentPage="PageType.Settings" />

    <div class="row bg-white g-3 mt-1" @key="ActiveAssessmentId" style="border-radius: 6px;">

        <div class="col-lg-10 col-12 order-lg-1 order-2">

            <div class="my-0">
                <ViqAlertComponent Severity="AlertSeverity" Heading="@AlertHeading" Message="@AlertMessage" AllowDismiss="true" />
            </div>
            @if (IsLoading)
            {
                <FormLoadingComponent />
            }
            else if (Model != null)
            {
                @if (!string.IsNullOrEmpty(ValidationAlertMessage))
                {
                    <div class="alert alert-warning p-2 rounded mb-2 d-flex align-items-center justify-content-between shadow-sm" style="font-size: 0.82rem;">
                        <span><i class="bi bi-exclamation-triangle-fill me-2 text-warning"></i> @ValidationAlertMessage</span>
                        <button type="button" class="btn-close small" @onclick="ClearValidationMessage" style="font-size: 0.7rem;"></button>
                    </div>
                }

                <!--- =================VAT & MAIN HEADER FIELDS =============================================================== -->
                <div class="row g-3">
                    <VATEditComponent @ref="VATEditRef" vatUpdateModel="@vatUpdateModel" OnUpdate='(result) => RefreshComponentData(result, "VAT-UPDATE")' />                  
                </div>

                <div class="row g-3">
                    <div class="col-md-4 col-12">
                        <OpeningBalancesComponent @ref="OpeningBalancesRef" openingBalancesModel="@openingBalancesModel" OnUpdate='(result) => RefreshComponentData(result, "OPENING-BALANCES")' />                      
                    </div>
                    <div class="col-md-8 col-12">
                        <div class="viq-elevated-card h-100">
                            <div class="viq-card-header-dark-ice">
                                <span class="fw-bold text-smokewhite-brand" style="font-size: 0.85rem;">Sales Categories</span>
                                <button type="button" class="btn btn-primary btn-update-font py-1 px-2 shadow-sm" @onclick='() => OpenConfigurationPanel("SALES-CATEGORY", 0)'>
                                    <i class="bi bi-plus-lg me-1 fw-bold"></i>Add New Sales Category
                                </button>
                            </div>
                            <div class="p-0">
                                <SalesCategoryListComponent @ref="SalesCategoryListRef" AssessmentId="@ActiveAssessmentId" OnEditRequested='(id) => OpenConfigurationPanel("SALES-CATEGORY", id)' />                              
                            </div>
                        </div>
                    </div>
                </div>


                <!-- ==============================================CREDITORS/DEBTORS COMPONENT ROW -->
                <div class="row g-3 mt-2">
                    <DebtorsCreditorsComponent @ref="DebtorsCreditorsRef" AssessmentId="@ActiveAssessmentId" OnUpdate='(result) => RefreshComponentData(result, "DEBTORS-CREDITORS")' />
                </div>

                <!-- ============================================== DIRECTOR WAGES & LOANS LIST ROW  -->
                <div class="row g-3">
                    <div class="col-md-4 col-12">
                        <DirectorWagesComponent @ref="DirectorWagesRef" directorWagesModel="@directorWagesModel" OnUpdate='(result) => RefreshComponentData(result, "DIRECTOR-WAGES")' />          
                    </div>
                    <div class="col-md-8 col-12">
                        <!-- PUT ASSESSMENT LOANS HERE -->
                        <div class="viq-elevated-card h-100">
                            <div class="viq-card-header-dark-ice d-flex align-items-center justify-content-between">
                                <span class="fw-bold text-smokewhite-brand" style="font-size: 0.85rem;">Assessment Loans</span>
                                <button type="button" class="btn btn-primary btn-update-font py-1 px-2 shadow-sm" @onclick='() => OpenConfigurationPanel("ASSESSMENT-LOANS", 0)'>
                                    <i class="bi bi-plus-lg me-1 fw-bold"></i>Add New Loan
                                </button>
                            </div>
                            <div class="p-0">
                                <AssessmentLoansListComponent @ref="AssessmentLoansListRef" AssessmentId="@ActiveAssessmentId" OnEditRequested='(id) => OpenConfigurationPanel("ASSESSMENT-LOANS", id)'/>                              
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- ==================== QUICK SETTINGS =============================================== -->
        <div class="col-lg-2 col-3 order-lg-2 order-1">
            <div class="viq-elevated-card viq-security-sidebar-card h-100 p-2">
                <span class="fw-bold text-dark d-block mb-2 border-bottom pb-1 px-1" style="font-size: 0.78rem;">
                    <i class="bi bi-sliders me-1 text-muted"></i> Quick Settings
                </span>

                <div class="d-flex flex-column gap-2">
                    <button type="button" class="settings-action-tile border-0 bg-light text-start p-2 rounded w-100" @onclick='() => OpenConfigurationPanel("ASSESSMENT")'>
                        <div class="tile-icon-wrapper base-avatar text-center mb-1">
                            <i class="fas fa-building text-primary"></i>
                        </div>
                        <div class="tile-meta-block">
                            <span class="tile-label d-block text-dark fw-bold">Director Wages</span>
                            <p class="tile-narration text-muted mb-0">Specify Director Wages</p>
                        </div>
                    </button>

                    <button type="button" class="settings-action-tile border-0 bg-light text-start p-2 rounded w-100" @onclick='() => OpenConfigurationPanel("DEBTORS-CREDITORS")'>
                        <div class="tile-icon-wrapper base-avatar text-center mb-1">
                            <i class="bi bi-incognito text-navy"></i>
                        </div>
                        <div class="tile-meta-block">
                            <span class="tile-label d-block text-dark fw-bold">Debtors/Creditors</span>
                            <p class="tile-narration text-muted mb-0">Map Profiles</p>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<ZabOffCanvas @ref="OffCanvasControlRef" HeaderTitle="@ActivePanelTitle" dWidth="350">
    @if (ActiveFormType != null)
    {
        <DynamicComponent Type="@ActiveFormType" Parameters="@ActiveFormParameters" />
    }
</ZabOffCanvas>

<footer class="py-2 bg-light mt-3">
    <BFooter />
</footer>