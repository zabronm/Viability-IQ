@namespace ViabilityIQ.Web.Components.Pages_Assessments.PageFormComponents
@using ViabilityIQ.Shared.DataModels

<div class="viq-form-shell">
    @if (FormModel != null)
    {
        <EditForm Model="FormModel" OnValidSubmit="ExecuteSaveWorkflowAsync"
                  class="viq-data-form" aria-label="Sales income projection">
            <DataAnnotationsValidator />
@* 
            <div class="viq-form-intro">
                <span class="viq-form-intro-icon"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i></span>
                <div>
                    <h2>Sales income projection</h2>
                    <p>Configure the income classification, VAT treatment and monthly sales forecast.</p>
                </div>
            </div> *@

            <ValidationSummary class="viq-form-validation-summary" />

            <section class="viq-form-section">
                <header class="viq-form-section-heading">
                    <span><i class="bi bi-tags" aria-hidden="true"></i></span>
                    <div>
                        <h3>Income details</h3>
                        <p>Classify and describe this projected income stream.</p>
                    </div>
                </header>
                <div class="viq-form-grid">
                    <div class="viq-form-field">
                        <label>Income type category</label>
                        <DDLookupComponent SourceKey="DDLookupEnums.IncomeTypes"
                                           @bind-Value="FormModel.IncomeTypeId" />
                    </div>
                    <div class="viq-form-field">
                        <label for="incomeDescription">Income description</label>
                        <input id="incomeDescription" type="text" class="viq-form-control"
                               @bind="FormModel.Description" />
                    </div>
                    <label class="viq-toggle-card" for="incomeVatSwitch">
                        <span>
                            <strong>Include VAT (+15%)</strong>
                            <small>Add VAT to the projected sales total.</small>
                        </span>
                        <input id="incomeVatSwitch" class="viq-switch" type="checkbox"
                               checked="@(FormModel.IncludeVAT > 0)"
                               @onchange="@(e => FormModel.IncludeVAT = (bool)e.Value! ? 1 : 0)"
                               value="true" />
                    </label>
                </div>
            </section>

            <section class="viq-form-section">
                <header class="viq-form-section-heading">
                    <span><i class="bi bi-distribute-horizontal" aria-hidden="true"></i></span>
                    <div>
                        <h3>Quick distribution</h3>
                        <p>Split an annual amount evenly across all months.</p>
                    </div>
                </header>
                <div class="viq-form-grid viq-form-grid-2">
                    <div class="viq-form-field">
                        <label for="salesAnnualTarget">Annual target amount</label>
                        <input id="salesAnnualTarget" type="number" class="viq-form-control"
                               @bind="BulkAnnualValueTarget" />
                    </div>
                    <div class="viq-form-field">
                        <label>Distribution action</label>
                        <button class="viq-button viq-button-secondary" type="button"
                                @onclick="DistributeAnnualValueEvenly">
                            <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                            <span>Apply split</span>
                        </button>
                    </div>
                </div>
            </section>

            <section class="viq-form-section">
                <header class="viq-form-section-heading">
                    <span><i class="bi bi-calendar3" aria-hidden="true"></i></span>
                    <div>
                        <h3>Assessment period sales projections</h3>
                        <p>Enter the projected sales value for each month.</p>
                    </div>
                </header>
                <div class="viq-form-grid viq-form-grid-2">
                    @for (int i = 0; i < 12; i++)
                    {
                        int index = i;
                        <div class="viq-form-field">
                            <label for="@($"salesMonth{index + 1}")">Month @(index + 1)</label>
                            <input id="@($"salesMonth{index + 1}")" type="number"
                                   class="viq-form-control"
                                   @bind="MonthlyValues[index]"
                                   @bind:event="oninput" />
                        </div>
                    }
                </div>
            </section>

            <section class="viq-form-section">
                <header class="viq-form-section-heading">
                    <span><i class="bi bi-calculator" aria-hidden="true"></i></span>
                    <div>
                        <h3>Total</h3>
                        <p>R @GrandCalculatedTotalSum.ToString("N2")</p>
                    </div>
                </header>
            </section>

            <footer class="viq-form-actions">
                <button class="viq-button viq-button-primary" @onclick="ExecuteSaveWorkflowAsync">
                    <i class="bi bi-check2-circle" aria-hidden="true"></i>
                    <span>Save</span>
                </button>
                <button class="viq-button viq-button-secondary" @onclick="CancelFormAsync">Cancel</button>
            </footer>
        </EditForm>
    }
</div>
