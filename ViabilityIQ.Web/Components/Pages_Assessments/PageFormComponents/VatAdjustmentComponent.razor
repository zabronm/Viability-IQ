@using ViabilityIQ.Shared.SharedModels
@inherits Microsoft.AspNetCore.Components.ComponentBase

<div class="vat-adjustment-container">
    <div class="vat-adjustment-header mb-3">
        <h6 class="mb-1 fw-bold">Bulk VAT Adjustments & Overrides</h6>
        <small class="text-muted">Assessment ID: @AssessmentId</small>
    </div>
@* 
    <div class="alert alert-info py-2 px-3 mb-3 text-xs">
        <i class="bi bi-info-circle-fill me-1"></i> Adjustments entered here override calculated values for payment and cashflow modeling without altering base engine figures.
    </div> *@

    <!-- ================= REASON CODE ================= -->
   @*  <div class="mb-3">
        <label class="form-label fw-semibold">Global Reason Code</label>
        <select class="form-select form-select-sm" @bind="selectedReasonCode">
            <option value="">Select Default Reason (e.g., Apportionment Ratio / Bad Debts)</option>
            <option value="bad_debt">Bad Debt Relief</option>
            <option value="apportionment">Apportionment Adjustment</option>
            <option value="capital_goods">Capital Goods Correction</option>
            <option value="rounding">Manual Rounding</option>
        </select>
    </div> *@

    <!-- ================= ADJUSTMENTS TABLE ================= -->
    <div class="table-responsive mb-3 vat-adjustments-table">
        <table class="table table-sm mb-0 borderless-table align-middle">
            <thead class="table-light sticky-top">
                <tr>
                    <th class="col-month text-uppercase text-secondary" style="width: 120px;">Month</th>
                    <th class="col-output text-uppercase text-secondary">Output VAT Adj (+/-)</th>
                    <th class="col-input text-uppercase text-secondary">Input VAT Adj (+/-)</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < 12; i++)
                {
                    int index = i;
                    <tr>
                        <td class="fw-semibold align-middle text-muted month-cell">Month @(index + 1)</td>
                        <td class="p-1">
                            <input type="number"
                                   class="form-control form-control-sm text-end"
                                   @bind="outputAdjustments[index]"
                                   step="0.01"
                                   placeholder="0" />
                        </td>
                        <td class="p-1">
                            <input type="number"
                                   class="form-control form-control-sm text-end"
                                   @bind="inputAdjustments[index]"
                                   step="0.01"
                                   placeholder="0" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- ================= TOTALS SUMMARY ================= -->
    <div class="p-2 bg-light border rounded mb-3 totals-summary">
        <div class="row g-2 text-xs fw-bold">
            <div class="col-6">
                <small class="text-muted">Output Total:</small>
                <div>@outputAdjustments.Sum().ToString("C0")</div>
            </div>
            <div class="col-6">
                <small class="text-muted">Input Total:</small>
                <div>@inputAdjustments.Sum().ToString("C0")</div>
            </div>
        </div>
    </div>

    <!-- ================= FORM ACTIONS ================= -->
    <div class="d-flex gap-2 justify-content-end mt-4 pt-3 border-top">
        <button type="button" class="btn btn-sm btn-outline-secondary px-4" @onclick="HandleCancel">
            <i class="bi bi-x-circle me-1"></i>
            <span>Cancel</span>
        </button>
        <button type="button" class="btn btn-sm btn-primary px-4" @onclick="HandleSave" disabled="@isSaving">
            @if (isSaving)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                <span>Saving...</span>
            }
            else
            {
                <i class="bi bi-check-circle me-1"></i>
                <span>Save Adjustments</span>
            }
        </button>
    </div>

    <!-- ================= SUCCESS MESSAGE ================= -->
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="mt-3">
            <div class="alert alert-success alert-dismissible fade show py-2 text-xs mb-0" role="alert">
                <i class="bi bi-check-circle me-2"></i> @successMessage
                <button type="button" class="btn-close btn-sm" @onclick="() => successMessage = string.Empty"></button>
            </div>
        </div>
    }

    <!-- ================= ERROR MESSAGE ================= -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="mt-3">
            <div class="alert alert-danger alert-dismissible fade show py-2 text-xs mb-0" role="alert">
                <i class="bi bi-exclamation-circle me-2"></i> @errorMessage
                <button type="button" class="btn-close btn-sm" @onclick="() => errorMessage = string.Empty"></button>
            </div>
        </div>
    }
</div>