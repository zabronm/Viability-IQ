@using ViabilityIQ.Web.Components.CommonComponents
@namespace ViabilityIQ.Web.Components.Pages_Assessments

<EditForm Model="FormModel" OnValidSubmit="ExecuteSaveWorkflowAsync">
    <DataAnnotationsValidator />
    <div class="p-2">
        @* <div class="alert alert-info py-1.5 rounded mb-3 text-xxs shadow-sm">
            <i class="bi bi-box-seam me-1"></i> Update inventory data entries.
        </div> *@

        <!-- (i) AssessmentSalesCategoryId Lookup -->
        <div class="mb-3">
            <label class="form-label fw-bold text-xs text-secondary uppercase">Sales Category</label>
            <DDLookupComponent SourceKey="DDLookupEnums.AssessmentSalesCategories"
                               @bind-Value="FormModel.AssessmentSalesCategoryId"
                               Placeholder="Select Sales Category" />
        </div>

        <!-- (ii) Include VAT Switch -->
        <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" id="vatSwitch" @bind="FormModel.blIncludeVAT">
            <label class="form-check-label text-xs fw-bold text-secondary ps-2" for="vatSwitch">Include VAT</label>
        </div>

        <!-- Quick Distribution Engine -->
        <div class="card bg-light border-0 mb-3 p-1.5 rounded">
            <label class="form-label fw-bold text-xs">Quick Even Distribution</label>
            <div class="input-group input-group-sm">
                <input type="number" class="form-control" @bind="BulkTargetValue" />
                <button class="btn btn-outline-success" type="button" @onclick="DistributeStockValuesEvenly">Apply</button>
            </div>
        </div>

        <!-- 12-Month Horizon -->
        @for (int i = 0; i < 12; i++)
        {
            int idx = i;
            <div class="row mb-1 align-items-center">
                <div class="col-4"><span class="text-xs fw-semibold text-muted">M@(idx + 1)</span></div>
                <div class="col-8">
                    <input type="number" class="form-control form-control-sm text-end font-monospace text-xs"
                           @bind="MonthlyValues[idx]"
                           @bind:event="oninput" />
                </div>
            </div>
        }

        <div class="d-flex align-items-center gap-2 mt-3 pt-2 border-top">            >

            <button type="submit" class="btn btn-primary w-100 flex-fill py-1.5 text-xs fw-bold " disabled="@IsSubmitting">
                @if (IsSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span> Updating stock changes ...</span>
                }
                else
                {
                    <i class="bi bi-check2-circle"></i>
                    <span> &nbsp; Save Stock Changes</span>
                }
            </button>

            @* <button type="button" class="btn btn-outline-secondary btn-sm py-1.5 text-xs" @onclick="CancelFormAsync">Cancel</button> *@
        </div>
    </div>
</EditForm>