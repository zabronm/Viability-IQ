@using ViabilityIQ.Web.Components.CommonComponents
@using ViabilityIQ.Shared.UtilityServices
@namespace ViabilityIQ.Web.Components.Pages_Assessments.PageFormComponents

<div class="viq-form-shell">
    @if (IsSubmitting)
    {
        <div class="viq-form-busy" role="status" aria-live="polite">
            <div class="viq-form-busy-card">
                <span class="viq-form-spinner" aria-hidden="true"></span>
                <div>
                    <strong>Saving stock changes</strong>
                    <span>Please wait while the monthly values are saved.</span>
                </div>
            </div>
        </div>
    }

    <EditForm Model="FormModel" OnValidSubmit="ExecuteSaveWorkflowAsync"
              class="viq-data-form" aria-label="Assessment expense values">
        <DataAnnotationsValidator />

        @* <div class="viq-form-intro">
            <span class="viq-form-intro-icon"><i class="bi bi-box-seam" aria-hidden="true"></i></span>
            <div>
                <h2>Assessment expense values</h2>
                <p>Configure the sales category, VAT treatment and monthly stock values.</p>
            </div>
        </div> *@

        <section class="viq-form-section">
            <header class="viq-form-section-heading">
                <span><i class="bi bi-tags" aria-hidden="true"></i></span>
                <div>
                    <h3>@(IsManufacturingMode ? "Manufactured product settings" : "Stock settings")</h3>
                    <p>@(IsManufacturingMode
                        ? "Standard unit cost values inventory only. Record actual production spending in Expenses; enable cashbook posting and set VAT treatment there."
                        : "Select the reporting category and VAT treatment.")</p>
                </div>
            </header>
            <div class="viq-form-grid">
                <div class="viq-form-field">
                    <label for="stockItemName">Stock item name <span class="viq-required">*</span></label>
                    <InputText id="stockItemName" class="viq-form-control"
                               @bind-Value="FormModel.Description"
                               placeholder="e.g. Maize meal, Packaging, Repair parts" />
                    <ValidationMessage For="@(() => FormModel.Description)" class="viq-form-validation" />
                </div>
                <div class="viq-form-field">
                    <label>Sales category</label>
                    <DDLookupComponent SourceKey="DDLookupEnums.AssessmentSalesCategories"
                                       @bind-Value="FormModel.AssessmentSalesCategoryId"
                                       Placeholder="Select Sales Category" />
                </div>
                @if (!IsServiceMode)
                {
                    <div class="viq-form-field">
                    <label for="openingStockBalance">Opening stock balance (@(sessionService?.CurrencyCode ?? "ZAR"))</label>
                    <InputNumber id="openingStockBalance" class="viq-form-control"
                                 min="0" step="0.01" @bind-Value="FormModel.OpeningBalance" />
                    <ValidationMessage For="@(() => FormModel.OpeningBalance)" class="viq-form-validation" />
                    </div>
                    @if (IsManufacturingMode)
                    {
                        <div class="viq-form-field">
                            <label for="standardUnitCost">Standard production cost per unit (@(sessionService?.CurrencyCode ?? "ZAR"))</label>
                            <InputNumber id="standardUnitCost" class="viq-form-control"
                                         min="0" step="0.01" @bind-Value="FormModel.StandardUnitCost" />
                            <ValidationMessage For="@(() => FormModel.StandardUnitCost)" class="viq-form-validation" />
                        </div>
                    }
                    @if (IsManufacturingMode)
                    {
                        <div class="alert alert-info mb-0">
                            Record actual materials, labor and other production spending in Expenses. Enable cashbook posting for expected cash outflows and set the appropriate VAT treatment there.
                        </div>
                    }
                    else
                    {
                        <label class="viq-toggle-card" for="vatSwitch">
                            <span>
                                <strong>Include VAT</strong>
                                <small>Include VAT in projected stock purchases.</small>
                            </span>
                            <input class="viq-switch" type="checkbox" id="vatSwitch" @bind="FormModel.blIncludeVAT">
                        </label>
                    }
                }
            </div>
        </section>

        @if (!IsServiceMode)
        {
            <section class="viq-form-section">
                <header class="viq-form-section-heading">
                    <span><i class="bi bi-distribute-horizontal" aria-hidden="true"></i></span>
                    <div>
                        <h3>Distribute same monthly figure</h3>
                        <p>Enter one monthly @(IsManufacturingMode ? "production unit" : "purchase/addition") figure and apply it to all twelve months.</p>
                    </div>
                </header>
                <div class="viq-form-grid viq-form-grid-2">
                    <div class="viq-form-field">
                        <label for="monthlyDistributionValue">Monthly @(IsManufacturingMode ? "production units" : "figure")</label>
                        <input id="monthlyDistributionValue" type="number" min="0" step="0.01"
                               class="viq-form-control" @bind="BulkTargetValue" />
                    </div>
                    <div class="viq-form-field">
                        <label>Distribution action</label>
                        <button class="viq-button viq-button-secondary" type="button"
                                @onclick="DistributeStockValuesEvenly">
                            <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                            <span>Apply to all months</span>
                        </button>
                    </div>
                </div>
            </section>

            <section class="viq-form-section">
                <header class="viq-form-section-heading">
                    <span><i class="bi bi-calendar3" aria-hidden="true"></i></span>
                    <div>
                        <h3>12-month horizon</h3>
                        <p>@(IsManufacturingMode ? "Enter planned production units for each month." : "Enter monthly purchases or stock additions for this item.")</p>
                    </div>
                </header>
                <div class="viq-form-grid viq-form-grid-2">
                    @for (int i = 0; i < 12; i++)
                    {
                        int idx = i;
                        <div class="viq-form-field">
                            <label for="@($"expenseMonth{idx + 1}")">Month @(idx + 1) @(IsManufacturingMode ? "production units" : string.Empty)</label>
                            @if (IsManufacturingMode)
                            {
                                <InputNumber id="@($"expenseMonth{idx + 1}")" class="viq-form-control"
                                             @bind-Value="ProductionUnits[idx]" />
                            }
                            else
                            {
                                <InputNumber id="@($"expenseMonth{idx + 1}")" class="viq-form-control"
                                             @bind-Value="MonthlyValues[idx]" />
                            }
                        </div>
                    }
                </div>
            </section>

            <section class="viq-form-section">
                <header class="viq-form-section-heading">
                    <span><i class="bi bi-calculator" aria-hidden="true"></i></span>
                    <div>
                        <h3>@(IsManufacturingMode ? "Total planned production value" : "Total stock purchases")</h3>
                        <p>@DisplayUtility.FormatCurrency(
                            IsManufacturingMode
                                ? ProductionUnits.Sum() * FormModel.StandardUnitCost
                                : MonthlyValues.Sum(),
                            sessionService?.CurrencyCode,
                            sessionService?.CultureName)</p>
                    </div>
                </header>
            </section>
        }
        else
        {
            <div class="alert alert-info">
                Service assessments do not use stock inputs. Direct and operating costs, including director wages, are entered through Expenses.
            </div>
        }

        <footer class="viq-form-actions">
            <button type="submit" class="viq-button viq-button-primary" disabled="@IsSubmitting">
                @if (IsSubmitting)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Saving stock changes...</span>
                }
                else
                {
                    <i class="bi bi-check2-circle" aria-hidden="true"></i>
                    <span>Save stock changes</span>
                }
            </button>
        </footer>
    </EditForm>
</div>
