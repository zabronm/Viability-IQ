@namespace ViabilityIQ.Web.Components.Pages_Assessments.PageFormComponents
@using Microsoft.AspNetCore.Components.Forms

<div class="viq-form-shell">
    <EditForm Model="ActiveRepaymentModel" OnValidSubmit="SubmitFormWorkflowAsync"
              class="viq-data-form" aria-label="Loan repayment allocation">
        <DataAnnotationsValidator />

        @* <div class="viq-form-intro">
            <span class="viq-form-intro-icon"><i class="bi bi-calendar3" aria-hidden="true"></i></span>
            <div>
                <h2>Loan repayment allocation</h2>
                <p>Review the calculated schedule and allocate extra or balloon repayments by month.</p>
            </div>
        </div> *@

        <ValidationSummary class="viq-form-validation-summary" />

        <section class="viq-form-section">
            <header class="viq-form-section-heading">
                <span><i class="bi bi-bank" aria-hidden="true"></i></span>
                <div>
                    <h3>Loan details</h3>
                    <p>Confirm the loan profile and cashbook treatment.</p>
                </div>
            </header>

            <div class="viq-form-grid">
                <div class="viq-form-field">
                    <label for="repaymentLoanDescription">Loan description</label>
                    <input id="repaymentLoanDescription" type="text" class="viq-form-control"
                           value="@ActiveRepaymentModel.LoanTypeName" disabled />
                </div>
            </div>

            <label class="viq-toggle-card viq-toggle-card-wide" for="sendToCashbookChild">
                <span>
                    <strong>Send to cashbook</strong>
                    <small>Include this repayment schedule in cashbook projections.</small>
                </span>
                <input id="sendToCashbookChild" class="viq-switch" type="checkbox"
                       @bind="ActiveRepaymentModel.SendToCashbook" />
            </label>
        </section>

        <section class="viq-form-section">
            <header class="viq-form-section-heading">
                <span><i class="bi bi-grid-3x3-gap" aria-hidden="true"></i></span>
                <div>
                    <h3>Monthly extra repayments</h3>
                    <p>Expected repayments and interest are locked. Enter additional amounts below.</p>
                </div>
            </header>

            <div class="viq-repayment-tools">
                <div class="viq-form-field">
                    <label for="bulkExtraAmount">Bulk extra amount</label>
                    <input id="bulkExtraAmount" type="number" step="0.01"
                           class="viq-form-control text-end" placeholder="0.00"
                           @bind="BulkExtraAmount" />
                </div>
                <div class="viq-repayment-tool-actions">
                    <button type="button" class="viq-button viq-button-secondary"
                            @onclick="ClearBulkExtraAllocation" title="Clear all extra amounts">
                        Clear
                    </button>
                    <button type="button" class="viq-button viq-button-primary btn-outline-success"
                            @onclick="ApplyBulkExtraAllocation" title="Apply to all months">
                        <i class="bi bi-lightning-charge" aria-hidden="true"></i>
                        <span>Apply all</span>
                    </button>
                </div>
            </div>

            <div class="viq-repayment-table-wrap">
                <table class="viq-repayment-table">
                    <thead>
                        <tr class="viq-repayment-row">
                            <th scope="col">Month</th>
                            <th scope="col" class="text-end">Expected (R)</th>
                            <th scope="col" class="text-end">Interest (R)</th>
                            <th scope="col" class="text-end">Extra / balloon (R)</th>
                            <th scope="col" class="text-end">Month total (R)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ActiveRepaymentModel?.MonthlyLines != null && ActiveRepaymentModel.MonthlyLines.Count == 12)
                        {
                            @for (int i = 0; i < 12; i++)
                            {
                                var idx = i;
                                var rowTotal = ActiveRepaymentModel.MonthlyLines[idx].Expected +
                                               ActiveRepaymentModel.MonthlyLines[idx].Interest +
                                               ActiveRepaymentModel.MonthlyLines[idx].Extra;

                                <tr>
                                    <th scope="row">M@(idx + 1)</th>
                                    <td>
                                        <input type="text" readonly
                                               class="viq-repayment-value viq-repayment-readonly"
                                               value="@ActiveRepaymentModel.MonthlyLines[idx].Expected.ToString("N2")" />
                                    </td>
                                    <td>
                                        <input type="text" readonly
                                               class="viq-repayment-value viq-repayment-readonly"
                                               value="@ActiveRepaymentModel.MonthlyLines[idx].Interest.ToString("N2")" />
                                    </td>
                                    <td>
                                        <input type="number"
                                               class="viq-repayment-value viq-repayment-extra"
                                               @bind="ActiveRepaymentModel.MonthlyLines[idx].Extra"
                                               @bind:event="oninput" min="0" step="0.01" />
                                    </td>
                                    <td class="viq-repayment-total">
                                        @rowTotal.ToString("N2")
                                    </td>
                                </tr>
                            }

                            <tr class="viq-repayment-grand-total">
                                <th scope="row">Total</th>
                                <td class="text-end font-monospace">@ActiveRepaymentModel.MonthlyLines.Sum(x => x.Expected).ToString("N2")</td>
                                <td class="text-end font-monospace">@ActiveRepaymentModel.MonthlyLines.Sum(x => x.Interest).ToString("N2")</td>
                                <td class="text-end font-monospace">@ActiveRepaymentModel.MonthlyLines.Sum(x => x.Extra).ToString("N2")</td>
                                <td class="text-end font-monospace">@ActiveRepaymentModel.MonthlyLines.Sum(x => x.Expected + x.Interest + x.Extra).ToString("N2")</td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center">Loading schedule months…</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <footer class="viq-form-actions">
            <button type="submit" class="viq-button viq-button-primary" disabled="@IsSubmitting">
                @if (IsSubmitting)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Saving repayments…</span>
                }
                else
                {
                    <i class="bi bi-save" aria-hidden="true"></i>
                    <span>Commit repayments</span>
                }
            </button>
        </footer>
    </EditForm>
</div>
