@using ViabilityIQ.Shared.DataModels
@using ViabilityIQ.Shared.SharedModels

<div class="viq-form-shell">
    @if (IsLoading)
    {
        <div class="viq-form-busy" role="status" aria-live="polite">
            <div class="viq-form-busy-card">
                <span class="viq-form-spinner" aria-hidden="true"></span>
                <div>
                    <strong>Loading director wages</strong>
                    <span>Synchronizing ledger operational state...</span>
                </div>
            </div>
        </div>
    }
    else if (Model != null)
    {
        <EditForm Model="@Model" OnValidSubmit="HandleFormSubmit"
                  class="viq-data-form" aria-label="Director wages">
            <DataAnnotationsValidator />

            <div class="viq-form-intro">
                <span class="viq-form-intro-icon"><i class="bi bi-people" aria-hidden="true"></i></span>
                <div>
                    <h2>Director wages</h2>
                    <p>Record the number of directors and their monthly wage impact.</p>
                </div>
            </div>

            <ValidationSummary class="viq-form-validation-summary" />

            <section class="viq-form-section">
                <header class="viq-form-section-heading">
                    <span><i class="bi bi-cash-stack" aria-hidden="true"></i></span>
                    <div>
                        <h3>Monthly wage details</h3>
                        <p>Director headcount, individual wage and combined monthly impact.</p>
                    </div>
                </header>

                <div class="viq-form-grid viq-form-grid-2">
                    <div class="viq-form-field">
                        <label for="numberOfDirectors">Number of directors</label>
                        <input id="numberOfDirectors" type="number" class="viq-form-control" min="1" max="50"
                               @bind-value="Model.NumberOfDirectors"
                               @bind-value:event="oninput"
                               @onchange="CalculateWagesImpact" />
                    </div>

                    <div class="viq-form-field">
                        <label for="monthlyDirectorWage">Monthly wage per director (R)</label>
                        <input id="monthlyDirectorWage" type="number" step="0.01" class="viq-form-control"
                               @bind-value="Model.MonthlyDirectorWagesAmount"
                               @bind-value:event="oninput"
                               @onchange="CalculateWagesImpact" />
                    </div>

                    <div class="viq-form-field viq-form-span-2">
                        <label for="combinedMonthlyImpact">Combined monthly impact (R)</label>
                        <input id="combinedMonthlyImpact" type="text" class="viq-form-control"
                               value="@Model.MonthlyDirectorWagesAmountTotal.ToString("N2")" readonly disabled />
                    </div>
                </div>
            </section>

            <section class="viq-form-section">
                <header class="viq-form-section-heading">
                    <span><i class="bi bi-card-text" aria-hidden="true"></i></span>
                    <div>
                        <h3>Administration</h3>
                        <p>Optional internal context for the ledger entry.</p>
                    </div>
                </header>

                <div class="viq-form-field">
                    <label for="directorWagesRemarks">Internal remarks</label>
                    <textarea id="directorWagesRemarks" class="viq-form-control viq-form-textarea" rows="3"
                              placeholder="Enter ledger justifications or optional annotations..."
                              @bind="Model.Remarks"></textarea>
                </div>
            </section>

            <footer class="viq-form-actions">
                @if (IsSubmitting)
                {
                    <button type="button" class="viq-button viq-button-secondary" disabled>
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Storing Buffers...</span>
                    </button>
                }
                else
                {
                    <button type="submit" class="viq-button viq-button-primary">
                        <i class="bi bi-save" aria-hidden="true"></i>
                        <span>Save Changes</span>
                    </button>
                }
            </footer>
        </EditForm>
    }
</div>
