@using ViabilityIQ.Shared.DataModels
@using ViabilityIQ.Shared.SharedModels

<div class="p-3 bg-white">
    @if (IsLoading)
    {
        <FormLoadingComponent />
    }
    else if (Model != null)
    {
        <EditForm Model="@Model" OnValidSubmit="ExecuteSaveWorkflow">
            <DataAnnotationsValidator />
            <ValidationSummary class="alert alert-danger p-2 rounded mb-3" style="font-size: 0.85rem;" />

            <div class="row g-2">

                <div class="col-12 mb-1">
                    <label class="form-label-custom">Loan Type<span class="text-danger">*</span></label>
                    <DDLookupComponent SourceKey="DDLookupEnums.LoanTypes"
                                       @bind-Value="Model.LoanTypeId" />
                    <ValidationMessage For="() => Model.LoanTypeId" class="text-danger small" />
                </div>

                <div class="col-12 mb-1">
                    <label class="form-label-custom">Bank Name<span class="text-danger">*</span></label>
                    <DDLookupComponent SourceKey="DDLookupEnums.Banks"
                                       @bind-Value="Model.BankId" />
                    <ValidationMessage For="() => Model.BankId" class="text-danger small" />
                </div>

                <div class="col-md-6 col-12 mb-2">
                    <label class="form-label-custom mb-0">Loan Date</label>
                    <input type="date" class="form-control-compact" placeholder="Loan date" @bind-value="Model.LoanDate" />
                </div>

                <div class="col-md-6 col-12 mb-2">
                    <label class="form-label-custom mb-0">Loan Amount</label>
                    <input type="number" class="form-control-compact" placeholder="00.00" @bind-value="Model.LoanAmount" />
                </div>

                <div class="col-md-6 col-12 mb-2">
                    <label class="form-label-custom mb-0">Period(months)</label>
                    <input type="number" step="0.01" class="form-control-compact" placeholder="0.00" @bind-value="Model.RepaymentPeriodMonths" />
                </div>
                <div class="col-md-6 col-12 mb-2">
                    <label class="form-label-custom mb-0">Interest Rate P/A(%)</label>
                    <input type="number" step="0.01" class="form-control-compact" placeholder="0.00" @bind-value="Model.InterestRatePerAnnum" />
                </div>

                <div class="col-md-6 col-12 mb-2">
                    <label class="form-label-custom mb-0">Loan Balance</label>
                    <input type="number" class="form-control-compact" placeholder="00.00" @bind-value="Model.LoanBalanceAtAssessmentDate" />
                </div>

                <div class="col-md-6 col-12 mb-2">
                    <label class="form-label-custom mb-0">Monthly Payment(R)</label>
                    <input type="number" step="0.01" class="form-control-compact" placeholder="00.00" @bind-value="Model.ActualRepaymentAmount" />
                </div>

                <div class="col-12">
                    <label class="form-label-custom mb-0">Audit Trail Remarks</label>
                    <textarea class="form-control-compact-textarea" rows="3" placeholder="Enter configuration remarks or optional justifications..." @bind="Model.Remarks"></textarea>
                </div>

                <div class="col-12 mt-3">
                    <div class="form-check form-switch p-2 bg-light border rounded ps-5 ms-0 d-flex align-items-center">
                        <input class="form-check-input ms-3" type="checkbox" id="LoanActiveSwitch" @bind="Model.Active" />
                        <label class="form-check-label fw-semibold ps-2 mb-0" for="LoanActiveSwitch">
                            Loan Active
                        </label>
                    </div>
                </div>

            </div>

            <div class="mt-4 pt-2 d-flex justify-content-end align-items-center">
                @if (IsSubmitting)
                {
                    <button type="button" class="btn btn-sm btn-secondary px-4 style-opacity-75" disabled>
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span> Storing Buffers...
                    </button>
                }
                else
                {
                    <button type="submit" class="btn btn-sm btn-primary px-4 fw-semibold shadow-sm">
                        <i class="bi bi-save me-1"></i> Save Changes
                    </button>
                }
            </div>
        </EditForm>
    }
</div>