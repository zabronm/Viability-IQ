@using ViabilityIQ.Shared.DataModels
@using ViabilityIQ.Shared.SharedModels

<div class="viq-form-shell">
    @if (IsLoading)
    {
        <div class="viq-form-busy" role="status" aria-live="polite">
            <div class="viq-form-busy-card">
                <span class="viq-form-spinner" aria-hidden="true"></span>
                <div>
                    <strong>Loading loan</strong>
                    <span>Please wait while the loan details are prepared.</span>
                </div>
            </div>
        </div>
    }
    else if (Model != null)
    {
        <EditForm Model="@Model" OnValidSubmit="ExecuteSaveWorkflow"
                  class="viq-data-form" aria-label="Assessment loan details">
            <DataAnnotationsValidator />

            <div class="viq-form-intro">
                <span class="viq-form-intro-icon"><i class="bi bi-bank" aria-hidden="true"></i></span>
                <div>
                    <h2>@(Model.AssessmentLoanId == 0 ? "New assessment loan" : "Assessment loan")</h2>
                    <p>Capture the lender, principal, repayment terms and current balance.</p>
                </div>
            </div>

            <ValidationSummary class="viq-form-validation-summary" />

            <section class="viq-form-section">
                <header class="viq-form-section-heading">
                    <span><i class="bi bi-building-check" aria-hidden="true"></i></span>
                    <div>
                        <h3>Loan provider</h3>
                        <p>Select the loan category and financial institution.</p>
                    </div>
                </header>

                <div class="viq-form-grid viq-form-grid-2">
                    <div class="viq-form-field">
                        <label>Loan type <span class="viq-required">*</span></label>
                        <DDLookupComponent SourceKey="DDLookupEnums.LoanTypes"
                                           @bind-Value="Model.LoanTypeId" />
                        <ValidationMessage For="@(() => Model.LoanTypeId)" class="viq-form-validation" />
                    </div>

                    <div class="viq-form-field">
                        <label>Bank name</label>
                        <DDLookupComponent SourceKey="DDLookupEnums.Banks"
                                           @bind-Value="Model.BankId" />
                        <ValidationMessage For="@(() => Model.BankId)" class="viq-form-validation" />
                    </div>
                </div>
            </section>

            <section class="viq-form-section">
                <header class="viq-form-section-heading">
                    <span><i class="bi bi-calendar2-check" aria-hidden="true"></i></span>
                    <div>
                        <h3>Loan terms</h3>
                        <p>Record the original facility date, amount and repayment conditions.</p>
                    </div>
                </header>

                <div class="viq-form-grid viq-form-grid-2">
                    <div class="viq-form-field">
                        <label for="loanDate">Loan date</label>
                        <input id="loanDate" type="date" class="viq-form-control"
                               @bind-value="Model.LoanDate" />
                        <ValidationMessage For="@(() => Model.LoanDate)" class="viq-form-validation" />
                    </div>

                    <div class="viq-form-field">
                        <label for="loanAmount">Loan amount</label>
                        <input id="loanAmount" type="number" class="viq-form-control text-end"
                               placeholder="0.00" @bind-value="Model.LoanAmount" />
                        <ValidationMessage For="@(() => Model.LoanAmount)" class="viq-form-validation" />
                    </div>

                    <div class="viq-form-field">
                        <label for="repaymentPeriod">Period (months)</label>
                        <input id="repaymentPeriod" type="number" step="0.01"
                               class="viq-form-control text-end" placeholder="0.00"
                               @bind-value="Model.RepaymentPeriodMonths" />
                        <ValidationMessage For="@(() => Model.RepaymentPeriodMonths)" class="viq-form-validation" />
                    </div>

                    <div class="viq-form-field">
                        <label for="interestRate">Interest rate per annum (%)</label>
                        <input id="interestRate" type="number" step="0.01"
                               class="viq-form-control text-end" placeholder="0.00"
                               @bind-value="Model.InterestRatePerAnnum" />
                        <ValidationMessage For="@(() => Model.InterestRatePerAnnum)" class="viq-form-validation" />
                    </div>
                </div>
            </section>

            <section class="viq-form-section">
                <header class="viq-form-section-heading">
                    <span><i class="bi bi-cash-stack" aria-hidden="true"></i></span>
                    <div>
                        <h3>Repayment profile</h3>
                        <p>Define the balance and payment timing used by the projection.</p>
                    </div>
                </header>

                <div class="viq-form-grid viq-form-grid-2">
                    <div class="viq-form-field">
                        <label for="loanBalance">Loan balance</label>
                        <input id="loanBalance" type="number" class="viq-form-control text-end"
                               placeholder="0.00" @bind-value="Model.LoanBalanceAtAssessmentDate" />
                        <ValidationMessage For="@(() => Model.LoanBalanceAtAssessmentDate)" class="viq-form-validation" />
                    </div>

                    <div class="viq-form-field">
                        <label for="monthlyPayment">Monthly payment (R)</label>
                        <input id="monthlyPayment" type="number" step="0.01"
                               class="viq-form-control text-end" placeholder="0.00"
                               @bind-value="Model.ActualRepaymentAmount" />
                        <ValidationMessage For="@(() => Model.ActualRepaymentAmount)" class="viq-form-validation" />
                    </div>

                    <div class="viq-form-field viq-form-span-2">
                        <label for="firstRepaymentMonth">First repayment month <span class="viq-required">*</span></label>
                        <select id="firstRepaymentMonth" class="viq-form-control" @bind="Model.StartMonth">
                            @for (int m = 1; m <= 12; m++)
                            {
                                <option value="@m">Month @m</option>
                            }
                        </select>
                        <ValidationMessage For="@(() => Model.StartMonth)" class="viq-form-validation" />
                    </div>
                </div>
            </section>

            <section class="viq-form-section">
                <header class="viq-form-section-heading">
                    <span><i class="bi bi-card-text" aria-hidden="true"></i></span>
                    <div>
                        <h3>Administration</h3>
                        <p>Add audit context and control whether this loan remains active.</p>
                    </div>
                </header>

                <div class="viq-form-field">
                    <label for="loanRemarks">Audit trail remarks</label>
                    <textarea id="loanRemarks" class="viq-form-control viq-form-textarea" rows="3"
                              placeholder="Enter configuration remarks ..."
                              @bind="Model.Remarks"></textarea>
                    <ValidationMessage For="@(() => Model.Remarks)" class="viq-form-validation" />
                </div>

                <label class="viq-toggle-card viq-toggle-card-wide" for="loanActive">
                    <span>
                        <strong>@(Model.Active ? "Loan active" : "Loan inactive")</strong>
                        <small>Inactive loans remain in history but are excluded from active processing.</small>
                    </span>
                    <input id="loanActive" class="viq-switch" type="checkbox" @bind="Model.Active" />
                </label>
            </section>

            <footer class="viq-form-actions">
                <button type="submit" class="viq-button viq-button-primary" disabled="@IsSubmitting">
                    @if (IsSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Saving data…</span>
                    }
                    else
                    {
                        <i class="bi bi-save" aria-hidden="true"></i>
                        <span>Save changes</span>
                    }
                </button>
            </footer>
        </EditForm>
    }
</div>
