@using ViabilityIQ.Application.Interfaces
@using ViabilityIQ.Infrastructure.Repositories
@using ViabilityIQ.Shared.DataModels

@if (loadingStateActive)
{
    <FormLoadingComponent />
}
else
{
    <EditForm Model="@debtorsCreditorsModel" OnValidSubmit="UpdateDebtorsCreditors">
        <DataAnnotationsValidator />
        <ValidationSummary class="alert alert-danger p-2 rounded mb-3" style="font-size: 0.85rem;" />
        <div class="viq-elevated-card">
            <div class="viq-card-header-dark-ice">
                <span class="fw-bold text-smokewhite-brand" style="font-size: 0.90rem;">Debtors/Creditors Ageing Profiles</span>
                <button type="submit" class="btn btn-sm btn-primary btn-update-font py-1 px-3 shadow-sm" disabled="@IsSubmitting">
                    <i class="bi bi-save me-1"></i> Update Profiles
                </button>
            </div>

            <div class="p-3">
                <div class="row g-0">
                    <!-- Entry Mode Switch -->
                    <div class="col-12 ps-1">
                        <div class="form-check form-switch bg-light rounded">
                            <input class="form-check-input" type="checkbox" id="entryModeSwitch"
                                   @bind="debtorsCreditorsModel.EntryMode"
                                   @bind:event="onchange" />
                            <label class="form-check-label fw-semibold text-navy" for="entryModeSwitch">
                                &nbsp;&nbsp;&nbsp;@(debtorsCreditorsModel.EntryMode ? "Entry Mode: Actual Values (R)" : "Entry Mode: Percentages (%)")
                            </label>
                        </div>
                    </div>

                    <!-- Creditors Section -->
                    <div class="col-md-6 col-12 border-end pe-md-3">
                        <div class="row mb-2 pb-2 border-bottom g-1 text-uppercase fw-bold text-dark" style="font-size: 0.75rem; letter-spacing: 0.3px;">
                            <div class="col-6 text-start">Creditors Profile Items</div>
                            <div class="col-3 text-end">% Value</div>
                            <div class="col-3 text-end">R Value</div>
                        </div>
                        <div class="d-flex flex-column gap-0">
                            <!-- 0-30 Days (Auto) -->
                            <div class="row form-inline-align-row g-0 align-items-center py-0">
                                <div class="col-6 py-1">
                                    <label class="form-label-custom text-muted mb-0" style="font-size: 0.80rem;">0-30 Days (Auto):</label>
                                </div>
                                <div class="col-3 py-1">
                                    <input type="text" class="form-control form-control-sm text-end bg-light"
                                           value="@CalculatedCreditors0To30.ToString("F2")%" readonly />
                                </div>
                                <div class="col-3 py-1">
                                    <div class="input-group input-group-sm py-0">
                                        <span class="input-group-text bg-light py-0 px-1" style="font-size: 0.75rem;">R</span>
                                        <input type="number" step="0.01" class="form-control form-control-sm text-end bg-light"
                                               value="@CalculatedCreditors0To30Value.ToString("F2")" readonly />
                                    </div>
                                </div>
                            </div>

                            <!-- 31-60 Days -->
                            <div class="row form-inline-align-row g-0 align-items-center">
                                <div class="col-6 py-1">
                                    <label class="form-label-custom text-muted mb-0" style="font-size: 0.80rem;">31-60 Days:</label>
                                </div>
                                <div class="col-3 py-1">
                                    <input type="number" step="0.01" class="form-control form-control-sm text-end"
                                           @bind="debtorsCreditorsModel.Creditors_60"
                                           @bind:event="onchange"
                                           min="0" max="100" />
                                </div>
                                <div class="col-3 py-1">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light py-0 px-1" style="font-size: 0.75rem;">R</span>
                                        <input type="number" step="0.01" class="form-control form-control-sm text-end"
                                               @bind="debtorsCreditorsModel.CreditorsValue_60"
                                               @bind:event="onchange"
                                               disabled="@(!debtorsCreditorsModel.EntryMode)" />
                                    </div>
                                </div>
                            </div>

                            <!-- 61-90 Days -->
                            <div class="row form-inline-align-row g-1 align-items-center py-0">
                                <div class="col-6 py-1">
                                    <label class="form-label-custom text-muted mb-0" style="font-size: 0.80rem;">61-90 Days:</label>
                                </div>
                                <div class="col-3 py-1">
                                    <input type="number" step="0.01" class="form-control form-control-sm text-end"
                                           @bind="debtorsCreditorsModel.Creditors_90"
                                           @bind:event="onchange"
                                           min="0" max="100" />
                                </div>
                                <div class="col-3 py-1">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light py-0 px-1" style="font-size: 0.75rem;">R</span>
                                        <input type="number" step="0.01" class="form-control form-control-sm text-end"
                                               @bind="debtorsCreditorsModel.CreditorsValue_90"
                                               @bind:event="onchange"
                                               disabled="@(!debtorsCreditorsModel.EntryMode)" />
                                    </div>
                                </div>
                            </div>

                            <!-- 91-120 Days -->
                            <div class="row form-inline-align-row g-1 align-items-center py-0">
                                <div class="col-6 py-1">
                                    <label class="form-label-custom text-muted mb-0" style="font-size: 0.80rem;">91-120 Days:</label>
                                </div>
                                <div class="col-3 py-1">
                                    <input type="number" step="0.01" class="form-control form-control-sm text-end"
                                           @bind="debtorsCreditorsModel.Creditors_120"
                                           @bind:event="onchange"
                                           min="0" max="100" />
                                </div>
                                <div class="col-3 py-1">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light py-0 px-1" style="font-size: 0.75rem;">R</span>
                                        <input type="number" step="0.01" class="form-control form-control-sm text-end"
                                               @bind="debtorsCreditorsModel.CreditorsValue_120"
                                               @bind:event="onchange"
                                               disabled="@(!debtorsCreditorsModel.EntryMode)" />
                                    </div>
                                </div>
                            </div>

                            <!-- 120+ Days -->
                            <div class="row form-inline-align-row g-1 align-items-center py-0">
                                <div class="col-6 py-1">
                                    <label class="form-label-custom text-muted mb-0" style="font-size: 0.80rem;">120+ Days:</label>
                                </div>
                                <div class="col-3 py-1">
                                    <input type="number" step="0.01" class="form-control form-control-sm text-end"
                                           @bind="debtorsCreditorsModel.Creditors_120Plus"
                                           @bind:event="onchange"
                                           min="0" max="100" />
                                </div>
                                <div class="col-3 py-1">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light py-0 px-1" style="font-size: 0.75rem;">R</span>
                                        <input type="number" step="0.01" class="form-control form-control-sm text-end"
                                               @bind="debtorsCreditorsModel.CreditorsValue_120Plus"
                                               @bind:event="onchange"
                                               disabled="@(!debtorsCreditorsModel.EntryMode)" />
                                    </div>
                                </div>
                            </div>

                            <!-- Total Row -->
                            <div class="row form-inline-align-row g-1 align-items-center border-top pt-1 mt-1 fw-bold">
                                <div class="col-6 py-0">
                                    <label class="form-label-custom text-dark mb-0 fw-bold" style="font-size: 0.70rem;">TOTAL:</label>
                                </div>
                                <div class="col-3 py-0">
                                    <input type="text" class="form-control form-control-sm text-end bg-light"
                                           value="@TotalCreditorsPercentage.ToString("F2")%" readonly />
                                </div>
                                <div class="col-3 py-0">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light py-0 px-1" style="font-size: 0.75rem;">R</span>
                                        <input type="text" class="form-control form-control-sm text-end bg-light"
                                               value="@TotalCreditorsValue.ToString("F2")" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Debtors Section -->
                    <div class="col-md-6 col-12 ps-md-2">
                        <div class="row mb-2 pb-2 border-bottom g-1 text-uppercase fw-bold text-dark" style="font-size: 0.75rem; letter-spacing: 0.3px;">
                            <div class="col-6 text-start">Debtors Profile Items</div>
                            <div class="col-3 text-end">% Value</div>
                            <div class="col-3 text-end">R Value</div>
                        </div>
                        <div class="d-flex flex-column gap-2">
                            <!-- 0-30 Days (Auto) -->
                            <div class="row form-inline-align-row g-1 align-items-center">
                                <div class="col-6">
                                    <label class="form-label-custom text-muted mb-0" style="font-size: 0.80rem;">0-30 Days (Auto):</label>
                                </div>
                                <div class="col-3">
                                    <input type="text" class="form-control form-control-sm text-end bg-light"
                                           value="@CalculatedDebtors0To30.ToString("F2")%" readonly />
                                </div>
                                <div class="col-3">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light py-0 px-1" style="font-size: 0.75rem;">R</span>
                                        <input type="number" step="0.01" class="form-control form-control-sm text-end bg-light"
                                               value="@CalculatedDebtors0To30Value.ToString("F2")" readonly />
                                    </div>
                                </div>
                            </div>

                            <!-- 31-60 Days -->
                            <div class="row form-inline-align-row g-1 align-items-center">
                                <div class="col-6">
                                    <label class="form-label-custom text-muted mb-0" style="font-size: 0.80rem;">31-60 Days:</label>
                                </div>
                                <div class="col-3">
                                    <input type="number" step="0.01" class="form-control form-control-sm text-end"
                                           @bind="debtorsCreditorsModel.Debtors_60"
                                           @bind:event="onchange"
                                           min="0" max="100" />
                                </div>
                                <div class="col-3">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light py-0 px-1" style="font-size: 0.75rem;">R</span>
                                        <input type="number" step="0.01" class="form-control form-control-sm text-end"
                                               @bind="debtorsCreditorsModel.DebtorsValue_60"
                                               @bind:event="onchange"
                                               disabled="@(!debtorsCreditorsModel.EntryMode)" />
                                    </div>
                                </div>
                            </div>

                            <!-- 61-90 Days -->
                            <div class="row form-inline-align-row g-1 align-items-center">
                                <div class="col-6">
                                    <label class="form-label-custom text-muted mb-0" style="font-size: 0.80rem;">61-90 Days:</label>
                                </div>
                                <div class="col-3">
                                    <input type="number" step="0.01" class="form-control form-control-sm text-end"
                                           @bind="debtorsCreditorsModel.Debtors_90"
                                           @bind:event="onchange"
                                           min="0" max="100" />
                                </div>
                                <div class="col-3">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light py-0 px-1" style="font-size: 0.75rem;">R</span>
                                        <input type="number" step="0.01" class="form-control form-control-sm text-end"
                                               @bind="debtorsCreditorsModel.DebtorsValue_90"
                                               @bind:event="onchange"
                                               disabled="@(!debtorsCreditorsModel.EntryMode)" />
                                    </div>
                                </div>
                            </div>

                            <!-- 91-120 Days -->
                            <div class="row form-inline-align-row g-1 align-items-center">
                                <div class="col-6">
                                    <label class="form-label-custom text-muted mb-0" style="font-size: 0.80rem;">91-120 Days:</label>
                                </div>
                                <div class="col-3">
                                    <input type="number" step="0.01" class="form-control form-control-sm text-end"
                                           @bind="debtorsCreditorsModel.Debtors_120"
                                           @bind:event="onchange"
                                           min="0" max="100" />
                                </div>
                                <div class="col-3">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light py-0 px-1" style="font-size: 0.75rem;">R</span>
                                        <input type="number" step="0.01" class="form-control form-control-sm text-end"
                                               @bind="debtorsCreditorsModel.DebtorsValue_120"
                                               @bind:event="onchange"
                                               disabled="@(!debtorsCreditorsModel.EntryMode)" />
                                    </div>
                                </div>
                            </div>

                            <!-- 120+ Days -->
                            <div class="row form-inline-align-row g-1 align-items-center">
                                <div class="col-6">
                                    <label class="form-label-custom text-muted mb-0" style="font-size: 0.80rem;">120+ Days:</label>
                                </div>
                                <div class="col-3">
                                    <input type="number" step="0.01" class="form-control form-control-sm text-end"
                                           @bind="debtorsCreditorsModel.Debtors_120Plus"
                                           @bind:event="onchange"
                                           min="0" max="100" />
                                </div>
                                <div class="col-3">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light py-0 px-1" style="font-size: 0.75rem;">R</span>
                                        <input type="number" step="0.01" class="form-control form-control-sm text-end"
                                               @bind="debtorsCreditorsModel.DebtorsValue_120Plus"
                                               @bind:event="onchange"
                                               disabled="@(!debtorsCreditorsModel.EntryMode)" />
                                    </div>
                                </div>
                            </div>

                            <!-- Total Row -->
                            <div class="row form-inline-align-row g-1 align-items-center border-top pt-1 mt-1 fw-bold ">
                                <div class="col-6 py-0">
                                    <label class="form-label-custom text-dark mb-0 fw-bold" style="font-size: 0.70rem;">TOTAL:</label>
                                </div>
                                <div class="col-3 py-0">
                                    <input type="text" class="form-control form-control-sm text-end bg-light"
                                           value="@TotalDebtorsPercentage.ToString("F2")%" readonly />
                                </div>
                                <div class="col-3 py-0">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light py-0 px-1" style="font-size: 0.75rem;">R</span>
                                        <input type="text" class="form-control form-control-sm text-end bg-light"
                                               value="@TotalDebtorsValue.ToString("F2")" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </EditForm>
}