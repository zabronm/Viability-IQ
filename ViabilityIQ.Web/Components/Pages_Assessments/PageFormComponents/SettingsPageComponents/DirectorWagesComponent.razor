@using ViabilityIQ.Infrastructure.Repositories
<EditForm Model="@directorWagesModel" OnValidSubmit="UpdateDirectorWages">
    <DataAnnotationsValidator />
    <section class="dw-card">
        <header><span class="dw-icon"><i class="bi bi-people"></i></span><div><span>Management costs</span><h3>Director Wages</h3><p>Monthly remuneration included in operating cash outflows.</p></div></header>
        <ValidationSummary class="dw-validation" />
        <div class="dw-fields">
            <label><span>Number of directors</span><input type="number" min="1" max="100" @bind-value="directorWagesModel.NumberOfDirectors" @bind-value:event="oninput" /></label>
            <label><span>Monthly wage per director</span><div class="dw-input"><span>R</span><input type="number" step="0.01" @bind-value="directorWagesModel.MonthlyDirectorWagesAmount" @bind-value:event="oninput" /></div></label>
            <label><span>Combined monthly impact</span><div class="dw-input"><span>R</span><input value="@TotalCalculatedDirectorWages.ToString("N2")" readonly disabled /></div></label>
        </div>
        <footer>
            <span><i class="bi bi-calculator"></i> Total is recalculated from directors × wage.</span>
            <button type="submit" disabled="@IsSubmitting">
                <i class="bi bi-check2-circle"></i> Update Director Wages
            </button>
        </footer>
    </section>
</EditForm>

@code {

    [Inject] private MasterDataService? ViqCrudService { get; set; }
    [Parameter] public DirectorWagesModel directorWagesModel { get; set; } = new();
    [Parameter] public EventCallback<SaveResult> OnUpdate { get; set; }

    private SaveResult? result = new();
    private bool IsSubmitting; private bool loadingStateActive;
    private decimal TotalCalculatedDirectorWages => (directorWagesModel?.NumberOfDirectors ?? 0) * (directorWagesModel?.MonthlyDirectorWagesAmount ?? 0m);
    protected override async Task OnParametersSetAsync() => await RefreshAsync();

    public async Task RefreshAsync()
    {
        loadingStateActive = true;
        await Task.Delay(150); loadingStateActive = false; StateHasChanged();
    }

    private async Task UpdateDirectorWages()
    {
        IsSubmitting = true;
        directorWagesModel.MonthlyDirectorWagesAmountTotal = TotalCalculatedDirectorWages;
        const string sql = @"UPDATE tblAssessments SET MonthlyDirectorWagesAmountTotal=@MonthlyDirectorWagesAmountTotal, 
                                NumberOfDirectors=@NumberOfDirectors, MonthlyDirectorWagesAmount=@MonthlyDirectorWagesAmount WHERE AssessmentId=@AssessmentId";
        try
        {
            var rows = await ViqCrudService!.ExecuteCommandAsync(
                            sql, new { directorWagesModel.MonthlyDirectorWagesAmountTotal, directorWagesModel.MonthlyDirectorWagesAmount, directorWagesModel.NumberOfDirectors, directorWagesModel.AssessmentId });
            result = rows > 0 ? new SaveResult { Message = "Director wages updated successfully", Success = true } : SaveResult.Failed("Director wages were not updated. Please retry.");
        }
        catch (Exception ex)
        {
            result = SaveResult.Failed($"Director wages could not be updated: {ex.Message}");
        }
        finally
        {
            IsSubmitting = false; if (OnUpdate.HasDelegate) await OnUpdate.InvokeAsync(result!);
        }
    }
}
