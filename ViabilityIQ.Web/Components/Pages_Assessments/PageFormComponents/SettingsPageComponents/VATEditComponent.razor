@using ViabilityIQ.Infrastructure.Repositories

<div class="viq-form-shell">
    @if (loadingStateActive)
    {
        <div class="viq-form-busy" role="status" aria-live="polite">
            <div class="viq-form-busy-card">
                <span class="viq-form-spinner" aria-hidden="true"></span>
                <div>
                    <strong>Loading VAT settings</strong>
                    <span>Please wait while the assessment context is prepared.</span>
                </div>
            </div>
        </div>
    }
    else
    {
        <EditForm Model="@vatUpdateModel" OnValidSubmit="UpdateVATRateOnly"
                  class="viq-data-form" aria-label="Assessment period and VAT">
            <DataAnnotationsValidator />

            <div class="viq-form-intro">
                <span class="viq-form-intro-icon"><i class="bi bi-receipt" aria-hidden="true"></i></span>
                <div>
                    <h2>Assessment period &amp; VAT</h2>
                    <p>Confirm the assessment context and VAT rate used across taxable projections.</p>
                </div>
            </div>

            <ValidationSummary class="viq-form-validation-summary" />

            <section class="viq-form-section">
                <header class="viq-form-section-heading">
                    <span><i class="bi bi-calendar3-range" aria-hidden="true"></i></span>
                    <div>
                        <h3>Assessment context</h3>
                        <p>Read-only case, period and business information.</p>
                    </div>
                </header>

                <div class="viq-form-grid viq-form-grid-2">
                    <div class="viq-form-field">
                        <label for="vatCaseNumber">Case number</label>
                        <input id="vatCaseNumber" class="viq-form-control"
                               value="@vatUpdateModel.CaseNumber" readonly disabled />
                    </div>

                    <div class="viq-form-field">
                        <label for="vatBusiness">Business</label>
                        <div id="vatBusiness">
                            <DDLookupComponent SourceKey="DDLookupEnums.Businesses" Label="Business"
                                               @bind-Value="@vatUpdateModel.BusinessId" IsDisabled="true" />
                        </div>
                    </div>

                    <div class="viq-form-field">
                        <label for="vatPeriodStart">Period start</label>
                        <input id="vatPeriodStart" class="viq-form-control"
                               value="@vatUpdateModel.AssessmentStartDate?.ToString("yyyy-MM-dd")" readonly disabled />
                    </div>

                    <div class="viq-form-field">
                        <label for="vatPeriodEnd">Period end</label>
                        <input id="vatPeriodEnd" class="viq-form-control"
                               value="@vatUpdateModel.AssessmentFinishDate?.ToString("yyyy-MM-dd")" readonly disabled />
                    </div>
                </div>
            </section>

            <section class="viq-form-section">
                <header class="viq-form-section-heading">
                    <span><i class="bi bi-percent" aria-hidden="true"></i></span>
                    <div>
                        <h3>Statutory settings</h3>
                        <p>Set the VAT percentage applied to taxable projections.</p>
                    </div>
                </header>

                <div class="viq-form-grid viq-form-grid-2">
                    <div class="viq-form-field viq-form-span-2">
                        <label for="vatRate">VAT rate (%) <span class="viq-required">*</span></label>
                        <input id="vatRate" class="viq-form-control" type="number" min="0" max="100" step="0.01"
                               value="@vatUpdateModel.VatRate.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                               @onchange="SetVatRate" />
                        <ValidationMessage For="@(() => vatUpdateModel.VatRate)" class="viq-form-validation" />
                    </div>
                </div>
            </section>

            <footer class="viq-form-actions">
                <span><i class="bi bi-info-circle" aria-hidden="true"></i> The rate is applied to VAT-inclusive sales, purchases and expenses.</span>
                <button type="submit" class="viq-button viq-button-primary" disabled="@IsSubmitting">
                    @if (IsSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Updating…</span>
                    }
                    else
                    {
                        <i class="bi bi-check2-circle" aria-hidden="true"></i>
                        <span>Update VAT</span>
                    }
                </button>
            </footer>
        </EditForm>
    }
</div>

@code {
    [Inject] private MasterDataService? ViqCrudService { get; set; }
    [Parameter] public VatUpdateModel vatUpdateModel { get; set; } = new();
    [Parameter] public EventCallback<SaveResult> OnUpdate { get; set; }
    private SaveResult? result = new(); private bool IsSubmitting; private bool loadingStateActive;
    protected override async Task OnParametersSetAsync() => await RefreshAsync();
    public async Task RefreshAsync(){loadingStateActive=true;await Task.Delay(150);loadingStateActive=false;StateHasChanged();}
    private void SetVatRate(ChangeEventArgs e){if(decimal.TryParse(Convert.ToString(e.Value),System.Globalization.NumberStyles.Number,System.Globalization.CultureInfo.InvariantCulture,out var value))vatUpdateModel.VatRate=value;}
    private async Task UpdateVATRateOnly()
    {
        IsSubmitting=true;
        try
        {
            var rows=await ViqCrudService!.ExecuteCommandAsync("UPDATE tblAssessments SET VATRate=@VATRate WHERE AssessmentId=@AssessmentId",new{VATRate=vatUpdateModel.VatRate,vatUpdateModel.AssessmentId});
            result=rows>0?new SaveResult{Message="VAT rate updated successfully",Success=true}:SaveResult.Failed("VAT rate was not updated. Please retry.");
        }
        catch(Exception ex){result=SaveResult.Failed($"VAT rate could not be updated: {ex.Message}");}
        finally{IsSubmitting=false;if(OnUpdate.HasDelegate)await OnUpdate.InvokeAsync(result!);}
    }
}
