@namespace ViabilityIQ.Web.Components.Pages_Assessments.PageFormComponents

<div class="viq-form-shell">
    @if (FormModel != null)
    {
        <div class="viq-data-form" aria-label="Sundry income projection">
            <div class="viq-form-intro">
                <span class="viq-form-intro-icon"><i class="bi bi-info-circle" aria-hidden="true"></i></span>
                <div>
                    <h2>Incidental income schedule</h2>
                    <p>Update incidental operational cash flows or use split allocations.</p>
                </div>
            </div>

            <section class="viq-form-section">
                <header class="viq-form-section-heading">
                    <span><i class="bi bi-bullseye" aria-hidden="true"></i></span>
                    <div>
                        <h3>Sundry target</h3>
                        <p>@FormModel.StreamName</p>
                    </div>
                </header>
            </section>

            <section class="viq-form-section">
                <header class="viq-form-section-heading">
                    <span><i class="bi bi-distribute-horizontal" aria-hidden="true"></i></span>
                    <div>
                        <h3>Quick distribution engine</h3>
                        <p>Split an annual amount evenly across all months.</p>
                    </div>
                </header>
                <div class="viq-form-grid viq-form-grid-2">
                    <div class="viq-form-field">
                        <label for="sundryAnnualTarget">Annual target amount</label>
                        <input id="sundryAnnualTarget" type="number" class="viq-form-control"
                               placeholder="Enter target annual amount..."
                               @bind="BulkAnnualValueTarget" min="0" />
                    </div>
                    <div class="viq-form-field">
                        <label>Distribution action</label>
                        <button class="viq-button viq-button-secondary" type="button"
                                @onclick="DistributeAnnualValueEvenly">
                            <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                            <span>Apply split</span>
                        </button>
                    </div>
                </div>
            </section>

            <section class="viq-form-section">
                <header class="viq-form-section-heading">
                    <span><i class="bi bi-calendar3" aria-hidden="true"></i></span>
                    <div>
                        <h3>12-month incidental stream</h3>
                        <p>Enter the incidental income balance for each month.</p>
                    </div>
                </header>
                <div class="viq-form-grid viq-form-grid-2">
                    @for (int i = 0; i < 12; i++)
                    {
                        var index = i;
                        <div class="viq-form-field">
                            <label for="@($"sundryMonth{index + 1}")">Month @(index + 1)</label>
                            <input id="@($"sundryMonth{index + 1}")" type="number"
                                   class="viq-form-control"
                                   @bind="FormModel.MonthlySundry[index]"
                                   @bind:event="oninput" min="0" />
                        </div>
                    }
                </div>
            </section>

            <footer class="viq-form-actions">
                <button type="button" class="viq-button viq-button-primary"
                        @onclick="ExecuteSaveWorkflowAsync">
                    <i class="bi bi-check-circle" aria-hidden="true"></i>
                    <span>Save matrix parameters</span>
                </button>
                <button type="button" class="viq-button viq-button-secondary"
                        @onclick="CancelFormAsync">Cancel</button>
            </footer>
        </div>
    }
</div>
