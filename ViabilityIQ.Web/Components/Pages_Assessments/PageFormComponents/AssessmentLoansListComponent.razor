@using ViabilityIQ.Application.Dtos
@using ViabilityIQ.Shared.DataModels
@using ViabilityIQ.Application.Interfaces



<div class="w-100 table-responsive viq-table-container">
    @if (IsComponentLoading)
    {
        <div class="p-3 text-center">
            <div class="spinner-border text-primary spinner-border-sm mb-1" role="status"></div>
            <div class="text-muted" style="font-size: 0.72rem;">Loading Assessment Loans...</div>
        </div>
    }
    else if (Loans == null || !Loans.Any())
    {
        <div class="p-3 text-center text-muted" style="font-size: 0.75rem;">
            <i class="bi bi-folder-x d-block mb-1 fs-5"></i> No assessment loans mapped to this assessment.
        </div>
    }
    else
    {
        <table class="table table-sm table-hover align-middle mb-0 text-nowrap border-0">
            <thead>
                <tr class="pb-1" style="background-color: #f5f5f5 !important;">
                    <th class="text-center small text-secondary" style="width: 60px;font-size:0.70rem;">Item#</th>
                    <th class="text-start small text-secondary " style="font-size:0.70rem;">Loan Type</th>
                    <th class="text-start small text-secondary " style="font-size:0.70rem;">Bank</th>
                    <th class="text-end small text-secondary " style="font-size:0.70rem;">Loan Balance</th>
                    @* <th class="text-end viq-th-style" style="width: 60px;">Term(months)</th> *@
                    <th class="text-end small text-secondary " style="font-size:0.70rem;">Interest(%)</th>
                    <th class="text-end small text-secondary " style="font-size:0.70rem;">Installment</th>
                    <th class="text-center small text-secondary " style="font-size:0.70rem;">Status</th>
                    <th class="text-center small text-secondary " style="font-size:0.70rem;">Action</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int rowCounter = 1;
                }
                @foreach (var loan in Loans)
                {
                    <tr class="viq-td-style">
                        <td class="text-center text-muted fw-semibold">
                            @rowCounter
                        </td>
                        <td class="text-start text-dark fw-medium">
                            @loan.LoanTypeName
                        </td>
                        <td class="text-start text-dark fw-medium">
                            @loan.BankName
                        </td>
                        <td class="text-end">
                            <span class="py-1" style="min-width: 65px; font-size: inherit;">
                                @loan.LoanBalanceAtAssessmentDate.ToString("N2")
                            </span>
                        </td>
                        @* <td class="text-end">
                            <span class="text-end" style="min-width: 65px; font-size: inherit;">
                                @loan.RepaymentPeriodMonths.ToString("N2")
                            </span>
                        </td> *@
                        <td class="text-end">
                            <span class="badge fw-normal px-1 py-1 @GetInterestBadgeClass(loan.InterestRatePerAnnum)" style="min-width: 65px; font-size: inherit;">
                                @loan.InterestRatePerAnnum.ToString("N2")%
                            </span>
                        </td>
                        <td class="text-end">
                            <span class="py-1" style="min-width: 65px; font-size: inherit;">
                                @loan.ActualRepaymentAmount.ToString("N2")
                            </span>
                        </td>
                        <td class="text-center">                            

                            @if (loan.Active)
                            {
                                <span class="badge border" style="font-size: 0.65rem; padding: 2px 5px; background-color: #e8f5e9; color: #2e7d32; border-color: #c8e6c9 !important;">Active</span>
                            }
                            else
                            {
                                <span class="badge border" style="font-size: 0.65rem; padding: 2px 5px; background-color: #ffebee; color: #c62828; border-color: #ffcdd2 !important;">Inactive</span>
                            }
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-xs btn-link p-0 text-primary line-height-1" title="Edit Category"
                                    @onclick="() => OnEditRequested.InvokeAsync(loan.AssessmentLoanId)">
                                <i class="bi bi-vector-pen" style="font-size: 0.95rem;"></i>
                            </button>
                        </td>
                    </tr>
                    rowCounter++;
                }
            </tbody>
        </table>
    }
</div>

<style type="text/css">
    /* Table Wrapper to isolate rounded clipping context */
    .viq-table-container {
        border-top-left-radius: 6px !important; /* Matches dashboard card theme */
        border-top-right-radius: 6px !important;
        overflow: hidden !important;
    }

    /* Table Header Specific Rules */
    .viq-th-style {
        font-size: 0.75rem !important;
        font-weight: 700 !important;
        color: #212529 !important;
        padding-top: 6px !important;
        padding-bottom: 2px !important;
        border-bottom: 2px solid #b2b2b2 !important;
    }

        /* Force the leftmost th to clip cleanly */
        .viq-th-style:first-child {
            border-top-left-radius: 6px !important;
        }

        /* Force the rightmost th to clip cleanly */
        .viq-th-style:last-child {
            border-top-right-radius: 6px !important;
        }

    /* Detail Line Item Styling */
    .viq-td-style td {
        font-size: 0.85rem !important;
        padding-top: 2px !important;
        padding-bottom: 2px !important;
        border-bottom: 1px solid #dee2e6 !important;
    }
</style>