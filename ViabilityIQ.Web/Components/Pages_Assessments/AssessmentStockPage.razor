@page "/assessment/stock/"
@layout MainLayout_Assessment
@inherits Microsoft.AspNetCore.Components.ComponentBase
@inject IJSRuntime JSRuntime

@using ViabilityIQ.Web.Components.CommonComponents
@using ViabilityIQ.Web.Components.Layout

<div class="p-0 position-relative dashboard-workspace container-fluid">
    <PageHeading_Assessment _pageTitle="Stock" PageTitle="Stock Management & Valuation" CurrentPage="PageType.Stock" />    

    <div class="row bg-white g-3 mt-2 workspace-card-row">
        @if (blAlert == true)
        {
            <div class="my-0">
                <ViqAlertComponent Severity="AlertSeverity" 
                          Heading="@AlertHeading" 
                          Message="@AlertMessage" 
                          AllowDismiss="true" />
            </div>
        }
        <div class="p-0 my-1">
            <div class="row align-items-center mx-0 g-3">
                <div class="col-md-7 col-12 d-flex gap-1.5">
                    <button type="button" class="btn btn-primary text-xs py-2 px-2 shadow-sm" @onclick="OpenStockDataEntryPanel">
                        <i class="bi bi-pencil-square me-1"></i>Edit Monthly Inventory
                    </button>
                </div>
                <div class="col-md-5 col-12"></div>
            </div>
        </div>

        <div class="col-xl-12 col-lg-12 col-12">
            <div class="table-responsive shadow-sm border border-secondary-subtle mb-3 stock-grid-container">
                <table class="table table-sm table-hover text-nowrap vertical-align-middle align-middle mb-0 matrix-grid-table">
                    <thead>
                        <tr class="bg-light header-row text-muted fw-bold border-bottom align-bottom">
                            <th class="ps-2 text-uppercase text-xs stock-header-title text-end pb-2">Stock Line&nbsp;<i class="bi bi-caret-right-fill"></i></th>
                            @for (int m = 1; m <= 12; m++)
                            {
                                <th class="text-end text-xxs text-uppercase stock-month-header pb-2">
                                    @if (m == 1)
                                    {
                                        <span class="d-block text-xxs text-muted fst-italic fw-normal text-lowercase">(opening stock)</span>
                                    }
                                    @if (m == 12)
                                    {
                                        <span class="d-block text-xxs text-muted fst-italic fw-normal text-lowercase">(closing stock)</span>
                                    }
                                    M@(m)
                                </th>
                            }
                            <th class="text-end font-weight-bold text-white bg-navy stock-summary-header pb-2">Avg Stock</th>
                            <th class="text-end font-weight-bold text-white bg-navy stock-summary-header pb-2 px-3">Turn-Over (Days)</th>
                            <th class="text-center sticky-action-header stock-action-header pb-2"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (StockInventoryContext != null)
                        {
                            <tr class="stock-row-style">
                                <td class="ps-2 text-dark small text-truncate stock-body-title-label" title="@StockInventoryContext.StockRowLabel">
                                    @StockInventoryContext.StockRowLabel:
                                </td>
                                @for (int i = 0; i < 12; i++)
                                {
                                    var index = i;
                                    <td class="text-end font-monospace text-secondary">
                                        @StockInventoryContext.MonthlyBalances[index].ToString("N0")
                                    </td>
                                }
                                <td class="text-end font-monospace fw-bold bg-navy-light-summary stock-summary-cell">
                                    @AverageStockValue.ToString("N0")
                                </td>
                                <td class="text-end font-monospace fw-bold bg-navy-light-summary stock-summary-cell px-3">
                                    <span class="me-1.5">@StockTurnoverDays.ToString("N0")</span>
                                    <span class="badge @GetTurnoverRatingBadgeClass()">@TurnoverRatingText</span>
                                </td>
                                <td class="text-center pe-1">
                                    <button type="button" class="btn btn-outline-primary btn-xs p-0 px-1 shadow-sm line-action-btn"
                                            @onclick="OpenStockDataEntryPanel">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-2 mb-4 pt-1 pb-4 shadow" style="border-radius: 8px; background-color: #ffffff;">
        <div class="fs-4 my-1">Stock Analysis</div>

        <div class="col-xl-3 col-md-3 col-12" >           
            <div class="card shadow-sm border border-secondary-subtle p-2 mb-3 bg-white" style="border-radius: 8px;">                
                <div class="d-flex align-items-center mb-2 border-bottom pb-1">
                    <span class="text-xxs fw-bold text-uppercase text-secondary tracking-wider">
                        <i class="bi bi-calculator text-primary me-1"></i>Cost of Sales Analysis
                    </span>
                </div>
                <table class="table table-sm table-borderless vertical-align-middle align-middle mb-0 text-xs">
                    <tbody>
                        <tr class="border-bottom-subtle">
                            <td class="text-muted py-1">Opening Stock</td>
                            <td class="text-end font-monospace fw-semibold text-dark py-1">@OpeningStockValue.ToString("N0")</td>
                        </tr>
                        <tr class="border-bottom-subtle">
                            <td class="text-muted py-1"><i class="bi bi-plus text-success me-1"></i>Add: Purchases</td>
                            <td class="text-end font-monospace fw-semibold text-dark py-1">@TotalPurchasesComputed.ToString("N0")</td>
                        </tr>
                        <tr class="border-bottom">
                            <td class="text-muted py-1"><i class="bi bi-dash text-danger me-1"></i>Less: Closing Stock</td>
                            <td class="text-end font-monospace fw-semibold text-dark py-1">@ClosingStockValue.ToString("N0")</td>
                        </tr>
                        <tr class="bg-light-totals-cell">
                            <td class="fw-bold text-navy-brand py-1">Cost Of Sales</td>
                            <td class="text-end font-monospace fw-bold text-navy-brand py-1">@CostOfSalesValue.ToString("N0")</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="card shadow-sm border border-secondary-subtle p-2 bg-white" style="border-radius: 8px;">
                <div class="d-flex align-items-center mb-2 border-bottom pb-1">
                    <span class="text-xxs fw-bold text-uppercase text-secondary tracking-wider">
                        <i class="bi bi-speedometer2 text-warning me-1"></i>Stock Turnover Rate
                    </span>
                </div>
                <table class="table table-sm table-borderless vertical-align-middle align-middle mb-0 text-xs">
                    <tbody>
                        <tr class="border-bottom-subtle">
                            <td class="text-muted py-1">Cost Of Sales</td>
                            <td class="text-end font-monospace fw-semibold text-dark py-1">@CostOfSalesValue.ToString("N0")</td>
                        </tr>
                        <tr class="border-bottom-subtle">
                            <td class="text-muted py-1">Average Stock</td>
                            <td class="text-end font-monospace fw-semibold text-dark py-1">@AverageStockValue.ToString("N0")</td>
                        </tr>
                        <tr class="border-bottom-subtle">
                            <td class="text-muted py-1">COS / Av Stock (Times)</td>
                            <td class="text-end font-monospace fw-bold text-dark py-1">@TurnoverTimes.ToString("N1")×</td>
                        </tr>
                        <tr class="bg-light-totals-cell border-top">
                            <td class="fw-bold text-dark py-1">365 / Times (Days)</td>
                            <td class="text-end font-monospace fw-bold text-navy-brand py-1">
                                <span class="me-1">@StockTurnoverDays.ToString("N0") Days</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="col-xl-5 col-md-5 col-12">
            <div class="card shadow-sm border border-secondary-subtle p-3 h-100 bg-white" style="border-radius: 8px;">
                <div class="d-flex align-items-center justify-content-between mb-2 border-bottom pb-1">
                    <span class="text-xxs fw-bold text-uppercase text-secondary tracking-wider">
                        <i class="bi bi-graph-up text-primary me-1"></i>Sales Volume Revenue vs Stock Value Trends
                    </span>
                    <span class="badge bg-light text-dark border text-xxs">12 Months Horizon</span>
                </div>
                <div class="chart-container position-relative flex-fill mt-1" style="height: 200px;">
                    <canvas id="viqSalesStockTrendChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-4 col-12">
            <div class="card shadow-sm border border-secondary-subtle p-3 h-100 bg-white" style="border-radius: 8px;">
                <div class="d-flex align-items-center justify-content-between mb-2 border-bottom pb-1">
                    <span class="text-xxs fw-bold text-uppercase text-secondary tracking-wider">
                        <i class="bi bi-arrow-repeat text-success me-1"></i>Cash Conversion Cycle Metrics
                    </span>
                    <span class="badge bg-navy-light-summary text-navy-brand text-xxs">@CashCycleDays Days</span>
                </div>
                <div class="chart-container position-relative flex-fill mt-1" style="height: 200px;">
                    <canvas id="viqCashCycleHorizontalChart"></canvas>
                </div>
            </div>
        </div>
        
    </div>
</div>

<footer class="py-2 bg-light mt-3">
    <BFooter />
</footer>

<ZabOffCanvas @ref="OffCanvasControlRef" HeaderTitle="@ActivePanelTitle" dWidth="430">
    <div class="p-3">
        @if (ActiveFormType == FormContextType.Stock && StockInventoryContext != null)
        {
            <div class="alert alert-info py-1.5 rounded mb-2 text-xxs shadow-sm">
                <i class="bi bi-box-seam me-1"></i> Update inventory data entries or apply instant full splits below.
            </div>

            <div class="card bg-light border-0 mb-3 p-1.5 rounded">
                <label class="form-label fw-bold text-xxs text-secondary uppercase mb-0.5">Quick Even Distribution Engine</label>
                <div class="input-group input-group-sm">
                    <input type="number" class="form-control font-monospace text-xs" placeholder="Target figure for all months" @bind="BulkStockValueTarget" min="0" />
                    <button class="btn btn-navy text-white text-xxs px-2 fw-bold" type="button" @onclick="DistributeStockValuesEvenly">Apply Split</button>
                </div>
            </div>

            <h6 class="text-xxs fw-bold text-secondary mb-1 uppercase">12-Month Inventory Horizon Balances</h6>
            <div class="pe-1 border p-1.5 rounded bg-light-subtle mb-3 stock-input-pane">
                @for (int i = 0; i < 12; i++)
                {
                    var index = i;
                    <div class="row align-items-center mb-1 g-2 mx-0 input-row-hover rounded py-0.5">
                        <div class="col-4">
                            <span class="text-xxs fw-semibold text-muted">
                                @(index == 0 ? "M1 (Opening)" : index == 11 ? "M12 (Closing)" : $"Month {index + 1}")
                            </span>
                        </div>
                        <div class="col-8">
                            <input type="number" class="form-control form-control-sm text-end font-monospace text-xs py-0.5 text-dark fw-bold"
                                   @bind="StockInventoryContext.MonthlyBalances[index]"
                                   @bind:event="oninput"
                                   min="0" />
                        </div>
                    </div>
                }
            </div>

            <div class="d-flex align-items-center gap-2 mt-3 pt-2 border-top">
                <button type="button" class="btn btn-primary btn-sm flex-fill py-1.5 text-xs fw-bold shadow-sm" @onclick="HandleWorkflowStateChanged">Save Stock Changes</button>
                <button type="button" class="btn btn-outline-secondary btn-sm py-1.5 text-xs" @onclick="() => OffCanvasControlRef.CloseAsync()">Cancel</button>
            </div>
        }
    </div>
</ZabOffCanvas>