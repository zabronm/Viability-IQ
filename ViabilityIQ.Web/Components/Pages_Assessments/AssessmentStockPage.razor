@page "/assessment/stock/"
@layout MainLayout_Assessment
@using ViabilityIQ.Web.Components.CommonComponents
@using ViabilityIQ.Web.Components.Pages_Assessments.ProjectionComponents
@using ViabilityIQ.Shared.UtilityServices

<div class="p-0 position-relative dashboard-workspace container-fluid">
    <PageHeading_Assessment _pageTitle="Stock" PageTitle="Stock Management & Valuation" CurrentPage="PageType.Stock" />

    <div class="row bg-white g-3 mt-2 py-2 px-2" style="border-radius: 6px;">

        <!-- ✅ BUSINESS HEALTH ALERTS (FIRST) -->
        <div class="col-12">
            <BusinessHealthAlertsComponent AssessmentId="@AssessmentId" MaxAlerts="3" />
        </div>

        <!-- ✅ CASHFLOW KPI DASHBOARD (SECOND) -->
        <div class="col-12">
            <CashflowKPICardsComponent AssessmentId="@AssessmentId" />
        </div>

        <!-- Search and Add Row -->
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center gap-3">
                <button type="button" class="btn btn-primary btn-sm" @onclick="() => OpenStockDataEntryPanel(0)">
                    <i class="bi bi-plus-circle me-1"></i> Add Inventory
                </button>
                <div class="input-group input-group-sm" style="width: 300px;">
                    <input type="text" class="form-control form-control-sm"
                           placeholder="Search Category..."
                           @bind="SearchTerm"
                           @bind:event="oninput" />
                    <button class="btn btn-outline-secondary" @onclick="FilterData">Search</button>
                </div>
            </div>
        </div>

        <!-- Stock Table -->
        <div class="col-12">
            <div class="table-responsive shadow-sm border border-secondary-subtle" style="border-radius: 6px; overflow: hidden;">
                <table class="table table-sm table-hover mb-0">
                    <thead class="py-1">
                        <tr class="bg-light text-muted fw-bold border-bottom align-bottom">
                            <th class="sticky-col ps-2 text-xxs text-uppercase">Stock Category <i class="bi bi-caret-down-fill text-secondary"></i></th>
                            @for (int i = 1; i <= 12; i++)
                            {
                                <th class="text-end td-header-ice text-uppercase text-xxs">M@(i)</th>
                            }
                            <th class="text-end text-uppercase text-xxs" style="background-color: #d1d5db; color: #000080;">Total Stock Value</th>
                            <th class="text-center td-header-ice text-xxs">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (IsLoading)
                        {
                            <LoadingTableRowsComponent />
                        }
                        else if (!FilteredStockList.Any())
                        {
                            <EmptyTableRowComponent EmptyRowMessage="No stock/inventory mapped to this assessment yet." />
                        }
                        else
                        {
                            @foreach (var item in FilteredStockList)
                            {
                                <tr class="hover-light-blue">
                                    <td class="ps-2 text-black">
                                        <span title="@item.AssessmentSalesCategoryName"
                                              style="font-size:0.75rem !important;">
                                            @DisplayUtility.TruncateValue(item.AssessmentSalesCategoryName, 20)
                                        </span>
                                    </td>
                                    @for (int i = 1; i <= 12; i++)
                                    {
                                        <td class="text-end font-monospace text-secondary text-xxs">@GetMonthValue(item, i).ToString("N0")</td>
                                    }
                                    <td class="text-end font-monospace fw-bold text-xxs" style="background-color: #d1d5db; color: #000080;">
                                        @item.MonthlyValues.Sum().ToString("N0")
                                    </td>
                                    <td class="text-center">
                                        <button class="btn-action-operation btn-edit-accent" @onclick="() => OpenStockDataEntryPanel(item.Id)">
                                            <i class="bi bi-vector-pen text-navy"></i>
                                        </button>
                                    </td>
                                </tr>
                            }

                            <!-- Grand Total Row -->
                            <tr style="background-color: #d1d5db; color: #000080; font-weight: bold;">
                                <td class="ps-2 text-uppercase text-xxs">Grand Total Stock Value:</td>
                                @for (int i = 1; i <= 12; i++)
                                {
                                    <td class="text-end font-monospace text-xs">@GetTotalForMonth(i).ToString("N0")</td>
                                }
                                <td class="text-end font-monospace">@GetGrandTotalStockValue().ToString("N0")</td>
                                <td></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>