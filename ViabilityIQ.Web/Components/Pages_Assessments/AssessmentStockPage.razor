@page "/assessment/stock/"
@layout MainLayout_Assessment
@using ViabilityIQ.Web.Components.CommonComponents
@using ViabilityIQ.Web.Components.Pages_Assessments.ProjectionComponents
@using ViabilityIQ.Shared.UtilityServices

<div class="p-0 position-relative dashboard-workspace container-fluid">
    <PageHeading_Assessment _pageTitle="Stock" PageTitle="Stock Management & Valuation" CurrentPage="PageType.Stock" />

    <div class="row bg-white g-3 mt-2 py-2 px-2" style="border-radius: 6px;">

        
        <!-- ✅ BUSINESS HEALTH ALERTS (FIRST) -->
        <div class="col-12 mt-0 pt-0">
            <BusinessHealthAlertsAccordionComponent AssessmentId="@AssessmentId" MaxAlerts="3" />
        </div>

        <!-- Search and Add Row -->
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center gap-3">
                <button type="button" class="btn btn-primary btn-sm shadow-sm" @onclick="() => OpenStockDataEntryPanel(0)">
                    <i class="bi bi-plus-circle me-1"></i> Add Inventory
                </button>
                <!-- Search Box with Lens Icon (Search button removed) -->
                <div class="input-group input-group-sm shadow-sm" style="width: 280px;">
                    <span class="input-group-text bg-white text-muted border-end-0">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" class="form-control form-control-sm border-start-0 ps-0"
                           placeholder="Search Category..."
                           @bind="SearchTerm"
                           @bind:event="oninput" />
                </div>
            </div>
        </div>

        <!-- Stock Table with Marble Border Wrapper -->
        <div class="col-12">
            <div class="table-responsive marble-border shadow-sm mb-2" style="border-radius: 8px; overflow: hidden;">
                <table class="table table-sm table-hover mb-0 align-middle">
                    <thead class="py-1">
                        <tr class="bg-light text-muted fw-bold border-bottom align-middle">
                            <th class="sticky-col ps-3 text-xxs text-uppercase sortable-header py-2" @onclick="SortStockCategory">
                                Stock Category <i class="@GetSortIcon() ms-1"></i>
                            </th>
                            @for (int i = 1; i <= 12; i++)
                            {
                                <th class="text-end td-header-ice text-uppercase text-xxs py-2">M@(i)</th>
                            }
                            <th class="text-end text-uppercase text-xxs py-2" style="background-color: #cbd5e1; color: #0f172a;">Total Stock Value</th>
                            <th class="text-center td-header-ice text-xxs py-2" style="background-color: #e2e8f0; color: #0f172a; width: 50px;">Action</th>
                        </tr>
                    </thead>
                    <tbody class="grid-font-standard">
                        @if (IsLoading)
                        {
                            <LoadingTableRowsComponent />
                        }
                        else if (!FilteredStockList.Any())
                        {
                            <EmptyTableRowComponent EmptyRowMessage="No stock/inventory mapped to this assessment yet." />
                        }
                        else
                        {
                            @foreach (var item in FilteredStockList)
                            {
                                <tr class="hover-light-blue">
                                    <td class="ps-3 text-black">
                                        <span title="@item.AssessmentSalesCategoryName"
                                              style="font-size:0.75rem !important;">
                                            @DisplayUtility.TruncateValue(item.AssessmentSalesCategoryName, 20)
                                        </span>
                                    </td>
                                    @for (int i = 1; i <= 12; i++)
                                    {
                                        <td class="text-end font-monospace text-secondary text-xxs">@GetMonthValue(item, i).ToString("N0")</td>
                                    }
                                    <td class="text-end font-monospace fw-bold text-xxs text-dark" style="background-color: #e2e8f0;">
                                        @item.MonthlyValues.Sum().ToString("N0")
                                    </td>
                                    <td class="text-center">
                                        <button class="btn-action-operation btn-edit-accent shadow-sm" @onclick="() => OpenStockDataEntryPanel(item.Id)" title="Edit Inventory">
                                            <i class="bi bi-vector-pen text-navy"></i>
                                        </button>
                                    </td>
                                </tr>
                            }

                            <!-- Grand Total Row -->
                            <tr style="background-color: #cbd5e1; color: #0f172a; font-weight: bold; border-top: 2px solid #94a3b8;">
                                <td class="ps-3 text-uppercase text-xxs fw-bold">Grand Total Stock Value:</td>
                                @for (int i = 1; i <= 12; i++)
                                {
                                    <td class="text-end font-monospace text-xs text-dark">@GetTotalForMonth(i).ToString("N0")</td>
                                }
                                <td class="text-end font-monospace text-dark">@GetGrandTotalStockValue().ToString("N0")</td>
                                <td></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* This component is for the cashflow summaries and details, including projections. *@
    <CashflowMainPagesComponent AssessmentId="@AssessmentId" />

</div>

<ZabConfirmDialogComponent @ref="ConfirmDeleteDialog" />

<footer class="py-2 bg-light mt-3">
    <BFooter />
</footer>