@page "/assessment/stock/{AssessmentId:long}"

@layout MainLayout_Assessment
@using ViabilityIQ.Web.Components.CommonComponents
@using ViabilityIQ.Web.Components.Pages_Assessments.ProjectionComponents
@using ViabilityIQ.Web.Components.Pages_Assessments.CommonComponents
@using ViabilityIQ.Web.Components.Pages_Assessments.PageFormComponents
@using ViabilityIQ.Shared.UtilityServices

<div class="p-0 position-relative dashboard-workspace container-fluid assessment-print-page">
    <PageHeading_Assessment _pageTitle="@(IsFullManufacturingMode ? "Manufacturing" : "Stock")"
                            PageTitle="@(IsFullManufacturingMode ? "Manufacturing & Inventory Cost Flow" : "Stock Management & Valuation")"
                            CurrentPage="PageType.Stock" />

    <div class="row bg-white g-3 mt-1 mb-1 py-2 px-2" style="border-radius: 6px;">

        @if (!IsFullManufacturingMode)
        {
            <div class="col-12 mt-0 pt-0">
                <AssessmentKpiCardsComponent Items="@StockKpis" AriaLabel="Stock key performance indicators" />
            </div>
        }

        <!-- Search and Add Row -->
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center gap-3 assessment-page-toolbar">
                <div class="col-md-4">
                    @if (!IsServiceMode && !IsFullManufacturingMode)
                    {
                        <button type="button" class="zdt-add-button" @onclick="() => OpenStockDataEntryPanel(0)">
                            <i class="bi bi-plus-circle me-1"></i> @(IsManufacturingMode ? "Add Manufactured Product" : "Add Stock Item")
                        </button>
                    }
                </div>                
                <div class="col-md-8 d-flex justify-content-end align-items-center gap-2">
                    <AssessmentPrintButton />
                    @if (!IsFullManufacturingMode)
                    {
                        <label class="assessment-page-search">
                            <i class="bi bi-search"></i>
                            <input type="search"
                                   placeholder="Search inventory..."
                                   @bind="SearchTerm"
                                   @bind:event="oninput" />
                        </label>
                    }
                </div>
            </div>
        </div>

        <!-- Stock Table -->
        <div class="col-12">
            @if (IsLoading)
            {
                <div class="d-flex align-items-center gap-2 py-4 text-muted" role="status">
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    <span>Loading stock and inventory...</span>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(LoadErrorMessage))
            {
                <div class="alert alert-warning" role="alert">@LoadErrorMessage</div>
            }
            else if (IsServiceMode)
            {
                <div class="alert alert-info">
                    Service assessments do not project inventory. Capture service delivery and operating costs, including director wages, in Expenses.
                </div>
            }
            else if (IsFullManufacturingMode)
            {
                <AssessmentManufacturingInputComponent AssessmentId="@AssessmentId" />
            }
            else
            {
                <p class="small text-muted mb-2">
                    @if (IsManufacturingMode)
                    {
                        <span>Enter opening finished-goods value, standard production cost per unit, and monthly planned output. Closing inventory is estimated using production additions and the existing cost-of-sales assumptions.</span>
                    }
                    else
                    {
                        <span>Opening balances are entered per item. Monthly values are purchases/additions; closing inventory is calculated from opening stock, purchases and estimated cost of sales.</span>
                    }
                </p>
                <div class="table-responsive shadow-sm avd-table-frame " style="overflow: hidden; border: solid 1px #98AFC7; border-radius: 0.8rem !important">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="py-1">
                            <tr class="bg-light text-muted fw-bold border-bottom align-bottom">
                                <th class="sticky-col ps-2 text-xxs text-uppercase">Stock item</th>
                                <th class="text-xxs text-uppercase">Sales category</th>
                                <th class="text-end text-uppercase text-xxs">Opening balance</th>
                                @if (IsManufacturingMode)
                                {
                                    <th class="text-end text-uppercase text-xxs">Standard unit cost</th>
                                }
                                @for (int i = 1; i <= 12; i++)
                                {
                                    <th class="text-end td-header-ice text-uppercase text-xxs">@(IsManufacturingMode ? $"Units M{i}" : $"M{i}")</th>
                                }
                                <th class="text-end text-uppercase text-xxs" style="background-color: #d1d5db; color: #000080;">@(IsManufacturingMode ? "Annual units" : "Annual Purchases")</th>
                                <th class="text-center td-header-ice text-xxs assessment-grid-actions">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (IsLoading)
                            {
                                <LoadingTableRowsComponent />
                            }
                            else if (!FilteredStockList.Any())
                            {
                                <EmptyTableRowComponent EmptyRowMessage="No stock/inventory mapped to this assessment yet." />
                            }
                            else
                            {
                                @foreach (var item in FilteredStockList)
                                {
                                    <tr class="hover-light-blue">
                                        <td class="ps-2 text-black">
                                            <span title="@item.Description"
                                                  style="font-size:0.75rem !important;">
                                                @DisplayUtility.TruncateValue(item.Description, 24)
                                            </span>
                                        </td>
                                        <td class="text-secondary text-xxs">@item.AssessmentSalesCategoryName</td>
                                        <td class="text-end font-monospace text-secondary text-xxs">@Money(item.OpeningBalance)</td>
                                        @if (IsManufacturingMode)
                                        {
                                            <td class="text-end font-monospace text-secondary text-xxs">@Money(item.StandardUnitCost)</td>
                                        }
                                        @for (int i = 1; i <= 12; i++)
                                        {
                                            <td class="text-end font-monospace text-secondary text-xxs">@(IsManufacturingMode
                                                ? DisplayUtility.FormatNumber(GetMonthValue(item, i), sessionService?.CultureName, "N2")
                                                : Money(GetMonthValue(item, i)))</td>
                                        }
                                        <td class="text-end font-monospace fw-bold text-xxs" style="background-color: #d1d5db; color: #000080;">
                                            @(IsManufacturingMode
                                                ? DisplayUtility.FormatNumber(item.MonthlyProductionUnits.Sum(), sessionService?.CultureName, "N2")
                                                : Money(item.MonthlyValues.Sum()))
                                        </td>
                                        <td class="text-center assessment-grid-actions">
                                            <button class="btn-action-operation btn-edit-accent" @onclick="() => OpenStockDataEntryPanel(item.Id)">
                                                <i class="bi bi-vector-pen text-navy"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }

                                <!-- Grand Total Row -->
                                <tr style="background-color: #d1d5db; color: #000080; font-weight: bold;">
                                    <td class="ps-2 text-uppercase text-xxs">Totals:</td>
                                    <td></td>
                                    <td class="text-end font-monospace text-xs">@Money(FilteredStockList.Sum(x => x.OpeningBalance))</td>
                                    @if (IsManufacturingMode)
                                    {
                                        <td></td>
                                    }
                                    @for (int i = 1; i <= 12; i++)
                                    {
                                        <td class="text-end font-monospace text-xs">@(IsManufacturingMode
                                            ? DisplayUtility.FormatNumber(GetTotalForMonth(i), sessionService?.CultureName, "N2")
                                            : Money(GetTotalForMonth(i)))</td>
                                    }
                                    <td class="text-end font-monospace">@(IsManufacturingMode
                                        ? DisplayUtility.FormatNumber(GetGrandTotalStockValue(), sessionService?.CultureName, "N2")
                                        : Money(GetGrandTotalStockValue()))</td>
                                    <td></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="assessment-record-navigation">
                    <span>Showing <strong>@FilteredStockList.Count</strong> of <strong>@StockDataList.Count</strong> records</span>
                    <div class="btn-group shadow-sm" role="group" aria-label="Inventory record navigation">
                        <button type="button" class="btn btn-outline-secondary btn-sm" disabled>
                            <i class="bi bi-chevron-left me-1"></i>Previous
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" disabled>
                            Next<i class="bi bi-chevron-right ms-1"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

    @* This component is for the cashflow summaries and details, including projections. *@
    <CashflowMainPagesComponent AssessmentId="@AssessmentId" />

</div>

<ZabConfirmDialogComponent @ref="ConfirmDeleteDialog" />

<footer class="py-0 bg-light mt-3">
    <BFooter />
</footer>
