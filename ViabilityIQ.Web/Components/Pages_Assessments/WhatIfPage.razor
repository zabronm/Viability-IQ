@page "/assessment/dashboards/{AssessmentId:long}"
@page "/assessment/dashboards/"

@layout MainLayout_Assessment

@using ViabilityIQ.Web.Components.CommonComponents
@using ViabilityIQ.Web.Components.Layout
@using ViabilityIQ.Web.Components.Pages_Assessments.ProjectionComponents

<div class="p-0 position-relative dashboard-workspace container-fluid assessment-print-page">
    <PageHeading_Assessment _pageTitle="What-If Analysis"
                            PageTitle="Dashboards &amp; Scenarios"
                            CurrentPage="PageType.Dashboards" />

    <div class="row bg-white g-3 mt-0 py-2 px-2" style="border-radius: 6px;">
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="alert alert-danger mt-2" role="alert">
                <strong>Dashboard unavailable.</strong> @ErrorMessage
            </div>
        }
        else
        {
            <main class="dashboard-content">
                <ErrorBoundary>
                    <ChildContent>
                        <CashflowPerformanceAlertsComponent AssessmentId="@ActiveAssessmentId" />
                    </ChildContent>
                    <ErrorContent Context="error">
                        <div class="dashboard-widget-error"><i class="bi bi-exclamation-triangle"></i> Performance alerts failed to render: @error.Message</div>
                    </ErrorContent>
                </ErrorBoundary>                
                <ErrorBoundary>
                    <ChildContent>
                        <CashflowKPICardsComponent AssessmentId="@ActiveAssessmentId" />
                    </ChildContent>
                    <ErrorContent Context="error">
                        <div class="dashboard-widget-error"><i class="bi bi-exclamation-triangle"></i> KPI cards failed to render: @error.Message</div>
                    </ErrorContent>
                </ErrorBoundary>

                <section class="dashboard-visual-grid mt-2" aria-label="Assessment performance charts">
                    <ErrorBoundary>
                        <ChildContent>
                            <CashflowBusinessHealthIndexComponent AssessmentId="@ActiveAssessmentId" />
                        </ChildContent>
                        <ErrorContent Context="error">
                            <div class="dashboard-widget-error"><i class="bi bi-exclamation-triangle"></i> Business Health Index failed to render: @error.Message</div>
                        </ErrorContent>
                    </ErrorBoundary>

                    <ErrorBoundary>
                        <ChildContent>
                            <CashflowProfitLossTimelineComponent AssessmentId="@ActiveAssessmentId" />
                        </ChildContent>
                        <ErrorContent Context="error">
                            <div class="dashboard-widget-error"><i class="bi bi-exclamation-triangle"></i> P&amp;L timeline failed to render: @error.Message</div>
                        </ErrorContent>
                    </ErrorBoundary>
                </section>

                <section class="dashboard-detail-grid" aria-label="Assessment financial summary">
                    <ErrorBoundary>
                        <ChildContent>
                            <CashflowSummaryDashboardComponent AssessmentId="@ActiveAssessmentId" />
                        </ChildContent>
                        <ErrorContent Context="error">
                            <div class="dashboard-widget-error"><i class="bi bi-exclamation-triangle"></i> Profit summary failed to render: @error.Message</div>
                        </ErrorContent>
                    </ErrorBoundary>

                    <ErrorBoundary>
                        <ChildContent>
                            <CashflowBusinessIndicatorComponent AssessmentId="@ActiveAssessmentId" />
                        </ChildContent>
                        <ErrorContent Context="error">
                            <div class="dashboard-widget-error"><i class="bi bi-exclamation-triangle"></i> Business indicators failed to render: @error.Message</div>
                        </ErrorContent>
                    </ErrorBoundary>
                </section>
            </main>
        }
    </div>
</div>
<footer class="py-2 bg-light mt-3">
    <BFooter />
</footer>
