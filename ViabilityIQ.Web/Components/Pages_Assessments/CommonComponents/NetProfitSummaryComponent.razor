
<div class="card h-100 border border-secondary-subtle shadow" style="border-radius:10px;">
    <div class="card-header bg-light py-2 px-3 border-bottom d-flex align-items-center" style="border-radius:10px;">
        <span class="fw-bold text-xs text-navy-brand text-uppercase"><i class="bi bi-calculator me-1.5 text-primary"></i>Net Profit Calculation Matrix</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive grid-font-standard">
            <table class="table table-sm table-hover text-nowrap vertical-align-middle mb-0 text-xs">
                <thead>
                    <tr class="bg-light-subtle text-muted fw-bold border-bottom text-xxs uppercase">
                        <th class="ps-3 py-2">Financial Line Item</th>
                        @for (int m = 1; m <= 12; m++)
                        {
                            <th class="text-end py-2">M@m</th>
                        }
                        <th class="text-end pe-3 py-2 bg-navy text-white text-xxs font-weight-bold">Annual Total</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Total Sales -->
                    <tr>
                        <td class="ps-3 fw-semibold text-dark py-1.5">Total Sales Revenue</td>
                        @for (int i = 0; i < 12; i++)
                        {
                            <td class="text-end font-monospace text-secondary">@Data.MonthlySales[i].ToString("N0").Replace(",", " ")</td>
                        }
                        <td class="text-end font-monospace fw-bold text-navy-brand bg-light-totals-cell pe-3">@Data.MonthlySales.Sum().ToString("N0").Replace(",", " ")</td>
                    </tr>
                    <!-- Less: Cost of Sales -->
                    <tr class="border-bottom-dashed">
                        <td class="ps-3 text-muted py-1.5"><i class="bi bi-dash text-danger"></i> Less: Cost of Sales (COS)</td>
                        @for (int i = 0; i < 12; i++)
                        {
                            <td class="text-end font-monospace text-muted">@Data.MonthlyCostOfSales[i].ToString("N0").Replace(",", " ")</td>
                        }
                        <td class="text-end font-monospace text-danger bg-light-totals-cell pe-3">(@Data.MonthlyCostOfSales.Sum().ToString("N0").Replace(",", " "))</td>
                    </tr>
                    <!-- Gross Profit Summary Intercept -->
                    <tr class="bg-light-totals fw-bold">
                        <td class="ps-3 text-navy-brand py-1.5">= Gross Profit Margin</td>
                        @for (int i = 0; i < 12; i++)
                        {
                            <td class="text-end font-monospace text-navy-brand">@((Data.MonthlySales[i] - Data.MonthlyCostOfSales[i]).ToString("N0").Replace(",", " "))</td>
                        }
                        <td class="text-end font-monospace text-navy-brand bg-navy-light-summary pe-3">@((Data.MonthlySales.Sum() - Data.MonthlyCostOfSales.Sum()).ToString("N0").Replace(",", " "))</td>
                    </tr>
                    <!-- Add Sundry Income -->
                    <tr>
                        <td class="ps-3 text-muted py-1.5"><i class="bi bi-plus text-success"></i> Add: Sundry Inflows</td>
                        @for (int i = 0; i < 12; i++)
                        {
                            <td class="text-end font-monospace text-secondary">@Data.MonthlySundryIncome[i].ToString("N0").Replace(",", " ")</td>
                        }
                        <td class="text-end font-monospace text-success bg-light-totals-cell pe-3">@Data.MonthlySundryIncome.Sum().ToString("N0").Replace(",", " ")</td>
                    </tr>
                    <!-- Gross Income Summary Intercept -->
                    <tr class="fw-semibold" style="background-color: rgba(248, 250, 252, 0.8);">
                        <td class="ps-3 text-dark py-1.5">= Gross Income Position</td>
                        @for (int i = 0; i < 12; i++)
                        {
                            <td class="text-end font-monospace text-dark">@GetGrossIncome(i).ToString("N0").Replace(",", " ")</td>
                        }
                        <td class="text-end font-monospace text-dark bg-light-totals-cell pe-3">@GetAnnualGrossIncome().ToString("N0").Replace(",", " ")</td>
                    </tr>
                    <!-- Less Total Expenses -->
                    <tr class="border-bottom-dashed">
                        <td class="ps-3 text-muted py-1.5"><i class="bi bi-dash text-danger"></i> Less: Total Operating Expenses</td>
                        @for (int i = 0; i < 12; i++)
                        {
                            <td class="text-end font-monospace text-muted">@Data.MonthlyExpenses[i].ToString("N0").Replace(",", " ")</td>
                        }
                        <td class="text-end font-monospace text-danger bg-light-totals-cell pe-3">(@Data.MonthlyExpenses.Sum().ToString("N0").Replace(",", " "))</td>
                    </tr>
                    <!-- Net Profit Final Row -->
                    <tr class="fw-bold bg-navy text-white border-top-navy">
                        <td class="ps-3 text-uppercase text-xxs py-2"><i class="bi bi-pie-chart-fill me-1.5 text-warning"></i>Net Profit / Loss Position</td>
                        @for (int i = 0; i < 12; i++)
                        {
                            <td class="text-end font-monospace @(GetNetProfit(i) < 0 ? "text-warning-light" : "text-white")">@GetNetProfit(i).ToString("N0").Replace(",", " ")</td>
                        }
                        <td class="text-end font-monospace text-white bg-navy-darker pe-3 header-totals-navy">@GetAnnualNetProfit().ToString("N0").Replace(",", " ")</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

