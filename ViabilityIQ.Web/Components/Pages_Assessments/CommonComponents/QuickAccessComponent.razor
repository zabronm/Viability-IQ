        </div>
    </a>

    <a class="quick-grid-item" href="/assessment/loan-repayments">
        <div class="grid-icon-wrapper text-success"><i class="bi bi-umbrella-fill"></i></div>
        <div class="grid-item-text">
            <span class="strong">Loan Payments</span>
            <span class="sub-text">Loan Repayments</span>
        </div>
    </a>
    <a class="quick-grid-item" href="/assessment/debtors-creditors/">
        <div class="grid-icon-wrapper text-danger"><i class="bi bi-incognito"></i></div>
        <div class="grid-item-text">
            <span class="strong">Debtors/Creditors</span>
            <span class="sub-text">Receivables & Payables</span>
        </div>
    </a>

    <a class="quick-grid-item" href="/reports/balance-sheet">
        <!-- 5) Updated Icon asset mapping for Balance Sheet statement ledger views -->
        <div class="grid-icon-wrapper text-primary"><i class="bi bi-receipt-cutoff"></i></div>
        <div class="grid-item-text">
            <span class="strong">Balance Sheet</span>
            <span class="sub-text">Statement File</span>
        </div>
    </a>

    <a class="quick-grid-item" href="/reports/income-statement">
