@using ViabilityIQ.Application.Interfaces
@inject ISessionService SessionService

<div class="viq-card-header-dark-ice text-white text-uppercase" style="font-size:0.75rem;">Quick Access Shortcuts</div>

<div class="quick-access-grid">

    <!-- ============== Dashboards =============== -->
     <a class="quick-grid-item" href="@DashboardsUrl">
        <div class="grid-icon-wrapper text-success"><i class="bi bi-grid"></i></div>
        <div class="grid-item-text">
            <span class="strong">Dashboards</span>
            <span class="sub-text">Assessment Health</span>
        </div>
    </a>
        
     <!-- ============== Assumptions =============== -->
    <a class="quick-grid-item" href="@AssumptionsUrl">
        <div class="grid-icon-wrapper text-info"><i class="bi bi-gear text-warning"></i></div>
        <div class="grid-item-text">
            <span class="strong">Assumptions</span>
            <span class="sub-text">Model Drivers</span>
        </div>
    </a>
        
     <!-- ============== Sensitivity =============== -->
    <a class="quick-grid-item" href="@SensitivityUrl">
        <div class="grid-icon-wrapper text-navy"><i class="bi bi-binoculars-fill text-primary"></i></div>
        <div class="grid-item-text">
            <span class="strong">Sensitivity</span>
            <span class="sub-text">Scenario Mapping</span>
        </div>
    </a>

     <!-- ============== Assets =============== -->
    <a class="quick-grid-item" href="@AssetsUrl">
        <div class="grid-icon-wrapper text-success"><i class="bi bi-suitcase-lg-fill"></i></div>
        <div class="grid-item-text">
            <span class="strong">Assets</span>
            <span class="sub-text">Assets vs. cashflow</span>
        </div>
    </a>

     <!-- ============== Sales =============== -->
    <a class="quick-grid-item" href="@SalesUrl">
        <div class="grid-icon-wrapper text-success"><i class="bi bi-graph-up-arrow"></i></div>
        <div class="grid-item-text">
            <span class="strong">Sales</span>
            <span class="sub-text">Sales vs. cashflow.</span>
        </div>
    </a>

     <!-- ============== Expenses =============== -->
    <a class="quick-grid-item" href="@ExpensesUrl">
        <div class="grid-icon-wrapper text-danger"><i class="bi bi-wallet2"></i></div>
        <div class="grid-item-text">
            <span class="strong">Expenses</span>
            <span class="sub-text">Expenses vs cashflow.</span>
        </div>
    </a>

     <!-- ============== Stock =============== -->
    <a class="quick-grid-item" href="@StockUrl">
        <!-- 5) Updated Icon asset mapping for Balance Sheet statement ledger views -->
        <div class="grid-icon-wrapper text-primary"><i class="bi bi-boxes"></i></div>
        <div class="grid-item-text">
            <span class="strong">Stock</span>
            <span class="sub-text">Stock vs. cashflow.</span>
        </div>
    </a>

     <!-- ============== VAT =============== -->
    <a class="quick-grid-item" href="@VatUrl">
        <div class="grid-icon-wrapper text-warning"><i class="bi bi-bug text-danger"></i></div>
        <div class="grid-item-text">
            <span class="strong">VAT</span>
            <span class="sub-text">VAT vs. cashflow</span>
        </div>
    </a>

    <!-- ============== Reports =============== -->
    <a class="quick-grid-item" href="@ReportsUrl">
        <div class="grid-icon-wrapper text-warning"><i class="bi bi-clipboard2-data"></i></div>
        <div class="grid-item-text">
            <span class="strong">Reports</span>
            <span class="sub-text">Performance reports</span>
        </div>
    </a>


    <!-- ============== Budgets =============== -->
    <a class="quick-grid-item" href="@BudgetsUrl">
        <div class="grid-icon-wrapper text-primary"><i class="bi bi-calculator"></i></div>
        <div class="grid-item-text">
            <span class="strong">Budgets</span>
            <span class="sub-text">Assessment Budget &amp; Variance</span>
        </div>
    </a>

</div>




@code {

    //============== Budgets ===============
    private string BudgetsUrl =>  SessionService.AssessmentId is long assessmentId && assessmentId > 0
            ? $"/assessment/budgets/{assessmentId}"
            : "/assessment/assesment-error";

    //============== Sensitivity ===============
    private string SensitivityUrl =>  SessionService.AssessmentId is long assessmentId && assessmentId > 0
            ? $"/assessment/sensitivity/{assessmentId}"
            : "/assessment/assesment-error";

    //============== Assumptions ===============
    private string AssumptionsUrl =>SessionService.AssessmentId is long assessmentId && assessmentId > 0
            ? $"/assessment/assumptions/{assessmentId}"
            : "/assessment/assesment-error";

    //============== Dashboards ===============
    private string DashboardsUrl => SessionService.AssessmentId is long assessmentId && assessmentId > 0
            ? $"/assessment/dashboards/{assessmentId}"
            : "/assessment/assesment-error";

    //============== VAT ===============
    private string VatUrl => SessionService.AssessmentId is long assessmentId && assessmentId > 0
            ? $"/assessment/vat/{assessmentId}"
            : "/assessment/assesment-error";

    //============== Assets ===============
    private string ReportsUrl =>SessionService.AssessmentId is long assessmentId && assessmentId > 0
            ? $"/assessment/reports/{assessmentId}"
            : "/assessment/assesment-error";

    //============== Assets ===============
    private string AssetsUrl =>SessionService.AssessmentId is long assessmentId && assessmentId > 0
            ? $"/assessment/assets/{assessmentId}"
            : "/assessment/assesment-error";

    //============== Sales ===============
     private string SalesUrl => SessionService.AssessmentId is long assessmentId && assessmentId > 0
             ? $"/assessment/sales/{assessmentId}"
             : "/assessment/assesment-error";

    //============== Expenses ===============
    private string ExpensesUrl => SessionService.AssessmentId is long assessmentId && assessmentId > 0
            ? $"/assessment/expenses/{assessmentId}"
            : "/assessment/assesment-error";

    //============== Stock ===============
    private string StockUrl => SessionService.AssessmentId is long assessmentId && assessmentId > 0
            ? $"/assessment/stock/{assessmentId}"
            : "/assessment/assesment-error";


    private bool isQuickAccessOpen = true;

    private void ToggleQuickAccess()
    {
        isQuickAccessOpen = !isQuickAccessOpen;
    }

    private async Task HandleBlur()
    {
        await Task.Delay(180);
        isQuickAccessOpen = true;
        StateHasChanged();
    }
}