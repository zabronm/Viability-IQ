<div class="card h-100 shadow-sm border border-secondary-subtle">
    <div class="card-header bg-light py-2 px-3 border-bottom d-flex align-items-center">
        <!-- Kept clean and balanced at text-xs -->
        <span class="fw-bold text-xs text-navy-brand text-uppercase"><i class="bi bi-file-earmark-bar-graph me-1.5 text-primary"></i>Annual Summary Aggregates</span>
    </div>
    <div class="card-body p-3 d-flex flex-column">
        <!-- Balanced text base size at text-xs -->
        <div class="bg-light-subtle rounded border p-3 font-monospace text-xs d-flex flex-column justify-content-between flex-grow-1">
            <!-- Sales -->
            <div class="d-flex justify-content-between py-1.5 border-bottom border-light align-items-center">
                <span class="text-secondary fw-medium">Sales Revenue</span>
                <span class="text-dark fw-semibold">R @TotalSales.ToString("N0").Replace(",", " ")</span>
            </div>
            <!-- Cost of Sales -->
            <div class="d-flex justify-content-between py-1.5 border-bottom align-items-center">
                <span class="text-muted"><i class="bi bi-dash text-danger"></i> Cost of Sales</span>
                <span class="text-danger fw-medium">(@TotalCos.ToString("N0").Replace(",", " "))</span>
            </div>
            <!-- Gross Profit Summary -->
            <div class="d-flex justify-content-between py-1.5 bg-light px-1.5 fw-bold text-navy-brand rounded-sm my-0.5 align-items-center">
                <span>= Gross Profit</span>
                <span>R @((TotalSales - TotalCos).ToString("N0").Replace(",", " "))</span>
            </div>
            <!-- Sundry Income -->
            <div class="d-flex justify-content-between py-1.5 border-bottom border-light align-items-center">
                <span class="text-muted"><i class="bi bi-plus text-success"></i> Sundry Income</span>
                <span class="text-success fw-medium">@TotalSundry.ToString("N0").Replace(",", " ")</span>
            </div>
            <!-- Gross Income Summary -->
            <div class="d-flex justify-content-between py-1.5 px-1.5 fw-semibold text-dark rounded-sm my-0.5 align-items-center" style="background-color: #f8fafc;">
                <span>= Gross Income</span>
                <span>R @GrossIncome.ToString("N0").Replace(",", " ")</span>
            </div>
            <!-- Expenses -->
            <div class="d-flex justify-content-between py-1.5 border-bottom align-items-center">
                <span class="text-muted"><i class="bi bi-dash text-danger"></i> Operating Expenses</span>
                <span class="text-danger fw-medium">(@TotalExpenses.ToString("N0").Replace(",", " "))</span>
            </div>
            <!-- Net Profit Final Total Line - Perfectly middle-grounded -->
            <div class="d-flex justify-content-between py-2 px-3 bg-navy text-white fw-bold rounded shadow-sm mt-1 align-items-center">
                <span class="text-uppercase text-xxs d-flex align-items-center">Net Profit Yield</span>
                <!-- Stepped down to a solid fs-6 instead of fs-5 -->
                <span class="fs-6">R @NetProfit.ToString("N0").Replace(",", " ")</span>
            </div>
        </div>
    </div>
</div>