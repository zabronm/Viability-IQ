<!-- Alert Stack Container -->
<div class="business-health-alerts-container my-0 py-0">
    @if (IsLoading)
    {
        <div class="alert alert-info animate-fade mb-0">
            <div class="spinner-border spinner-border-sm me-2" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            Analyzing business health...
        </div>
    }
    else if (Alerts.Any())
    {
        @foreach (var alert in Alerts)
        {
            <!-- Use ViqAlertComponent for consistent styling -->
            <div class="mb-2" @key="alert.AlertId">
                <ViqAlertComponent Message="@BuildAlertMessage(alert)"
                                   Heading="@alert.Title"
                                   Severity="@ConvertSeverity(alert.Severity)"
                                   AllowDismiss="@alert.IsDismissible" />

                <!-- Detailed Guidance Section (below ViqAlertComponent) -->
                @if (alert.DetailedGuidance.Any())
                {
                    <div class="alert-guidance-section mb-0 p-1 rounded"
                         style="background-color: #f8f9fa; border-left: 4px solid @GetGuidanceColor(alert.Severity);">
                        <small class="d-block mb-2">
                            <strong><i class="bi bi-bookmark me-2"></i>Detailed Guidance:</strong>
                        </small>
                        <ul class="mb-0 ps-3" style="font-size: 0.85rem; line-height: 1.6;">
                            @foreach (var guideline in alert.DetailedGuidance)
                            {
                                @if (string.IsNullOrWhiteSpace(guideline))
                                {
                                    <li class="py-1"></li>
                                }
                                else if (guideline.StartsWith("   •"))
                                {
                                    <li class="py-1 text-muted ps-2">@guideline.Substring(4)</li>
                                }
                                else
                                {
                                    <li class="py-1">@guideline</li>
                                }
                            }
                        </ul>
                    </div>
                }
            </div>
        }
    }
</div>