@namespace ViabilityIQ.Web.Components.Pages_Assessments.ProjectionComponents
@inherits IndependentCashflowProjectionComponent

<section class="cfkpi-shell" aria-label="Assessment key performance indicators">
    @if (IsLoading)
    {
        <div class="cfkpi-state"><span class="spinner-border spinner-border-sm"></span> Loading KPI cards...</div>
    }
    else if (!string.IsNullOrWhiteSpace(LoadError))
    {
        <div class="cfkpi-state cfkpi-state-error"><i class="bi bi-exclamation-triangle"></i> KPI cards could not load: @LoadError</div>
    }
    else if (Projection is not null)
    {
        <div class="cfkpi-grid">
            @foreach (var item in KpiItems)
            {
                <article class="cfkpi-card cfkpi-card-@item.Accent">
                    <div class="cfkpi-heading">
                        <span class="cfkpi-label">@item.Label</span>
                        <span class="cfkpi-icon">
                            <i class="bi @item.Icon"></i>
                        </span>
                    </div>
                    <div class="cfkpi-value">R @item.Value.ToString("N0")</div>
                    <div class="cfkpi-note">@item.Note</div>
                </article>
            }
        </div>
    }
</section>

@code {
    private record KpiItem(string Label, decimal Value, string Icon, string Note, string Accent);

    private decimal InventoryMovement =>
        Projection!.Summary.ClosingStock - Projection.Summary.OpeningStock;

    private string InventoryMovementNote =>
        $"Opening R {Projection!.Summary.OpeningStock:N0} · Closing R {Projection.Summary.ClosingStock:N0}";

    private string VatNote =>
        Projection!.Summary.VatPayable >= 0m ? "Payable" : "Refund receivable";

    private string Margin(decimal value) =>
        Projection!.Summary.Revenue == 0m
            ? "No sales base"
            : $"{value / Projection.Summary.Revenue * 100m:F1}% of sales";

    private IEnumerable<KpiItem> KpiItems => new[]
    {
        new KpiItem("Total Sales", Projection!.Summary.Revenue, "bi-graph-up-arrow", "Sales revenue", "sales"),
        new KpiItem("Inventory Movement", InventoryMovement, "bi-boxes", InventoryMovementNote, InventoryMovement >= 0m ? "inventory-up" : "inventory-down"),
        new KpiItem("Operating Expenses", Projection!.Summary.OperatingExpenses, "bi-wallet2", "Projected period", "expenses"),
        new KpiItem("Net VAT", Projection!.Summary.VatPayable, "bi-receipt", VatNote, "vat"),
        new KpiItem("Gross Profit", Projection!.Summary.GrossProfit, "bi-bar-chart-line", Margin(Projection!.Summary.GrossProfit), "gross-profit"),
        new KpiItem("EBITDA", Projection!.Summary.EBITDA, "bi-speedometer2", Margin(Projection!.Summary.EBITDA), "ebitda"),
        new KpiItem("Profit Before Tax", Projection!.Summary.ProfitBeforeTax, "bi-cash-coin", Margin(Projection!.Summary.ProfitBeforeTax), Projection!.Summary.ProfitBeforeTax >= 0m ? "profit" : "loss")
    };
}