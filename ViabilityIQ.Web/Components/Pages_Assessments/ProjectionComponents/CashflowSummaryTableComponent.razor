@namespace ViabilityIQ.Web.Components.Pages_Assessments.ProjectionComponents

<div class="cashflow-summary-kpi auth-card p-0 overflow-hidden">
    <!-- Professional Table Header (Reduced height with py-2) -->
    <div class="d-flex align-items-center justify-content-between bg-marble-header px-3 py-2 text-white">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-wallet2 fs-6"></i>
            <h5 class="mb-0 fw-bold fs-6 text-white">12-Month Cash Summary</h5>
        </div>
        <span class="text-xxs uppercase tracking-wider text-white-50 fw-semibold">Overview</span>
    </div>

    <!-- Data Table Container -->
    <div class="table-responsive px-3 pt-2 pb-3">
        <table class="table table-borderless viability-summary-table align-middle mb-0">
            <tbody>
                <tr class="data-row">
                    <td class="fw-semibold text-dark">Total cash inflows</td>
                    <td class="text-end font-monospace fw-bold text-navy">@Projection.Summary.TotalInflows.ToString("N0")</td>
                </tr>
                <tr class="data-row">
                    <td class="fw-semibold text-dark">Total cash outflows</td>
                    <td class="text-end font-monospace fw-bold text-navy">(@Projection.Summary.TotalOutflows.ToString("N0"))</td>
                </tr>
                <tr class="data-row">
                    <td class="fw-semibold text-dark">Net cashflow</td>
                    <td class="text-end font-monospace fw-bold text-navy">@Projection.Summary.NetCashflow.ToString("N0")</td>
                </tr>
                <tr class="data-row">
                    <td class="fw-semibold text-dark">Opening bank</td>
                    <td class="text-end font-monospace fw-bold text-navy">@Projection.Summary.OpeningBank.ToString("N0")</td>
                </tr>
                <tr class="data-row">
                    <td class="fw-semibold text-dark">Closing bank</td>
                    <td class="text-end font-monospace fw-bold text-navy">@Projection.Summary.ClosingBank.ToString("N0")</td>
                </tr>
                <tr class="data-row border-0">
                    <td class="fw-semibold text-dark">Closing debtors / creditors</td>
                    <td class="text-end font-monospace fw-bold text-navy">
                        @Projection.Summary.ClosingDebtors.ToString("N0") /
                        @Projection.Summary.ClosingCreditors.ToString("N0")
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Bottom Accent Footer Box -->
    <div class="px-3 pb-3">
        <div class="viability-footer-banner p-2 rounded-2 d-flex align-items-center gap-2">
            <div class="footer-banner-bar"></div>
            <span class="text-muted text-xxs">Aggregated cash position totals across the entire 12-month projection cycle.</span>
        </div>
    </div>
</div>