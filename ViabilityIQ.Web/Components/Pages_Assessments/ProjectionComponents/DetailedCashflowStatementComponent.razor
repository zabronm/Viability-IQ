@namespace ViabilityIQ.Web.Components.Pages_Assessments.ProjectionComponents

<div class="detailed-cashflow-container card border-0 shadow-sm">
    <div class="card-header bg-dark text-white"><strong>Detailed Cashflow Statement</strong></div>
    <div class="table-responsive">
        <table class="table table-sm table-hover mb-0 detailed-cashflow-table">
            <thead>
                <tr>
                    <th>Line item</th>
                    @foreach (var month in Projection.Months)
                    {
                        <th class="text-end">@month.MonthLabel</th>
                    }
                    <th class="text-end">TOTAL</th>
                </tr>
            </thead>
            <tbody>
                @Row("Sales receipts", x => x.SalesReceipts)
                @Row("Sundry income receipts", x => x.SundryIncomeReceipts)
                @Row("Grants / donations receipts", x => x.GrantsDonationsReceipts)
                @Row("Asset disposal receipts", x => x.AssetDisposalReceipts)
                @Row("Other income receipts", x => x.OtherIncomeReceipts)
                @Row("VAT refunds", x => x.VatRefund)
                @Row("Total inflows", x => x.TotalInflows, true)
                @Row("Supplier payments", x => x.SupplierPayments)
                @Row("Cash operating expenses", x => x.CashOperatingExpenses)
                @Row("VAT payments", x => x.VatPayment)
                @Row("Loan repayments", x => x.LoanCashPayment)
                @Row("Overdraft interest", x => x.OverdraftInterest)
                @Row("Asset purchases", x => x.AssetPurchases)
                @Row("Total outflows", x => x.TotalOutflows, true)
                @Row("Net cashflow", x => x.NetCashflow, true)
                @Row("Opening bank", x => x.OpeningBank)
                @Row("Closing bank", x => x.ClosingBank, true)
                @Row("Sales (VAT exclusive)", x => x.Revenue)
                @Row("COGS (VAT exclusive)", x => x.CostOfGoodsSold)
                @Row("Gross profit", x => x.GrossProfit, true)
                @Row("Sundry income (VAT exclusive)", x => x.SundryIncome)
                @Row("Grants / donations (VAT exclusive)", x => x.GrantsDonationsIncome)
                @Row("Asset disposal income (VAT exclusive)", x => x.ClassifiedAssetDisposalIncome)
                @Row("Other income (VAT exclusive)", x => x.OtherIncome)
                @Row("Gross income", x => x.GrossIncome, true)
                @Row("Operating expenses (VAT exclusive)", x => x.OperatingExpenses)
                @Row("EBITDA", x => x.EBITDA)
                @Row("Depreciation", x => x.Depreciation)
                @Row("Interest", x => x.InterestExpense)
                @Row("Profit before tax", x => x.ProfitBeforeTax, true)
            </tbody>
        </table>
    </div>
</div>

@code {
    private Microsoft.AspNetCore.Components.RenderFragment Row(
        string label,
        Func<ViabilityIQ.Shared.FinancialModels.CashflowProjectionMonth, decimal> value,
        bool bold = false) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "tr");
        if (bold)
        {
            builder.AddAttribute(sequence++, "class", "fw-bold table-light");
        }

        builder.OpenElement(sequence++, "td");
        builder.AddContent(sequence++, label);
        builder.CloseElement();

        foreach (var month in Projection.Months)
        {
            builder.OpenElement(sequence++, "td");
            builder.AddAttribute(sequence++, "class", "text-end");
            builder.AddContent(sequence++, value(month).ToString("N0"));
            builder.CloseElement();
        }

        builder.OpenElement(sequence++, "td");
        builder.AddAttribute(sequence++, "class", "text-end");
        builder.AddContent(sequence++, Projection.Months.Sum(value).ToString("N0"));
        builder.CloseElement();
        builder.CloseElement();
    };
}
