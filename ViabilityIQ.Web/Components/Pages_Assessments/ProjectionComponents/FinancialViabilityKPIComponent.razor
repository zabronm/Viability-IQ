@namespace ViabilityIQ.Web.Components.Pages_Assessments.ProjectionComponents

<div class="financial-viability-kpi auth-card p-0 overflow-hidden">
    <!-- Professional Table Header (Reduced height by a quarter using py-2) -->
    <div class="d-flex align-items-center justify-content-between bg-marble-header px-3 py-2 text-white">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-shield-check fs-6"></i>
            <h5 class="mb-0 fw-bold fs-6 text-white">Financial Viability Metrics</h5>
        </div>
        <span class="text-xxs uppercase tracking-wider text-white-50 fw-semibold">Key Indicators</span>
    </div>

    <!-- Data Table Container -->
    <div class="table-responsive px-3 pt-2 pb-3">
        <table class="table table-borderless viability-summary-table align-middle mb-0">
            <tbody>
                <tr class="data-row">
                    <td class="fw-semibold text-dark">Contribution margin ratio</td>
                    <td class="text-end font-monospace fw-bold text-navy">@Percent(Projection.Viability.ContributionMarginRatio)</td>
                </tr>
                <tr class="data-row">
                    <td>
                        <span class="fw-semibold text-dark">Break-even sales</span>
                        <div class="text-muted text-xxs font-italic">(all operating expenses treated as fixed)</div>
                    </td>
                    <td class="text-end font-monospace fw-bold text-navy">@Money(Projection.Viability.BreakEvenSales)</td>
                </tr>
                <tr class="data-row">
                    <td class="fw-semibold text-dark">Margin of safety</td>
                    <td class="text-end font-monospace fw-bold text-navy">@Percent(Projection.Viability.MarginOfSafety)</td>
                </tr>
                <tr class="data-row">
                    <td class="fw-semibold text-dark">Interest cover <span class="text-muted fw-normal text-xxs">(EBIT / interest)</span></td>
                    <td class="text-end font-monospace fw-bold text-navy">@Ratio(Projection.Viability.InterestCover)</td>
                </tr>
                <tr class="data-row">
                    <td class="fw-semibold text-dark">DSCR <span class="text-muted fw-normal text-xxs">(EBITDA / loan cash payments)</span></td>
                    <td class="text-end font-monospace fw-bold text-navy">@Ratio(Projection.Viability.DebtServiceCoverageRatio)</td>
                </tr>
                <tr class="data-row">
                    <td class="fw-semibold text-dark">NPV <span class="text-muted fw-normal text-xxs">(10% nominal annual / 12)</span></td>
                    <td class="text-end font-monospace fw-bold text-navy">@Projection.Viability.NetPresentValue.ToString("N0")</td>
                </tr>
                <tr class="data-row">
                    <td class="fw-semibold text-dark">PBT volatility</td>
                    <td class="text-end font-monospace fw-bold text-navy">@Percent(Projection.Viability.ProfitVolatility)</td>
                </tr>
                <tr class="data-row">
                    <td class="fw-semibold text-dark">Current ratio</td>
                    <td class="text-end font-monospace fw-bold text-navy">@Ratio(Projection.Viability.CurrentRatio)</td>
                </tr>
                <tr class="data-row border-0">
                    <td class="fw-semibold text-dark">Payback</td>
                    <td class="text-end text-muted small fst-italic">Not available — no initial investment basis</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Bottom Accent Footer Box -->
    <div class="px-3 pb-3">
        <div class="viability-footer-banner p-2 rounded-2 d-flex align-items-center gap-2">
            <div class="footer-banner-bar"></div>
            <span class="text-muted text-xxs">All metrics are computed based on live 12-month projections and weighted structural assumptions.</span>
        </div>
    </div>
</div>

@code {
    private static string Percent(decimal? value) => value.HasValue ? value.Value.ToString("P1") : "N/A";
    private static string Ratio(decimal? value) => value.HasValue ? $"{value.Value:F2}x" : "N/A";
    private static string Money(decimal? value) => value.HasValue ? value.Value.ToString("N0") : "N/A";
}