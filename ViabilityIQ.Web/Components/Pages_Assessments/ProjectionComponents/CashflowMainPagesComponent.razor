@namespace ViabilityIQ.Web.Components.Pages_Assessments.ProjectionComponents

<div class="row bg-white g-3 mt-1 mb-4 py-2 px-2 shadow-sm rounded-3 border-0">
    <div class="d-flex align-items-center justify-content-between mb-2">
        <div>
            <h3 class="fw-extrabold text-marble-dark mb-1 fs-4 fw-bold">Cashflow Projections & General Assessment Outook</h3>
            <p class="text-muted small mb-0">Live 12-month cash, profit, balance and viability projection.</p>
        </div>
        <div class="badge bg-light text-marble-dark px-3 py-2 rounded-pill border fw-semibold">
            Assessment #@AssessmentId
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary"></div>
            <p>Calculating live projection...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <strong>Cashflow calculation failed.</strong> @ErrorMessage
        </div>
    }
    else if (Projection is not null)
    {
        <div class="accordion custom-professional-accordion" id="cashflowAccordion">

            <!-- Section 1: KPI Cards (Expanded by default) -->
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingOne">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                        <i class="bi bi-speedometer2"></i>&nbsp; Key Performance Indicators
                    </button>
                </h2>
                <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#cashflowAccordion">
                    <div class="accordion-body">
                        <div class="row g-3 w-100">
                            <CashflowKPICardsComponent Projection="@Projection" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 2: Business Health Alerts (Expanded by default) -->
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingTwo">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="true" aria-controls="collapseTwo">
                        <i class="bi bi-shield-exclamation"></i>&nbsp; Business Health Alerts
                    </button>
                </h2>
                <div id="collapseTwo" class="accordion-collapse collapse show" aria-labelledby="headingTwo" data-bs-parent="#cashflowAccordion">
                    <div class="accordion-body">
                        <div class="row g-3 w-100">
                            <BusinessHealthAlertsComponent Projection="@Projection" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 3: Summary Dashboard & Viability KPIs -->
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingThree">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                        <i class="bi bi-graph-up-arrow"></i>&nbsp; Summary Dashboard & Financial Viability
                    </button>
                </h2>
                <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#cashflowAccordion">
                    <div class="accordion-body">
                        <div class="row g-3 mt-1">
                            <div class="col-xl-5">
                                <CashflowSummaryDashboardComponent Projection="@Projection" />
                            </div>
                            <div class="col-xl-7">
                                <FinancialViabilityKPIComponent Projection="@Projection" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 4: Performance Chart -->
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingFour">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFour" aria-expanded="false" aria-controls="collapseFour">
                        <i class="bi bi-bar-chart-line"></i>&nbsp; Cashflow Performance Chart
                    </button>
                </h2>
                <div id="collapseFour" class="accordion-collapse collapse" aria-labelledby="headingFour" data-bs-parent="#cashflowAccordion">
                    <div class="accordion-body">
                        <div class="row g-3 mt-1 align-items-stretch">
                            <div class="col-lg-12">
                                <CashflowPerformanceChartComponent Projection="@Projection" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 5: Summary Tables & Business Indicators -->
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingFive">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFive" aria-expanded="false" aria-controls="collapseFive">
                        <i class="bi bi-table"></i>&nbsp; Summary Table & Business Indicators
                    </button>
                </h2>
                <div id="collapseFive" class="accordion-collapse collapse" aria-labelledby="headingFive" data-bs-parent="#cashflowAccordion">
                    <div class="accordion-body">
                        <div class="row g-3 mt-1">
                            <div class="col-lg-6">
                                <CashflowSummaryTableComponent Projection="@Projection" />
                            </div>
                            <div class="col-lg-6">
                                <CashflowBusinessIndicatorsComponent Projection="@Projection" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 6: Detailed Statement -->
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingSix">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSix" aria-expanded="false" aria-controls="collapseSix">
                        <i class="bi bi-file-earmark-text"></i>&nbsp; Detailed Cashflow Statement
                    </button>
                </h2>
                <div id="collapseSix" class="accordion-collapse collapse" aria-labelledby="headingSix" data-bs-parent="#cashflowAccordion">
                    <div class="accordion-body">
                        <div class="row g-3 mt-1">
                            <DetailedCashflowStatementComponent Projection="@Projection" />
                        </div>
                    </div>
                </div>
            </div>

        </div>
    }
</div>