@namespace ViabilityIQ.Web.Components.Pages_Assessments.ProjectionComponents
@using ViabilityIQ.Shared.UtilityServices

<div class="cashflow-summary-dashboard mb-4 font-def">
    <div class="auth-card my-2 py-2" style="max-width: 100%;">
        <!-- Card Header -->
        <div class="auth-header mb-4" style="text-align: left; border-bottom: 1px solid #e2e8f0; padding-bottom: 16px;">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="auth-brand fs-6 mb-1">
                        <i class="bi bi-pie-chart me-2 text-navy"></i><span class="brand-main">Cashflow Summary</span>
                    </div>
                    <p class="auth-subtitle">12-Month Projected Period Total</p>
                </div>
                @if (IsLoading)
                {
                    <div class="spinner-border spinner-border-sm text-navy" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                }
            </div>
        </div>

        <!-- Card Body -->
        <div class="card-body p-0" style="background-color: #ffffff !important;">
            @if (IsLoading)
            {
                <div class="text-center py-2">
                    <div class="spinner-border text-navy" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="text-secondary mt-3">Calculating cashflow summary...</p>
                </div>
            }
            else if (SummaryData == null)
            {
                <div class="alert alert-warning m-1 mb-0" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <strong>No Data Available</strong> - Enter financial data to generate cashflow summary.
                </div>
            }
            else
            {
                <div class="summary-content p-0" style="background-color: #ffffff !important;">                   
                    <!-- Vertical List Table Format -->
                    <div class="table-responsive bg-white p-0" style="background-color: #ffffff !important;">
                        <table class="table table-hover table-borderless align-middle mb-0 cashflow-summary-table bg-white p-3">
                            <tbody>
                                <tr class="data-row" style="border-top: solid 0px #B3D9D9;">
                                    <td class="ps-2 text-secondary">
                                        Total Sales
                                    </td>
                                    <td class="text-end pe-2 font-monospace">
                                        @SummaryData.TotalSales.ToString("N0")
                                    </td>
                                </tr>
                                <tr class="data-row">
                                    <td class="ps-2 text-secondary">
                                        <i class="bi bi-dash text-danger"></i>Cost of Sales <small class="text-muted">(@SummaryData.COGSPercentage.ToString("F1")% of Sales)</small>
                                    </td>
                                    <td class="text-end pe-2 font-monospace text-danger">
                                        (@SummaryData.CostOfSales.ToString("N0"))
                                    </td>
                                </tr>
                                <tr class="data-row bg-light">
                                    <td class="ps-2 text-secondary">
                                        Gross Profit <small class="text-success">(@SummaryData.GrossProfitMargin.ToString("F1")% Margin)</small>
                                    </td>
                                    <td class="text-end pe-2 font-monospace text-success">
                                        @SummaryData.GrossProfit.ToString("N0")
                                    </td>
                                </tr>
                                <tr class="data-row">
                                    <td class="ps-2 text-secondary">
                                        <i class="bi bi-plus text-danger"></i> Sundry Income
                                    </td>
                                    <td class="text-end pe-2 font-monospace text-info">
                                        @SummaryData.SundryIncome.ToString("N0")
                                    </td>
                                </tr>
                                <tr class="data-row bg-light">
                                    <td class="ps-2 text-secondary">
                                        Gross Income
                                    </td>
                                    <td class="text-end pe-2 font-monospace text-navy">
                                        @SummaryData.GrossIncome.ToString("N0")
                                    </td>
                                </tr>
                                <tr class="data-row">
                                    <td class="ps-2 text-secondary">
                                        <i class="bi bi-dash text-danger"></i> Operating Expenses <small class="text-muted">(@SummaryData.OpExPercentage.ToString("F1")% of Sales)</small>
                                    </td>
                                    <td class="text-end pe-2 font-monospace text-warning" style="color: #f59e0b !important;">
                                        (@SummaryData.OperatingExpenses.ToString("N0"))
                                    </td>
                                </tr>
                                <tr class="data-row bg-light">
                                    <td class="ps-2 text-secondary">
                                        EBITDA <small class="text-muted">(@SummaryData.EBITDAMargin.ToString("F1")% Margin)</small>
                                    </td>
                                    <td class="text-end pe-2 font-monospace" style="color: (@DisplayUtility.GetTrendColor(SummaryData.EBITDA)">
                                        @SummaryData.EBITDA.ToString("N0")
                                    </td>
                                </tr>
                                <tr class="data-row" >
                                    <td class="ps-2 text-secondary">
                                        <i class="bi bi-dash text-danger"></i> VAT <small class="text-muted">(@SummaryData.EBITDAMargin.ToString("F1")% Margin)</small>
                                    </td>
                                    <td class="text-end pe-2 font-monospace" style="color: (@DisplayUtility.GetDisplayColorByValue(SummaryData.EBITDA)">
                                        @SummaryData.EBITDA.ToString("N0")
                                    </td>
                                </tr>
                                <tr class="data-row">
                                    <td class="ps-2 text-secondary">
                                        <i class="bi bi-dash text-danger"></i>Interest(Loan) <small class="text-muted">(@SummaryData.EBITDAMargin.ToString("F1")% Margin)</small>
                                    </td>
                                    <td class="text-end pe-2 font-monospace" style="color: @(SummaryData.EBITDA >= 0 ? "#0284c7" : "#dc2626");">
                                        @SummaryData.EBITDA.ToString("N0")
                                    </td>
                                </tr>
                                <tr class="data-row bg-light">
                                    <td class="ps-2 text-secondary strong">
                                        <span class="fw-bold">Net Profit</span> <small class="text-muted">(@SummaryData.NetProfitMargin.ToString("F1")% Margin)</small>
                                    </td>
                                    <td class="text-end pe-2 font-monospace " style="color: (@DisplayUtility.GetDisplayColorByValue(SummaryData.NetProfit);">
                                        <span class="fw-bold">@SummaryData.NetProfit.ToString("N0")</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
