@namespace ViabilityIQ.Web.Components.Pages_Assessments.ProjectionComponents
@inherits IndependentCashflowProjectionComponent

<section class="cfhealth-card" aria-labelledby="cfhealth-title">
    <header class="cfhealth-header">
        <div><i class="bi bi-activity"></i><strong id="cfhealth-title">Business Health Index</strong></div>
        <span>Live viability radar</span>
    </header>

    @if (IsLoading)
    {
        <div class="cfhealth-state"><span class="spinner-border spinner-border"></span> Loading health index...</div>
    }
    else if (!string.IsNullOrWhiteSpace(LoadError))
    {
        <div class="cfhealth-state cfhealth-state-error"><i class="bi bi-exclamation-triangle"></i> Health index could not load: @LoadError</div>
    }
    else if (Projection is not null)
    {
        <div class="cfhealth-layout">
            <div class="cfhealth-radar-wrap">
                <svg class="cfhealth-radar" viewBox="0 0 550 360" role="img" aria-labelledby="cfhealth-description">
                    <title id="cfhealth-description">Business health 3-axis framework radar for interest cover, margin of safety and asset efficiency</title>

                    <defs>
                        <filter id="cfhealthGlow" x="-40%" y="-40%" width="180%" height="180%">
                            <feDropShadow dx="0" dy="6" stdDeviation="6" flood-color="#0891b2" flood-opacity=".35" />
                        </filter>
                        <linearGradient id="cfhealthGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.5" />
                            <stop offset="100%" stop-color="#3b82f6" stop-opacity="0.25" />
                        </linearGradient>
                    </defs>

                    <!-- Background Triangular Grid Rings -->
                    <polygon points="275,65 425,270 125,270" class="cfhealth-grid cfhealth-grid-outer" />
                    <polygon points="275,105 397,250 153,250" class="cfhealth-grid" />
                    <polygon points="275,145 369,230 181,230" class="cfhealth-grid" />
                    <polygon points="275,185 341,210 209,210" class="cfhealth-grid" />

                    <!-- PROTRUDING STRUCTURAL AXIS ARMS -->
                    <line x1="275" y1="270" x2="275" y2="25" class="cfhealth-axis-arm" />
                    <line x1="275" y1="270" x2="480" y2="295" class="cfhealth-axis-arm" />
                    <line x1="275" y1="270" x2="70" y2="295" class="cfhealth-axis-arm" />

                    <!-- Scale Ticks & Numbers -->
                    <line x1="275" y1="65" x2="281" y2="65" class="cfhealth-tick" />
                    <text x="287" y="68" class="cfhealth-tick-label">80</text>
                    <line x1="275" y1="105" x2="281" y2="105" class="cfhealth-tick" />
                    <text x="287" y="108" class="cfhealth-tick-label">60</text>
                    <line x1="275" y1="145" x2="281" y2="145" class="cfhealth-tick" />
                    <text x="287" y="148" class="cfhealth-tick-label">40</text>
                    <line x1="275" y1="185" x2="281" y2="185" class="cfhealth-tick" />
                    <text x="287" y="188" class="cfhealth-tick-label">20</text>
                    <text x="283" y="260" class="cfhealth-tick-label">0</text>

                    <line x1="425" y1="270" x2="433" y2="277" class="cfhealth-tick" />
                    <text x="437" y="278" class="cfhealth-tick-label">80</text>
                    <line x1="397" y1="250" x2="403" y2="257" class="cfhealth-tick" />
                    <text x="409" y="258" class="cfhealth-tick-label">60</text>
                    <line x1="369" y1="230" x2="375" y2="237" class="cfhealth-tick" />
                    <text x="381" y="238" class="cfhealth-tick-label">40</text>
                    <line x1="341" y1="210" x2="347" y2="217" class="cfhealth-tick" />
                    <text x="353" y="218" class="cfhealth-tick-label">20</text>

                    <line x1="125" y1="270" x2="117" y2="277" class="cfhealth-tick" />
                    <text x="101" y="278" class="cfhealth-tick-label">80</text>
                    <line x1="153" y1="250" x2="147" y2="257" class="cfhealth-tick" />
                    <text x="133" y="258" class="cfhealth-tick-label">60</text>
                    <line x1="181" y1="230" x2="175" y2="237" class="cfhealth-tick" />
                    <text x="161" y="238" class="cfhealth-tick-label">40</text>
                    <line x1="209" y1="210" x2="203" y2="217" class="cfhealth-tick" />
                    <text x="189" y="218" class="cfhealth-tick-label">20</text>

                    <!-- Metric Zones & Filled Data Polygon -->
                    <polygon points="275,270 275,@InterestY @MarginX,@MarginY" class="cfhealth-zone cfhealth-zone-interest" />
                    <polygon points="275,270 @MarginX,@MarginY @EfficiencyX,@EfficiencyY" class="cfhealth-zone cfhealth-zone-margin" />
                    <polygon points="275,270 @EfficiencyX,@EfficiencyY 275,@InterestY" class="cfhealth-zone cfhealth-zone-efficiency" />

                    <polygon points="@RadarPoints" class="cfhealth-outline" />

                    <!-- Glowing Nodes -->
                    <circle cx="275" cy="@InterestY" r="6" class="cfhealth-point cfhealth-point-interest" />
                    <circle cx="275" cy="@MarginY" r="0" style="display:none;" /> <!-- placeholder binding safety -->
                    <circle cx="@MarginX" cy="@MarginY" r="6" class="cfhealth-point cfhealth-point-margin" />
                    <circle cx="@EfficiencyX" cy="@EfficiencyY" r="6" class="cfhealth-point cfhealth-point-efficiency" />

                    <!-- Main Category Labels & Values (Wrapped into 2 Lines) -->
                    <text x="275" y="14" text-anchor="middle" class="cfhealth-label">Interest Cover</text>
                    <text x="275" y="24" text-anchor="middle" class="cfhealth-value-label">@InterestCoverDisplay</text>

                    <text x="492" y="300" text-anchor="start" class="cfhealth-label">
                        <tspan x="492" dy="0">Margin of</tspan>
                        <tspan x="492" dy="12">Safety</tspan>
                    </text>
                    <text x="492" y="328" text-anchor="start" class="cfhealth-value-label">@MarginOfSafetyDisplay</text>

                    <text x="60" y="300" text-anchor="end" class="cfhealth-label">
                        <tspan x="60" dy="0">Asset</tspan>
                        <tspan x="60" dy="12">Efficiency</tspan>
                    </text>
                    <text x="60" y="328" text-anchor="end" class="cfhealth-value-label">@AssetEfficiencyDisplay</text>
                </svg>
            </div>

            <aside class="cfhealth-score">
                <span>Overall health</span>
                <strong>@Projection.Viability.HealthScore.ToString("F0")<small>/100</small></strong>
                <div class="cfhealth-score-track">
                    <span style="@($"width:{Clamp(Projection.Viability.HealthScore):F0}%")"></span>
                </div>
                <p>@HealthSummary</p>
            </aside>
        </div>
    }
</section>

@code {
    private decimal InterestScore =>
        Projection!.Viability.InterestCover is null
            ? (Projection.Summary.InterestExpense == 0m && Projection.Summary.EBIT > 0m ? 100m : 0m)
            : Clamp(Projection.Viability.InterestCover.Value / 4m * 100m);

    private decimal MarginScore =>
        Clamp(Projection!.Viability.MarginOfSafety.GetValueOrDefault() / 0.5m * 100m);

    private decimal EfficiencyScore =>
        Clamp(Projection!.Viability.AssetTurnover.GetValueOrDefault() / 2m * 100m);

    private decimal InterestY => 270m - (205m * InterestScore / 100m);

    private decimal MarginX => 275m + (205m * MarginScore / 100m);
    private decimal MarginY => 270m + (25m * MarginScore / 100m);

    private decimal EfficiencyX => 275m - (205m * EfficiencyScore / 100m);
    private decimal EfficiencyY => 270m + (25m * EfficiencyScore / 100m);

    private string RadarPoints =>
        FormattableString.Invariant($"275,{InterestY:F1} {MarginX:F1},{MarginY:F1} {EfficiencyX:F1},{EfficiencyY:F1}");

    private string InterestCoverDisplay =>
        Projection!.Viability.InterestCover.HasValue
            ? $"{Projection.Viability.InterestCover.Value:F1}x"
            : Projection.Summary.InterestExpense == 0m ? "No interest burden" : "N/A";

    private string MarginOfSafetyDisplay =>
        Projection!.Viability.MarginOfSafety.HasValue
            ? $"{Projection.Viability.MarginOfSafety.Value * 100m:F1}%"
            : "N/A";

    private string AssetEfficiencyDisplay =>
        Projection!.Viability.AssetTurnover.HasValue
            ? $"{Projection.Viability.AssetTurnover.Value:F2}x"
            : "N/A";

    private string HealthSummary => Projection!.Viability.HealthScore switch
    {
        >= 75m => "Strong financial resilience",
        >= 55m => "Stable, with room to improve",
        >= 40m => "Performance requires attention",
        _ => "Immediate corrective action advised"
    };

    private static decimal Clamp(decimal value) => Math.Clamp(value, 0m, 100m);
}