@page "/index"
@page "/website/index"
@page "/web/home"


@layout PublicLayout

<PageTitle>Viability.IQ — Understand. Project. Decide.</PageTitle>

<div class="viq-home">

    <!-- =====================================================
         HERO
         ===================================================== -->

    <section class="viq-hero">

        <div class="viq-container">

            <div class="viq-hero-content">

                <div class="viq-hero-eyebrow">
                    Financial Modelling &amp; Business Viability
                </div>

                <h1 style="color: #033E3E !important;">
                    Understand the Viability of a Business Before You Commit.
                </h1>

                <p class="viq-hero-description">
                    Build a baseline. Model 12 months of business activity.
                    Generate financial projections, test different scenarios
                    and explore AI-powered insights.
                </p>
                <p>
                    Viability.IQ combines AI-driven viability scoring, market analysis,
                    and financial modeling so you can see the real picture in minutes —
                    not weeks.
                </p>
                <p class="viq-hero-audience">
                    For Entrepreneurs, Existing & Prospective Businesses, Investors and Shareholders.
                </p>

                <div class="viq-hero-actions">

                    @* <a href="/assessment/new"
                       class="viq-primary-button">
                        Start Your Assessment
                    </a> *@

                    <a href="/request-demo"
                       class="viq-secondary-button">
                        Request a Demo <i class="bi bi-magic text-white"></i>
                    </a>

                </div>

            </div>


            <!-- =================================================
                 DASHBOARD PREVIEW
                 ================================================= -->

            <div class="viq-hero-visual">                
                <div class="hero-visual">
                    <img src="images/hero-dashboard.png"
                         alt="Viability.IQ viability score dashboard"
                         style="width:100%; border-radius:6px;" />
                </div>
            </div>
        </div>

    </section>

    <!-- =====================================================
     ONE PLATFORM / MULTIPLE BUSINESS DECISIONS
     ===================================================== -->

    <section class="viq-decision-section">

        <div class="viq-container">

            <div class="viq-section-heading">

                <div class="viq-section-eyebrow">
                    One Platform! Multiple Decisions! Who must use               
                    <span class="viq-logo-name">
                        Viability<span class="viq-logo-dot">.</span><span class="viq-logo-iq">IQ</span> ??
                    </span>
                </div>
                @*  <h2>
                    Understand the Numbers Behind the Decision.
                </h2> *@

                <p>
                    Whether you are starting a business, managing an existing
                    operation or evaluating an investment, Viability.IQ gives
                    you a structured financial view of the business and its
                    potential scenarios.
                    <br />
                    Viability.IQ combines AI-driven viability scoring, market analysis,
                    and financial modeling so you can see the real picture in minutes —
                    not weeks.
                </p>

            </div>


            <div class="viq-decision-grid">

                <!-- =================================================
                 ENTREPRENEURS
                 ================================================= -->

                <article class="viq-decision-card">

                    <div class="viq-decision-icon">
                        <i class="bi bi-rocket-takeoff"></i>
                    </div>

                    <h3>
                        Starting a Business
                    </h3>

                    <p>
                        Build a financial baseline, model your expected
                        business activity and explore whether the proposed
                        business model can support the required costs,
                        investment and working capital.
                    </p>

                    <a href="/features"
                       class="viq-section-link">
                        Explore Business Planning
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </article>


                <!-- =================================================
                 EXISTING BUSINESSES
                 ================================================= -->

                <article class="viq-decision-card">

                    <div class="viq-decision-icon">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>

                    <h3>
                        Existing Businesses
                    </h3>

                    <p>
                        Start with the current financial position of the
                        business, model the next 12 months and examine
                        profitability, cash flow, working capital and
                        other key viability indicators.
                    </p>

                    <a href="/features"
                       class="viq-section-link">
                        Explore Business Analysis
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </article>


                <!-- =================================================
                 INVESTORS / SHAREHOLDERS
                 ================================================= -->

                <article class="viq-decision-card">

                    <div class="viq-decision-icon">
                        <i class="bi bi-pie-chart"></i>
                    </div>

                    <h3>
                        Investors &amp; Shareholders
                    </h3>

                    <p>
                        Examine the financial structure of a business,
                        model projected cash flows and explore different
                        assumptions and scenarios before making an
                        investment decision.
                    </p>

                    <a href="/investors"
                       class="viq-section-link">
                        Explore Investor Analysis
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </article>

            </div>

        </div>

    </section>

    <!-- =====================================================
         MORE HOME PAGE SECTIONS
         ===================================================== -->

    <section class="viq-home-introduction">

        <div class="viq-container">

            <!-- Additional home page sections will be added here -->

        </div>

    </section>

</div>




<style type="text/css">
    /* =========================================================
               VIABILITYIQ PUBLIC WEBSITE
               ========================================================= */

    :root {
        /* Brand */
        --viq-teal: #0F8A7B;
        --viq-orange: #D97706;
        /* Button colours */
        --viq-marble: #566D7E;
        --viq-bottle-green: #006A4E;
        /* General colours */
        --viq-navy: #0F172A;
        --viq-navy-light: #1E293B;
        --viq-text: #334155;
        --viq-text-light: #64748B;
        --viq-white: #FFFFFF;
        --viq-background: #F8FAFC;
        --viq-border: #E2E8F0;
        /* Layout */
        --viq-container: 1240px;
        /* Effects */
        --viq-radius-sm: 6px;
        --viq-radius-md: 10px;
        --viq-radius-lg: 16px;
        --viq-shadow-sm: 0 2px 6px rgba(15, 23, 42, 0.06);
        --viq-shadow-md: 0 10px 30px rgba(15, 23, 42, 0.10);
        --viq-shadow-lg: 0 20px 50px rgba(15, 23, 42, 0.14);
    }


    /* =========================================================
               GLOBAL
               ========================================================= */

    .viq-public-site {
        min-height: 100vh;
        background: var(--viq-background);
        color: var(--viq-text);
        font-family: Inter, "Segoe UI", Arial, sans-serif;
    }

    .viq-public-main {
        min-height: calc(100vh - 80px);
    }

    .viq-container {
        width: 100%;
        max-width: var(--viq-container);
        margin: 0 auto;
        padding-left: 24px;
        padding-right: 24px;
    }


    /* =========================================================
               VIABILITYIQ LOGO
               ========================================================= */

    .viq-logo {
        display: inline-flex;
        align-items: baseline;
        text-decoration: none;
        line-height: 1;
        white-space: nowrap;
    }

    .viq-logo-name {
        color: var(--viq-teal);
        font-size: 27px;
        font-weight: 800;
        letter-spacing: -1.2px;
    }

    .viq-logo-dot,
    .viq-logo-iq {
        color: var(--viq-orange);
    }

    .viq-logo-dot {
        margin-left: 1px;
    }

    .viq-logo-tagline {
        display: block;
        margin-top: 4px;
        color: var(--viq-text-light);
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.7px;
    }


    /* =========================================================
               PUBLIC NAVIGATION
               ========================================================= */

    .viq-public-nav {
        position: sticky;
        top: 0;
        z-index: 1000;
        background: rgba(255, 255, 255, 0.96);
        border-bottom: 1px solid var(--viq-border);
        backdrop-filter: blur(12px);
    }

    .viq-nav-inner {
        min-height: 76px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
    }

    .viq-nav-brand {
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
    }

    .viq-nav-links {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 25px;
        flex: 1;
    }

    .viq-nav-link {
        color: var(--viq-text);
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        transition: color 0.2s ease, transform 0.2s ease;
    }

        .viq-nav-link:hover {
            color: var(--viq-bottle-green);
            transform: translateY(-1px);
        }

    .viq-nav-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
    }


    /* =========================================================
               BUTTONS
               ========================================================= */

    /*
               All public-site buttons use the marble colour.
               Hover changes them to bottle green.
            */

    .viq-primary-button,
    .viq-secondary-button,
    .viq-outline-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 0 20px;
        border-radius: var(--viq-radius-sm);
        background: var(--viq-marble);
        border: 1px solid var(--viq-marble);
        color: var(--viq-white);
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }

        .viq-primary-button:hover,
        .viq-secondary-button:hover,
        .viq-outline-button:hover {
            background: var(--viq-bottle-green);
            border-color: var(--viq-bottle-green);
            color: var(--viq-white);
            transform: translateY(-1px);
            box-shadow: 0 6px 15px rgba(0, 106, 78, 0.20);
        }


    /* =========================================================
               HERO
               ========================================================= */

    .viq-hero {
        position: relative;
        overflow: hidden;
        background: linear-gradient( 135deg, #FFFFFF 0%, #F8FAFC 55%, #EEF5F3 100% );
        padding: 72px 0 82px;
    }

        .viq-hero::before {
            content: "";
            position: absolute;
            width: 420px;
            height: 420px;
            top: -180px;
            right: -120px;
            border-radius: 50%;
            background: rgba(15, 138, 123, 0.06);
        }

        .viq-hero::after {
            content: "";
            position: absolute;
            width: 300px;
            height: 300px;
            bottom: -170px;
            left: -120px;
            border-radius: 50%;
            background: rgba(217, 119, 6, 0.05);
        }

        .viq-hero .viq-container {
            position: relative;
            z-index: 1;
        }

    .viq-hero-content {
        max-width: 620px;
    }

    .viq-hero-eyebrow {
        display: inline-flex;
        align-items: center;
        margin-bottom: 16px;
        color: var(--viq-bottle-green);
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1.2px;
    }

    .viq-hero h1 {
        margin: 0 0 20px;
        max-width: 650px;
        /*
                   Previous large heading was approximately 56px.
                   Reduced by 50%.
                */
        font-size: 28px;
        line-height: 1.15;
        letter-spacing: -0.8px;
        color: var(--viq-navy);
        font-weight: 800;
    }

    .viq-hero-description {
        max-width: 600px;
        margin: 0 0 14px;
        color: #033E3E; /* var(--viq-text); */
        font-size: 16px;
        line-height: 1.65;
    }

    .viq-hero-audience {
        margin: 0 0 28px;
        color: var(--viq-text-light);
        font-size: 13px;
        font-weight: 600;
    }

    .viq-hero-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }


    /* =========================================================
               HERO LAYOUT
               ========================================================= */

    .viq-hero .viq-container {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(420px, 520px);
        align-items: center;
        gap: 70px;
    }


    /* =========================================================
               DASHBOARD PREVIEW
               ========================================================= */

    .viq-hero-visual {
        display: flex;
        justify-content: center;
    }

    .viq-dashboard-placeholder {
        width: 100%;
        overflow: hidden;
        background: #FFFFFF;
        border: 1px solid var(--viq-border);
        border-radius: var(--viq-radius-lg);
        box-shadow: var(--viq-shadow-lg);
        transform: perspective(1200px) rotateY(-3deg);
    }

    .viq-dashboard-top {
        min-height: 48px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 18px;
        background: var(--viq-navy);
        color: white;
        font-size: 11px;
        font-weight: 700;
    }

    .viq-dashboard-body {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        padding: 18px;
    }

    .viq-dashboard-card {
        min-height: 78px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 14px;
        background: #F8FAFC;
        border: 1px solid var(--viq-border);
        border-radius: 8px;
    }

        .viq-dashboard-card span {
            margin-bottom: 7px;
            color: var(--viq-text-light);
            font-size: 10px;
            font-weight: 600;
        }

        .viq-dashboard-card strong {
            color: var(--viq-navy);
            font-size: 18px;
            font-weight: 800;
        }

    .viq-dashboard-chart {
        grid-column: 1 / -1;
        min-height: 180px;
        padding: 16px;
        background: #FFFFFF;
        border: 1px solid var(--viq-border);
        border-radius: 8px;
    }

        .viq-dashboard-chart > span {
            display: block;
            margin-bottom: 20px;
            color: var(--viq-text);
            font-size: 11px;
            font-weight: 700;
        }

    .viq-chart-lines {
        height: 110px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        border-bottom: 1px solid var(--viq-border);
    }

        .viq-chart-lines div {
            height: 1px;
            width: 100%;
            background: var(--viq-border);
        }


    /* =========================================================
               FOOTER
               ========================================================= */

    .viq-public-footer {
        background: var(--viq-navy);
        color: #CBD5E1;
        padding: 55px 0 25px;
    }

    .viq-footer-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr;
        gap: 50px;
    }

    .viq-footer-brand .viq-logo-name {
        font-size: 25px;
    }

    .viq-footer-description {
        max-width: 360px;
        margin-top: 15px;
        color: #94A3B8;
        font-size: 13px;
        line-height: 1.7;
    }

    .viq-footer-title {
        margin-bottom: 15px;
        color: #FFFFFF;
        font-size: 13px;
        font-weight: 700;
    }

    .viq-footer-links {
        display: flex;
        flex-direction: column;
        gap: 9px;
    }

        .viq-footer-links a {
            color: #94A3B8;
            text-decoration: none;
            font-size: 12px;
            transition: color 0.2s ease;
        }

            .viq-footer-links a:hover {
                color: #FFFFFF;
            }

    .viq-footer-bottom {
        margin-top: 45px;
        padding-top: 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.10);
        color: #64748B;
        font-size: 11px;
    }


    /* =========================================================
               MOBILE MENU
               ========================================================= */

    .viq-mobile-menu-button {
        display: none;
        width: 40px;
        height: 40px;
        align-items: center;
        justify-content: center;
        background: transparent;
        border: 1px solid var(--viq-border);
        border-radius: 7px;
        color: var(--viq-navy);
        cursor: pointer;
    }

    .viq-mobile-menu {
        display: none;
        padding: 15px 24px 20px;
        border-top: 1px solid var(--viq-border);
        background: #FFFFFF;
    }

        .viq-mobile-menu.open {
            display: block;
        }

    .viq-mobile-menu-links {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

        .viq-mobile-menu-links a {
            padding: 8px 0;
            color: var(--viq-text);
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
        }


    /* =========================================================
               RESPONSIVE
               ========================================================= */

   

    
    

</style>